              else if (LOCALORSERVERNEW == 'SERVER') {
                  url = 'PurchaseOrderView/getPOHistory?poid=' + $('#hiddn_poid').val().trim();
              }

              var dataTable = "";
              var dt = "";
              var po = new Array();


              $.ajax({
                  type: "POST",
                  url: url,
                  //data: { 'poid': $('#hiddn_poid').val().trim() },
                  contentType: "application/json; charset=utf-8",
                  dataType: "JSON",
                  success: function (data) {
                     
                      
                          dt = data.data;

                          $('#POHistory').dataTable().fnDestroy();

                         

                              for (i = 0; i < dt.length ; i++) {

                                  po[i] = new Array();
                                  //Subhabartata Mondal

                                  var POID = dt[i].PurchaseOrderID.toString();
                                  POID = POID.substring(POID.length - 4, POID.length);

                                  po[i][0] = '<i class="fa fa-list" onclick="openlineitems(\'' + dt[i].FldID + '\');"></i>'
                                              + '<i style="margin-left:10px;" class="fa fa-history" onclick="openpohistory(\'' + parseInt(POID) + '\',\'' + dt[i].Version + '\');"></i>';
                                  po[i][1] = dt[i].PurchaseOrderID;
                                  po[i][2] = dt[i].VendorName;
                                  po[i][3] = dt[i].BuyerName;
                                  po[i][4] = dt[i].ArrivalDate;
                                  po[i][5] = dt[i].CheckBackDate;
                                  po[i][6] = dt[i].VendorCOName;
                                  po[i][7] = dt[i].InsertDate;
                                  po[i][8] = dt[i].Version;
                                  po[i][9] = dt[i].AddedByName;
                              }

                              $('#POHistory').dataTable({
                                  "processing": true,
                                  "data": po,
                                  "columns":
                                    [
                                      { "title": "Action" },
                                      { "title": "PO #" },
                                      { "title": "Vendor Name" },
                                      { "title": "Buyer Name" },
                                      { "title": "Ship Date" },
                                      { "title": "CheckBack Date" },
                                      { "title": "VendorCOName" },
                                      { "title": "Created Date" },
                                    { "title": "Version" },
                                    { "title": "Added By" }

                                    ],
                                  "initComplete": function () {
                                      //$('#UnCommittedPODetail tr').each(function () {
                                      //    var id = $(this).find("td:eq(0)").html();
                                      //    if (id != null) {
                                      //        var html = $(this).html();
                                      //        alert(html);
                                      //    }
                                      //});
                                  }
                              });


                         
                     
                  }


              });










          });

          function openpohistory(POID, Version) {

              var url = '';
              if (LOCALORSERVERNEW == 'LOCAL') {
                  url = '/PurchaseOrderView/getPOApprovalsBackup';
              }
              else if (LOCALORSERVERNEW == 'SERVER') {
                  url = 'PurchaseOrderView/getPOApprovalsBackup';
              }


              $.ajax({
                  type: "POST",
                  url: url,
                  data: "{ 'POID' : '" + POID + "','Version' : '" + Version + "'}",
                  contentType: "application/json; charset=utf-8",
                  dataType: "JSON",
                  success: function (data) {
                      var html = "<div><table border='1' class='display no-footer dataTable'><thead><th>Action</th><th>Comment</th></thead>";
                      data = data.data;
                      
                      for (var i = 0; i < data.length; i++) {
                          html += "";
                          var Approved = data[i].Approved;
                          var Rejected = data[i].Rejected;
                          var InsertDate = data[i].InsertDate;
                          var Comment = data[i].Comment;
                          var Version = data[i].Version;
                          var UserName = data[i].UserName;
                          var ManagerName = data[i].ManagerName;

                          html += "<tr><td>";

                          if (Approved == "1") {
                              html += "Approved ";
                          }
                          else {
                              html += "Rejected ";
                          }

                          var tmpstr = "";

                          if (ManagerName == "") {
                              tmpstr = "By " + UserName;
                          }
                          else {
                              tmpstr = "By " + ManagerName + " on behalf of " + UserName;

                          }
                          html += tmpstr + " on " + InsertDate + "</td>";
                          html += "<td>" + Comment + "</td></tr>";

                      }
                      html += "</table></div>";

                      // alert(html);
                      if(data.length == 0){
                          html = "<span>No History found<span>";
                      }

                      $('#pohistory').html(html);

                      $('#popuppohistory').bPopup({
                          easing: 'easeOutBack', //uses jQuery easing plugin
                          speed: 450,
                          transition: 'slideDown',
                          modalColor: 'rgb(18, 54, 65)'

                      });

                  }


              });


          }

          function openlineitems(poid) {

              var url = '';
              if (LOCALORSERVERNEW == 'LOCAL') {
                  url = '/PurchaseOrderView/getPOBackupLineItems?poid=' + poid;
              }
              else if (LOCALORSERVERNEW == 'SERVER') {
                  url = 'PurchaseOrderView/getPOBackupLineItems?poid=' + poid;
              }

            

              $.ajax({
                  type: "POST",
                  url: url,
                  //data: { 'poid': $('#hiddn_poid').val().trim() },
                  contentType: "application/json; charset=utf-8",
                  dataType: "JSON",
                  success: function (data) {

                      
                      var dataTable = "";
                      var dt = "";
                      var lineitems = new Array();

                     // //console.log(data.data);


                      dt = data.data;

                      $('#polineitems').dataTable().fnDestroy();



                      for (i = 0; i < dt.length ; i++) {

                          lineitems[i] = new Array();

                          lineitems[i][0] = dt[i].ItemDescription;
                          lineitems[i][1] = dt[i].SpecNum;
                          lineitems[i][2] = dt[i].Vendor;
                          lineitems[i][3] = dt[i].Quantity;
                          lineitems[i][4] = dt[i].UOM;
                          lineitems[i][5] = dt[i].Cost;
                          lineitems[i][6] = dt[i].Cost * dt[i].Quantity;
                         
                      }

                      $('#polineitems').dataTable({
                          "processing": true,
                          "data": lineitems,
                          "columns":
                            [
                              { "title": "ItemDescription" },
                              { "title": "SpecNum" },
                              { "title": "Vendor" },
                              { "title": "Quantity" },
                              { "title": "UOM  " },
                              { "title": "Cost" },
                               { "title": "Total" }

                            ],
                          "initComplete": function () {
                              //$('#UnCommittedPODetail tr').each(function () {
                              //    var id = $(this).find("td:eq(0)").html();
                              //    if (id != null) {
                              //        var html = $(this).html();
                              //        alert(html);
                              //    }
                              //});
                          }
                      });



                      $('#popuplineitems').bPopup({
                          easing: 'easeOutBack', //uses jQuery easing plugin
                          speed: 450,
                          transition: 'slideDown',
                          modalColor: 'rgb(18, 54, 65)'

                      });

                  }

              });

          }

      </script>
