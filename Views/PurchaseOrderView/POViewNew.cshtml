        function ExpediteNotesTwistee(obj) {
            if ($(obj).hasClass('collapsed') == true) {
                $('#txt_ExpediteNotes').show();
                $('#btn_ExpediteNotes').show();
                $('#expeditenotelist').show();
                $(obj).removeClass('collapsed');
                $(obj).addClass('opened');

                $(obj).html('<i class="fa fa-minus-circle"></i>  ' + 'Expedite Notes');

            }
            else {
                $('#txt_ExpediteNotes').hide();
                $('#btn_ExpediteNotes').hide();
                $('#expeditenotelist').hide();
                $(obj).removeClass('opened');
                $(obj).addClass('collapsed');

                $(obj).html('<i class="fa fa-plus-circle"></i>  ' + 'Expedite Notes');
            }
        }
