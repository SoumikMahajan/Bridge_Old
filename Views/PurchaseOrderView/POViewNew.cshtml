    <script type="text/javascript">
        
        


        function getpoexpeditenotes() {

            var POID = $('#Hdn_PurchaseOrderID').val();

           
            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/PurchaseOrderView/getPOExpediteNote';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {

                url1 = 'PurchaseOrderView/getPOExpediteNote';
            }



            $.ajax({
                type: "POST",
                url: url1,
                async: false,
                data: { 'POID': POID  },
                success: function (data) {
                    if (data == "") {
                        $('#expeditenotelist').html("No Notes available.");
                        return;
                    }
                    var html = "";
              
                    for (var i = 0; i < data.split(',').length; i++) {
                        html += "<span class='remove'>" + data.split(',')[i].split('^')[0] + "( " + data.split(',')[i].split('^')[1] + " )</span>";
                    }

                   

                    $('#expeditenotelist').html(html);
                },
                error: function () { notify('Something went wrong'); }
            });



        }

        

    </script>
