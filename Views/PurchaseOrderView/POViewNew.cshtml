    <script type="text/javascript">

        function alreadyconfirmed() {
            notify("Already Confirmed");
        }

        function confirmpo() {
            var POID = $('#Hdn_ID').val();

            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/PurchaseOrderView/VendorConfirmPO';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {

                url1 = 'PurchaseOrderView/VendorConfirmPO';
            }



            $.ajax({
                type: "POST",
                url: url1,
                async: false,
                data: { 'POID': POID },
                success: function (data) {

                    $('#Vendorconfirmation').removeAttr('onclick');
                    $('#Vendorconfirmation').attr('onclick', 'alreadyconfirmed();');

                    $('#Vendorconfirmation').css('background', '#556A77');
                    $('#Vendorconfirmation').val('Confirmed');

                    notify("Vendor Confirmed");

                },
                error: function () { notify('Something went wrong'); }
            });

        }

        $(document).ready(function () {

            var tmp = $('#Hdn_IsVendorConfirmation').val();
            if (tmp == "0") {
                $('#Vendorconfirmation').remove();
            }
            else if (tmp == "2") {

                $('#Vendorconfirmation').removeAttr('onclick');
                $('#Vendorconfirmation').attr('onclick', 'alreadyconfirmed();');
                $('#Vendorconfirmation').css('background', '#556A77');
                $('#Vendorconfirmation').val('Confirmed');

            }
        });

    </script>


