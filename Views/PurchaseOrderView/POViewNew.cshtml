    <script type="text/javascript">

        var selectedpopup;

        $(document).ready(function () {

            $(document).tooltip();

            var classarray = new Array();
            var clsearch = '';
            var ddlfrcllsfictn;
            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/PurchaseOrderView/getClassification';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {

                url1 = 'PurchaseOrderView/getClassification';
            }



            $.ajax({
                type: "POST",
                url: url1,
                async: false,
                data: {},
                success: function (data) {

                    ddlfrcllsfictn = "<select id='Ddl_Clftion' multiple='multiple'>"

                    data = JSON.parse(data);
                    ////console.log(data);
                    classarray = data.data;

                    for (var a = 0; a < classarray.length ; a++) {

                        //ddlfrcllsfictn += "<opiton>" + 'test' + "</option>";
                        ddlfrcllsfictn += "<option text='" + classarray[a].classname + "' value='" + classarray[a].classid + "'>" + deletespaces(classarray[a].classname) + "</option>";
                    }

                    ddlfrcllsfictn += "</select>";

                    //notify(ddlfrcllsfictn);
                },
                error: function () { notify('Something went wrong'); }
            });




            url1 = '';


            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/PurchaseOrderView/getVendors';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {

                url1 = 'PurchaseOrderView/getVendors';
            }


            var totdata;

            var vendors = new Array();

            //$('#vendorlist tfoot th').each(function () {
            //    var title = $('#example thead th').eq($(this).index()).text();
            //    $(this).html('<input type="text" placeholder="Search ' + title + '" />');
            //});

            $.get(url1)
                .success(function (response) {


                    totdata = JSON.parse(response);
                    totdata = totdata.data;

                    for (i = 0; i < totdata.length ; i++) {
                        vendors[i] = new Array();
                        var id = totdata[i].Vendor_ID;
                        var txt = 'Click to select ' + totdata[i].ContactFirstname + ' ' + totdata[i].ContactLastname + ' At ' + totdata[i].ParentVendorName;
                        vendors[i][0] = '<i class="fa fa-hand-o-right" style="font-size: 1.5em;cursor:pointer;" data-id="' + id + '" title="' + txt + '" onclick="selectvendor(this);"></i>';
                        vendors[i][1] = totdata[i].ParentVendorName;
                        vendors[i][2] = totdata[i].ContactFirstname + ' ' + totdata[i].ContactLastname;
                        vendors[i][3] = deletespaces(totdata[i].Classifications);
                        vendors[i][4] = totdata[i].Currency;
                        vendors[i][5] = totdata[i].City;
                        vendors[i][6] = totdata[i].State;
                        vendors[i][7] = totdata[i].CurrCode;
                    }

