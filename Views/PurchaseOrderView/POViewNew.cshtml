        function IsNumber(e) {
            var keyCode = e.which ? e.which : e.keyCode
            if ((keyCode > 47 && keyCode < 58) || (keyCode == 8) || (keyCode == 46)) {
                return true;
            }
            else {
                notify('Use Only Numeric value');
                return false;
            }
        }



    </script>

