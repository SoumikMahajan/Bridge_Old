        });
        function resetsrch() {
            $("#Ddl_Clftion").multiselect("uncheckAll");

            var table = $('#vendorlist').DataTable();
            table.column(3).search('').draw();
            $('.srch').each(function () {
                this.value = '';
                var indx = $(this).attr('data-indx');
                var txt = this.value;
                table
                       .column(indx)
                       .search(txt)
                       .draw();
            });
        }

        function openvendors(obj) {

            resetsrch();

            selectedpopup = obj;


            $('#popupforvendorlist').bPopup({
                easing: 'easeOutBack', //uses jQuery easing plugin
                speed: 450,
                transition: 'slideDown',
                modalColor: 'rgb(18, 54, 65)'

            });
        }

        function selectvendor(obj) {
            var id = $(obj).attr('data-id');
            var rw = $(obj).parent().parent();
            // var cname = $(rw).find("td:eq(1)").html() + '-' + $(rw).find("td:eq(2)").html();

            var cname = "";

            if (selectedpopup == 'vendor') {
                cname = $(rw).find("td:eq(1)").html() + '-' + $(rw).find("td:eq(2)").html();
            }
            else {
                cname = $(rw).find("td:eq(2)").html();
            }


            var currency = $(rw).find("td:eq(4)").html();
            var currencycode = $(rw).find("td:eq(7)").html();

            //alert(rw);

            $('#popupforvendorlist').bPopup().close();

            if (selectedpopup == 'vendor') {

                $('#txt_CurrencyCode').text(currency);
                $('#txt_CurrencyCode').attr('data-id', currencycode);

                $('#txt_VendorName').text(cname);
                $('#txt_VendorName').attr('data-id', id);
            }
            else {

                $('#txt_VendorCO').text(cname);
                $('#txt_VendorCO').attr('data-id', id);
                // notify('still working');

                var url1 = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url1 = '/PurchaseOrderView/vendoraddress';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url1 = 'PurchaseOrderView/vendoraddress';
                }


                $.ajax({
                    type: "POST",
                    url: url1,
                    async: false,
                    data: { 'vendorid': id },
                    success: function (data) {
                        $('#txt_addr1').text(data);
                    },
                    error: function () { notify('Something went wrong'); }
                });

            }
        }


        

        function deletespaces(str) {
            var newstr = '';
            for (var i = 0; i < str.length; i++) {
                if (str[i] != ' ') {
                    newstr += str[i];
                }
            }
            return newstr;
        }

    </script>
    <script>

        $(document).ready(function () {


            var poid = $('#poid').val();




            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/PurchaseOrderView/getpobyid';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'PurchaseOrderView/getpobyid';
            }



            $.ajax({
                type: "POST",
                url: url,
                data: { 'poid': poid },
                success: function (data) {

                    var obj = JSON.parse(data).data[0];
                    //console.log(obj);


                    var iscommited = obj.IsCommited;
                    var IsSentForApproval = obj.IsSentForApproval;

                    

                    if (iscommited == "0") {
                        $('#Hdn_iscommited').val("0");
                        $('#btn_RevisePO').hide();

                        //$('.makedisable').removeAttr('disabled');

                        $('#btn_ViewPOPDF').hide();
                    }
                    else {
                        $('#Hdn_iscommited').val("1");
                        $('#btn_CreatePO').hide();
                        $('#btn_CommitPO').hide();
                        $('#btn_CommitPONSndApprvl').hide();
                        $('#btn_ProofPONSndApprvl').hide();

                        $('#btn_ViewPOPDF').show();

                        $('.makedisable').attr('disabled', 'disabled');

                    }
                    $('.makedisable').attr('disabled', 'disabled');
                    //if (IsSentForApproval == "1") {
                    //    $('#btn_RevisePO').hide();

                    //    $('.makedisable').removeAttr('disabled');
                    //}

                    $('#Ddl_Project').val(obj.Project_ID);
                    $('#Ddl_Project').attr('disabled', 'disabled');

                    $('#txt_ShipTo').val(obj.ShipTo);
                    $('#txt_VendorName').text(obj.VendorName);
                    $('#txt_VendorName').attr('data-id', obj.Vendor_ID);
                    $('#txt_VendorCO').text(obj.VendorCareOfName);
                    $('#txt_VendorCO').attr('data-id', obj.VendorCO);

                    $('#txt_ConversionRate').val(obj.ConversionRate);
                    $('#txt_InvoiceTo').val(obj.InvoiceTo);
                    $('#txt_addr1').text(obj.Address1);

                    $('#txt_CurrencyCode').text(obj.Currency);
                    $('#Ddl_Buyer').val(obj.Buyer_ID);
                    $('#Ddl_Shipment').val(obj.ShipMethod);
                    $('#txt_ArrivalDate').val(obj.ArrivalDate);
                    $('#txt_CheckDate').val(obj.CheckBackDate);
                    $('#txt_Terms').val(obj.Terms);
                    $('#txt_FOB').val(obj.FOB);
                    $('#txt_Freight').val(obj.Freight);
                    //$('#txt_Notes').val(obj.Freight);
                    $('#txt_Remarks').val(obj.Remarks);
                    
                    $('#txt_Notes').val(obj.Notes);
                }
            });

        });


    </script>



