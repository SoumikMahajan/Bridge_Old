@{
    ViewBag.Title = "MergeVendor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/css/jquery.switchButton.css" rel="stylesheet" />
    <link href="~/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="~/css/jquery-ui.css" rel="stylesheet" />
    <link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.1.0/css/font-awesome.min.css" rel="stylesheet" type="text/css">
 <link href="~/css/jquery.dataTables.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.dataTables.min.js"></script>
    <script src="~/Scripts/jquery-ui.min.js"></script>
    <script src="~/Scripts/jquery.switchButton.js"></script>
    <script src="~/Scripts/InnerMisc.js"></script>
    <script src="~/Scripts/User.js"></script>
    <script src="~/Scripts/GlobalJS.js"></script>
<style>
      .remove { /* width: 450px; */
            border: 1px solid #060506;
            -moz-border-radius: 2px;
            -webkit-border-radius: 2px;
            display: block;
            padding: 5px;
            text-decoration: none;
            background: #526779;
            color: #E2E2E2;
            margin-right: 5px;
            margin-bottom: 5px;
            font-family: helvetica;
            font-size: 16px;
            position: relative;
        }
        .remove a {
  cursor: pointer;
  position: absolute;
  top: -5px;
  right: -6px;
  font-size: 0.9em;
  color: white;
  background: black;
  border-radius: 100px;
  padding: 7px;
  line-height: 9px;
}
</style>
 <div class="container-fluid">
     <input type="hidden" id="parentvendordata" value="@ViewBag.VENDORDATA" />
     <input type="hidden" id="parentvendorid" />
     <input type="hidden" id="parentvendorcurrcode" />
      <div class="row">
            <div class="col-sm-12">
                <h3 class="section-header">Merge Vendors</h3>
            </div>
        </div>
     <div class="row">
         <div class="col-sm-4">
             <label>Vendor Common Name</label>
             <input type="text" id="vendorcommonname" class="form-control" disabled/>
         </div>
          <div class="col-sm-4">
              <label>Vendor Legal Name</label>
             <input type="text" id="vendorlegalname" class="form-control" disabled/>
         </div>
          <div class="col-sm-4">
              <label>Vendor Currency</label>
             <input type="text" id="vendorcurrency" class="form-control" disabled/>
         </div>
     </div>
     <div class="row">
         <div class="col-sm-4 mrg10T">
                <div class="form-group">
                          <button class="btn btn-block btn-primary" data-toggle="modal" data-target="#allvendors"><i class="fa fa-list mrg5R"></i>Select Vendor(s) to merge</button>
                    </div>
             </div>
     </div>
<!-- Modal -->
<div id="allvendors" class="modal fade" role="dialog">
  <div class="modal-dialog">
    <!-- Modal content-->
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">&times;</button>
        <i class="fa fa-table mrg10R"></i><h4 class="modal-title" id="vendorcurrencyforpopup">Vendor List</h4>
      </div>
      <div class="modal-body"  style="max-height: 480px;overflow: auto;">
          <table id="vendorlist">
              <thead>
              <tr>
                  <th>Action</th>
                  <th>endor Common Name</th>
                  <th>endor Legal Name</th>
                  <th>Currency</th>                  
                  <th>Currency</th>                  
              </tr>
                  </thead>
              <tbody></tbody>
          </table>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal" onclick="addVendorToMerge();">Add selected</button>
      </div>
    </div>
  </div>
</div>
      <div class="row mrg10T">
            <div class="col-sm-12">
                <h3 class="section-header">Selected Vendor(s)</h3>
            </div>
        </div>
     <div class="row mrg10T">
     <div class="col-sm-12" id="vendormergelist">
          None selected
     </div>
         <div class="col-sm-4 mrg10T">
                <div class="form-group">
                      <button class="btn btn-block btn-primary" onclick="mergevendornow();"><i class="fa fa-clipboard mrg5R"></i>Merge Selected</button>
       @* <button type="button" class="btn btn-default mrg10T" data-toggle="modal" data-target="#allvendors">Select Vendor(s) to merge</button>
         <button type="button" class="btn btn-default mrg10T" onclick="mergevendornow();">Merge Selected</button>*@
                    </div>
              </div>
         </div>
 </div>
<script>
    $(document).ready(function () {
        var vendordata = $('#parentvendordata').val();
        $('#parentvendorid').val(vendordata.split('^')[0]);
        $('#vendorcommonname').val(vendordata.split('^')[1]);
        $('#vendorlegalname').val(vendordata.split('^')[2]);
        $('#vendorcurrency').val(vendordata.split('^')[3]);
        $('#parentvendorcurrcode').val(vendordata.split('^')[4]);
         $('#vendorcurrencyforpopup').html('Vendor List (' + vendordata.split('^')[3] + ')');
        var url1 = '';
        if (LOCALORSERVERNEW == 'LOCAL') {
            url1 = '/Vendor/GetVendorListForMerge';
        }
        else if (LOCALORSERVERNEW == 'SERVER') {
            url1 = 'Vendor/GetVendorListForMerge';
        }
        url1 += "?currcode=" + vendordata.split('^')[4] + "&vendorid=" + vendordata.split('^')[0];
        var totdata;
        $.get(url1)
                .success(function (response) {
                    var vendor;
                    totdata = JSON.parse(response).data;
                    var vendor = new Array();
                    for (i = 0; i < totdata.length ; i++) {
                        var edtvendorlink = "";
                        var pourl = "";
                        if (LOCALORSERVERNEW == 'LOCAL') {
                            edtvendorlink = "/Vendor/EditVendor/";
                        }
                        else if (LOCALORSERVERNEW == 'SERVER') {
                            edtvendorlink = "Vendor/EditVendor/";
                        }
                        edtvendorlink += totdata[i].vendorid;
                        var acccolumnhtml = "<input type='checkbox' id='chkvnd_" + totdata[i].vendorid + "' />";
                        acccolumnhtml += "   |  <a href='" + edtvendorlink + "' target='_blank'><i class='fa fa-search'></i></a>";
                        vendor[i] = new Array();
                        vendor[i][0] = acccolumnhtml;// Convert.ToString(dr["ProjectContact_ID"]);
                        vendor[i][1] = totdata[i].vendorid;
                        vendor[i][2] = totdata[i].commonname;// Convert.ToString(dr["ContactName"]);
                        vendor[i][3] = totdata[i].LegalName;// Convert.ToString(dr["Address"]);
                        vendor[i][4] = totdata[i].contacts;// Convert.ToString(dr["Address"]);
                    }
                    $('#vendorlist').dataTable({
                        "processing": true,
                        "data": vendor,
                        "columns": [
                            { "title": "Action" },
                            { "title": "", "class": "displaynone" },
                            { "title": "Common Name" },
                            { "title": "LegalName" },
                        { "title": "LegalName","class" : "displaynone" }
                        ]
                      ,
                        "initComplete": function () {
                        },
                        "order": [[1, "asc"]],
                        "aoColumnDefs": [
                            { 'bSortable': false, 'aTargets': [0, 1] }
                        ]
                    });
                });
    });
    function addVendorToMerge() {
        var html = "";
        var cnt = 0;
        $('#vendorlist tbody tr').each(function () {
            var vndid = $(this).find('td:eq(1)').html();
            var vndname = $(this).find('td:eq(2)').html();
            var vndncontacts = $(this).find('td:eq(4)').html();
            if ($(this).find('input[type=checkbox]').is(':checked')) {
                cnt++;
                var contactlist = "";
                for (var t = 0 ; t < vndncontacts.split('#').length; t++) {
                    var contactidurl = "";
                    var url1 = '';
                    if (LOCALORSERVERNEW == 'LOCAL') {
                        contactidurl = "/Vendor/EditContact/";
                    }
                    else if (LOCALORSERVERNEW == 'SERVER') {
                        contactidurl = 'Vendor/EditContact/';
                    }
                    contactidurl += vndncontacts.split('#')[t].split('^')[1];
                    contactlist += "<span style='cursor:pointer' class='label label-success mrg5L' onclick='openvendorcontact(this);' data-url='" + contactidurl + "'>" + vndncontacts.split('#')[t].split('^')[0] + "</span>";
                }
                html += "<span class='remove'  data-id='" + vndid + "'><a href='javascript:void(0);'  onclick='removevendor(this);'>x</a><span>" + vndname  + "</span>" + contactlist + "</span>";
            }
        });
        if (cnt > 0) {
            $('#vendormergelist').html(html);
        }
        else {
            $('#vendormergelist').html("None selected");
        }
    }
    function openvendorcontact(obj) {
        window.open($(obj).attr('data-url'));
    }
    function removevendor(obj) {
        var c = confirm("Are you sure you want to delete?");
        if (!c) {
            return;
        }
        $(obj).parent().remove();
    }
    function mergevendornow() {
        if ($('.remove').length == 0) {
            notify("None selected!!!Select vendor(s) first");
            $('#allvendors').modal('show');
            return;
        }
        var c = confirm("Are you sure you want to Merge " + $('.remove').length + " vendors with \"" + $('#vendorlegalname').val() + "\"?");
        if (!c) {
            return;
        }
        var vndid = '';
        $('.remove').each(function () {
            vndid += vndid == "" ? $(this).attr('data-id') : '^' + $(this).attr('data-id');
        });
        var parentid = $('#parentvendorid').val();
        var url = '';
        if (LOCALORSERVERNEW == 'LOCAL') {
            url = '/vendor/mergeVendors';
        }
        else if (LOCALORSERVERNEW == 'SERVER') {
            url = 'vendor/mergeVendors';
        }
        $.ajax({
            type: "POST",
            dataType: "text",
            contentType: "application/json; charset=utf-8",
            url: url,
            data: "{ 'VendorID':'" + parentid + "','toBeMergedID' : '" + vndid + "'}",
            success: function (data) {
                var url = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url = '/vendor/EditVendor/';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url = 'vendor/EditVendor/';
                }
                url += parentid;
                var c = confirm(data + " New Contacts merged" + " Go back to Edit Screen");
                if (!c) {
                    window.location.reload();
                    return;
                }
                window.location.href = url;
            },
            error: function () { }
        });
    }
</script>
