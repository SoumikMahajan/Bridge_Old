    <script>

        $(document).ready(function () {
            var obj = new Object();



            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "poms_AllVendorsget";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var o = DBSP.call_DB_Procedure();
            o = o.data;
            data = o;
            console.log(o);
            var vendors = new Array();

            for (var t = 0; t < data.length; t++) {
                vendors[t] = new Array();
                vendors[t][0] = data[t].ParentVendorName;
                vendors[t][1] = data[t].LegalName;
                vendors[t][2] = data[t].Classifications;
                vendors[t][3] = data[t].City;
                vendors[t][4] = data[t].Country;
                vendors[t][5] = data[t].ParentVendor_ID;

            }
            console.log(vendors);

            $('#vendors').dataTable({
                "processing": true,
                "data": vendors,
                "destroy": true,

                "columns":
                  [
                    { "title": "Common Name", "class": "leftposition" },
                    { "title": "Legal Name", "class": "leftposition" },
                    { "title": "Classification", "class": "leftposition" },
                  { "title": "City", "class": "leftposition" },
                  { "title": "Country", "class": "leftposition" },
                  { "title": "Country", "class": "displaynone" }


                  ],
                "order": [[0, "asc"]],
                "initComplete": function () {


                    $('#vendors tbody tr').each(function () {

                        var ob = $(this);
                        $(ob).css('cursor', 'pointer');
                        $(ob).find('td:eq(0)').attr('onclick', 'gotoV(this);');

                        $(ob).find('td:eq(1)').attr('onclick', 'gotoV(this);');
                        $(ob).find('td:eq(2)').attr('onclick', 'gotoV(this);');
                        $(ob).find('td:eq(3)').attr('onclick', 'gotoV(this);');

                    });

                    var html = "<tr>"
            //+ "<th class='Resetth' rowspan='1' colspan='1'>"
            //+ "<a><input type='button' value='Reset' onclick='ResetSearch();' style='margin-bottom:6px;' /></a></th>"


            + "<th rowspan='1' colspan='1'><input class='srch' style='width:100%;padding: 2px 2%; font-family:Arial, FontAwesome' placeholder=' &#xF002;' data-indx='0' type='text'></th>"
            + "<th rowspan='1' colspan='1'><input class='srch' style='width:100%;padding: 2px 2%; font-family:Arial, FontAwesome' placeholder=' &#xF002;' data-indx='1' type='text'></th>"
            + "<th rowspan='1' colspan='1'><input class='srch' style='width:100%;padding: 2px 2%; font-family:Arial, FontAwesome' placeholder=' &#xF002;' data-indx='2' type='text'></th>"
            + "<th rowspan='1' colspan='1'><input class='srch' style='width:100%;padding: 2px 2%; font-family:Arial, FontAwesome' placeholder=' &#xF002;' data-indx='3' type='text'></th>"
            + "<th rowspan='1' colspan='1'><input class='srch' style='width:100%;padding: 2px 2%; font-family:Arial, FontAwesome' placeholder=' &#xF002;' data-indx='4' type='text'></th>"

            + "</tr>";

                    if ($('#vendors thead').find('tr').length == 1) {
                        $('#vendors thead').append(html);
                    }
                    else {
                        $('#vendors thead').find('tr:eq(1)').remove();
                        $('#vendors thead').append(html);

                    }

                    $('.srch').on('keyup change', function () {
                        var indx = $(this).attr('data-indx');
                        var txt = this.value;

                        var table = $('#vendors').DataTable();
                        table
                               .column(indx)
                               .search(txt)
                               .draw();




                    });




                }
            });

        });
        $(document).ready(function () {
            $('#vendors').on('draw.dt', function () {
                console.log('111111');

                $('#vendors tbody tr').each(function () {

                    var ob = $(this);
                    $(ob).css('cursor', 'pointer');
                    $(ob).find('td:eq(0)').attr('onclick', 'gotoV(this);');

                    $(ob).find('td:eq(1)').attr('onclick', 'gotoV(this);');
                    $(ob).find('td:eq(2)').attr('onclick', 'gotoV(this);');
                    $(ob).find('td:eq(3)').attr('onclick', 'gotoV(this);');

                });
            });

        });

        function gotoV(obj) {
            var vendorid = $(obj).parent().find('td:eq(5)').html();
            console.log(vendorid);
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Vendor/EditVendor/';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Vendor/EditVendor/';
            }
            url += vendorid;
            window.open(url);

        }
    </script>
</head>
<body>






    <div class="container-fluid" id="angulardiv" style="zoom: 0.95;">


        <div class="row">
            <div class="col-sm-12">
                <h3 class="section-header">Vendors</h3>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-12">
                <table cellpadding="0" cellspacing="0" border="0" class="display" id="vendors" style="text-align: center;">
                    <thead>
                        <tr>
                            <th class='leftposition'>Common Name</th>
                            <th class='leftposition'>Legal Name</th>
                            <th class='leftposition'>Classification</th>
                            <th class='leftposition'>City</th>
                            <th class='leftposition'>Country</th>
                            <th class='leftposition'>ID</th>


                        </tr>
                    </thead>

                </table>


            </div>
        </div>


    </div>
</body>



</html>
