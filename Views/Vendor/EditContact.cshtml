    <script>
       
       

        function goback(obj) {

            var o = $(obj).attr('data-parentid');

            var url1 = "";

            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = "/Vendor/EditVendor/";
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Vendor/EditVendor/';
            }
            url1 += o;

            window.location.href = url1;

