    <script>

        function generateVcard() {

            var urltemp = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                urltemp = '/Vendor/generateVcard';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                urltemp = 'Vendor/generateVcard';
            }
            var obj = {};

            obj.FN = $('#txt_ContactFname').val();
            obj.LN = $('#txt_ContactLname').val();
            obj.TITLE = "Contact";
            obj.ORG = $('#txt_ContactFname').val();
            obj.EMAIL = $('#txt_Email').val();
            obj.COUNTRY = $('#Ddl_Country option:selected').text();
            obj.ADR = $('#txt_Add1').val();
            obj.STATE = $('#Ddl_State option:selected').text();
            obj.CITY = $('#Ddl_City').val();
            obj.POSTALCODE = $('#txt_ZipCode').val();
            obj.PHONE = $('#txt_Phone').val();
            obj.EXT = $('#txt_Extension').val();
            obj.Cell = $('#txt_Mobile').val();
            obj.FAX = $('#txt_Fax').val();

            $.ajax({
                type: "POST",
                url: urltemp,
                async: false,
                data: obj,
                success: function (data) {

                    if (LOCALORSERVERNEW == 'LOCAL') {
                        urltemp = '/Assets/VendorFiles/';
                    }
                    else if (LOCALORSERVERNEW == 'SERVER') {
                        urltemp = 'Assets/VendorFiles/';
                    }

                    urltemp += data;

                    var html = "<a target='_blank' href='" + urltemp + "'><i class='fa fa-download mrg5R' aria-hidden='true'></i>"
                        + "Download Contact for " + $('#txt_ContactFname').val() + " " + $('#txt_ContactLname').val() + "</u></a>";
                    $('#vcardlink').html(html);

                }
            });

        }

    </script>

    <script>

        function rebuiltPriorityintoDivs(obj) {

            $('.newappendeddivforpermissions').remove();

            var ttt = 0;
            var cnt = -1;
            var outerhtml = "<div class='row newappendeddivforpermissions mrg5T'>";

            $(obj).find('tbody tr').each(function () {

                var nowDiv = $(this).find('td:eq(0)').html().toUpperCase();

                if (nowDiv != "PROJECT" && nowDiv != "USER" && nowDiv != "VENDOR") {

                    if ($(this).find('td').length == 1) {

                        cnt++;

                        if (ttt == 0) {


                            outerhtml += '<div class="row" style="margin-left:16px;margin-right:9px;">';

                            outerhtml += '<div class="col-sm-3" style="width:20%;">';
                        }
                        else {




                            if (cnt % 7 == 0) {
                                if (nowDiv != "PROJECT" && nowDiv != "USER" && nowDiv != "VENDOR") {
                                    outerhtml += '</div></div><div class="row"  style="margin-left:16px;margin-right:9px;"><div class="col-sm-3"  style="width:20%;">';
                                }
                                else {
                                    outerhtml += '</div></div><div class="row"  style="margin-left:16px;margin-right:9px;"><div class="col-sm-3 displaynone"  style="width:20%;">';


                                }


                            }
                            else {

                                if (nowDiv != "PROJECT" && nowDiv != "USER" && nowDiv != "VENDOR") {
                                    outerhtml += '</div><div class="col-sm-3"  style="width:20%;">';
                                }
                                else {
                                    outerhtml += '</div><div class="col-sm-3 displaynone">';

                                }

                            }
                        }
                        //outerhtml += '<h3 class="section-header">' + $(this).find('td:eq(0)').html() + '</h3>';

                        outerhtml += '<div class="col-sm-12 section-header"><span style="float: left;width: 76.9%;text-align: left;font-size:16px;">' + $(this).find('td:eq(0)').html() + '</span>'
                            + '<input style="float:left;margin-left:2px;    margin-top: 10px;" type="checkbox" onclick="Checkallinner(this);" /></div> ';

                    }

                    else {

                        if (nowDiv != "PROJECT" && nowDiv != "USER" && nowDiv != "VENDOR") {
                            outerhtml += '<div class="col-sm-9">';
                            outerhtml += '<span>' + $(this).find('td:eq(0)').html() + '</span></div>';
                            outerhtml += '<div class="col-sm-3">' + $(this).find('td:eq(1)').html() + '</div>';
                        }
                        else {
                            outerhtml += '<div class="col-sm-9 displaynone">';
                            outerhtml += '<span>' + $(this).find('td:eq(0)').html() + '</span></div>';
                            outerhtml += '<div class="col-sm-3 displaynone">' + $(this).find('td:eq(1)').html() + '</div>';

                        }


                    }

                    ttt = 1;

                }

            });

            outerhtml += "</div>";
            //console.log(outerhtml);

            $(obj).after(outerhtml);

            $(obj).html('');

        }


        function Checkallinner(obj) {

            var pdiv = $(obj).parent().parent();
            if ($(obj).is(':checked')) {
                $(pdiv).find('.chkScrty').prop('checked', true);
            }
            else {
                $(pdiv).find('.chkScrty').prop('checked', false);

            }
        }
    </script>
