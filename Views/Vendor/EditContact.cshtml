<body>

    <input type="hidden" value="@ViewBag.VendorEditPermission" id="editpermission" />
    <input type="hidden" value="@ViewBag.Vendorid" id="Vendorid" />
    <input type="hidden" value="@ViewBag.UserType" id="UserType" />



    <div id="addressmodal" class="modal fade" role="dialog">
        <div class="modal-dialog">

            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Add New address</h4>
                </div>
                <div class="modal-body">
                    <div class="row" id="newaddress">

                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" onclick="savenewaddress();">Save</button>
                </div>
            </div>

        </div>
    </div>



    <div class="container-fluid" id="angulardiv" ng-app="customer" ng-controller="customer" style="zoom:0.95;">

        <div>

            <span ng-hide="User.CreatedBy == ''">Created By:- {{User.CreatedBy}}</span>

        </div>







        <div class="row">

            <div class="col-sm-5">


                <div class="col-sm-12">
                    <h3 class="section-header">Edit Contact <strong>→</strong> @ViewBag.Parentvendorname </h3>
                </div>


                <div class="col-sm-3">
                    <button class="btn btn-block btn-primary" data-parentid="{{User.ParentVendorID}}" style="height:25px;padding:2px;" onclick="goback(this);">Go back</button>
                </div>

                <div class="col-sm-3">
                    <button class="btn btn-block btn-primary" onclick="generateVcard();" style="height:25px;padding:2px;">Create VCard</button>
                </div>

                <div class="col-sm-6" style="margin-top: 4px; min-height: 20px;margin-bottom: 3px;" id="vcardlink">
                </div>




                <div class="col-sm-3 req">
                    <label>First Name</label>
                    <input type="text" id="txt_ContactFname" ng-model="User.ContactFname" class="form-control text-uppercase" />

                </div>
                <div class="col-sm-3">
                    <label>Last Name</label>
                    <input type="text" id="txt_ContactLname" ng-model="User.ContactLname" class="form-control text-uppercase" />
                </div>
                <div class="col-sm-3">
                    <label>Email address</label>
                    <input type="text" id="txt_Email" ng-model="User.Email" class="form-control" />
                </div>
                <div class="col-sm-3">
                    <label>Website</label>
                    <input type="text" id="txt_Website" ng-model="User.Website" class="form-control" />
                </div>

                <div class="col-sm-3">
                    <label>Contact Title</label>
                    <input type="text" class="form-control" id="txt_ContactTitle" ng-model="User.ContactTitle" />
                </div>

                <div class="col-sm-2">
                    <label>Phone</label>
                    <input type="text" id="txt_Phone" ng-model="User.Phone" class="form-control" />
                </div>
                <div class="col-sm-1">
                    <label>Ext</label>
                    <input type="text" id="txt_Extension" ng-model="User.Extension" class="form-control" />
                </div>
                <div class="col-sm-3">

                    <label>Fax</label>
                    <input type="text" id="txt_Fax" ng-model="User.Fax" class="form-control" />
                </div>
                <div class="col-sm-3">
                    <label>Mobile</label>
                    <input type="text" id="txt_Mobile" ng-model="User.Mobile" class="form-control phonenumber" />
                </div>

                <div class="NotForVendors">


                    <div class="col-sm-3" style="text-align: left;margin-top: 22px !important;">
                        <label for="Chk_IsHiddn">Hidden</label>
                        <input type="checkbox" id="Chk_IsHiddn" ng-if="User.IsHiddn !='1'" onchange="ChkIsHiddnChange(this);" />
                        <input type="checkbox" id="Chk_IsHiddn" checked="checked" ng-if="User.IsHiddn =='1'" onchange="ChkIsHiddnChange(this);" />
                        <select id="Ddl_IsHiddn" style="display: none;">
                            <option value="1">Yes</option>
                            <option value="0" selected="selected">No</option>
                        </select>
                    </div>
                    <div class="col-sm-3" style="text-align: left;margin-top: 22px !important;">
                        <label for="Chk_IsSystemUser">System User </label>
                        <input type="checkbox" id="Chk_IsSystemUser" onchange="ChkIsSystemUser(this);" ng-if="User.IsSystemUser =='1'" checked="checked" />
                        <input type="checkbox" id="Chk_IsSystemUser" style="background-color: #EBEBE4;" onchange="ChkIsSystemUser(this);" ng-if="User.IsSystemUser !='1'" />
                        <select id="Ddl_IsSystemUser" style="display: none;">
                            <option value="1">Yes</option>
                            <option value="0">No</option>
                        </select>
                    </div>
                </div>


                <div class="col-sm-12">
                    <h3 class="section-header">Addresses</h3>
                </div>


                <div class="col-sm-12">

                    <ul class="nav nav-tabs mrg15T" id="nvbar"></ul>

                    <div class="tab-content" id="areaholder">
                        <div id="projectaccnttab" class="tab-pane fade in active">




                        </div>


                    </div>


                </div>






            </div>


            <div id="tocopytab" class="displaynone">
                <div class="col-sm-12">
                    <label>Address Title</label>
                    <input type="text" class="cnheader form-control" />
                </div>
                <div class="col-sm-6">
                    <label>Address(Press Enter for multiple lines)</label>
                    <textarea ng-model="User.Address1" style="max-height:70px !important;height:70px;" class="form-control no-resize cnaddress"></textarea>
                </div>

                <div class="col-sm-6 mrg5B">
                    <div class="form-group">
                        <label>Country</label>
                        <select onchange="GetCtryID(this);" class="form-control cncountry">
                            @Html.Raw(ViewData["GetAllCountry"])
                        </select>
                    </div>

                    <div class="form-group">
                        <label>State/Prov</label>
                        <select onchange="GetStateID(this);" class="form-control cnstate">
                            <option value="0">select</option>
                            @Html.Raw(ViewData["GetAllStateByCntryID"])
                        </select>
                    </div>
                </div>

                <div class="col-sm-6">
                    <label>City</label>
                    <input type="text" ng-model="User.City" class="form-control cncity" />
                </div>

                <div class="col-sm-6">
                    <label>Postal/Zip Code</label>
                    <input type="text" class="postalcode form-control cnzip" ng-model="User.ZipCode" />
                </div>

                <div class="col-sm-4 mrg5T">
                    <label><input type="checkbox" class="cndefault" />&nbsp;Is Default Address?</label>
                </div>


                <div class="col-sm-2 mrg5T">
                    <input class="btn btn-poms" type="button" onclick="deleteaddress(this);" value="Delete" />
                </div>
                <div class="col-sm-2 mrg5T">
                    <input class="btn btn-poms" type="button" onclick="updateaddress(this);" value="Update" />
                </div>


            </div>





            <div class="displaynone">
