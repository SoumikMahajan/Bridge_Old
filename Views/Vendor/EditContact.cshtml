    <script type="text/javascript">
        function addnewaddress(o) {

            var innerhtml = $('#tocopytab').html();


            $('#addressmodal').modal('show');
            $('#newaddress').html(innerhtml);
            $('#newaddress').find('div:eq(8)').remove();
            $('#newaddress').find('div:eq(8)').remove();

        }


        function savenewaddress() {

            var o = $('#newaddress');

            
            var Tabheader = $(o).find('.cnheader').val().trim();
            var Address = $(o).find('.cnaddress').val().trim();
            var CountryID = $(o).find('.cncountry').val();
            var StateID = $(o).find('.cnstate').val();
            var PinCode = $(o).find('.cnzip').val();
            var City = $(o).find('.cncity').val();
            var Isdefault = $(o).find('.cndefault').is(':checked') == true ? 'True' : 'False';

            if (Tabheader == '') {
                notify("Address title can not be blank.");
                return;
            }
            if (Address == '') {
                notify("Address can not be blank.");
                return;
            }

            var vendorid = $('#Vendorid').val();

            var obj = new Object();
            obj.Mode = 'CREATE';
            obj.VendorID = vendorid;

            obj.Tabheader = Tabheader;
            obj.Address = Address;
            obj.CountryID = CountryID;
            obj.StateID = StateID;
            obj.Pincode = PinCode;
            obj.City = City;
            obj.Isdefault = Isdefault;
            

            console.log(obj);


            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "POMS_ContactAddressesProc";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var o1 = DBSP.call_DB_Procedure();
            //o1 = o1.data;
            irrrrr = 0;
            notify("Added new address","GREEN");
            loadaddresses();
            $('#addressmodal').modal('hide');

        }

        function deleteaddress(obj) {


            var c = confirm("Do you really waht to delete the address?");
            if (!c) {
                return;
            }

            var o = $(obj).parent().parent();

            var Fldid = $(o).attr('id').split('addrtab_')[1];
            
            var obj = new Object();
            obj.Mode = 'DELETE';
            obj.FldID = Fldid



            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "POMS_ContactAddressesProc";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var o1 = DBSP.call_DB_Procedure();
            o1 = o1.data;

            console.log(o1);

            if (o1[0].Result == 'SUCCESS') {
                irrrrr = 0;
                notify("Deleted the address", "GREEN");
                loadaddresses();
            }
            else {
                notify("Cannot delete the default address");
            }
            //loadaddresses();






        }





        function updateaddress(obj) {

            var o = $(obj).parent().parent();

            var Fldid = $(o).attr('id').split('addrtab_')[1];
            var Tabheader = $(o).find('.cnheader').val().trim();
            var Address = $(o).find('.cnaddress').val().trim();
            var CountryID = $(o).find('.cncountry').val();          
            var StateID = $(o).find('.cnstate').val();
            var PinCode = $(o).find('.cnzip').val();
            var City = $(o).find('.cncity').val();
            var Isdefault = $(o).find('.cndefault').is(':checked') == true ? 'True' : 'False';
            
            if (Tabheader == '') {
                notify("Address title can not be blank.");
                return;
            }
            if (Address == '') {
                notify("Address can not be blank.");
                return;
            }


            var vendorid = $('#Vendorid').val();

            var obj = new Object();
            obj.Mode = 'UPDATE';
            obj.VendorID = vendorid;

            obj.Tabheader = Tabheader;
            obj.Address = Address;
            obj.CountryID = CountryID;
            obj.StateID = StateID;
            obj.Pincode = PinCode;
            obj.City = City;
            obj.Isdefault = Isdefault;
            obj.FldID = Fldid

            console.log(obj);



            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "POMS_ContactAddressesProc";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var o1 = DBSP.call_DB_Procedure();
            //o1 = o1.data;

            irrrrr = 0;
            notify("Updated the address", "GREEN");
            loadaddresses();






        }
        function loadaddresses() {


            
            var innerhtml = $('#tocopytab').html();
           
          



            var vendorid = $('#Vendorid').val();

            var obj = new Object();
            obj.Mode = 'GET';
            obj.VendorID = vendorid;


            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "POMS_ContactAddressesProc";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var o1 = DBSP.call_DB_Procedure();
            o1 = o1.data;

            console.log(o1);
            var nvhtml = '';

            var adhtml = '';

            $('#nvbar').html('');

            $('#areaholder').html('');

            for (var a = 0; a < o1.length; a++) {

                var Address = o1[a].Address;
                var City = o1[a].City;
                var CountryID = o1[a].CountryID;
                var FldID = o1[a].FldID;
                var IsDefault = o1[a].IsDefault;
                var PinCode = o1[a].PinCode;
                var StateID = o1[a].StateID;
                var Tabheader = o1[a].Tabheader;

                if (IsDefault == 'True') {
                    nvhtml = '<li  class="active"><a data-toggle="tab" href="#addrtab_' + FldID + '">' + Tabheader
                        + '<i class="fa fa-check mrg5L" aria-hidden="true"></i>'
                        + '</a></li>';

                }
                else{
                    nvhtml = '<li><a data-toggle="tab" href="#addrtab_' + FldID + '">' + Tabheader + '</a></li>';
                }
               
               
                if (IsDefault == 'True') {
                    adhtml = '<div id="addrtab_' + FldID + '" class="tab-pane fade in active">' + innerhtml + '</div>';
                }
                else {
                    adhtml = '<div id="addrtab_' + FldID + '" class="tab-pane fade in">' + innerhtml + '</div>';

                }


                $('#nvbar').append(nvhtml);

                $('#areaholder').append(adhtml);


                console.log(nvhtml);
                console.log(adhtml);

                var o = $('#addrtab_' + FldID);

                console.log($(o).find('.cnaddress'));

                $(o).find('.cnheader').val(Tabheader);


                $(o).find('.cnaddress').val(Address);
                $(o).find('.cncountry').val(CountryID);
                $(o).find('.cncountry').change();

                $(o).find('.cnstate').val(StateID);
                $(o).find('.cnzip').val(PinCode);
                $(o).find('.cncity').val(City);

                if (IsDefault == 'True') {
                    $(o).find('.cndefault').prop('checked', 'checked');
                    $(o).find('.cndefault').prop('disabled', 'disabled');
                }
                else {
                    $(o).find('.cndefault').removeAttr('checked');

                }
                
            }

            $('#nvbar').append('<li><i title="Add new address." class="fa fa-plus" onclick="addnewaddress(this);" style="cursor:pointer;    color: #7792a8;  padding-top: 6px;margin-left: 13px;"></i></li>');
            

        }




        $(document).ready(function () {
          
            loadaddresses();

            //    BindControls();
            var canedit = $('#editpermission').val();

            if (canedit != "1") {

                setTimeout(function () {

                    $('input').each(
                   function () {

                       $(this).attr('disabled', 'disabled');
                       $(this).removeAttr('onclick');

                   }
                   );
                    $('textarea').attr('disabled', 'disabled');
                    $('select').attr('disabled', 'disabled');
                    $('.foreditonly').remove();


                },700);

               

            }


            $('textarea').autosize();
        });


        function GetCtryID(obj) {

            var Cnrty = $(obj).find('option:selected').attr("name").split("_")[1];
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/adduser/getAllStateByCntryID';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'adduser/getAllStateByCntryID';
            }
            var o = $(obj).parent().next('div').find('select');

            $.ajax({
                type: "POST",
                url: url,
                async: false,
                data: { 'CountryID': Cnrty },
                success: 
                    function (data) {
                        
                        console.log(o);
                        $(o).html(data);
                    },
                error: failed
            });
        }
        function GetStateID(obj) {
            var State = $(obj).find('option:selected').val();
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/adduser/GetAllCityByStateID';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'adduser/GetAllCityByStateID';
            }
            $.ajax({
                type: "POST",
                url: url,
                data: { 'StateID': State },
                success: GetSuccessDetailState,
                error: failed
            });
        }

        function GetSuccessDetailState(data) {
            //$('#Ddl_City').html(data);
            //$('#txt_City').html(data);
        }

        function GetSuccessDetail(data) {
            
            $('#Ddl_State').html(data);
        }

        function failed(data) {
            alert('Failed');
        }


    </script>


