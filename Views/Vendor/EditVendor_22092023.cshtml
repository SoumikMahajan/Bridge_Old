    <script type="text/javascript">
        $(function () {


            var bs = $('#bridgesupporter').val();
            if (bs == '1') {
                $('#chk_bridgesupporter').prop('checked', true);
            }
            var utype = $('#UserType').val();
            if (utype != "3" && utype != "2" && utype != "1") {
                $('#tcg_staff').remove();
            }
            else {

                $('#tcg_staff').show();
            }



            var date = new Date();
            var currentMonth = date.getMonth() + 1;
            var currentDate = date.getDate();
            var currentYear = date.getFullYear();

            currentMonth = currentMonth < 9 ? '0' + currentMonth : currentMonth;
            currentDate = currentDate < 9 ? '0' + currentDate : currentDate;


            //$('#To_Date').val(date.toDateString());
            $('#To_Date').val(currentYear + '.' + currentMonth + '.' + currentDate);
            //$('#Date_Range').val(new Date(currentYear, 0, 1).toDateString());

            var date = new Date(currentYear, 1, 1);
            currentMonth = date.getMonth();
            currentDate = date.getDate();
            currentYear = date.getFullYear();

            currentMonth = currentMonth < 9 ? '0' + currentMonth : currentMonth;
            currentDate = currentDate < 9 ? '0' + currentDate : currentDate;

            $('#Date_Range').val(currentYear + '.' + currentMonth + '.' + currentDate);


            $('#Date_Range').datepicker({
                changeMonth: true,
                changeYear: true,
                dateFormat: 'yy.mm.dd'
                , onSelect: function () {
                    FetchDate();
                }
            });
            $('#To_Date').datepicker({
                changeMonth: true,
                changeYear: true,
                dateFormat: 'yy.mm.dd',
                onSelect: function () {
                    FetchDate();
                }
            });
            FetchDate();
        });
        function ResetSearch() {
            var table = $('#ProjectList').DataTable();
            $('.srch').each(function () {
                this.value = '';
                var indx = $(this).attr('data-indx');
                var txt = this.value;
                table
                       .column(indx)
                       .search(txt)
                       .draw();
            });
        }
        function FetchDate() {
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Vendor/GetProject';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Vendor/GetProject';
            }
            var dataTable = "";
            var dt = "";
            var us = new Array();
            $.ajax({
                type: "POST",
                url: url,
                data: "{ 'From': '" + $('#Date_Range').val() + "', 'Todate': '" + $('#To_Date').val() + "','VenderID':'" + $('#Vendorid').val() + "'}",
                contentType: "application/json; charset=utf-8",
                dataType: "JSON",
                success: function (data) {
                    if (data != '') {
                        dt = data.data;
                        //if (dt.length == 0) {
                        //    return;
                        //}

                        var tot = 0;
                        var curr;

                        $('#ProjectList').dataTable().fnDestroy();
                        if (dt.length >= 0) {
                            for (i = 0; i < dt.length ; i++) {
                                us[i] = new Array();
                                us[i][0] = '<a href="javascript:void(0);" onclick="Click(' + dt[i].ProjectID + ',' + $('#Vendorid').val() + ')" >' + dt[i].ProjectNumber + '</a>';
                                us[i][1] = dt[i].ProjectName;
                                us[i][2] = numberWithCommas(dt[i].Total) + ' ' + ($('#Ddl_Currency :selected').attr('data-currencycode') == undefined ? "" : $('#Ddl_Currency :selected').attr('data-currencycode'));

                                tot +=parseFloat(dt[i].Total);

                                curr = $('#Ddl_Currency :selected').attr('data-currencycode') == undefined ? "" : $('#Ddl_Currency :selected').attr('data-currencycode');
                                $("#TotalValues").val(dt[i].TotalProjectValues)
                            }
                            $('#ProjectList').dataTable({
                                "processing": true,
                                "data": us,
                                "drawCallback": function (settings) {
                                    var ttot = 0;
                                    var currcode = '';
                                    $('#ProjectList tbody tr').each(function () {
                                        var vl = 0;

                                        if ($(this).find('td:eq(2)').html() != undefined) {

                                            vl = replaceAll($(this).find('td:eq(2)').html().split(' ')[0], ',', '');
                                            currcode = $(this).find('td:eq(2)').html().split(' ')[1];
                                        }

                                        ttot += parseFloat(vl).toFixed(2);
                                    });

                                    $('#ProjectList thead').find('tr:eq(1)').find('th:eq(2)').html(numberWithCommas(ttot) + ' ' + currcode)
                                    
                                },
                                "columns":
                                  [
                                    { "title": "Project","class" : "leftposition" },
                                    { "title": "Name", "class": "leftposition" },
                                    { "title": "Amount", "class": "rightposition" },
                                  ],
                                "initComplete": function () {

                                    



                                    $('#ProjectList thead').find('tr:eq(1)').remove();
                                    $('#ProjectList thead').find('tr:eq(0)').find('th:eq(0)').removeClass('sorting_asc');
                                    $('#ProjectList_filter').remove();
                                    $('#ProjectList_length').remove();

                                }
                            });
                            var html = "";
                            var totaldata = parseFloat(tot).toFixed(2);
                            curr = curr == undefined ? '' : curr;
                            html = "<tr>"
                                  + "<th class='leftposition' rowspan='1' colspan='1'><input class='srch' style='width:100%; padding: 2px 2%;font-family:Arial, FontAwesome' placeholder=' &#xF002;' data-indx='0' type='text'></th>"
                                  + "<th class='leftposition' rowspan='1' colspan='1'><input class='srch' style='width:100%; padding: 2px 2%;font-family:Arial, FontAwesome' placeholder=' &#xF002;' data-indx='1' type='text'></th>"
                                + "<th class='rightposition'>" + numberWithCommas(totaldata) + ' ' + curr + "</th>"
                                  + "</tr>";
                            // $('#ProjectList thead').find('tr:eq(0)').append(html);
                            $('#ProjectList thead').append(html);
                            var table = $('#ProjectList').DataTable();
                            $('.srch').on('keyup change', function () {
                                var indx = $(this).attr('data-indx');
                                var txt = this.value;
                                table
                                       .column(indx)
                                       .search(txt)
                                       .draw();
                            });
                        }
                        else {
                        }
                    }
                }
            })
        }
        function Click(ProjectID, VendorID) {
            //window.location.href = "/Vendor/SearchPoList?ProjectID=" + ProjectID + "&VendorID=" + VendorID + "&Status=Singal";


            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Purchaseorder/POList';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Purchaseorder/POList';
            }

            url += "?id=" + ProjectID + "&VendorID=" + VendorID + "&Status=Signal";
            //window.location.href = url;
            window.open(url);


        }
        function Popup() {
            $('#popupforTaxComment2').modal('show');
        }

        function MergeVendor() {

            var vendorID = $('#Vendorid').val();


            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Vendor/MergeVendor';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Vendor/MergeVendor';
            }
            url += "/" + vendorID;
            window.location.href = url;
        }

    </script>
