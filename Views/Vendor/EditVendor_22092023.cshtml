        function buildcommonname() {
            if ($("#Ddl_Currency").val() != '0') {
                $("#txt_Name").val($("#txt_LegalName").val() + " (" + $("#Ddl_Currency option:selected").attr('data-currencycode') + ")");
            }
            else {
                $("#txt_Name").val($("#txt_LegalName").val());
            }
        }

        function getselectedlistfirst(obj) {
            var list = $(obj).val();
            var selected = '';
            var not_selected = '';

            if (list == null) { return; }
            $(obj).find('option').each(function () {
                var vl = $(this).val();
                var cnt = 0;
                for (var a = 0; a < list.length; a++) {
                    if (vl == list[a]) {
                        cnt++;
                        continue;
                    }
                }
                //console.log($(this)[0].outerHTML);


                if (cnt == '0') {
                    not_selected += $(this)[0].outerHTML.replace('selected=""', '').replace('selected', '');

                }
                else {
                    selected += $(this)[0].outerHTML.replace('<option','<option selected');

                }

            });

            $(obj).html(selected + not_selected);
            window.setTimeout(function () {
                $(obj).multiselect('refresh');

                var width = '350px';
                $('.ui-multiselect').css('width', width);
                //$('.ui-multiselect-menu').css('width', '39.5%');
                $('.ui-multiselect-menu').css('width', '400px');
                $('.ui-state-default').css('color', '#C31001');
                $('.ui-multiselect').css('height', '34px');
                $('.ui-multiselect').css('margin-top', '5px');

            }, 0);

           



        }

        function r_chk(obj) {
            if ($(obj).is(':checked')) {
                $('#r_div').show();
            }
            else {
                $('#r_div').hide();
            }
        }


