</body>
<script>

    function sendmailall() {

        $('#sendmailvendor').modal('show');


    }


    function createVcard(obj) {
        var cid = $(obj).attr('data-cid');



        var urltemp = '';
        if (LOCALORSERVERNEW == 'LOCAL') {
            urltemp = '/Vendor/generateVcardDynamically';
        }
        else if (LOCALORSERVERNEW == 'SERVER') {
            urltemp = 'Vendor/generateVcardDynamically';
        }


        $.ajax({
            type: "POST",
            datatype: "text",
            contentType: "application/json; charset=utf-8",
            url: urltemp,
            async: false,
            data: "{ \"contactid\" : \"" + cid + "\"}",
            success: function (data) {

                if (LOCALORSERVERNEW == 'LOCAL') {
                    urltemp = '/Assets/VendorFiles/';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    urltemp = 'Assets/VendorFiles/';
                }

                urltemp += data;

                var htm = "<a class='downloadvcardlink' target='_blank' href='" + urltemp + "'>"
                        + "<i title='Download VCard' class='fa fa-download mrg5L' style='cursor:pointer;font-size: 14px;color: #7792AE;'></i>"
                        + "</a>";

                var tdcurr = $(obj).parent();

                $(tdcurr).find('.downloadvcardlink').remove();


                //$(obj).remove();
                $(tdcurr).append(htm);

                notify("VCard Created click to download on the link button " + htm, "green");

            }
        });






    }


    function mailcheck() {


        var mailid = "";


        $('.mailcheck').each(function () {



            if ($(this).is(':checked')) {
                if ($(this).attr('data-email').trim() != "") {
                    mailid += mailid == "" ? $(this).attr('data-email') : ',' + $(this).attr('data-email');
                }
            }

        });

        if (mailid == "") {
            notify("Select User first");
            return;
        }


        $('#sendmailvendortemplate').modal('show');
        $('#pomailtos').val(mailid);

        $('#mailcount__tot').text('(' + mailid.split(',').length + ' Selected)');

        $('#sendmailvendor').modal('hide');
    }


    function checkuncheckallmail(obj) {

        if ($(obj).is(':checked')) {
           
            $('.mailcheck').prop('checked', true);
        }
        else {

            $('.mailcheck').prop('checked', false);
        }

    }

    $(document).ready(function () {

        getmailbody('NEWUSERMAIL');

    });


    function getmailbody(mode) {

        var url1 = '';
        if (LOCALORSERVERNEW == 'LOCAL') {
            url1 = '/SystemAdmin/getMailContent';
        }
        else if (LOCALORSERVERNEW == 'SERVER') {
            url1 = 'SystemAdmin/getMailContent';
        }

        $.ajax({
            type: "POST",
            url: url1,
            data: "{ \"mode\" : \"" + mode + "\"}",
            async: false,
            dataType: 'text',
            contentType: "application/json; charset=utf-8",
            success: function (response) {

                var subject = response.split('!##!')[1];

                response = unescape(response.split('!##!')[0]);


                //console.log(response);

                if (mode == 'NEWUSERMAIL') {

                    $('#newusersubject').val(subject);
                    $('#newusermail').text(response);

                    tinymce.init({
                        selector: "#newusermail",
                        plugins: "textcolor,fullscreen,image",
                        toolbar: "image | undo redo | styleselect | bold italic | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent| forecolor backcolor"
                        , menubar: false
                        , height: "250px"
                        , image_list: [
    { title: 'Logo 1', value: '/images/BridgeLogo6-darker2.png' },

                        ]
                    });


                }

            },
            error: function (error) {

            }
        });


    }

    function setdynamicfieldformailnewuser(obj) {
        var vl = $(obj).val();

        if (vl == '1') {
           
            var url = "THESERVERLINKBASEURLLOGIN";
            tinymce.activeEditor.execCommand('mceInsertContent', true, "<a data-mce-href=\"" + url + "\" href=\"" + url + "\"><input type='button' style='border-radius: 4px;color: white;background: grey;cursor: pointer;' value='Log In' /></a>");
        }
        else if (vl != '0') {
            insertTextAtCursor(vl);
        }

    }

    function insertTextAtCursor(text) {
        tinymce.activeEditor.execCommand('mceInsertContent', true, "<a><<\(" + text + "\)>></a>");
    }

    function sendfinalmail() {

        var pomailtos = $('#pomailtos').val();
     
        for (var i = 0; i < pomailtos.split(',').length; i++) {
            $('#mailsenderloader').html('Sending to ' + pomailtos.split(',')[i]);
           
               
          
                var url1 = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url1 = '/Vendor/VendorMailSend';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url1 = 'Vendor/VendorMailSend';
                }


                BODY = tinyMCE.activeEditor.getContent();//$('#vendormail').val();

                var subject = $('#newusersubject').val();

                $.ajax({
                    type: "POST",
                    url: url1,
                    data: "{ \"mailid\" : \"" + pomailtos.split(',')[i] + "\",\"body\" : \"" + escape(BODY) + "\",\"Subject\" : \"" + subject + "\"}",
                    async: false,
                    dataType: 'text',
                    contentType: "application/json; charset=utf-8",
                    success: function (response) {
                        $('#mailsenderloader').html("Sending mail");
                       
                    },
                    error: function (error) {
                        //alert("errror");
                    }
                });



        }

       // $('#mailsenderloader').html("Sent to " + i);
        window.setTimeout(function () {
            $('#mailsenderloader').html("");
        }, 2000);

        window.setTimeout(function () {
            $('#sendmailvendortemplate').modal('hide');
        }, 1500);

        

    }

    function openmailpopup(obj) {

        var mailid = $(obj).attr('data-email');

        $('#sendmailvendortemplate').modal('show');
        $('#pomailtos').val(mailid);

       // $('#mailcount__tot').text('(' + mailid.split(',').length + ' Selected)');

       // $('#sendmailvendor').modal('hide');


    }

</script>


</html>
