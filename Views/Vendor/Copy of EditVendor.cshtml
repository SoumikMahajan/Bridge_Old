                           //uscontact[i][14] = uscontactdata[i].Username;


                           uscontact[i][0] = uscontactdata[i].Vendor_ID;


                           uscontact[i][1] = '<i class="fa fa-times-circle"></i>';

                           if (uscontactdata[i].IsActive == "1") {
                               uscontact[i][1] = '<i class="fa fa-check-circle"></i>';
                           }

                           uscontact[i][2] = uscontactdata[i].ParentVendorName;
                           uscontact[i][3] = uscontactdata[i].VendorName;
                           uscontact[i][4] = uscontactdata[i].ContactTitle;
                           uscontact[i][5] = uscontactdata[i].City;
                           uscontact[i][6] = uscontactdata[i].Phone;
                           uscontact[i][7] = uscontactdata[i].Fax;
                           uscontact[i][8] = "<a href='mailto:" + uscontactdata[i].Email + "'>" + uscontactdata[i].Email + "</a>";





                           uscontact[i][9] = uscontactdata[i].IsActive;
                           //uscontact[i][10] = uscontactdata[i].Email;
                           //uscontact[i][11] = uscontactdata[i].IsHidden;
                           //uscontact[i][12] = uscontactdata[i].IsSystemUser;
                           //uscontact[i][13] = uscontactdata[i].IsVendorLoginSent;
                           //uscontact[i][14] = uscontactdata[i].Username;
                       }
                       $('#ContactsUnderParentVndr').dataTable({
                           "processing": true,
                           "data": uscontact
                           , "columns": [

                               { "title": "Vendor_ID" },
                               { "title": "Active Status", "class": "centerposition" },
                               { "title": "Vendor", "class": "displaynone" },
                               { "title": "Contact" },
                               { "title": "Title" },
                               { "title": "City" },
                               { "title": "Phone" },
                               { "title": "Fax" },
                               { "title": "E-mail" },

                               { "title": "", "class": "displaynone" },
                           ]
                           ,
                           "initComplete": function () {

                               if (uscontact.length > 0) {
                                   RowHtmlRenderfrContcts();
                               }
                           },
                           "aoColumnDefs": [
                               { 'bSortable': false, 'aTargets': [0] }
                           ]
                       });
                       var html = "";
                       html = "<tr>"
                             + "<th class='' rowspan='1' colspan='1'>"
                             + "<a><input type='button' value='Reset' onclick='ResetContactSearch();' style='margin-bottom:6px;' /></a>"
                             + "</th>"

                             + "<th rowspan='1' colspan='1'><select class='srch' style='padding: 2px 2%;' data-indx='9'>"
                             + "<option value=''>All</option><option value='1'>Active</option><option value='0'>InActive</option></select></th>"

                             + "<th rowspan='1' colspan='1'><input class='srch' style='padding: 2px 2%;' data-indx='3' type='text' placeholder='Search Contact'></th>"
                             + "<th rowspan='1' colspan='1'><input class='srch' style='padding: 2px 2%;' data-indx='4' type='text' placeholder='Search Title'></th>"
                             + "<th rowspan='1' colspan='1'><input class='srch' style='padding: 2px 2%;' data-indx='5' type='text' placeholder='City'></th>"
                             + "<th rowspan='1' colspan='1'><input class='srch' style='padding: 2px 2%;' data-indx='6' type='text' placeholder='Phone'></th>"
                             + "<th rowspan='1' colspan='1'><input class='srch' style='padding: 2px 2%;' data-indx='7' type='text' placeholder='Fax'></th>"
                             + "<th rowspan='1' colspan='1'><input class='srch' style='padding: 2px 2%;' data-indx='8' type='text' placeholder='Email'></th>"

                             + "</tr>";
                       // html = "";
                       $('#ContactsUnderParentVndr thead').append(html);
                       var table = $('#ContactsUnderParentVndr').DataTable();
                       $('.srch').on('keyup change', function () {
                           var indx = $(this).attr('data-indx');
                           var txt = this.value;
                           table
                                  .column(indx)
                                  .search(txt)
                                  .draw();
                           RowHtmlRenderfrContctsNew();
                       });
                       $('.delrow').on('click', function () {
                           var c = confirm('Are you sure you want to delete?');
                           var chk = false;
                           if (c) {
                               var obj = $(this).attr('data-id');
                               var url = '';//"Vendor/DeleteVendorContact";
                               if (LOCALORSERVERNEW == 'LOCAL') {
                                   url = '../DeleteVendorContact/';
                               }
                               else if (LOCALORSERVERNEW == 'SERVER') {
                                   url = 'Vendor/DeleteVendorContact/';
                               }
                               $.ajax({
                                   type: "POST",
                                   url: url,
                                   async: false,
                                   //dataType: "text",
                                   //contentType: "application/json; charset=utf-8",
                                   data: { 'VendorContactID': obj },
                                   success: function (data) {
                                       if (data == 'FAILED') {
                                           alert('You cannot delete this Contact before adding one');
                                           chk = false;
                                           return;
                                       }
                                       else {
                                           chk = true;
                                           var table = $('#ContactsUnderParentVndr').DataTable();
                                           table
                                           .row($(this).parents('tr'))
                                           .remove()
                                           .draw();
                                           // RowHtmlRenderfrContctsNew();
                                       }
                                   },
                                   error: function () {
                                       alert('Something went wrong.');
                                   }
                               });
                               if (chk == true) {
                                   var table = $('#ContactsUnderParentVndr').DataTable();
                                   table
                                   .row($(this).parents('tr'))
                                   .remove()
                                   .draw();
                                   RowHtmlRenderfrContctsNew();
                               }
                           }
                       });
                   });
            });
        }

        $(document).ready(function () {
            clickContactsUnderParentVndr();

            $('.paginate_button').live('click', function () {
                RowHtmlRenderfrContctsNew();
            });
        });

        function RowHtmlRenderfrContctsNew() {

            $('#ContactsUnderParentVndr thead tr').find("th:eq(0)").html('Action').removeClass('sorting_asc');
            $('#ContactsUnderParentVndr tbody tr').find("td:eq(0)").each(function () {
                var zz = $(this).html();
                //var yy = $(this).parent().find("td:eq(0)").html();


                if ($(this).find('a').attr('data-id') == undefined) {
                    zz = $(this).html();
                }
                else {
                    zz = $(this).find('a').attr('data-id');
                }
                var deleteUrl = '';
                var editUrl = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    deleteUrl = '../DeleteVendorContact/';
                    editUrl = '../EditContact/';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    deleteUrl = 'Vendor/DeleteVendorContact/';
                    editUrl = 'Vendor/EditContact/';
                }
                $(this).html('<a class="delrow" data-id="' + zz + '" onclick="event.preventDefault();" href="' + deleteUrl + zz + '"><input type="button"  style="margin-bottom:6px;" class="buttondelete" /></a><a href="' + editUrl + zz + '"><input type="button" style="margin-bottom:6px;" class="buttonedit" /></a>');
            });

            $('#ContactsUnderParentVndr').find("tr:eq(1)").find("th:eq(0)").html("<a><input type='button' value='Reset' onclick='ResetContactSearch();' style='margin-bottom:6px;' /></a>");
        }
        $(function () {
            $('select[name="ContactsUnderParentVndr_length"]').live('change', function () {
                // alert('hi');
                RowHtmlRenderfrContctsNew();
            });
        });
    </script>
