    <script type="text/javascript">
        $(function () {


            var bs = $('#bridgesupporter').val();
            if (bs == '1') {
                $('#chk_bridgesupporter').prop('checked', true);
            }
            var utype = $('#UserType').val();
            if (utype != "3") {
                $('#tcg_staff').remove();
            }
            else {

                $('#tcg_staff').show();
            }



            var date = new Date();
            var currentMonth = date.getMonth() + 1;
            var currentDate = date.getDate();
            var currentYear = date.getFullYear();

            currentMonth = currentMonth < 9 ? '0' + currentMonth : currentMonth;
            currentDate = currentDate < 9 ? '0' + currentDate : currentDate;


            //$('#To_Date').val(date.toDateString());
            $('#To_Date').val(currentYear + '.' + currentMonth + '.' + currentDate);
            //$('#Date_Range').val(new Date(currentYear, 0, 1).toDateString());

            var date = new Date(currentYear, 1, 1);
            currentMonth = date.getMonth();
            currentDate = date.getDate();
            currentYear = date.getFullYear();

            currentMonth = currentMonth < 9 ? '0' + currentMonth : currentMonth;
            currentDate = currentDate < 9 ? '0' + currentDate : currentDate;

            $('#Date_Range').val(currentYear + '.' + currentMonth + '.' + currentDate);


            $('#Date_Range').datepicker({
                changeMonth: true,
                changeYear: true,
                dateFormat: 'yy.mm.dd'
                , onSelect: function () {
                    FetchDate();
                }
            });
            $('#To_Date').datepicker({
                changeMonth: true,
                changeYear: true,
                dateFormat: 'yy.mm.dd',
                onSelect: function () {
                    FetchDate();
                }
            });
            FetchDate();
        });
        function ResetSearch() {
            var table = $('#ProjectList').DataTable();
            $('.srch').each(function () {
                this.value = '';
                var indx = $(this).attr('data-indx');
                var txt = this.value;
                table
                       .column(indx)
                       .search(txt)
                       .draw();
            });
        }
        function FetchDate() {
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = 'http://www.thebridgebytcg.com/Vendor/GetProject';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Vendor/GetProject';
            }
            var dataTable = "";
            var dt = "";
            var us = new Array();
            $.ajax({
                type: "POST",
                url: url,
                data: "{ 'From': '" + $('#Date_Range').val() + "', 'Todate': '" + $('#To_Date').val() + "','VenderID':'" + $('#Vendorid').val() + "'}",
                contentType: "application/json; charset=utf-8",
                dataType: "JSON",
                success: function (data) {
                    if (data != '') {
                        dt = data.data;
                        //if (dt.length == 0) {
                        //    return;
                        //}
                        $('#ProjectList').dataTable().fnDestroy();
                        if (dt.length >= 0) {
                            for (i = 0; i < dt.length ; i++) {
                                us[i] = new Array();
                                us[i][0] = '<a href="javascript:void(0);" onclick="Click(' + dt[i].ProjectID + ',' + $('#Vendorid').val() + ')" >' + dt[i].ProjectNumber + '</a>';
                                us[i][1] = dt[i].ProjectName;
                                us[i][2] = numberWithCommas(dt[i].Total) + ' ' + ($('#Ddl_Currency :selected').attr('data-currencycode') == undefined ? "" : $('#Ddl_Currency :selected').attr('data-currencycode'));




                                $("#TotalValues").val(dt[i].TotalProjectValues)
                            }
                            $('#ProjectList').dataTable({
                                "processing": true,
                                "data": us,
                                "columns":
                                  [
                                    { "title": "ProjectNumber" },
                                    { "title": "ProjectName" },
                                    { "title": "Amount" },
                                  ],
                                "initComplete": function () {

                                    $('#ProjectList thead').find('tr:eq(1)').remove();
                                    $('#ProjectList thead').find('tr:eq(0)').find('th:eq(0)').removeClass('sorting_asc');
                                    $('#ProjectList_filter').remove();
                                    $('#ProjectList_length').remove();

                                }
                            });
                            var html = "";
                            html = "<tr>"
                                  + "<th rowspan='1' colspan='1'><input class='srch' style='padding: 2px 2%;' data-indx='0' type='text' placeholder='Project No'></th>"
                                  + "<th rowspan='1' colspan='1'><input class='srch' style='padding: 2px 2%;' data-indx='1' type='text' placeholder='Project Name'></th>"
                                  + "<th></th>"
                                  + "</tr>";
                            // $('#ProjectList thead').find('tr:eq(0)').append(html);
                            $('#ProjectList thead').append(html);
                            var table = $('#ProjectList').DataTable();
                            $('.srch').on('keyup change', function () {
                                var indx = $(this).attr('data-indx');
                                var txt = this.value;
                                table
                                       .column(indx)
                                       .search(txt)
                                       .draw();
                            });
                        }
                        else {
                        }
                    }
                }
            })
        }
        function Click(ProjectID, VendorID) {
            //window.location.href = "/Vendor/SearchPoList?ProjectID=" + ProjectID + "&VendorID=" + VendorID + "&Status=Singal";


            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = 'http://www.thebridgebytcg.com/Vendor/SearchPoList';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Vendor/SearchPoList';
            }

            url += "?ProjectID=" + ProjectID + "&VendorID=" + VendorID + "&Status=Singal";
            window.location.href = url;


        }
        function Popup() {
            $('#popupforTaxComment2').bPopup({
                easing: 'easeOutBack', //uses jQuery easing plugin
                speed: 450,
                transition: 'slideDown',
                modalColor: 'rgb(18, 54, 65)'
            });
        }

        function MergeVendor() {

            var vendorID = $('#Vendorid').val();


            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = 'http://www.thebridgebytcg.com/Vendor/MergeVendor';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Vendor/MergeVendor';
            }

            url += "/" + vendorID;
            window.location.href = url;




        }

    </script>
