<body>
    <div class="container-fluid" id="angulardiv" ng-app="Project" ng-controller="Project" style="zoom:0.95;">

        
          <div class="row">
            <div class="col-sm-12">
                <h3 class="section-header">Assign Tasks to TCG Staff</h3>
            </div>
        </div>


        <div class="row">
            <div class="col-sm-8">

                <div class="col-sm-4 req ">
                    <label>Project Number</label>
                    <select id="txt_Project" class="form-control" onchange="categorychange($('#Ddl_SystemComponent'));">
                        @*<option value="0">--Select Project--</option>*@
                        @Html.Raw(ViewData["getAllProjectNameNumber"])
                    </select>
                </div>

                <div class="col-sm-4 req ">
                    <label>User For Task</label>
                    <select id="Ddl_TCGUsers" name="TCGUsers" class="form-control">
                        @*onchange="GetDefaultBuyer(this);"*@
                        @*<option value="0">--Select TCG Users--</option>*@
                        @Html.Raw(ViewData["getAllTCGUsers"])
                    </select>
                </div>

                <div class="col-sm-4 req ">
                    <label>Required By</label>
                    <input type="text" id="txt_RequiredBy" class="form-control" />
                </div>

                <div class="col-sm-4 mrg5T">

                    <label>Category</label>
                    <select style="height:24px;" id="Ddl_SystemComponent" name="SystemComponent" class="form-control" onchange="categorychange(this);">
                        @*<option value="0">--Select Category--</option>*@
                        @Html.Raw(ViewData["getSystemComponent"])
                    </select>

                </div>

                <div class="col-sm-8 mrg5T">
                    <label>Component Item</label>
                    <input type="text" class="form-control txtcomponentitem" />

                    <select class="ddlcomponentitem form-control displaynone"></select>

                </div>

                <div class="col-sm-4 req mrg5T">
                    <label>Task to Perform</label>
                    <input type="text" id="txt_TaskToPerform" class="form-control" />
                </div>

            </div>

        </div>



      

      
      

    </div>


    <div class="float-panel-container">
        <ul>
            <li id="btn_AssignTask"><a href="javascript:void(0);"><i class="fa fa-save mrg5R" title="Assign Task" data-toggle="tooltip"></i><span class="tooltip-toggle">Assign Task</span></a></li>
            
        </ul>
    </div>


    <script>
        $(document).ready(function () {
            categorychange($('#Ddl_SystemComponent'));
        });
        function categorychange(obj) {
            var item = $(obj).find('option:selected').text();
            var ProjectID = $('#txt_Project').val();
            if(item == "Budget"){

                try {
                    $(".ddlcomponentitem").multiselect().multiselectfilter("destroy");

                    $(".ddlcomponentitem").multiselect("destroy");
                }
                catch (eee) {

                    $(".ddlcomponentitem").multiselect().multiselectfilter();

                    $(".ddlcomponentitem").multiselect();

                    $(".ddlcomponentitem").multiselect().multiselectfilter("destroy");

                    $(".ddlcomponentitem").multiselect("destroy");


                }


                $('.txtcomponentitem').show();
                $('.txtcomponentitem').attr('id', 'txt_ComponentItem');
                $('.txtcomponentitem').attr('disabled', 'disabled');
                $('.txtcomponentitem').addClass('budget');

                $('.ddlcomponentitem').hide();
                $('.ddlcomponentitem').removeAttr('id', 'txt_ComponentItem');

            }
            else if (item == "PO" || item == "Project" || item == "Vendor" || item == "User" ) {

               
                $('.ddlcomponentitem').attr('id', 'txt_ComponentItem');

                $('.txtcomponentitem').hide();
                $('.txtcomponentitem').removeAttr('id', 'txt_ComponentItem');

                var url = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url = '/TaskList/getDDLVal';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url = 'TaskList/getDDLVal';
                }
                $.ajax({
                    type: "POST",
                    url: url,
                    data: { 'mode': item, 'ProjectID': ProjectID },
                    success: function (data) {
                        if (data != '') {

                            $('.ddlcomponentitem').html(data);
                            $(".ddlcomponentitem").multiselect({
                                multiple : false
                            }).multiselectfilter();

                        }
                        else {
                            notify('Something going wrong');
                        }
                    }
                });
            }
            else {

                try{
                    $(".ddlcomponentitem").multiselect().multiselectfilter("destroy");

                    $(".ddlcomponentitem").multiselect("destroy");
                }
                catch(eee){
                   
                    $(".ddlcomponentitem").multiselect().multiselectfilter();

                    $(".ddlcomponentitem").multiselect();

                    $(".ddlcomponentitem").multiselect().multiselectfilter("destroy");

                    $(".ddlcomponentitem").multiselect("destroy");


                }
                

                $('.txtcomponentitem').show();
                $('.txtcomponentitem').attr('id', 'txt_ComponentItem');
                $('.txtcomponentitem').removeAttr('disabled', 'disabled');

                $('.ddlcomponentitem').hide();
                $('.ddlcomponentitem').removeAttr('id', 'txt_ComponentItem');

              

            }


            
        }

        $(document).ready(function () {

            $("#txt_Project").multiselect(
       {
           header: "Select all",
           maxTextWrapSize: 50,
           multiple:false
           
       }).multiselectfilter();

            var width = '100%';
            $('.ui-multiselect').css('width', width);
            $('.ui-multiselect-menu').css('width', '39.5%');
            $('.ui-state-default').css('color', '#C31001');
            $('.ui-multiselect').css('height', '34px');
            $('.ui-multiselect').css('margin-top', '5px');

        });
    </script>
   



</body>
