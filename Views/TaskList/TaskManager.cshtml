    <script type="text/javascript">
        $(function () {
            $('#btn_AssignTask').click(function () {

                var ProjectID = $('#txt_Project').val();

               
              

                if (ProjectID == null) {
                    alert('You must select Project before giving any Task');
                    $('#txt_Project').focus();
                    return;
                }


                var TCGUsers = $('#Ddl_TCGUsers').val().trim();
                if (TCGUsers == "0") {
                    alert('You must select TCG Users before giving any Task');
                    $('#Ddl_TCGUsers').focus();
                    return;
                }
                var TaskToPerform = $('#txt_TaskToPerform').val().trim();
                if (TaskToPerform == "") {
                    errorfunc('txt_TaskToPerform', 'You must enter task to perform before saving Task');
                    return;
                }
                
                var RequiredBy = $('#txt_RequiredBy').val().trim();
                if (RequiredBy == "") {
                    errorfunc('txt_RequiredBy', 'You must enter Required by date before saving Task');
                    return;
                }
                

                var SystemComponent = $('#Ddl_SystemComponent').val();
                var ComponentItem = $('#txt_ComponentItem').val();
                
                var item = $('#Ddl_SystemComponent option:selected').text();



                if (item == "PO" || item == "Project" || item == "Vendor" || item == "User") {
                    ComponentItem = $('#txt_ComponentItem').val().trim() + '^^^' + $('#txt_ComponentItem option:selected').text();
                }

               
              
                var url = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url = '/TaskList/SaveTaskList';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url = 'TaskList/SaveTaskList';
                }
                $.ajax({
                    type: "POST",
                    url: url,
                    data: {
                        'TCGUsers': TCGUsers, 'TaskToPerform': TaskToPerform, 'RequiredBy': RequiredBy,
                        'SystemComponent': SystemComponent, 'ComponentItem': ComponentItem, 'ProjectID': ProjectID
                    },
                    success: function (data) {
                        if (data != '') {
                            irrrrr = 0;
                            notify("Task given Successfully",'green');
                            window.location.reload();
                        }
                        else {
                            notify('Something going wrong');
                        }
                    }
                });
            });
        });
    </script>

