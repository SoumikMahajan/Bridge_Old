        function buildrows() {

            $("#lineitems tbody").addClass("disable-sort");
            getHiddenclass();
            checkselected();
            $('#lineitems').css("font-size", "0.9em").css("text-align", "center");

            var chktemp = checklocked();

            if (chktemp == null || chktemp.split('^').length < 1) {
                return;
            }
            var chk = chktemp.split('^')[0];
            if (chk != 1) {
                chk = 0;
            }

            $('#lckbtn').css('display', 'none');
            $('#unlckbtn').css('display', 'none');
            $('#AddNwLnItms').css('display', 'none');
            $('#ImportExportLineItems').css('display', 'none');
            $('#chk_VrsnCrt').parent().css('display', 'none');

            $('#svsndAprvl').css('display', 'none');

            $('#lineitems tbody tr').each(function () {

                var t1 = $(this).find("td:eq(0)").html();

                var attr = $(this).find("td:eq(0)").attr('data-poid');


                if (attr == undefined) {
                    $(this).find("td:eq(0)").attr('data-poid', t1);
                }




                var header = $(this).find("td:eq(28)").html();
                if (header == '') {
                    header = '&nbsp;';
                }

                var htm = "<div style='cursor:pointer;' ><input type='text' value='" + header + "' style='display:none'   /><span>" + header + "</span></div>";
                $(this).find("td:eq(1)").html(htm);


                var currselectedspacing = $(this).find("td:eq(27)").html();
                ////console.log(currselectedspacing);

                if (currselectedspacing == "0") {
                    var html = "<span class='spacing_span'  data-id='" + 0 + "'>" + "No" + "</span>";
                    $(this).find("td:eq(27)").html(html);
                }
                else {
                    for (var a = 0; a < spacing.length ; a++) {
                        if (currselectedspacing == spacing[a].FldID) {
                            var align = "";
                            var height = "";
                            if (spacing[a].Spaceposition == "bottom") {
                                align = "padding-bottom";
                            }
                            else if (spacing[a].Spaceposition == "top") {
                                align = "padding-top";
                            }

                            height = spacing[a].SpaceHeight + "px";

                            $(this).find('td').css(align, height);

                            var html = "<span class='spacing_span'  data-id='" + spacing[a].FldID + "'>" + spacing[a].Spacingname + "</span>";

                            $(this).find("td:eq(27)").html(html);
                        }
                    }
                }


                $(this).find("td:eq(8)").css('padding-left', '50px');
                $(this).find("td:eq(8)").css('text-align', 'left');

                $(this).find("td:eq(9)").css('padding-left', '38px');
                $(this).find("td:eq(9)").css('text-align', 'left');


                $(this).find("td:eq(10)").css('padding-left', '38px');
                $(this).find("td:eq(10)").css('text-align', 'left');


                var notes = $(this).find("td:eq(15)").html();
                var lid = $(this).find("td:eq(5)").html();

                var cost = $(this).find("td:eq(13)").html();
                cost = isNaN(parseFloat(cost)) ? '0' : cost.replace(',', '');


                var total = $(this).find("td:eq(14)").html();
                total = isNaN(parseFloat(total)) ? '0' : total.replace(',', '');

                cost = Math.round(cost * 100) / 100;
                total = Math.round(total * 100) / 100;

                //total = numberWithCommas(parseFloat(total));

                if (lid == null) {
                    return;
                }

                $(this).find("td:eq(13)").html(numberWithCommas(formatNumber(cost)));
                $(this).find("td:eq(14)").html(numberWithCommas(total));

                if (chk != "1") {

                    var html = '';

                    var prev = $(this).find("td:eq(0)").attr('data-poid');
                    if (prev.trim() != '') {


                        var url1 = '';
                        if (LOCALORSERVERNEW == 'LOCAL') {
                            url1 = '/PurchaseOrderView/POList/';
                        }
                        else if (LOCALORSERVERNEW == 'SERVER') {
                            url1 = 'PurchaseOrderView/POList/';
                        }

                        url1 += prev;



                        html += '<div class="edtdiv BDGTEDT"><input style="float: left;" type="button" onclick="EditListitem(this,\'' + lid + '\');" class="buttonedit" />';
                        html += '<a target="_blank" href="' + url1 + '"><i class="fa fa-info-circle BDGTEDT" style="font-size: 1.3em;left: -4px;position: relative; color: black;" onclick="GoToPoList(this);"></i></a></div>';
                       



                    }
                    else {
                        html += '<div class="edtdiv BDGTEDT"><input style="float: left;" type="button" onclick="EditListitem(this,\'' + lid + '\');" class="buttonedit" /></div>';
                        
                    }

                    if (notes.trim() == "") {

                        html += '<div class="edtnotebtn BDGTEDT" onclick="edtvwnotes(this,\'' + lid + '\');" ><i class="fa fa-pencil-square-o"></i> &nbsp; View Notes</div>';

                    }
                    else {

                        html += '<div class="edtnotebtn BDGTEDT" onclick="edtvwnotes(this,\'' + lid + '\');" ><i class="fa fa-pencil-square-o"></i> &nbsp; View Notes</div>';
                    }

                    var prev = $(this).find("td:eq(0)").attr('data-poid');


                    $(this).find("td:eq(0)").html(html);




                    var order = $(this).find("td:eq(6)").html();
                    $(this).attr('data-id', order);
                }
                else {

                    $(this).addClass('budgetlocked');
                    var html = '';

                    html = '<i class="fa fa-lock"></i>&nbsp;&nbsp;Locked';

                    if (notes.trim() == "") {

                        html += '<div class="addnotebtn"><i class="fa fa-times"></i> &nbsp; No Notes</div>';

                    }
                    else {

                        html += '<div class="edtnotebtn" onclick="edtvwnotes(this,\'' + lid + '\');" ><i class="fa fa-pencil-square-o"></i> &nbsp; View Notes</div>';
                    }
                    var objdiv = $(this).find("td:eq(1)").find('div');
                    $(objdiv).removeAttr('onclick');
                    $(objdiv).css('cursor', 'default');

                    $(this).find("td:eq(27)").html('');
                    $(this).find("td:eq(0)").html(html);
                }
            });



