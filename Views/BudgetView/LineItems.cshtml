        function areset(st, lt) {
            st = parseInt(st);
            lt = parseInt(lt);
            $('#lineitems tbody tr').each(function () {
                if (st < lt) {
                    var prev1 = parseInt($(this).find("td:eq(5)").html());
                    var prev2 = parseInt($(this).attr('data-id'));
                    if (prev1 == st) {
                        $(this).find("td:eq(5)").html(lt);
                        $(this).attr('data-id', lt);
                        return;
                    }
                    if (prev1 > st && prev1 <= lt) {
                        prev1 = prev1 - 1;
                        $(this).find("td:eq(5)").html(prev1);
                    }
                    if (prev2 > st && prev1 <= lt) {
                        prev2 = prev2 - 1;
                        $(this).attr('data-id', prev2);
                    }
                }
                else {
                    var prev1 = parseInt($(this).find("td:eq(5)").html());
                    var prev2 = parseInt($(this).attr('data-id'));
                    if (prev1 == st) {
                        $(this).find("td:eq(5)").html(lt);
                        $(this).attr('data-id', lt);
                        return;
                    }
                    if (prev1 >= lt && prev1 <= st) {
                        prev1 = prev1 + 1;
                        $(this).find("td:eq(5)").html(prev1);
                    }
                    if (prev2 >= lt && prev1 <= st) {
                        prev2 = prev2 + 1;
                        $(this).attr('data-id', prev2);
                    }
                }
            });
            //var table = $('#lineitems').DataTable();
            //table.draw();
        }
        function EditListitem(obj, lid) {
            //$('.editlineitempopup').show();
            for (var a = 0; a < budget.length; a++) {
                ////console.log(budget[a][5] + ">>>" + lid);
                if (budget[a][5] == lid) {
                    var totid = budget[a][2];// = totdata[i].TotalID;
                    var itemid = budget[a][5];
                    $('#itemID').val(itemid);
                    var item = budget[a][7];// = totdata[i].Item;
                    $('#edtitemname').val(item);
                    var itemdesc = budget[a][8];// = totdata[i].ItemDescription;
                    $('#edtdesc').val(itemdesc);
                    var specnum = budget[a][9];
                    $('#edtspecnum').val(specnum);
                    var vendor = budget[a][10];
                    $('#edtvendor').val(vendor);
                    var qty = budget[a][11];// = totdata[i].Quantity;
                    $('#edtqty').val(qty);
                    var uom = budget[a][21];// = totdata[i].UOMID;
                    var cost = budget[a][13].replace(',', '');// = totdata[i].Cost;
                    $('#edtcost').val(cost);
                    //budget[i][13] = totdata[i].Note;
                    var wh = budget[a][22];// = totdata[i].ToWarehouse == 1 ? "<i class='fa fa-check'></i>" : "<i class='fa fa-times'></i>";
                    if (wh == 1) {
                        $('#edtwh').prop("checked", true);
                    }
                    else {
                        $('#edtwh').prop("checked", false);
                    }
                    //budget[i][15] = totdata[i].CommitAmountAdjust;
                    //budget[i][16] = totdata[i].DateCreated;
                    //budget[i][17] = totdata[i].CreatedBy_ID;
                    //budget[i][18] = totdata[i].Status;
                    var obj = $('#uom').clone();
                    $(obj).attr('id', 'edtuom');
                    $('#uomselect').html(obj);
                    $('#edtuom').val(uom).change();
                    break;
                }
            }
            editlineitempopup();
            setTimeout(function () {
                cancelselections();
            }, 0);
        }
