    <script type="text/javascript">
        $(document).ready(function () {

            var table = $('#UnCommittedPODetail').DataTable();
            table.clear().draw();



            getVal();






        });

        function ResetSearch() {
            var table = $('#UnCommittedPODetail').DataTable();
            $('.srch').each(function () {
                this.value = '';
                var indx = $(this).attr('data-indx');
                var txt = this.value;
                table
                       .column(indx)
                       .search(txt)
                       .draw();
            });
        }

        function getVal() {
            $('#UnCommittedPODetail thead').html('');
            var table1 = $('#UnCommittedPODetail').DataTable();
            table1.clear().draw();
            var ProjectID = $('#txt_Project').val();
            var VendorName = $('#txt_Project3').val();
           // var VendorName = $('#Status').val();
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/VendorView/getAllPONew';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'VendorView/getAllPONew';
            }
            var dataTable = "";
            var dt = "";
            var us = new Array();
            $.ajax({
                type: "POST",
                url: url,
                data: "{ 'ProjectID': '" + ProjectID + "', 'VendorName': '" + VendorName + "','Status':'" + $('#Status').val() + "','Item':'" + $("#txtItrm").val() + "'}",
                contentType: "application/json; charset=utf-8",
                dataType: "JSON",
                success: function (data) {
                    if (data != '') {
                        dt = data.data;
                        if (dt.length == 0) {
                            return;
                        }
                        $('#UnCommittedPODetail').dataTable().fnDestroy();
                        if (dt.length > 0) {
                            for (i = 0; i < dt.length ; i++) {
                                //Subhabrata Mondal
                                var POID = dt[i].PurchaseOrderID.toString();
                                POID = POID.substring(POID.length - 4, POID.length);
                                us[i] = new Array();
                                us[i][0] = '<i class="fa fa-history"style="font-size: 1.5em;cursor:pointer;padding:2px;" onclick="ViewPurchaseOrderHistory(\'' + parseInt(POID) + '\');"></i><i class="fa fa-pencil-square-o" style="font-size: 1.5em;cursor:pointer;padding:2px;" onclick="editpurchaseOrder(\'' + parseInt(POID) + '\');"></i>';//<i class="fa fa-pencil-square-o" style="font-size: 1.5em;cursor:pointer;" onclick="editpo(\'' + dt[i].PurchaseOrderID + '\');">
                                us[i][1] = dt[i].PurchaseOrderID;
                                us[i][2] = dt[i].ProjectNumber;
                                us[i][3] = dt[i].VendorName;
                                us[i][4] = dt[i].BuyerName;
                                us[i][5] = dt[i].ShipDate;
                                us[i][6] = dt[i].CheckBackDate;
                                us[i][7] = dt[i].IsCommited;
                                us[i][8] = dt[i].IsDeleted;
                            }
                            $('#UnCommittedPODetail').dataTable({
                                "processing": true,
                                "data": us,
                                "columns":
                                  [
                                    { "title": "Action" },
                                    { "title": "PO #" },
                                    { "title": "Project #" },
                                    { "title": "Vendor Name" },
                                    { "title": "Buyer Name" },
                                    { "title": "Ship Date" },
                                    { "title": "CheckBack Date" },
                                    { "title": "IsCommitted", "class": "displaynone" },
                                    { "title": "IsDeleted" }
                                  ],
                                "initComplete": function () {
                                    //$('#UnCommittedPODetail tr').each(function () {
                                    //    var id = $(this).find("td:eq(0)").html();
                                    //    if (id != null) {
                                    //        var html = $(this).html();
                                    //        alert(html);
                                    //    }
                                    //});
                                }
                            });
                            var html = "";
                            html = "<tr>"
                                  + "<th class='Resetth' rowspan='1' colspan='1'>"
                                  + "<a><input type='button' value='Reset' onclick='ResetSearch();' style='margin-bottom:6px;' /></a>"
                                  + "</th>"
                                  + "<th rowspan='1' colspan='1'><input class='srch' style='padding: 2px 2%;' data-indx='1' type='text' placeholder='Search VendorName'></th>"
                                  + "<th rowspan='1' colspan='1'><input class='srch' style='padding: 2px 2%;' data-indx='2' type='text' placeholder='Search Contact'></th>"
                                  + "<th rowspan='1' colspan='1'><input class='srch' style='padding: 2px 2%;' data-indx='3' type='text' placeholder='Search Country'></th>"
                                  + "<th rowspan='1' colspan='1'><input class='srch' style='padding: 2px 2%;' data-indx='4' type='text' placeholder='Search State'></th>"
                                  + "<th rowspan='1' colspan='1'><input class='srch' style='padding: 2px 2%;' data-indx='5' type='text' placeholder='Search City'></th>"
                                  + "<th rowspan='1' colspan='1'><input class='srch' style='padding: 2px 2%;' data-indx='6' type='text' placeholder='Search Address1'></th>"
                                  + "<th rowspan='1' colspan='1'><input class='srch' style='padding: 2px 2%;' data-indx='7' type='text' placeholder='Search ContactTitle'></th>"
                                  + "<th></th>"
                                  + "</tr>";
                            $('#UnCommittedPODetail thead').append(html);
                            var table = $('#UnCommittedPODetail').DataTable();
                            $('.srch').on('keyup change', function () {
                                var indx = $(this).attr('data-indx');
                                var txt = this.value;
                                table
                                       .column(indx)
                                       .search(txt)
                                       .draw();
                                //RowHtmlRendernew();
                            });
                        }
                        else {
                            var table = $('#UnCommittedPODetail').DataTable();
                            table.clear().draw();
                        }
                        $('#UnCommittedPODetail').show();
                    }
                    else {
                        alert('Wrong');
                    }
                }
            });
        }

        function editpo(poid) {

            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/PurchaseOrder/POlineitems/' + poid;
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'PurchaseOrder/POlineitems/' + poid;
            }
            // alert(url);
            window.location.href = url;
        }
        function editpurchaseOrder(poid) {
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/PurchaseOrderView/POViewNew/' + poid;
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'PurchaseOrderView/POViewNew/' + poid;
            }
            // alert(url);
            window.location.href = url;

        }
        

        function ViewPurchaseOrderHistory(poid) {
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/PurchaseOrderView/ViewPOHistory/' + poid;
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'PurchaseOrderView/ViewPOHistory/' + poid;
            }
            // alert(url);
            window.location.href = url;

        }

        function getValcheck(e) {
            var k = e.which;
            if (k == 13) {
                getVal();
            }
        }
    </script>


    <script type="text/javascript">
        function NvgtToDeletedPO() {

            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/PurchaseOrder/DeletedPOLIST';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'PurchaseOrder/DeletedPOLIST';
            }
            window.location.href = url1;
        }
    </script>


    <script type="text/javascript">
        $(document).ready(function () {
           // $("#txt_Project").multiselect({ multiple: false }).multiselectfilter();
            $("#txt_Project").multiselect().multiselectfilter();
            var width = '100%';
            $('.ui-multiselect').css('width', width);
            //$('.ui-multiselect-menu').css('width', '39.5%');
            $('.ui-multiselect-menu').css('width', '39.5%');
            $('.ui-state-default').css('color', '#C31001');
            $('.ui-multiselect').css('height', '34px');
            $('.ui-multiselect').css('margin-top', '5px');

            $("#txt_Project3").multiselect().multiselectfilter();

            var width = '100%';
            $('.ui-multiselect').css('width', width);
            //$('.ui-multiselect-menu').css('width', '39.5%');
            $('.ui-multiselect-menu').css('width', '39.5%');
            $('.ui-state-default').css('color', '#C31001');
            $('.ui-multiselect').css('height', '34px');
            $('.ui-multiselect').css('margin-top', '5px');

        });
       

    </script>

</head>
<body>

    <div class="main_container" id="angulardiv" ng-app="Project" ng-controller="PO">
        <input  id="ProjectID" type="hidden" value="@Html.Raw(ViewData["ProjectID"])"/>
        <input type="hidden" value="@ViewBag.Status" id="Status"  />
        @* <input  id="VendorID" type="hidden" value="@Html.Raw(ViewData["VendorID"])"/>*@
       
        <div class="logo_container_heading">Search Purchase Order List</div>

      
        <div class="edit_vendor_full">
    

            <div class="user_panel_container">
                <fieldset>
                    <legend>Search</legend>
                
                        <div class="user_panel_container policy-items">
                            <label>Project Number</label>
                            <select id="txt_Project" multiple="multiple">
                          
                            @Html.Raw(ViewData["getAllProjectNameNumber"])
                            </select>
                        </div>
                      <div class="user_panel_container policy-items">
                            <label>Vendor</label>
                            <select id="txt_Project3" multiple="multiple">
                            @*<option value="0">--Select Project--</option>*@
                            @Html.Raw(ViewData["parentVendor"])
                            </select>
                        </div>
                        <div class="user_panel_container">
                              <label>Item/Spec</label>
                          <input type="text" id="txtItrm"   style="width: 85%;" placeholder="Search by item/spec"  />
                            <input style="margin-left: 1%; width: 8%;" type="button" value="Search" onclick="getVal();" />
                        </div>
                </fieldset>
            </div>





            <div class="user_panel_container">
                <fieldset>
                    <legend>Purchase Order</legend>
                    <div>
                        <table cellpadding="0" cellspacing="0" border="0" class="display" id="UnCommittedPODetail" style="text-align: center;">
                            <thead>
                                <tr>
                                    <th>Action</th>
                                    <th>PO #</th>
                                    <th>Project Number</th>
                                    <th>Vendor Name</th>
                                    <th>Buyer Name</th>
                                    <th>Ship Date</th>
                                    <th>CheckBack Date</th>
                                    <th>IsCommitted</th>
                                    <th>IsDeleted</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </fieldset>
            </div>
        </div>



    </div>


</body>


</html>
