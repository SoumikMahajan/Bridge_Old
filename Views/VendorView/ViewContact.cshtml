                $scope.EditVendorContact = function () {


                    var priorities = "";

                    var url1 = "";

                    if (LOCALORSERVERNEW == 'LOCAL') {
                        url1 = "/VendorView/UpdateVendorContactData";
                    }
                    else if (LOCALORSERVERNEW == 'SERVER') {
                        url1 = 'VendorView/UpdateVendorContactData';
                    }


                    $('.chkScrty').each(function () {

                        if ($(this).is(":checked")) {


                            if (priorities == "")
                            { priorities += $(this).attr('id').split('prioritychk_')[1]; }
                            else {
                                priorities += "," + $(this).attr('id').split('prioritychk_')[1];
                            }
                        }
                    });

                    $scope.User.ParentVendorID = $('#Vendorid').val();

                    $scope.User.priorities_on_list = priorities;

                    $scope.User.Country = $('#Ddl_Country').val();
                    $scope.User.State = $('#Ddl_State').val();
                    $scope.User.City = $('#Ddl_City').val();



                    $scope.User.IsHiddn = $('#Ddl_IsHiddn').val();


                    var IsSystemUser = $('#Ddl_IsSystemUser').val();

                    if (IsSystemUser == '1' && $('#txt_Email').val().trim() == "") {
                        notify('Please enter E-mail ID');
                        return;
                    }
                    
                    if ($('#txt_Email').val().trim() == "") {
                        IsSystemUser = '0';
                    }
                    else {
                        IsSystemUser = '1';
                    }
                   


                    $scope.User.IsSystemUser = IsSystemUser;//$('#Ddl_IsSystemUser').val();

                    $('#loader_EdtVendorContact').show();
                    $('#btn_EdtVendorContact').hide();

                    var obj = JSON.stringify($scope.User);

                    $.ajax({
                        url: url1,
                        type: "POST",
                        dataType: "text",
                        contentType: "application/json; charset=utf-8",
                        data: obj,


                        error: function () {
                            alert("failed");
                            $('#loader_EdtVendorContact').hide();
                            $('#btn_EdtVendorContact').show();
                        },
                        success: function (data) {
                            if (data == 'INVALID^USERNAME') {

                                $('#txt_UName').val('');
                                errorfunc('txt_UName', 'Please enter an unique User name');
                                alert('Username already exists !! Please give an unique one !!');
                            }
                            else if (data == 'INVALID^EMAIL') {

                                $('#txt_Email').val('');
                                errorfunc('txt_Email', 'Please enter an unique Email Address');
