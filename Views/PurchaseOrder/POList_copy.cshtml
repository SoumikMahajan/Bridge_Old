        function getPOFiles(poid) {

            poid = poid.split('#')[0];



            var url11 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url11 = '/Project/GetProjectFilesToIncludePOList';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url11 = 'Project/GetProjectFilesToIncludePOList';
            }

            var availablefiles = '';

            $.ajax({
                type: "POST",
                async: false,
                datatype: "json",
                contentType: "application/json; charset=utf-8",
                url: url11,
                data: " { \"PID\" : \"" + poid + "\"}",
                success: function (data) {
                    availablefiles = data;

                    //console.log(data);

                    var baseurl = '';

                    if (LOCALORSERVERNEW == 'LOCAL') {
                        baseurl = '../../Assets/';
                    }
                    else if (LOCALORSERVERNEW == 'SERVER') {
                        baseurl = 'Assets/';
                    }

                    var html = '';

                    if (data != "") {
                        for (var i = 0; i < availablefiles.split('^^^').length; i++) {
