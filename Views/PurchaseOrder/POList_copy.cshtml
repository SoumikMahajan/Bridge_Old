    <script type="text/javascript">

        function ProofPOold(poid, IsCommited) {
            poid = poid.split('#')[0].trim();
            mode = 0;
            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Reports/PurchaseOrderReportGeneration';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Reports/PurchaseOrderReportGeneration';
            }
            url1 += "?ProjectID=" + "";
            url1 += "&SectionID=" + "";
            url1 += "&PurchaseOrder=" + poid;
            url1 += "&showImageFlag=" + mode;
            url1 += "&IsCommited=" + IsCommited;
            url1 += "&isSSRSCall=" + "1";

            var totdata = '';
            $.get(url1)
                .success(function (response) {
                    if (response == '0') {
                        notify('No records found!!!');
                        return;
                    }
                    if (response == "isSSRSCall") {
                        window.open("../../SSRSRptViewer/ReportTemplate.aspx");
                        return;
                    }


                    var html = "";
                    var url2 = '';
                    if (LOCALORSERVERNEW == 'LOCAL') {
                        totdata = response;
                    }
                    else if (LOCALORSERVERNEW == 'SERVER') {
                        totdata = "/POMS/POMS/" + response;
                    }
                    setTimeout(function () {
                        window.open(totdata, '_blank');
                    }, 1000);
                });
        }



        function ProofPO(obj, poid) {

            var poid1 = poid.split('#')[0].trim();
