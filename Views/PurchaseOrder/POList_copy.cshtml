        function IsNumber(e) {
            var keyCode = e.which ? e.which : e.keyCode
            var vl = $('#txtPurchaseOrder').val();
            if (keyCode == 13) {
                $("#btnSearchByPO").click();
                return;
            }
            else if (vl.length > 8) {
                return false;
            }
            else if ((keyCode > 47 && keyCode < 58) || (keyCode == 8)) {
                return true;
            }
            else if (keyCode == 45) {
                if (vl.indexOf('-') === -1) {
                    return true;
                }
                else {
                    return false;
                }
            }
            else {
                return false;
            }
        }
        function checkInput(obj) {
            var vl = $(obj).val();
            if (vl.length == 5) {
                if (vl.indexOf('-') === -1) {
                    $(obj).val(vl.substring(0, 4) + '-' + vl[4]);
                }
            }
        }

        function searchtriggertext(e) {


            var key = e.keyCode;

            if (key == 13) {
                getVal2();
            }
        }

