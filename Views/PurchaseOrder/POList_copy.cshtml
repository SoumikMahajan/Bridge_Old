            var mailsubject = $('#vendormailsubject').val();

            if (mailto.trim() == "") {
                notify("Add recipient");
                return;
            }

            if (mailbody.trim() == "") {
                notify("Add Body");
                return;
            }

            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Home/VendorMailSend';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Home/VendorMailSend';
            }
            var mailtonew = '';

            var conspoid = '';
            var poids = $(obj).attr('data-poid');

            var vendormail = $('#vendormailto').attr('data-emails');

            for (var a = 0; a < mailto.split(',').length; a++) {
                var mailtonew = '';
                var poidnew = '';
                var poall = '';

                poids = $(obj).attr('data-vendorid').split('%%')[a].split('$')[1];
                conspoid = poids;

                var rm = $(obj).attr('data-vendorid').split('%%')[a].split('$')[0];
                poall = replaceAll(poids, '^', ',');

                mailtonew = mailto.split(',')[a].trim();
                var addcc = $('#sendaddcc').is(':checked') ? "1" : "0";
                
                $.ajax({
                    type: "POST",
                    url: url1,
                    data: "{ \"mailto\" : \"" + mailtonew + "\",\"mailsubject\" : \"" + mailsubject + "\",\"mailbody\": \"" + mailbody
                        + "\",\"poid\":\"" + poall + "\",\"Project_ID\" : \"" + "" + "\",\"realmail\" : \"" + rm
                        + "\",\"addcc\" : \"" + addcc + "\"}",
                    async: false,
                    dataType: 'text',
                    contentType: "application/json; charset=utf-8",
                    success: function (response) {



                    },
                    error: function (error) {

                        $('#sendmailtovendor').modal('show');
                    }
                });

                notify("Mail sent to " + mailto, 'green');
             //   continue;

                //refreshtask();
                var url2 = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url2 = '/Home/markPOAsVendorSent';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url2 = 'Home/markPOAsVendorSent';
                }

                var poid = $(obj).attr('data-vendorid');
                //console.log(conspoid);
                
                $.ajax({
                    type: "POST",
                    url: url2,
                    data: "{ \"POID\" : \"" + conspoid + "\"}",

                    dataType: 'text',
                    contentType: "application/json; charset=utf-8",
                    success: function (response) {
                        window.setTimeout(function () { $('#sendmailtovendor').modal('hide'); getVal(); }, 2000);
                        $('.fa-paper-plane').removeClass('checked');
                        selectedpoidsvendor = [];
                        selectedemailvendor = [];
                        $('#btn_sendbatchvendor').hide();
                        conspoid = '';
                    },
                    error: function (error) {


                    }
                });



            }



            // sendmailtovendorForSingle();
        }


        function openpopupformailtovendor(obj) {

            var poids = '';
            var emails = $(obj).attr('data-email');
            var poid = $(obj).attr('data-poid').split('#')[0];

            $(obj).toggleClass('checked');
            var ischecked = $(obj).hasClass('checked');

            if (ischecked) {
                selectedpoidsvendor.push(poid);
                selectedemailvendor.push(emails.toLowerCase());
            }
            else {
                var index = selectedpoidsvendor.indexOf(poid);

                if (index > -1) {
                    selectedpoidsvendor.splice(index, 1);
                }

                index = selectedemailvendor.indexOf(emails);

                if (index > -1) {
                    selectedemailvendor.splice(index, 1);
                }



            }


            if (selectedpoidsvendor.length > 0) {
                $('#btn_sendbatchvendor').show();
                $('#btn_sendbatchvendor').find('.badge').html(selectedpoidsvendor.length);
            }
            else {
                $('#btn_sendbatchvendor').hide();

            }


        }

        function sendtovendorsbatch() {
            //console.log(selectedpoidsvendor)
            //console.log(selectedemailvendor)

            var poids = '';
            var emails = '';
            //var poid = $(obj).attr('data-poid').split('#')[0];

            var uniquemails = [];
            $.each(selectedemailvendor, function (i, el) {
                if ($.inArray(el, uniquemails) === -1) uniquemails.push(el);
            });

            uniquemails.sort();


            emails = '';
            for (var a = 0; a < uniquemails.length; a++) {
                emails += emails == '' ? uniquemails[a] : '^' + uniquemails[a];
            }

            $('#vendormailto').attr('data-emails', emails);



            var poids = '';
            for (var a = 0; a < selectedpoidsvendor.length; a++) {
                poids += poids == '' ? selectedpoidsvendor[a] : '^' + selectedpoidsvendor[a];
            }


