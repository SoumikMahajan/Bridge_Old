            if (LOCALORSERVERNEW == 'LOCAL') {
                url111 = '/PurchaseOrder/GetVendorIdFromMail';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url111 = 'PurchaseOrder/GetVendorIdFromMail';
            }
            $.ajax({
                type: "POST",
                url: url111,
                data: "{ \"mailids\" : \"" + poids + "\"}",
                async: false,
                dataType: 'text',
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    $('#mailsendvendorbtn').attr('data-vendorid', response);
                    $('#mailsendvendorbtn').attr('data-poid', "");
                },
                error: function (error) {
                    //alert("errror");
                }
            });







            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Home/VendorMailBuildMulti';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Home/VendorMailBuildMulti';
            }
            $.ajax({
                type: "POST",
                url: url1,
                data: "{ \"poid\" : \"" + '' + "\"}",
                async: false,
                dataType: 'text',
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    $('#vendormailto').val(emails.replace(/\^/g, ', '));
                    $(window).scrollTop(0);
                    $('#vendormailsubject').val(response.split('$#^%*!&~')[2]);

                    response = unescape(response.split('$#^%*!&~')[0]);

                    var editor = tinymce.get('vendormailbody');
                    $('#sendmailtovendor').modal('show');
                    if (editor == null) {
                        tinymce.init({
                            selector: "#vendormailbody",
                            plugins: "textcolor",
                            toolbar: "undo redo | styleselect | bold italic | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent| forecolor backcolor"
                            , menubar: false
                            , height: "300px"
