                                $('.notforvendors').hide();
                            }
                            else {
                                $('.notforvendors').show();
                            }

                            var table = $('#UnCommittedPODetail').DataTable();
                            $('.srch').on('keyup change', function () {
                                var indx = $(this).attr('data-indx');
                                var txt = this.value;
                                table.column(indx)
                                       .search(txt)
                                       .draw();
                            });
                        }
                        else {
                            var table = $('#UnCommittedPODetail').DataTable();
                            table.clear().draw();
                        }
                        $('#UnCommittedPODetail').show();
                    }
                    else {
                        alert('Wrong');
                    }
                }
            });
        }



        function editpo(poid) {
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/PurchaseOrder/POlineitems/' + poid;
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'PurchaseOrder/POlineitems/' + poid;
            }
            // alert(url);
            window.location.href = url;
        }
        function editpurchaseOrder(poid) {
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/PurchaseOrder/POEdit/' + poid;
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = '/PurchaseOrder/POEdit/' + poid;
            }
            window.open(url);
        }
        function deletepurchaseOrder(poid) {

            var obj = new Object();
            //obj.curr = curr;
            obj.POID = poid;


            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "POMS_CheckInvExistece";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var o = DBSP.call_DB_Procedure();
            o = o.data;
            if (o[0].Num > 0) {
                notify("Cannot delete this PO because it has one or more invoices written against it");
                return;
            }



            $("#dialog-confirm").html("Want to delete the Purchase Order ?");
            // Define the Dialog and its properties.
            $("#dialog-confirm").dialog({
                resizable: false,
                modal: true,
                // title: "Modal",
                height: 200,
                width: 340,
                buttons: {
                    "Yes": function () {
                        $(this).dialog('close');
                        var url = '';
                        if (LOCALORSERVERNEW == 'LOCAL') {
                            url = '/PurchaseOrder/DeletePO/' + poid;
                        }
                        else if (LOCALORSERVERNEW == 'SERVER') {
                            url = 'PurchaseOrder/DeletePO/' + poid;
                        }
                        // alert(url);
                        $.get(url).success(function (data) {
                            if (data == 'SUCCESS') {
                                getVal();
                                //window.location.reload();
                            }
                        });
                    },
                    "No": function () {
                        $(this).dialog('close');
                    }
                }
            });
        }
        function ViewPurchaseOrderHistory(poid) {
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/PurchaseOrder/ViewPOHistory/' + poid;
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'PurchaseOrder/ViewPOHistory/' + poid;
            }
            // alert(url);
            //window.location.href = url;
            window.open(url);
        }
        function getValcheck(e) {
            var k = e.which;
            if (k == 13) {
                getVal();
            }
        }
