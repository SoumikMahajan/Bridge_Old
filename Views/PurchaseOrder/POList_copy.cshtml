        function RejectApprovePO(poid) {
            poid = poid.split('#')[0].trim();
            $('#hdn_aprvrjctpoid').val(poid);
            $('#forvendorpopup').modal('show');
        }
        function approverejectsave(mode) {
            var poid = $('#hdn_aprvrjctpoid').val();
            var comment = $('#approverejectcomment').val();
            if (mode == 'REJECTPO' && comment.trim() == '') {
                notify('To reject you must enter comment');
                return;
            }
            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/PurchaseOrder/VendorConfirmRejectPO';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'PurchaseOrder/VendorConfirmRejectPO';
            }
            $.ajax({
                type: "POST",
                url: url1,
                async: false,
                data: { 'POID': poid, 'mode': mode, 'comment': comment },
                success: function (data) {
                    if (data == 'SUCCESS') {
                        if (mode == 'REJECTPO') {
                            notify('Rejected PO', 'red');

                        }
                        else {
                            notify('Accepted PO', 'green');
                        }

                        window.setTimeout(function () {
                            window.location.reload();
                        }, 4000);

                    }
                },
                error: function () { notify('Something went wrong'); }
            });
        }
    </script>
