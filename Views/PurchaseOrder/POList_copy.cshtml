                url1 = 'PurchaseOrder/sendforbatchapproval';
            }
            var c = confirm("Do you want to send the approvers a notification email? OK for yes, cancel for no.");

            $.ajax({
                type: "POST",
                url: url1,
                async: false,
                data: { 'poids': poids, 'mailsend': c },
                success: function (data) {

                    irrrrr = 0;
                    var str = '';
                    for (var a = 0; a < data.split(',').length; a++) {
                        str += str == '' ? ' ' + data.split(',')[a].split('^')[1] : ',' + ' ' + data.split(',')[a].split('^')[1];
                    }

                    if (c) {
                        notify("PO sent for approval. Mail sent to " + str, 'green');
                    }
                    else {
                        notify("PO sent for approval. ", 'green');
                    }
                    window.setTimeout(function () {


                        $('.fa-share-square').removeClass('checked');
                        selectedpoids = [];

                        selectedponumber = [];

                        $('#btn_sendbatchapproval').hide();

                        $('#pobatchapprovalpopup').modal('hide');

                        window.location.reload();

                    }, 4000);


                },
                error: function () { notify('Something went wrong'); }
            });



        }
