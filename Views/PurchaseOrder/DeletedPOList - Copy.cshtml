    <script type="text/javascript">
        function NvgtToPO() {

            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/PurchaseOrder/POLIST';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'PurchaseOrder/POLIST';
            }
            window.location.href = url1;
        }
    </script>
</head>
<body>
    <div class="container-fluid" id="angulardiv" ng-app="Project" ng-controller="PO">

        <div class="row" style="margin-top: -30px;">
            <div class="col-sm-3 ">
                <button style="height: 25px; padding: 2px;" class="btn btn-block btn-primary mrg10T" id="btn_NvgtToPO" onclick="NvgtToPO();"><i class="fa fa-list-ul mrg5R"></i>Show PO</button>
            </div>
        </div>


        <div class="row">



            <div class="col-md-12 col-xs-12 mrg10T">
                <div class="form-group">
                    <h3 class="section-header">Deleted Purchase Orders
                    </h3>
                </div>
            </div>
             <div class="form-group col-md-3 col-xs-12">
                  <label>Project Number</label>
                        <select id="txt_Project" multiple="multiple" tabindex="1">
                            @Html.Raw(ViewData["getAllProjectNameNumber"])
                        </select>
                 </div>

            <div class="form-group col-md-3 col-xs-12">
                 <label>Vendor</label>
                        <select id="txt_Project3" multiple="multiple" tabindex="2">
                            @Html.Raw(ViewData["parentVendor"])
                        </select>
                 </div>
            <div class="form-group col-md-3 col-xs-12">
                  <label>Item/Spec</label>
                        <input type="text" id="txtItrmSpc" ng-model="PO.PO_No" style="width: 85%;" placeholder="Enter Text" onkeyup="getValcheck(event);" tabindex="3" />
                 </div>
            <div class="form-group col-md-3 col-xs-12">
                 <button class="btn btn btn-block btn-primary" style="height:25px;margin-top:20px;padding:2px;width:150px;" onclick="getVal();" tabindex="4"><i class="fa fa-search mrg5R"></i>Search</button>
                 </div>

        </div>

       
           <div class="row mrg10T">
                <div class="form-group">
                    <h3 class="section-header">Purchase Orders List
                    </h3>
                </div>
               <div class="col-sm-12">
                 
                        <table cellpadding="0" cellspacing="0" border="0" class="display" id="POLists" style="text-align: center;">
                            <thead>
                                <tr>
                                    <th>Action</th>
                                    <th>PO #</th>
                                    <th>Vendor Name</th>
                                    <th>Buyer Name</th>
                                    <th>Ship Date</th>
                                    <th>CheckBack Date</th>
                                    <th>IsCommitted</th>
                                    <th class="displaynone">IsDeleted</th>
                                </tr>
                            </thead>
                        </table>
                 </div>
               
            </div>
       
    </div>
</body>
