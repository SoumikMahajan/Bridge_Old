    <script type="text/javascript">
        $(document).ready(function () {
            var table = $('#POLists').DataTable();
            table.clear().draw();
        });
        function getValOld() {
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/PurchaseOrder/getAllDeletedPO/' + $('#txt_SearchPO').val().trim();
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'PurchaseOrder/getAllDeletedPO/' + $('#txt_SearchPO').val().trim();
            }
            var dataTable = "";
            var dt = "";
            var us = new Array();
            $.ajax({
                type: "POST",
                url: url,
                //data: { 'id': $('#txt_SearchPO').val().trim() },
                contentType: "application/json; charset=utf-8",
                dataType: "JSON",
                success: function (data) {
                    if (data != '') {
                        dt = data.data;
                        $('#POLists').dataTable().fnDestroy();
                        if (dt.length > 0) {
                            for (i = 0; i < dt.length ; i++) {
                                us[i] = new Array();
                                us[i][0] = '<i class="fa fa-recycle" style="font-size: 1.3em;cursor:pointer;" onclick="recyclepurchaseOrder(\'' + dt[i].PurchaseOrderID + '\');"></i>';
                                us[i][1] = dt[i].PurchaseOrderID;
                                us[i][2] = dt[i].VendorName;
                                us[i][3] = dt[i].BuyerName;
                                us[i][4] = dt[i].ShipDate;
                                us[i][5] = dt[i].CheckBackDate;
                                us[i][6] = dt[i].IsCommited;
                                us[i][7] = dt[i].IsDeleted;
                            }
                            $('#POLists').dataTable({
                                "processing": true,
                                "data": us,
                                "columns":
                                  [
                                    { "title": "Action" },
                                    { "title": "PO #" },
                                    { "title": "Vendor Name" },
                                    { "title": "Buyer Name" },
                                    { "title": "Ship Date" },
                                    { "title": "CheckBack Date" },
                                    { "title": "IsCommitted" },
                                    { "title": "IsDeleted","class" : "displaynone" }
                                  ],
                                "initComplete": function () {
                                    //$('#POLists tr').each(function () {
                                    //    var id = $(this).find("td:eq(0)").html();
                                    //    if (id != null) {
                                    //        var html = $(this).html();
                                    //        alert(html);
                                    //    }
                                    //});
                                }
                            });
                        }
                        else {
                            var table = $('#POLists').DataTable();
                            table.clear().draw();
                        }
                        $('#POLists').show();
                    }
                    else {
                        alert('Wrong');
                    }
                }
            });
        }
        function recyclepurchaseOrder(poid) {
            var cn = confirm("Are you sure you want to restore the PO?");
            if (!cn) {
                return;
            }

            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/PurchaseOrder/RecyclePO/' + poid;
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'PurchaseOrder/RecyclePO/' + poid;
            }
            // alert(url);

            $.get(url).success(function (data) {
                if (data == 'SUCCESS') {
                    notify("Successfully restored the PO.", 'green');

                    window.setTimeout(function () {
                        window.location.reload();
                    }, 3000);
                }
            });
        }
        function getValcheck(e) {
            var k = e.which;
            if (k == 13) {
                getVal();
            }
        }


        function getVal() {
            $('#POLists thead').html('');
            var table1 = $('#POLists').DataTable();
            table1.clear().draw();
            var ProjectID = $('#txt_Project').val();
            var txtItrmSpc = $('#txtItrmSpc').val();
            var VendorID = $('#txt_Project3').val();
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/PurchaseOrder/getAllDeletedPONew';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'PurchaseOrder/getAllDeletedPONew';
            }
            var dataTable = "";
            var dt = "";
            var us = new Array();
            $.ajax({
                type: "POST",
                url: url,
                data: "{ 'ProjectID': '" + ProjectID + "', 'VendorName': '" + VendorID + "','ItemSpc':'" + txtItrmSpc + "' }",
                contentType: "application/json; charset=utf-8",
                dataType: "JSON",
                success: function (data) {
                    if (data != '') {
                        dt = data.data;
                        if (dt.length == 0) {
                            return;
                        }
                        $('#POLists').dataTable().fnDestroy();
                        if (dt.length > 0) {
                            for (i = 0; i < dt.length ; i++) {
                                us[i] = new Array();
                                //us[i][0] = '<i class="fa fa-recycle" style="font-size: 1.5em;cursor:pointer;" onclick="recyclepurchaseOrder(\'' + dt[i].PurchaseOrderID + '\');"></i>';
                                //us[i][1] = dt[i].PurchaseOrderID;
                                //us[i][2] = dt[i].ProjectNumber;
                                //us[i][3] = dt[i].VendorName;
                                //us[i][4] = dt[i].BuyerName;
                                //us[i][5] = dt[i].ShipDate;
                                //us[i][6] = dt[i].CheckBackDate;
                                //us[i][7] = dt[i].IsCommited;



                                var PurchaseOrderID = dt[i].PurchaseOrderID.split('#')[0];
                                var PurchaseOrderIDShow = dt[i].PurchaseOrderID.split('#')[1];

                                us[i][0] = '<i class="fa fa-recycle" style="font-size: 1.3em;cursor:pointer;" onclick="recyclepurchaseOrder(\'' + PurchaseOrderID + '\');"></i>';
                                us[i][1] = PurchaseOrderIDShow;
                                us[i][2] = dt[i].ProjectNumber;
                                us[i][3] = dt[i].VendorName;
                                us[i][4] = dt[i].BuyerName;
                                us[i][5] = dt[i].ShipDate;
                                us[i][6] = dt[i].CheckBackDate;
                                us[i][7] = dt[i].IsCommited;
                                us[i][8] = dt[i].IsDeleted;
                            }
                            $('#POLists').dataTable({
                                "processing": true,
                                "data": us,
                                "columns":
                                  [
                                    { "title": "Action" },
                                    { "title": "PO Number" },
                                    { "title": "Proj Number" },
                                    { "title": "Vendor Name" },
                                    { "title": "Buyer" },
                                    { "title": "Ship Date" },
                                    { "title": "CheckBack Date" },
                                    { "title": "Commit" },
                                    { "title": "IsDeleted","class" : "displaynone" }




                                    //{ "title": "Action" },
                                    //{ "title": "PO #" },
                                    //{ "title": "Vendor Name" },
                                    //{ "title": "Buyer Name" },
                                    //{ "title": "Ship Date" },
                                    //{ "title": "CheckBack Date" },
                                    //{ "title": "IsCommitted" },
                                    //{ "title": "IsDeleted" }



                                  ],
                                "initComplete": function () {

                                }
                            });
                            var html = "";
                            html = "<tr>"
                                  + "<th class='Resetth' rowspan='1' colspan='1'>"
                                  + "<a><input type='button' value='Reset' onclick='ResetSearch();' style='margin-bottom:6px;' /></a>"
                                  + "</th>"
                                  + "<th rowspan='1' colspan='1'><input class='srch' style='padding: 2px 2%;' data-indx='1' type='text' placeholder='Search Po' tabindex=5></th>"
                                  + "<th rowspan='1' colspan='1'><input class='srch' style='padding: 2px 2%;' data-indx='2' type='text' placeholder='Project Name' tabindex=6></th>"
                                  + "<th rowspan='1' colspan='1'><input class='srch' style='padding: 2px 2%;' data-indx='3' type='text' placeholder='Vendor Common ' tabindex=7></th>"
                                  + "<th rowspan='1' colspan='1'><input class='srch' style='padding: 2px 2%;' data-indx='4' type='text' placeholder='Buyer ' tabindex=8></th>"
                                  + "<th rowspan='1' colspan='1'><input class='srch' style='padding: 2px 2%;' data-indx='5' type='text' placeholder='Ship Date' tabindex=9></th>"
                                  + "<th rowspan='1' colspan='1'><input class='srch' style='padding: 2px 2%;' data-indx='6' type='text' placeholder='Chack Back' tabindex=10></th>"
                                  + "<th rowspan='1' colspan='1'><input class='srch' style='padding: 2px 2%;' data-indx='7' type='text' placeholder='Commit' tabindex=11></th>"
                                  + "<th></th>"
                                  + "</tr>";
                            $('#POLists thead').append(html);
                            var table = $('#POLists').DataTable();
                            $('.srch').on('keyup change', function () {
                                var indx = $(this).attr('data-indx');
                                var txt = this.value;
                                table
                                       .column(indx)
                                       .search(txt)
                                       .draw();
                                //RowHtmlRendernew();
                            });
                        }
                        else {
                            var table = $('#POLists').DataTable();
                            table.clear().draw();
                        }
                        $('#POLists').show();
                    }
                    else {
                        alert('Wrong');
                    }
                }
            });
        }


    </script>
    <script type="text/javascript">
        $(document).ready(function () {
            $("#txt_Project").multiselect().multiselectfilter();

            var width = '100%';
            $('.ui-multiselect').css('width', width);
