        function deleteHistory(obj) {
            if (!confirm("Are you sure you want to delete the item history?")) {
                return;
            }

            var historyID = $(obj).attr('data-id');

            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/PurchaseOrder/deletehistory';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'PurchaseOrder/deletehistory';
            }

            $.ajax({
                type: "POST",
                url: url,
                async: false,
                contentType: "application/json; charset=utf-8",
                data: "{ \"historyID\":\"" + historyID + "\"}",
                success: function (data) {
                    if (data == 'Success') {
                        notify("Successfully deleted the history.", "GREEN");
                        approvallist();
                    }
                }
            });



        }

