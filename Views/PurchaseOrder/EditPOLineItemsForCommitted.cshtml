            DBSP.obj = obj;
            DBSP.isasync = false;
            var o = DBSP.call_DB_Procedure();
            o = o.data;
            var a = o[0].result;
            //$('#Isallowededithistory').val(a);


            tabledgvPOItemApproval = $('#dgvPOItemApproval').DataTable();




            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/PurchaseOrder/getApprovalItemDtlByPOLineItem';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {

                url = 'PurchaseOrder/getApprovalItemDtlByPOLineItem';
            }

            $.ajax({
                type: "POST",
                url: url,
                data: {
                    'POLineItemID': $('#Hdn_POLineItemID').val()
                },
                success: function (data) {
                    if (data != "") {
                        var val = jQuery.parseJSON(data);

                        var tt1 = $('#dgvPOItemApproval').DataTable();
                        tt1.clear().draw();

                        // Add Row Dynamically into datatable

                        tt1.row.add([
                            "<input type='button' id='btnUpdateApprovalItem' value='Edit' style='margin-left: 57px;' onclick=UpdateApprovalItemDetail();>",                                                                // Second column Val
                             " " + val.ItemApprovalDesc,                     //  Third column Val
                             "<select id='ddlActionType'><option value='0'>--Select--</option><option value='1'>Receive</option><option value='2'>Approve</option><option value='3'>Rejected</option></select>",
                             "",
                             "<textarea id='txtComment' style='height:' placeholder='Enter Comment if Any'>" + val.Comment,
                            "<div style='margin-right: 21px;'>Added on:" + val.DateSubmitted + " by " + val.SubmittedBy + "</div><div style='margin-right: 21px;'>Received on:</div><div style='margin-right: 21px;'>Rejected on:</div><div style='margin-right: 21px;'>Receive on:</div><div style='margin-right: 21px;'>Approved on:</div>",
                             "<lable style='display:none'>" + val.ItemApprovalID + "</lable>"

                        ]).draw();
                    }

                }
            });
        });

        function addmultipleapproval() {

            var POLineItemID = $('#Hdn_POLineItemID').val();

            $('.remove').each(function () {

                var o = $(this);
                var ItemApprovalID = $(this).attr('data-index');
                var ItemApprovalDesc = $(this).attr('data-desc');

                var url = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url = '/PurchaseOrder/SavePOApprovalItem';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {

                    url = 'PurchaseOrder/SavePOApprovalItem';
                }


                $.ajax({
                    type: "POST",
                    url: url,
                    async: false,
                    data: { 'POLineItemID': POLineItemID, 'ItemApprovalDesc': ItemApprovalDesc, 'ItemApprovalID': ItemApprovalID },
                    success: function (data) {

                        //$('#popupforItemApproval').modal('hide');
                        $(o).remove();

                    },
                    failed: function () {

                    }

                });



            });

            approvallist();
            $('#approvalfinaladd').hide();


        }



        $(function () {

            $('#btn_AddItemApprovalInGrid222').click(function () {

                $(this).parent().find('.loader').show();
                $(this).hide();
                var ItemApprovalID = $('#ddlItemApprovalType').val();
                if (ItemApprovalID == 0) {
                    notify('Select Fabrication Approval Type');
                }

                var POLineItemID = $('#Hdn_POLineItemID').val();

                var url = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url = '/PurchaseOrder/SavePOApprovalItem';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {

                    url = 'PurchaseOrder/SavePOApprovalItem';
                }


                $.ajax({
                    type: "POST",
                    url: url,
                    data: { 'POLineItemID': POLineItemID, 'ItemApprovalID': ItemApprovalID },
                    success: function (data) {

                        $('#popupforItemApproval').modal('hide');
                        approvallist();
                        $('#btn_AddItemApprovalInGrid').parent().find('.loader').hide();
                        $('#btn_AddItemApprovalInGrid').show();
                    },
                    failed: function () {
                        $('#btn_AddItemApprovalInGrid').parent().find('.loader').hide();
                        $('#btn_AddItemApprovalInGrid').show();
                    }

                });




            });
        });

        function SaveApprovalItemDetail() {
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/PurchaseOrder/SaveApprovalItem';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {

                url = 'PurchaseOrder/SaveApprovalItem';
            }

            $.ajax({
                type: "POST",
                url: url,
                data: {
                    'ItemApprovalID': $('#ddlItemApprovalType').val(), 'ItemName': $('#ddlItemApprovalType :selected').text(),
                    'Action': $('#ddlActionType').val(), 'Comment': $('#txtComment').val(), 'POLineItemID': $('#Hdn_POLineItemID').val()
                },
                success: function (data) {
                    if (data != "") {
                        notify('Item Added');
                        var val = jQuery.parseJSON(data);

                        var tt1 = $('#dgvPOItemApproval').DataTable();
                        tt1.clear().draw();

                        // Add Row Dynamically into datatable

                        tt1.row.add([
                            "<input type='button' id='btnUpdateApprovalItem' value='Edit' style='margin-left: 57px;' onclick=UpdateApprovalItemDetail();>",                                                                // Second column Val
                             " " + val.ItemApprovalDesc,                     //  Third column Val
                             "<select id='ddlActionType'><option value='0'>--Select--</option><option value='1'>Receive</option><option value='2'>Approve</option><option value='3'>Rejected</option></select>",
                             "",
                             "<textarea id='txtComment' style='height:' placeholder='Enter Comment if Any'>" + val.Comment,
                            "<div style='margin-right: 21px;'>Added on:" + val.DateSubmitted + " by " + val.SubmittedBy + "</div><div style='margin-right: 21px;'>Received on:</div><div style='margin-right: 21px;'>Rejected on:</div><div style='margin-right: 21px;'>Receive on:</div><div style='margin-right: 21px;'>Approved on:</div>",
                             "<lable style='display:none'>" + val.ItemApprovalID + "</lable>"

                        ]).draw();
                    }
                }
            });
        }

        function UpdateApprovalItemDetail() {
            $('#popupforItemApproval').modal('show');
        }

    </script>
