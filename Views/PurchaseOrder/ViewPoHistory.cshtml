        function getAllHistory(obj) {

            var ver = $(obj).attr('data-version');
            var id = $(obj).attr('data-poid');


            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/PurchaseOrder/gethistoryall';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'PurchaseOrder/gethistoryall';
            }

            var dataTable = "";
            var dt = "";
            var po = new Array();


            $.ajax({
                type: "POST",
