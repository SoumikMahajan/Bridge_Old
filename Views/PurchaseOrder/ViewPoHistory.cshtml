                dataType: "JSON",
                success: function (data) {

                    var html = "";

                    var lastdate = "";

                    var lineitems = new Array();


                    data = data.data;

                    //$('#poallhistorytable').dataTable().fnDestroy();
                    var aindx = 0;
                    //console.log("***************");
                    console.log(data)
                    for (var t = 0; t < data.length; t++) {
                        if (lastdate == "" || lastdate != data[t].OperationON) {

                            lineitems[aindx] = new Array();

                            var mode = '';

                            if (data[t].Mode == "PO_UPDATE") {
                                mode = 'PO UPDATE <i style="cursor:pointer;" class="fa fa-info-circle" onclick="getUpdatedFieldDetails(this);" aria-hidden="true"></i>';
                            }
                            else if (data[t].Mode == "POITEM_UPDATE") {
                                mode = 'PO ITEM UPDATE <i style="cursor:pointer;" class="fa fa-info-circle" onclick="getUpdatedFieldDetailsItem(this);" aria-hidden="true"></i>';
                            }
                            else if (data[t].Mode == "POITEM_CREATE") {
                                mode = 'PO ITEM CREATED<i style="cursor:pointer;" class="fa fa-info-circle" onclick="getUpdatedFieldDetailsItem(this);" aria-hidden="true"></i>';
                            }
                            else if (data[t].Mode == "POITEM_DELETED") {
                                mode = 'PO ITEM DELETE<i style="cursor:pointer;" class="fa fa-info-circle" onclick="getUpdatedFieldDetailsItem(this);" aria-hidden="true"></i>';
                            }
                            else {
                                mode = data[t].Mode.replace('_', ' ');
                            }

                            lineitems[aindx][0] = data[t].User;
                            lineitems[aindx][1] = mode;
                            lineitems[aindx][2] = data[t].OperationONShow;
                            lineitems[aindx][3] = data[t].FldID;

                            aindx++;


                        }
                        lastdate = data[t].OperationON;
                    }

                    //console.log(lineitems);
                    //console.log($('#poallhistorytable thead').find('tr').length);

                    if ($('#poallhistorytable thead').find('tr').length > 1) {
                        $('#poallhistorytable thead').find('tr:eq(1)').remove();
                    }



                    $('#poallhistorytable').dataTable({
                        "processing": true,
                        "data": lineitems,
                        "destroy": true,

                        "columns":
                            [
                                { "title": "User", "class": "leftposition" },
                                { "title": "Action", "class": "leftposition" },
                                { "title": "Date", "class": "leftposition" },
                                { "title": "Date", "class": "displaynone" }


                            ],
                        "order": [[2, "desc"]],
                        "initComplete": function () {


                            var html = "<tr>"
                                + "<th class='Resetth' rowspan='1' colspan='1'>"
                                + "<a><input type='button' value='Reset' onclick='ResetSearch();' style='margin-bottom:6px;' /></a></th>"


                                + "<th rowspan='1' colspan='1'><input class='srch' style='width:100%;padding: 2px 2%; font-family:Arial, FontAwesome' placeholder=' &#xF002;' data-indx='1' type='text'></th>"
                                + "<th rowspan='1' colspan='1'><input class='srch' style='width:100%;padding: 2px 2%; font-family:Arial, FontAwesome' placeholder=' &#xF002;' data-indx='2' type='text'></th>"

                                + "</tr>";

                            if ($('#poallhistorytable thead').find('tr').length == 1) {
                                $('#poallhistorytable thead').append(html);
                            }
                            else {
                                $('#poallhistorytable thead').find('tr:eq(1)').remove();
                                $('#poallhistorytable thead').append(html);

                            }

                            $('.srch').on('keyup change', function () {
                                var indx = $(this).attr('data-indx');
                                var txt = this.value;

                                var table = $('#poallhistorytable').DataTable();
                                table
                                    .column(indx)
                                    .search(txt)
                                    .draw();

                                if (indx == '13') {

                                    if (txt != '') {
                                        $('#poallhistorytable tbody tr').each(function (index, item) {

                                            if ($(this).find("td:eq(1)").html() == '') {
                                                $(this).hide();
                                            }

                                        });
                                    }
                                    else {
                                        $('#poallhistorytable tbody tr').each(function (index, item) {
                                            $(this).show();

                                        });
                                    }
                                }


                            });




                        }
                    });


                    $('#poallhistorypopup').modal('show');


                    return;



                }


            });



            //console.log(id + ">>>" + ver);
        }

