        function openRejecthistory1(POID, Version) {

            

            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/PurchaseOrder/POHistory1';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'PurchaseOrder/POHistory1';
            }


            $.ajax({
                type: "POST",
                url: url,
                data: "{ 'POID' : '" + POID + "','Version' : '" + Version + "'}",
                contentType: "application/json; charset=utf-8",
                dataType: "JSON",
                success: function (data) {
                    var html = "<div><table border='1' class='display no-footer dataTable'><thead><th>Action</th><th>Comment</th></thead>";
                    data = data.data;

                    for (var i = 0; i < data.length; i++) {
                        html += "";
                        var lvl = data[i].Level;
                        var LevelStatus = data[i].LevelStatus;
                        if (data[i].Approved != 0 || data[i].Rejected != 0 || data[i].Comment != '') {
                            var Approved = data[i].Approved;
                            var Rejected = data[i].Rejected;
                            var InsertDate = data[i].InsertDate;
                            var Comment = data[i].Comment;
                            var Version = data[i].Version;
                            var UserName = data[i].UserName;
                            var ManagerName = data[i].ManagerName;
                            var fname = data[i].FName;
                            var fhtml = '';

                            for (var j = 0; j < fname.split('$$$$').length; j++) {
                                if (fhtml == '') {
                                    fhtml = '<a target="_blank" href="../../Assets/POApprovals/' + fname.split('$$$$')[j] + '">' + fname.split('$$$$')[j] + '</a>';
                                }
                                else {
                                    fhtml = ', <a target="_blank" href="../../Assets/POApprovals/' + fname.split('$$$$')[i] + '">' + fname.split('$$$$')[j] + '</a>';

                                }
                            }

                            //html += "<tr><td style='text-align:left;'>";
                            html += "<tr  style='background: rgb(192, 186, 186);'>";

                            //if (Approved == "1") {
                            //    html += "Approved ";
                            //}
                            //else {
                            //    html += "Rejected ";
                            //}
                            var txt = "";
                            //if (Approved == "1") {
                            //    txt = "Approved";
                            //}
                            if (Rejected == "1") {
                                txt = "Rejected";
                            }
                            else {
                                txt = "Commented";
                            }

                            var tmpstr = "";

                            if (ManagerName == "") {
                                tmpstr = " By " + UserName;
                            }
                            else {
                                tmpstr = " By " + ManagerName + " on behalf of " + UserName;

                            }
                            html += "<td> (" + numArray[lvl] + " LEVEL APPROVAL) " + txt + " On " + InsertDate + tmpstr + " </td>";//tmpstr + " on " + InsertDate + "</td>";
                            html += "<td>" + Comment + "</td>"
                            html += "<td>" + fhtml + "</td></tr>";
                        }
                        else {
                            html += "<tr  style='background: rgb(192, 186, 186);'>";
                            html += "<td>" + numArray[lvl] + " Level Sent for approval On " + data[i].InsertDate + " By " + data[i].UserName + " </td>";//tmpstr + " on " + InsertDate + "</td>";
                            html += "<td></td>"
                            html += "<td></td></tr>";
                        }
                    }
                    html += "</table></div>";
                    var totl = 0;
                    var approved = 0;
                    // alert(html);
                    if (data.length == 0) {
                        html = "<span>No History found<span>";
                    }
                    else {
                        totl = parseInt(LevelStatus.split('^')[0]);
                        approved = parseInt(LevelStatus.split('^')[1]);
                    }
                    var lab = new Array();

                    for (var i = 1; i <= totl; i++) {
                        lab.push(numArray[i] + ' LEVEL');
                    }

                    if (lvl != '' || lvl != undefined) {
                        $('#my1').milestones({
                            stage: approved,
                            checks: approved - 1,
                            checkclass: 'checks',
                            labels: lab
                        });

                    }

                    $('#rejecthistorypopup').modal('show');

                    $('#rejecthistorylist tbody').html(html);





                }


            });


        }

