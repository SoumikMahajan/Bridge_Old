    <script>
        function addresslist() {
            var vendorid = $('#txt_VendorCO').val();
            console.log(vendorid);

            //if (vendorid == '' || vendorid == '0') {
            //    notify("Choose a vendor first");
            //    return;
            //}

            var obj = new Object();
            obj.Mode = 'GETPO';
            obj.VendorID = vendorid;
            obj.FldID = $("#Ddl_Project").val().trim();


            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "POMS_ContactAddressesProc";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var o1 = DBSP.call_DB_Procedure();
            o1 = o1.data;

            console.log(o1);
            var html = '';
            for (var a = 0; a < o1.length; a++) {

                var address1 = o1[a].Address1;
                var Tabheader = o1[a].Tabheader;
                html += '<p style="font-weight: bold;">' + Tabheader + '</p>'
                    + '<p onclick="chooseaddress(this);" style="cursor:pointer;border: 1px solid black;padding: 15px;">' + address1 + '</span>';
            }



            $('#addresslist').html(html);

            $('#addresslistmodal').modal('show');

        }

        function chooseaddress(o) {
            var html = $(o).text();

            $('#txt_addr1').val(html);
            $('#addresslistmodal').modal('hide');
        }

        $(document).ready(function () {
            debugger;
            $('#master_content').removeClass('displaynone');
            ///work here
            var ie = $('#Hdn_IsEditable').val();
            if (ie == "0") {
                var poid = $('#Hdn_PurchaseOrderID').val();

                var mode = 0;
                var url1 = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url1 = '/Reports/PurchaseOrderReportGeneration';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url1 = 'Reports/PurchaseOrderReportGeneration';
                }


                url1 += "?ProjectID=" + "";
                url1 += "&SectionID=" + "";
                url1 += "&PurchaseOrder=" + poid;
                url1 += "&showImageFlag=" + mode;
                url1 += "&isSSRSCall=" + "1";


                var totdata = '';
                $.ajax({
                    type: "POST",
                    url: url1,
                    async: false,
                    dataType: "text",
                    contentType: "application/json; charset=utf-8",
                    data: {},
                    success: function (data) {
                        $('body').html('');
                        window.location.href = data;
                    },
                    error: function () {
                        notify('Something went wrong.');
                    }
                });

                $.get(url1)
                    .success(function (response) {
                        console.log(totdata);

                        //setTimeout(function () {
                        //    window.open(totdata, '_blank');
                        //}, 1000);

                    });

            }

            var restrictSelection = false;
            $('.disable-sort').live('click', function (event) {
                restrictSelection = true;

            });

            $('#POLineItemsDetail tr').live('click', function (event) {

                //$('.LineItem_Quantity').focus();

                //$(this).find('td.Edit_Line').children('.LineItem_Quantity').focus();
                //$(this).find('td.Edit_Line_Cost').children('.LineItem_Cost').focus();

                //var dataID = $(this).attr("data-id");
                //var uniq_class = 'focus_' + dataID;


                if (restrictSelection) {
                    restrictSelection = false;
                    return;
                }

                var iscommitted = $('#Hdn_iscommited').val();

                //if (iscommitted != '1') {

                //    restrictSelection = false;
                //    return;

                //}


                restrictSelection = false;




                if (iscommitted == '1')
                    return;

                var clickedrowid = $(this).attr("data-poitemid");
                if (clickedrowid == null) {
                    return;
                }
                var clickedrowindex = $(this).attr('data-id');
                var closestrow = "";
                // //console.log(clickedrowid);

                if (!event.ctrlKey && !event.shiftKey) {
                    var ln = $('.selectedrow').length;
                    var hclass = false;
                    hclass = $(this).hasClass('selectedrow');
                    cancelselections();
                    if (hclass && ln == 1) {
                        $(this).addClass('selectedrow');
                    }
                }
                if (event.shiftKey) {
                    // cancelselections();
                    var allids = "";
                    var short = 999999;
                    $('.selectedrow').each(function () {
                        var id = $(this).attr('data-id');
                        var diff = clickedrowindex - id;
                        if (diff < 0) {
                            diff = 0 - diff;
                        }
                        if (diff < short) {
                            closestrow = $(this).attr('data-id');
                            short = diff;
                        }
                        if (allids == "") {
                            allids = id;
                        }
                        else {
                            allids += "^" + id;
                        }
                    });
                    $('.selectedrow').each(function () {
                        var currtmp = $(this).attr("data-id");
                        if (currtmp == closestrow) {
                        }
                        else {
                            $(this).removeClass('selectedrow');
                            if ($(this).hasClass('odd')) {
                                $(this).css('background-color', '');
                            }
                            else {
                                $(this).css('background-color', '');
                            }
                        }
                    });
                    var isunderrange = 0;
                    $('#POLineItemsDetail tbody tr').each(function () {
                        if (isunderrange == 1) {
                            if (!$(this).hasClass('selectedrow')) {
                                $(this).addClass('selectedrow');
                                $(this).css('background-color', 'rgb(201, 240, 249)');
                            }
                            else {
                                isunderrange = 0;
                                return;
                            }
                        }
                        else if ($(this).hasClass('selectedrow')) {
                            isunderrange = 1;
                        }
                        var currentrowid = $(this).attr("data-poitemid");
                        if (currentrowid == clickedrowid) {
                            if (isunderrange == 1) {
                                isunderrange = 0;
                                return;
                            }
                            else {
                                $(this).addClass('selectedrow');
                                $(this).css('background-color', 'rgb(201, 240, 249)');
                                isunderrange = 1;
                            }
                        }
                    });
                    return;
                }
                $(this).toggleClass('selectedrow');
                if (!$(this).hasClass('selectedrow')) {
                    if ($(this).hasClass('odd')) {
                        $(this).css('background-color', '');
                    }
                    else {
                        $(this).css('background-color', '');
                    }
                }
                else {
                    $(this).css('background-color', 'rgb(201, 240, 249)');
                }
                checkselected();
            });

            GetUserType();
        });

        function GetUserType() {
            debugger;
            var result = "";
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/PurchaseOrder/GetUserTypenew';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {

                url = 'PurchaseOrder/GetUserTypenew';
            }


            $.ajax({
                type: "POST",
                async: false,
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                url: url,
                success: function (data) {

                    $('#hdn_isUsertype').val(data);
                }

            });
        }

        function cancelselections() {
            //$('#lineitems tr').removeClass('selectedrow');
            $('.selectedrow').each(function () {
                $(this).removeClass('selectedrow');
                if ($(this).hasClass('odd')) {
                    $(this).css('background-color', '#f9f9f9');
                }
                else {
                    $(this).css('background-color', '#fff');
                }
            });
            checkselected();
        }
        function checkselected() {
            var items = $('.selectedrow').length;
            if (items == 0) {
                $('#removemultiple').hide();
            }
            else {
                $('#removemultiple').show();
                if (items == 1) {
                    $('#dragger').show();
                }
                else {
                    $('#dragger').hide();
                }
            }
            // alert(items);
        }


    </script>
