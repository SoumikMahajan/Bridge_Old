        function cinv(data) {
            data = data[0].Result;
            console.log("YYYYYYY:" + data);

            var vl = data.split('^')[1];
            var tx = data.split('^')[2];
            data = data.split('^')[0];
            //Change By Gudu Singh Date-09-04-2019
            //$('#invval').text('Total invoiced value:- ' + vl);

            //$('#invtx').text('Total invoiced tax:- ' + tx);

            $('#invval').text(numberWithCommas(parseFloat(vl).toFixed(2)));

            $('#invtx').text(numberWithCommas(parseFloat(tx).toFixed(2)));

            $('#invtot').text(numberWithCommas(parseFloat(parseFloat(vl) + parseFloat(tx)).toFixed(2)));
            console.log("YYYYYYY:" + vl);

            $('#hdn_InvoiceStatus').val(data);
            if (data == 'Not Exists') {
                $('#invval').text('');
                $('#invtx').text('');
                $('#invtot').text('');

                $('input:radio[name=InvRcvdPartial]').parent("fieldset").hide();
                $('#invstatus').text("Invoice not received");

                return;
            }

            if (data == 'Full') {

                $('#invstatus').text("Invoice fully received");

                $('#invstatus').css('cursor', 'pointer');
                $('#invstatus').css('color', 'blue');
                $('#invstatus').css('text-decoration', 'underline');
                $('#invstatus').attr('onclick', 'gotoinvoices();');
                $('#invstatus').attr('title', 'View Invoice(s)');

                $("#radioPartial").prop("checked", false);
                $("#radioComplete").prop("checked", true);
            }
            else {
                $('#invstatus').text("Invoice partially received");
                $("#radioPartial").prop("checked", true);
                $("#radioComplete").prop("checked", false);

                $('#invstatus').css('color', 'blue');
                $('#invstatus').css('cursor', 'pointer');
                $('#invstatus').css('text-decoration', 'underline');
                $('#invstatus').attr('onclick', 'gotoinvoices();');
                $('#invstatus').attr('title', 'View Invoice(s)');
            }

        }

