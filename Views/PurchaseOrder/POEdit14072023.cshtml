        function DeletePOLineItems(obj, POLineItemID, mflag, itemnum) {

            mflag = mflag == undefined ? false : true;
            //alert(mflag);
            var cf = mflag || confirm("Are you sure you want to delete this PO Item?");
            //confirm(POLineItemID+" is id");
            //alert(cf);
            //return;

            if (cf) {
                var obj = new Object();
                obj.mode = 'CHECKITEMINVOICETOTAL';
                obj.POLineItemID = POLineItemID;


                var DBSP = new DB_SP_CONNECT();
                DBSP.ProcedureName = "POMS_createCreditMemoFromCommit";
                DBSP.obj = obj;
                DBSP.isasync = false;
                var o1 = DBSP.call_DB_Procedure();
                o1 = o1.data;
                var cnf = true;


                if (parseFloat(o1[0].TotalInv) != 0) {
                    cnf = false;
                    var cmessage = itemnum == undefined ? "" : "'" + itemnum + "' ";
                    if (confirm("The item " + cmessage + "has invoiced value of " + formatNumber(o1[0].TotalInv) + ", do you want to make the item cost and quantity zero?")) {
                        makeitemszeero(POLineItemID);
                    }
                }
                if (!cnf) {
                    return;
                }


                var url1 = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url1 = '/PurchaseOrder/DeletePOLineItems';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url1 = 'PurchaseOrder/DeletePOLineItems';// + pid
                }
                $.ajax({
                    type: "POST",
                    url: url1,
                    async: false,
                    dataType: "text",
                    contentType: "application/json; charset=utf-8",
                    data: "{ 'POLineItemID': '" + POLineItemID + "'}",
                    success: function (data) {
                        if (data == 'SUCCESS') {
                            // loaditems(sectionid);
                            if (!mflag) {
                                irrrrr = 0;
                                notify('Item Deleted successfully.', 'green');

                                window.setTimeout(function () {
                                    window.location.reload();
                                }, 2000);

                            }
                        }
                        else if (data == 'FAILED') {
                            notify("This item exists on an invoice.");
                            window.setTimeout(function () {
                                window.location.reload();
                            }, 2000);
                        }
                        else {
                            notify('Something went wrong.');
                        }
                    },
                    error: function () {
                        notify('Something went wrong.');
                    }
                });
            }
        }

