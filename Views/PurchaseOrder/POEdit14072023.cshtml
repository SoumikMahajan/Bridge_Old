        function UpdateLineItem(Quantity, Cost, PoLineItemID) {

            debugger;
            // var POLineItemID = $(obj).data('id');

            //var id11 = "#Quantity_" + PoLineItemID;
            //var id22 = "#cost_" + PoLineItemID;
            //var Quantity = $(id11).val();
            //var Cost = $(id22).val();

            var POLineItemID = PoLineItemID;

            var QID = "#txt_LineItemQty_" + POLineItemID;
            //var LineItemQty = $(QID).val();
            var LineItemQty = Quantity;
            if (LineItemQty.trim() == "" || isNaN(LineItemQty)) {
                notify("Please enter Line Item Qty");
                //$(QID).focus();
                return;
            }
            var confrm = true;

            var UID = "#Ddl_LineItemUnt_" + POLineItemID;
            var LineItemUnt = $(UID).val();
            if (LineItemUnt.trim() == "" || isNaN(LineItemUnt) || LineItemUnt == 0) {
                notify("Please Select a Line Item Unit");
                $(UID).focus();
                return;
            }

            var CID = "#txt_LineItemCosts_" + POLineItemID;
            //var LineItemCosts = $(CID).val();
            /*|| isNaN(LineItemCosts*//*)*/
            var LineItemCosts = Cost;

            if (LineItemCosts.trim() == "") {
                notify("Please enter Line Item Costs");
                //$(CID).focus();
                return;
            }

            if (LineItemCosts.trim() <= "0") {
                notify("Please enter correct Line Item Costs");
                //$(CID).focus();
                return;
            }

            var NID = "#hdn_Nonfreight_" + POLineItemID;
            var nonfreight = $(NID).val();
            var AID = "#hdn_IsApproved_" + POLineItemID;
            var isapproved = $(AID).val();
            var changed = 0;

            var allowedval = parseFloat(checkEditablevalueNew(POLineItemID));
            var cango = true;

            if (parseFloat(LineItemQty) * parseFloat(LineItemCosts) < allowedval) {
                cango = confirm("Item is having total value less than invoiced value. Do you want to continue?");

            }

            if (!cango) {
                return;
            }


            var LineItemQtyReal = $(QID).attr('data-relaval');
            var LineItemCostsReal = $(CID).attr('data-relaval');

            if (nonfreight == '0' && isapproved == '1') {

                if ((parseFloat(LineItemQtyReal) * parseFloat(LineItemCostsReal)) != (parseFloat(LineItemQty) * parseFloat(LineItemCosts))) {

                    changed = 1;
                    confrm = confirm("You are changing the total of a Non-freight item from an approved PO. This will make this PO unapproved. Do you still want to save this item?")
                }

            }


            if (!confrm) {
                return;
            }



            var NoStateTx = '1';
            var NTID = "#chk_StateTx_" + POLineItemID;
            if ($(NTID).is(':checked') == true) {
                NoStateTx = '0'
            }

            var GTID = "#chk_GSTHSTTx_" + POLineItemID;
            var NoGSTHSTTx = '1';
            if ($(GTID).is(':checked') == true) {
                NoGSTHSTTx = '0'
            }

            var PTID = "#chk_PSTTx_" + POLineItemID;
            var NoPSTTx = '1';
            if ($(PTID).is(':checked') == true) {
                NoPSTTx = '0'
            }



            var DTLID = "txt_LineItemDtldDesc_" + POLineItemID;
            var LineItemDtldDesc = tinyMCE.get(DTLID).getContent();

            //LineItemDtldDesc = LineItemDtldDesc.replace(new RegExp("<p>", 'g'), "<div>").replace(new RegExp("</p>", 'g'), "</div>");

            LineItemDtldDesc = LineItemDtldDesc.replace(new RegExp("<p style", 'g'), "<div style").replace(new RegExp("</p>", 'g'), "</div>").replace(new RegExp("&nbsp;", 'g'), "</br>");

            LineItemDtldDesc = encodeURI(LineItemDtldDesc);


            var ATGID = "#chk_ActvTg_" + POLineItemID;
            var ActvTg = '0';
            if ($(ATGID).is(':checked') == true) {
                ActvTg = '1'
            }

            var TGID = "#txt_LineItemAutoTagg_" + POLineItemID;
            var LineItemAutoTagg = $(TGID).val();



            //var PurchaseOrderID = $(obj).data('po');
            var PurchaseOrderID = $('#Hdn_PurchaseOrderID').val();

            var MID = "#txt_LineItemModel_" + POLineItemID;
            var Model = $(MID).val();


            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/PurchaseOrder/EditNSavePOLineItems';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'PurchaseOrder/EditNSavePOLineItems';
            }
            $.ajax({
                type: "POST",
                url: url,
                data: {
                    'LineItemQty': LineItemQty, 'LineItemUnt': LineItemUnt,
                    'LineItemCosts': LineItemCosts, 'NoStateTx': NoStateTx, 'NoGSTHSTTx': NoGSTHSTTx,
                    'NoPSTTx': NoPSTTx, 'LineItemDtldDesc': LineItemDtldDesc,
                    'PurchaseOrderID': PurchaseOrderID, 'POLineItemID': POLineItemID,
                    'LineItemAutoTagg': LineItemAutoTagg, 'ActvTg': ActvTg, 'Model': Model, 'changed': changed
                },
                success: function (data) {

                    irrrrr = 0;

                    if (data == 'SUCCESS') {
                        debugger;

                        notify("LineItem Updated Successfully", "GREEN");

                        var id1 = "#Quantity_" + PoLineItemID;
                        var id2 = "#cost_" + PoLineItemID;

                        $(id1).val("");
                        $(id1).val(Quantity);
                        $(id2).val("");
                        $(id2).val(Cost);

                        var id3 = "#LineItemEdit_" + PoLineItemID;
                        $(id3).click();



                        //var url = '';
                        //var PurchaseOrderID = $('#Hdn_PurchaseOrderID').val();
                        //if (LOCALORSERVERNEW == 'LOCAL') {
                        //    url = '/PurchaseOrder/POEdit/' + PurchaseOrderID;
                        //}
                        //else if (LOCALORSERVERNEW == 'SERVER') {
                        //    url = 'PurchaseOrder/POEdit/' + PurchaseOrderID;
                        //}

                        //window.location.href = url;


                    }
                    else {
                        notify("Listitem not added(Duplicate exists).");
                    }
                },
                error: function () {
                    notify('Something went wrong');
                }
            });
        }

