    <script type="text/javascript">

        function getpolevelfiledata() {
            //console.log("BBBBLLOOO");
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/PurchaseOrder/getpolevelfile';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = '/PurchaseOrder/getpolevelfile';
            }
            var poid = $('#Hdn_PurchaseOrderID').val();
            $.ajax({
                url: url,

                type: 'POST',
                async: false,
                contentType: "application/json; charset=utf-8",
                dataType: 'JSON',
                data: "{ \"poid\" : \"" + poid + "\"}",
                success: function (data) {
                    var html = '';
                    for (var a = 0; a < data.data.length; a++) {

                        var fileurl = '';
                        if (LOCALORSERVERNEW == 'LOCAL') {
                            fileurl = '/assets/ProjectFiles';
                        }
                        else if (LOCALORSERVERNEW == 'SERVER') {
                            fileurl = '/assets/ProjectFiles';
                        }
                        fileurl += "/" + data.data[a].filename;
                        var isexposed = data.data[a].isexposed;
                        if (isexposed == '0') {
