            var totamount = parseFloat(replaceAll($('#txt_SubtotalInvoice').val(), ",", ""));

            $('#txt_TotalInvoice').val(formatNumber(tottax1 + tottax2 + tottax3 + totamount));
        }

        function CommitPO() {
            if ($('#txt_Terms').val() == '0') {
                notify("No Invoice terms.");
                return;
            }
            else if ($('#txt_FOB').val() == '') {
                notify("No FOB.");
                return;
            }
            else if ($('#txt_ConversionRate').val() == '') {
                notify("No Conversion Rate.");
                return;
            }
            else if ($('#txt_ArrivalDate').val() == '') {
                notify("No Delivery date.");
                return;
            }
            else if ($('#txt_ShipTo').val() == '') {
                notify("No Ship to.");
                return;
            }
            else if ($('#txt_addr1').val() == '') {
                notify("No Address.");
                return;
            }

            var data = "NOTOVERCOMMITED";

            $('#POLineItemsDetail tbody tr').each(function () {

                if ($(this).find('td:eq(29)').html() == '1') {

                    data = "OVERCOMMITED";
                }

            });
            var carryon = true;

            if (data == "OVERCOMMITED") {
                carryon = confirm("You have line items that exceed budget. Do you want to continue?");
            }
            if (!carryon) {
                return;
            }

            var pocurrentid = $('#Hdn_PurchaseOrderID').val();

            var poidall = '';

            var obj = new Object();
            obj.mode = 'CHECKITEMS';
            obj.POID = pocurrentid;


            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "POMS_createCreditMemoFromCommit";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var o1 = DBSP.call_DB_Procedure();
            o1 = o1.data;

            //  console.log(o1);


            for (var a = 0; a < o1.length; a++) {
                if (parseFloat(o1[a].POCOST) < parseFloat(o1[a].TotalInv)) {
                    poidall += poidall == "" ? o1[a].POLineItemID : "^" + o1[a].POLineItemID;
                }
