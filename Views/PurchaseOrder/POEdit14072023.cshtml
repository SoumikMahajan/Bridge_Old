        function table_update() {
            var obj = new Object();

            //obj.ProjectID = $('#Ddl_Project').val();
            obj.POID = $('#Hdn_PurchaseOrderID').val();
            obj.SESSIONUSERBACKEND = 'UserID';


            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "POMS_POEditGetData";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var o1 = DBSP.call_DB_Procedure_Multi();
            o1 = o1.data;
            var todata = o1[1];
            debugger;
            var totextended = 0;
            for (i = 0; i < todata.length; i++) {
                totextended += parseFloat(precise_round(parseFloat(todata[i].Extended), 2));
            }
            $('#txt_CalculatedTaxAmount').val();
            var tax = taxvalue();
            var tot = parseFloat(tax) + parseFloat(totextended);
            $('#txt_CalculatedTaxAmount').val(tax);
            var subtotal = numberWithCommas(precise_round(parseFloat(totextended), 2));
            tax = numberWithCommas(precise_round(parseFloat(tax), 2));
            tot = numberWithCommas(precise_round(parseFloat(tot), 2))
            //if (!isNaN(subtotal)) {

            $('#totextendedcost').html(subtotal + "<br />" + tax + '<br />' + tot);
            //}
        }

