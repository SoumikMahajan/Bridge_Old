        function deleteHistory(obj) {
            if (!confirm("Are you sure you want to delete the item history?")) {
                return;
            }

            var historyID = $(obj).attr('data-id');
            var POLID = $(obj).attr('data-item');
            //var MID = $(obj).attr('data-ismanager');
            var MID = $('#hdn_isManager').val();

            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/PurchaseOrder/deletehistory';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'PurchaseOrder/deletehistory';
            }

            $.ajax({
                type: "POST",
                url: url,
                async: false,
                contentType: "application/json; charset=utf-8",
                data: "{ \"historyID\":\"" + historyID + "\", \"PoLineItemID\":\"" + POLID + "\"}",
                success: function (data) {
                    if (data == 'Success') {
                        notify("Successfully deleted the history.", "GREEN");
                        $(obj).closest('tr').css('display', 'none');
                        $('#poitemhistorypopup').modal('hide');
                        approvallist(POLID, MID);
                    }
                }
            });



        }
