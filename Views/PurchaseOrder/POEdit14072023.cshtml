        function taxvalue() {
            var obj = new Object();


            obj.POID = $('#Hdn_PurchaseOrderID').val();
            obj.Mode = 'GETCALCULATEDTAX';
            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "POMS_POCalculateTax";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var o1 = DBSP.call_DB_Procedure_Multi();
            o1 = o1.data;
            var tax = o1[0][0].TotalTax;
            return tax;
