                            + "\",\"ItemApprovalID\" : \"" + ItemApprovalID + "\", \"ActiveTag\":\"" + ActvTg + "\"}",
                        success: function (data) {
                            if (data == 'SUCCESS') {

                                notify("Saving " + (i + 1) + " Item", 'green');




                            }
                            else {
                                notify("Listitem not added(Duplicate exists).");
                            }
                        },
                        error: function () { notify('Something went wrong'); }
                    });


                }


                var url = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url = '/PurchaseOrder/POEdit/' + PurchaseOrderID;
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url = '/PurchaseOrder/POEdit/' + PurchaseOrderID;
