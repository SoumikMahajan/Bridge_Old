            </div>







        </div>



        <div class="row mrg15T">




        </div>

        <input type="hidden" id="Hdn_ProjectID" value="@ViewBag.ProjectID" />
        <input type="hidden" id="Hdn_PurchaseOrderID" value="@ViewBag.PurchaseOrderID" />

        <div class="user_panel_container policy-items displaynone">
        </div>
        <div class="user_panel_container policy-items ">
        </div>
        <div class="user_panel_container policy-items">
        </div>

        <div class="user_panel_container policy-items" id="LineItemDetail">

