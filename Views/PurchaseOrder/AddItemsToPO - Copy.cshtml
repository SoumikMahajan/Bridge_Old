    <script type="text/javascript">
        function OpenCloseAutoTagging(obj) {

            if ($(obj).is(':checked') == true) {
                $('#LineItemAutoTaggArea').css('display', 'block');






            }
            else {
                $('#LineItemAutoTaggArea').css('display', 'none');
            }
            // $('#txt_LineItemAutoTagg').val('');



            var LineItemID = $('#Ddl_LineItems').val();

            var url2 = '';

            if (LOCALORSERVERNEW == 'LOCAL') {
                url2 = '/PurchaseOrder/LoadTagData';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url2 = 'PurchaseOrder/LoadTagData';
            }
            url2 += "?LineItemID=" + LineItemID;



            var totdata2;
            $.get(url2)
                .success(function (response) {


                    var html = "";
                    totdata2 = response;
                    totdata2 = JSON.parse(totdata2).data;
                    var html = "";


                    for (i = 0; i < totdata2.length; i++) {
                        html += "Tag: " + totdata2[i].ProjectName + "\n";
                        html += "Specification: " + totdata2[i].SpecNum + "\n";
                        html += "Description: " + totdata2[i].ItemDescription + "\n";
                        html += "" + $('#txt_LineItemQty').val() + " " + $('#Ddl_LineItemUnt option:selected').text() + "\n";
                    }

                    $('#txt_LineItemAutoTagg').val(html);


                    //$('#txt_LintItemDesc').attr('disabled

                });






        }


        function updatetagging() {



            var LineItemID = $('#Ddl_LineItems').val();

            var url2 = '';

            if (LOCALORSERVERNEW == 'LOCAL') {
                url2 = '/PurchaseOrder/LoadTagData';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url2 = 'PurchaseOrder/LoadTagData';
            }
            url2 += "?LineItemID=" + LineItemID;



            var totdata2;
            $.get(url2)
                .success(function (response) {


                    var html = "";
                    totdata2 = response;
                    totdata2 = JSON.parse(totdata2).data;
                    var html = "";
                    for (i = 0; i < totdata2.length; i++) {
                        html += "Tag: " + totdata2[i].ProjectName + "\n";
                        html += "Specification: " + totdata2[i].SpecNum + "\n";
                        html += "Description: " + totdata2[i].ItemDescription + "\n";
                        html += "" + $('#txt_LineItemQty').val() + " " + $('#Ddl_LineItemUnt option:selected').text() + "\n";
                    }

                    $('#txt_LineItemAutoTagg').val(html);


                    //$('#txt_LintItemDesc').attr('disabled

                });






        }
        function OnApprovalItem() {
            $('#popupforItemApproval').bPopup({
                easing: 'easeOutBack', //uses jQuery easing plugin
                speed: 450,
                transition: 'slideDown',
                modalColor: 'rgb(18, 54, 65)'

            });
        }

        $(function () {
            $("#itemApproval").hide();

            $("#btn_AddApprovalItems").on("click", function () {
                $("#itemApproval").toggle();
                $("#expeditenotelist").css('display', 'block');
                if ($("#expeditenotelist").children().length == 0) {
                    $("<p>No Item Approval Availables.</p>").appendTo("#expeditenotelist");
                }
                else {

                }
            });

            $("#btn_AddItemApprovalInGrid").on("click", function () {

                $("#expeditenotelist").css('display', 'block');

                var html = '';
                var ItemApprovalID = $('#ddlItemApprovalType').val();
                var itemdesc = $('#itemdesc').val().trim();

                var exists = false;

                if (ItemApprovalID == 0) {
                    notify('Select Item Approval Type');
                    return;
                }

                if (itemdesc == "") {
                    notify('Enter Item Approval Description.');
                    return;
                }

                $('.remove').each(function () {
                    var nowdesc = $(this).attr('data-desc');
                    if (nowdesc == itemdesc) {

                        if (ItemApprovalID == $(this).attr('data-index')) {
                            notify("Description already exists");
                            exists = true;
                            return;
                        }
                    }
                });



                $("#expeditenotelist:has(p)").empty();



                if (exists == false) {
                    html += "<span data-desc='" + itemdesc + "' class='remove' data-index='" + ItemApprovalID + "'><a onclick='removeItemApproval(\"" + ItemApprovalID + "\",this);'>x</a><span>"
                        + $("#ddlItemApprovalType option[value='" + ItemApprovalID + "']").text() + "-" + itemdesc + "</span></span>";
                    $('#expeditenotelist').append(html);
                    $("#ddlItemApprovalType").val("0");
                    $("#itemdesc").val("");
                }




            });

        });

        function removeItemApproval(ItemApprovalID, obj) {

            if (confirm("Do you want to delete item approval?")) {

                $(obj).parent().remove();

            }
        }


        $(document).ready(function () {
            PreventTwoDecimalPlace("#txt_LineItemQty", 2);
            PreventTwoDecimalPlace("#txt_LineItemCosts", 3);

        });


    </script>

</body>
</html>
