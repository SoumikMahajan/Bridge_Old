                    </select>
                </div>
                <div class="col-sm-8">
                    <label>Select Line Items</label>
                    <select id="Ddl_LineItems" multiple="multiple" class="form-control">
                        <option value="0">--Select Line Items--</option>
                    </select>
                </div>

                <div class="col-sm-12" style="padding:0px !important;">
                    <div class="col-sm-3">
                        <label>Model</label>
                        <input disabled="disabled" type="text" id="txt_LineItemModel" class="form-control" />
                    </div>

                    <div class="col-sm-3">
                        <label>Qty.</label>
                        <input type="text" id="txt_LineItemQty" onkeyup="updatetagging();" class="floatonly form-control" />
                    </div>

                    <div class="col-sm-3">
                        <label>UOM</label>
                        <select id="Ddl_LineItemUnt" onchange="updatetagging();" class="form-control">
                            <option value="0">--Select--</option>
                            @Html.Raw(ViewData["getAllUOM"])
                        </select>
                    </div>

                    <div class="col-sm-3">
                        <label>Cost</label>
                        <input type="text" id="txt_LineItemCosts" class="floatonly form-control" />
                    </div>

                </div>
                <div class="col-sm-12">

                    <div class="col-sm-3">

                        <label>
                            <input type="checkbox" id="chk_ActvTg" onchange="OpenCloseAutoTagging(this);" />
                            Active tag
                        </label>


                    </div>


                    <div class="col-sm-12">
                        <div id="LineItemAutoTaggArea" style="display: none;">
                            <textarea id="txt_LineItemAutoTagg" style="height:59px;    font-weight: bold;" rows="4" class="form-control no-resize text-uppercase"></textarea>
                        </div>
                    </div>

                    <div class="col-sm-12" style="text-align: right;">

                        <p id="lbl_StateTx">

                            <span style="width: 270px; position: absolute; text-align: right;"></span>
                            <input style="margin-left: 288px;" type="checkbox" id="chk_StateTx" class="edit_vendor_half" />
                        </p>


                        <p id="lbl_GSTHSTTx">
                            <span style="width: 270px; position: absolute; text-align: right;"></span>
                            <input style="margin-left: 288px;" type="checkbox" id="chk_GSTHSTTx" />
                        </p>

                        <p id="lbl_PSTTx">
                            <span style="width: 270px; position: absolute; text-align: right;"></span>
                            <input style="margin-left: 288px;" type="checkbox" id="chk_PSTTx" />
                        </p>


                    </div>



                </div>


            </div>




            <div class="col-sm-8">

                <div class="col-sm-12">
                    <h3 class="section-header" id="ponumbershow">Item Detailed Description</h3>
                </div>

                <div class="col-sm-12">
                    <textarea id="txt_LineItemDtldDesc" tabindex="6"></textarea>
                </div>


            </div>
        </div>


        <div class="row mrg15T">

            <div class="col-sm-4 displaynone">
                <label>Select Project</label>
                <select id="Ddl_SelPro" class="form-control">
                    <option data-id="0" value="0">--Select Project--</option>
                    @Html.Raw(ViewData["getAllProjectName"])
