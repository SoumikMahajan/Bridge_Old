                    'LineItemDtldDesc': LineItemDtldDesc, 'PurchaseOrderID': PurchaseOrderID, 'POLineItemID': POLineItemID, 'LineItemAutoTagg': LineItemAutoTagg, 'ActvTg': ActvTg,
                    'ItemApprovalID': ItemApprovalID, 'Model': Model
                },
                success: function (data) {
                    irrrrr = 0;
                    if (data == 'SUCCESS') {
                        //var sectionid = $('#Ddl_SelProSec').val();
                        //loaditems(sectionid);
                        //notify('Lineitem Successfully Added.');
                        //$('#itemname').val('');
                        //$('#itemdescription').val('');
                        //$('#uom').val('0');
                        //$('#itemquantity').val('');
                        //$('#cost').val('');
                        //$('#notes').val('');
                        //$('#specnum').val('');
                        //$('#vendor').val('');
                        //$('#towh').attr('checked', false); // Checks it



                        var url = '';
                        if (LOCALORSERVERNEW == 'LOCAL') {
                            url = '/PurchaseOrder/POEdit/' + PurchaseOrderID;
                        }
                        else if (LOCALORSERVERNEW == 'SERVER') {
                            url = '/PurchaseOrder/POEdit/' + PurchaseOrderID;
                        }

                        if (REDIRECT == 'REDIRECT') {
                            window.location.href = url;
                        }
                        else {
                            irrrrr = 0;
                            window.location.reload();
                        }


                    }
                    else {
                        notify("Listitem not added(Duplicate exists).");
                    }
                },
                error: function () { notify('Something went wrong'); }
            });
        }

