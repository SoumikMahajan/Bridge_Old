<body>
    <div class="container-fluid" id="angulardiv" ng-app="Project" ng-controller="PO">


        <div class="row">

            <div class="col-sm-4">
                <div class="col-sm-12">
                    <h3 class="section-header">Add Items To PO(@Html.Raw(ViewData["POIDTOSHOW"]))</h3>
