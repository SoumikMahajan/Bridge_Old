                notify("Please Select a Line Item Unit");
                $('#Ddl_LineItemUnt').focus();
                return;
            }
            var LineItemCosts = $('#txt_LineItemCosts').val();
            if (LineItemCosts.trim() == "" || isNaN(LineItemCosts)) {
                notify("Please enter Line Item Costs");
                $('#txt_LineItemCosts').focus();
                return;
            }

            var NoStateTx = '0';
            if ($('#chk_StateTx').is(':checked') == true) {
                NoStateTx = '1'
            }
            var NoGSTHSTTx = '0';
            if ($('#chk_GSTHSTTx').is(':checked') == true) {
                NoGSTHSTTx = '1'
            }
            var NoPSTTx = '0';
            if ($('#chk_PSTTx').is(':checked') == true) {
                NoPSTTx = '1'
            }
            var LineItemDtldDesc = tinyMCE.get('txt_LineItemDtldDesc').getContent();
            LineItemDtldDesc = encodeURI(LineItemDtldDesc);
            //alert(LineItemDtldDesc);
            //alert(decodeURI(LineItemDtldDesc));
            //return;
            //var LineItemDtldDesc = $('#txt_LineItemDtldDesc').val();

            //Added By Subhabrata Mondal 1/2/2016
            var ActvTg = '0';
            if ($('#chk_ActvTg').is(':checked') == true) {
                ActvTg = '1'
            }

            var LineItemAutoTagg = $('#txt_LineItemAutoTagg').val();



            //

            var Model = $('#txt_LineItemModel').val();
            var PurchaseOrderID = $('#Hdn_PurchaseOrderID').val();
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/PurchaseOrder/addnewPOLineItems';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'PurchaseOrder/addnewPOLineItems';
            }
            $.ajax({
                type: "POST",
                url: url,
                data: {
                    'LineItemQty': LineItemQty, 'LineItemUnt': LineItemUnt,
