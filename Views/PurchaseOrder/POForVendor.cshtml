        else if (LOCALORSERVERNEW == 'SERVER') {

            url1 = 'PurchaseOrder/deletePOExpediteNote';
        }



        $.ajax({
            type: "POST",
            url: url1,
            async: false,
            data: { 'FldID': FldID },
            success: function (data) {
                getpoexpeditenotes();
            },
            error: function () { notify('Something went wrong'); }
        });
    }

