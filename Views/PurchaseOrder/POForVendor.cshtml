        function onlyAmount(myfield, e, dec) {
            var str = myfield.value;
            var decPos = str.split('.');

            var key;
            var keychar;

            if (window.event)
                key = window.event.keyCode;
            else if (e)
                key = e.which;
            else
                return true;

            keychar = String.fromCharCode(key);

            if ((key == null) || (key == 0) || (key == 8) || (key == 9) || (key == 13) || (key == 27)) // control keys
                return true;
            else if ((decPos.length > 1) && ((key > 47 && key < 58))) {
                decPos = decPos[1];
                if (decPos.length >= 4) return false;
            }
            else if ((("0123456789.").indexOf(keychar) > -1)) // numbers
                return true;
            else if (dec && (keychar == ".")) // decimal point jump
            {
                myfield.form.elements[dec].focus();
                return false;
            }
            else
                return false;
        }

    </script>
