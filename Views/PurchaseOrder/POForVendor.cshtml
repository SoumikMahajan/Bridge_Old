    <script>


        $(document).ready(function () {


            $("#POLineItemsDetail tbody").sortable(
                          {
                              cancel: ".disable-sort",
                              cursor: "move",
                              start: function (event, ui) {
                                  // 0 based array, add one
                                  var obj = ui.item;
                                  $(obj).css('background', '#86ABC2');
                                  // //console.log('start');
                              },
                              update: function (event, ui) {

                                  // 0 based array, add one
                                  var obj = ui.item;
                                  var obj2 = ui.item.prev('tr');
                                  var st = $(obj).attr('data-id');
                                  var lt = $(obj2).attr('data-id');
                                  if (parseInt(lt) < parseInt(st)) {
                                      obj2 = ui.item.next('tr');
                                      lt = $(obj2).attr('data-id');
                                  }
                                  // alert('Prev: ' + st + ' Final: ' + lt);
                                  if (lt == undefined) {
                                      lt = 1;
                                  }
                                  var url1 = '';
                                  if (LOCALORSERVERNEW == 'LOCAL') {
                                      url1 = '/Purchaseorder/sortlineitems';
                                  }
                                  else if (LOCALORSERVERNEW == 'SERVER') {
                                      url1 = 'Purchaseorder/sortlineitems';
                                  }
                                  var poid = $('#Hdn_PurchaseOrderID').val();

                                  //alert("start:  " + st + ",Last ::  " + lt);
                                  //return;
                                  //sectionid = 1;
                                  $.ajax({
                                      type: "POST",
                                      url: url1,
                                      async: false,
                                      dataType: "text",
                                      contentType: "application/json; charset=utf-8",
                                      data: "{ 'prev': '" + st + "','current' : '" + lt + "','poid' : '" + poid + "'}",
                                      success: function (data) {
                                          notify('Reordered Successfully row ' + st + ' has been shifted to row ' + lt);
                                          LoadPOLineItems('');
                                      },
                                      error: function () {
                                          notify('Something went wrong.');
                                      }
                                  });
                              },
                              stop: function (event, ui) {
                                  var obj = ui.item;
                                  //$(obj).css('background', '');
                              }
                              // end of drag
                          });


        });


    </script>

