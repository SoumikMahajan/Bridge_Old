    <script type="text/javascript">

        var selectedpopup;

        $(document).ready(function () {

            $(document).tooltip();

            var classarray = new Array();
            var clsearch = '';
            var ddlfrcllsfictn;
            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/PurchaseOrder/getClassification';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {

                url1 = 'PurchaseOrder/getClassification';
            }



            $.ajax({
                type: "POST",
                url: url1,
                async: false,
                data: {},
                success: function (data) {

                    ddlfrcllsfictn = "<select id='Ddl_Clftion' multiple='multiple'>"

                    data = JSON.parse(data);
                    ////console.log(data);
                    classarray = data.data;

                    for (var a = 0; a < classarray.length ; a++) {

                        //ddlfrcllsfictn += "<opiton>" + 'test' + "</option>";
                        ddlfrcllsfictn += "<option text='" + classarray[a].classname + "' value='" + classarray[a].classid + "'>" + deletespaces(classarray[a].classname) + "</option>";
                    }

                    ddlfrcllsfictn += "</select>";

                    //notify(ddlfrcllsfictn);
                },
                error: function () { notify('Something went wrong'); }
            });




            url1 = '';


            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/PurchaseOrder/getVendors';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {

                url1 = 'PurchaseOrder/getVendors';
            }


            var totdata;

            var vendors = new Array();

            //$('#vendorlist tfoot th').each(function () {
            //    var title = $('#example thead th').eq($(this).index()).text();
            //    $(this).html('<input type="text" placeholder="Search ' + title + '" />');
            //});

            $.get(url1)
                .success(function (response) {


                    totdata = JSON.parse(response);
                    totdata = totdata.data;

                    for (i = 0; i < totdata.length ; i++) {
                        vendors[i] = new Array();
                        var id = totdata[i].Vendor_ID;
                        var txt = 'Click to select ' + totdata[i].ContactFirstname + ' ' + totdata[i].ContactLastname + ' At ' + totdata[i].ParentVendorName;
                        vendors[i][0] = '<i class="fa fa-hand-o-right" style="font-size: 1.5em;cursor:pointer;" data-id="' + id + '" title="' + txt + '" onclick="selectvendor(this);"></i>';
                        vendors[i][1] = totdata[i].ParentVendorName;
                        vendors[i][2] = totdata[i].ContactFirstname + ' ' + totdata[i].ContactLastname;
                        vendors[i][3] = deletespaces(totdata[i].Classifications);
                        vendors[i][4] = totdata[i].Currency;
                        vendors[i][5] = totdata[i].City;
                        vendors[i][6] = totdata[i].State;
                        vendors[i][7] = totdata[i].CurrCode;
                    }

                    $('#vendorlist').dataTable({
                        "processing": true,
                        "data": vendors,
                        "columns": [
                            { "title": "Actions" },
                            { "title": "Vendor" },
                            { "title": "Contact Name" },
                            { "title": "Vendor Category", 'class': 'desktoponly-datatable' },
                            { "title": "Currency" },
                            { "title": "City", 'class': 'desktoponly-datatable' },
                            { "title": "State/Prov", 'class': 'desktoponly-datatable' },
                            { "title": "Currcode", "class": "displaynone" }


                        ],
                        //"lengthMenu": [[5, 10, 50, -1], [5, 10, 50, "All"]],
                        "initComplete": function () {

                            //var ddl = "<select><option>1</option><option>2</option></select>";
                            var html = "";
                            html = "<tr >"
                                + "<th><span onclick='resetsrch();' style='cursor:pointer;'><i class='fa fa-undo'></i></span></th>"
                                + "<th rowspan='1' colspan='1' ><input class='srch' type='text' data-indx='1' placeholder='Search Vendor'></th>"
                                + "<th rowspan='1' colspan='1'><input class='srch' type='text' data-indx='2' placeholder='Search Contact Name'></th>"
                                //+ "<th rowspan='1' colspan='1'><input class='srch' type='text' data-indx='3' placeholder='Search Vendor Category'></th>"
                                + "<th rowspan='1' colspan='1' class='desktoponly-datatable'>" + ddlfrcllsfictn + "</th>"
                                + "<th rowspan='1' colspan='1'><input class='srch' type='text' data-indx='4' placeholder='Search Currency'></th>"
                                + "<th rowspan='1' colspan='1' class='desktoponly-datatable'><input class='srch' type='text' data-indx='5' placeholder='Search City'></th>"
                                + "<th rowspan='1' colspan='1' class='desktoponly-datatable'><input class='srch' type='text' data-indx='6' placeholder='Search State/Prov'></th>";


                            $('#vendorlist thead').append(html);

                            $("#Ddl_Clftion").multiselect().multiselectfilter();

                            $("#Ddl_Clftion").multiselect({

                                //click: function (event, ui) {
                                //    //$callback.text(ui.value + ' ' + (ui.checked ? 'checked' : 'unchecked'));
                                //    //alert(ui.value);
                                //    //console.log(ui);
                                //    alert(ui.title);
                                //}

                                close: function () {
                                    var clsearch = $('#Ddl_Clftion').val();
                                    if (clsearch == null)
                                        clsearch = '';
                                    var srchtxt = '';
                                    var tmp = clsearch;

                                    for (var i = 0; i < tmp.length; i++) {

                                        var id = tmp[i];


                                        for (var a = 0; a < classarray.length ; a++) {


                                            if (classarray[a].classid == id) {
                                                if (srchtxt == '') {
                                                    srchtxt += deletespaces(classarray[a].classname);
                                                }
                                                else {
                                                    srchtxt += '|' + deletespaces(classarray[a].classname);
                                                }
                                            }
                                        }
                                    }
                                    var table = $('#vendorlist').DataTable();
                                    table.column(3).search(srchtxt, true).draw();
                                }
                            });


                            var table = $('#vendorlist').DataTable();
                            // table.column(2).search("fname|ff", true).draw();

                            $('.srch').on('keyup change', function () {
                                var indx = $(this).attr('data-indx');
                                var txt = this.value;
                                table
                                       .column(indx)
                                       .search(txt)
                                       .draw();
                                //RowHtmlRender();
                            });


                            $('#vendorlist_filter').remove();
                            $('#vendorlist_length').remove();

                        },
                        "pagingType": "full_numbers",
                        "aoColumnDefs": [
                            { 'bSortable': false, 'aTargets': [0] }
                        ]
                    });
                });

            $('#Ddl_Project').change(function () {

                var pid = $(this).val();


                var url1 = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url1 = '/PurchaseOrder/shiptoaddress';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {

                    url1 = 'PurchaseOrder/shiptoaddress';
                }



                $.ajax({
                    type: "POST",
                    url: url1,
                    async: false,
                    data: { 'pid': pid },
                    success: function (data) {
                        var hoteladdress = data.split('^')[0];
                        var legalname = data.split('^')[1];
                        var projectname = data.split('^')[2];

                        $('#txt_ShipTo').val(projectname);
                        $('#txt_InvoiceTo').val(legalname);
                        $('#txt_addr1').text(hoteladdress);


                    },
                    error: function () { notify('Something went wrong'); }
                });
            });
        });
        function resetsrch() {
            $("#Ddl_Clftion").multiselect("uncheckAll");

            var table = $('#vendorlist').DataTable();
            table.column(3).search('').draw();
            $('.srch').each(function () {
                this.value = '';
                var indx = $(this).attr('data-indx');
                var txt = this.value;
                table
                       .column(indx)
                       .search(txt)
                       .draw();
            });
        }

        function openvendors(obj) {

            resetsrch();

            selectedpopup = obj;


            $('#popupforvendorlist').bPopup({
                easing: 'easeOutBack', //uses jQuery easing plugin
                speed: 450,
                transition: 'slideDown',
                modalColor: 'rgb(18, 54, 65)'

            });
        }

        function selectvendor(obj) {
            var id = $(obj).attr('data-id');
            var rw = $(obj).parent().parent();
            // var cname = $(rw).find("td:eq(1)").html() + '-' + $(rw).find("td:eq(2)").html();

            var cname = "";

            if (selectedpopup == 'vendor') {
                cname = $(rw).find("td:eq(1)").html() + '-' + $(rw).find("td:eq(2)").html();
            }
            else {
                cname = $(rw).find("td:eq(2)").html();
            }


            var currency = $(rw).find("td:eq(4)").html();
            var currencycode = $(rw).find("td:eq(7)").html();

            //alert(rw);

            $('#popupforvendorlist').bPopup().close();

            if (selectedpopup == 'vendor') {

                $('#txt_CurrencyCode').text(currency);
                $('#txt_CurrencyCode').attr('data-id', currencycode);

                $('#txt_VendorName').text(cname + "(" + currency + ")");
                $('#txt_VendorName').attr('data-id', id);
            }
            else {

                $('#txt_VendorCO').text(cname);
                $('#txt_VendorCO').attr('data-id', id);
                // notify('still working');

                var url1 = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url1 = '/PurchaseOrder/vendoraddress';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url1 = 'PurchaseOrder/vendoraddress';
                }


                $.ajax({
                    type: "POST",
                    url: url1,
                    async: false,
                    data: { 'vendorid': id },
