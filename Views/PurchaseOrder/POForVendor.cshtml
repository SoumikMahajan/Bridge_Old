        if (ExpediteNote == "") {
            notify("Please enter note");
            return;
        }


        var url1 = '';
        if (LOCALORSERVERNEW == 'LOCAL') {
            url1 = '/PurchaseOrder/addPOExpediteNote';
        }
        else if (LOCALORSERVERNEW == 'SERVER') {

            url1 = 'PurchaseOrder/addPOExpediteNote';
        }



        $.ajax({
            type: "POST",
            url: url1,
            async: false,
            data: { 'POID': POID, 'ExpediteNote': ExpediteNote },
