        function DeletePOLineItems(obj, POLineItemID) {
            if (confirm("Are you sure want to delete this PO?")) {
                var url1 = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url1 = '/PurchaseOrder/DeletePOLineItems';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url1 = 'PurchaseOrder/DeletePOLineItems';// + pid
                }
                $.ajax({
                    type: "POST",
                    url: url1,
                    async: false,
                    dataType: "text",
                    contentType: "application/json; charset=utf-8",
                    data: "{ 'POLineItemID': '" + POLineItemID + "'}",
                    success: function (data) {
                        if (data == 'SUCCESS') {
                            // loaditems(sectionid);
                            irrrrr = 0;
                            notify('Item Deleted successfully.');
                            window.location.reload();
                        }
                        else {
                            notify('Something went wrong.');
                        }
                    },
                    error: function () {
                        notify('Something went wrong.');
                    }
                });
            }
        }

