            },
            error: function () { notify('Something went wrong'); }
        });



    }


    function getpoexpeditenotes() {

        var POID = $('#Hdn_PurchaseOrderID').val();


        var url1 = '';
        if (LOCALORSERVERNEW == 'LOCAL') {
            url1 = '/PurchaseOrder/getPOExpediteNote';
        }
        else if (LOCALORSERVERNEW == 'SERVER') {

            url1 = 'PurchaseOrder/getPOExpediteNote';
        }



        $.ajax({
            type: "POST",
            url: url1,
            async: false,
            data: { 'POID': POID },
            success: function (data) {
                if (data == "") {
                    $('#expeditenotelist').html("No Notes available.");
                    return;
                }
                var html = "";

                for (var i = 0; i < data.split(',').length; i++) {
                    html += "<span class='remove'><a onclick='removeexpeditenote(\"" + data.split(',')[i].split('^')[2] + "\");'>x</a><span>" + data.split(',')[i].split('^')[0] + "( " + data.split(',')[i].split('^')[1] + " )</span></span>";
                }



                $('#expeditenotelist').html(html);
            },
            error: function () { notify('Something went wrong'); }
        });



    }

    function removeexpeditenote(FldID) {

        var c = confirm("Are you sure you want to delete?");

        if (!c) {
            return;
        }


        var url1 = '';
        if (LOCALORSERVERNEW == 'LOCAL') {
            url1 = '/PurchaseOrder/deletePOExpediteNote';
