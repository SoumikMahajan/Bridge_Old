    <script type="text/javascript">
        $(document).ready(function () {
            $("#UpldLineItems").click(function () {
                //alert(1);
                var formData = new FormData();
                var totalFiles = document.getElementById("FileUpload").files.length;

                if (totalFiles > 1) {
                    notify('Single file at a time');
                    return;
                }

                for (var i = 0; i < totalFiles; i++) {
                    var file = document.getElementById("FileUpload").files[i];

                    formData.append("FileUpload", file);
                }


                var sectionid = $('#Ddl_SelProSec').val();


                var upldurl = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    upldurl = '/Budget/LineItems1';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    upldurl = 'Budget/LineItems1';
                }
                var txt = $(this).val();
                $(this).val('Please wait');
                upldurl += '?sectionid=' + sectionid;
                $.ajax({
                    type: "POST",
                    url: upldurl,
                    data: formData,
                    dataType: 'text',
                    contentType: false,
                    processData: false,
                    success: function (response) {

                        $('#UpldLineItems').val(txt);

                        if (isNaN(response)) {

                            notify(response);
                        }
                        else if (response == "0") {
                            notify("No items in the excel sheet.");
                        }
                        else {
                            var sectionid = $('#Ddl_SelProSec').val();
                            loaditems(sectionid);
                            notify(response + " Items added successfully.", 'green');
                            $('#FileUpload').replaceWith($('#FileUpload').val('').clone(true));
                        }
                    },
                    failed: function (error) {
                        $('#UpldLineItems').val(txt)
                        notify("error");
                    },
                    error: function (text) {

                        $('#UpldLineItems').val(txt)
                        notify(text);
                    }
                });
            });
        });
    </script>

