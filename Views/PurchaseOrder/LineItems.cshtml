    <script>
        function magnifydiv(mode) {
            var zoomval = 0;
            if ($('#lineitems').attr('data-zoomval') == undefined || $('#lineitems').attr('data-zoomval') == '') {
                zoomval = 1.0;
            }
            else {
                zoomval = parseFloat($('#lineitems').attr('data-zoomval'));
            }


            if (mode == 'in') {
                zoomval += 0.1;
            }
            else {

                zoomval -= 0.1;
            }
            if (zoomval > 1) {
                zoomval = 1;
            }
            if (zoomval <= 0.6) {
                zoomval = 0.6;
            }
            $('#lineitems').css('zoom', zoomval);
            $('#lineitems').attr('data-zoomval', zoomval)
        }
