    <script>

        function copynowbudget() {

            


            var pro = $('#Ddl_SelProCopy').val();
            var sec = $('#Ddl_SelSecCopy option:selected').text();

            if (pro == "0") {
                notify("Please select Project");
                return;
            }

            if (sec == "") {
                notify("Please select Section");
                return;
            }



            var c = confirm("Are You sure you want to copy this budget to " + pro + " - " + sec + "?");
            if (!c) {
                return;
            }
            else{


                var ProjectID = $('#Ddl_SelProCopy option:selected').attr('data-id');
                var secid = $('#Ddl_SelSecCopy').val();

                var spid = $('#Ddl_SelPro option:selected').attr('data-id');
                var ssid = $('#Ddl_SelProSec').val();
                var VersionID = $('#ddl_selectversion').val();

                if (VersionID != "0") {
                    ssid = $('#Ddl_SelProSecPreviousVersion').val();
                    
                }

                var url1 = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url1 = '/Budget/CopyBudget';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url1 = 'Budget/CopyBudget';
                }

                $.ajax({
                    type: "POST",
                    url: url1,
                    async: false,
                    dataType: "text",
                    contentType: "application/json; charset=utf-8",
                    data: "{ \"ProjectID\" : \"" + ProjectID + "\",\"SectionID\" : \"" + secid + "\",\"sourceProjectID\" : \"" + spid
                        + "\",\"sourceSectionID\" : \"" + ssid + "\",\"VersionID\" : \"" + VersionID + "\"}",
                    success: function (data) {
                        notify(data + " new rows added to " + pro + " - " + sec,'green');
                    },
                    error: function () {
                        notify('Something went wrong.');
                    }
                });







            }

        }


        function getSectionToCopy(obj) {

            var projectid = $('#Ddl_SelProCopy option:selected').attr('data-id');

            getsectionsforcopy(projectid);

           // getsections(projectid, '', '');




        }

        function copybudget() {

           

            $('#copybudgetpopup').modal('show');
            var currentsection = $('#Ddl_SelProSec').val();
            var currentproject = $('#Ddl_SelPro option:selected').attr('data-id');

            $('#Ddl_SelProCopy option').each(function () {

                //console.log($(this).attr('data-id'));

                if ($(this).attr('data-id') == currentproject) {
                    $(this).attr('selected', 'selected');
                }
            });

            var projectid = $('#Ddl_SelProCopy option:selected').attr('data-id');

            $("#Ddl_SelProCopy").multiselect("refresh");
            getsectionsforcopy(projectid);



        }

        var ProjectDdlForPage = $('#Ddl_SelPro'); //The project dropdown ID


        $(document).ready(function () {

            $("#Ddl_SelProCopy").multiselect({
                multiple: false
                //,header: "Select an option"
              , noneSelectedText: "Select a Project"
                // ,selectedList: 3
            }).multiselectfilter();


            if ($('#BudgetCreatePermission').val() == '0') {
                $('#btn_CopyBudget').remove();
            }

            var ispreviousproject = $('#ispreviousproject').val();

            var selectedpreferredpid = 0;

            if (ispreviousproject != "0") {

                selectedpreferredpid = ispreviousproject;

            }
            else {


                selectedpreferredpid = getProjectPreference();

                if (selectedpreferredpid.split(',').length > 0) {
                    selectedpreferredpid = selectedpreferredpid.split(',')[0];
                }


            }

            $(ProjectDdlForPage).find('option').each(function () {

                if ($(this).attr('data-id') == selectedpreferredpid) {
                    $(this).attr("selected", "true");

                }

            });

            $(ProjectDdlForPage).multiselect('refresh');

            var width = '100%';
            $('.ui-multiselect').css('width', width);
            $('.ui-multiselect-menu').css('width', '39.5%');
            $('.ui-state-default').css('color', '#C31001');
            $('.ui-multiselect').css('height', '34px');
            $('.ui-multiselect').css('margin-top', '5px');



            //To call page specific dropdown change event
            ProjectNameAtLabel(ProjectDdlForPage);

            var pid = selectedpreferredpid;

            getsections(pid, '', '');

            getBudgetVersion(pid);

            getapproverstatus();

            var ProjectID = $("#Ddl_SelPro option:selected").attr('data-id');

            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Budget/getallversionname';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Budget/getallversionname';
            }

            $.ajax({
                type: "POST",
                url: url1,
                async: false,
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                data: "{ 'PID': '" + ProjectID + "'}",
                success: function (data) {

                    $('#ddl_selectversion').html(data);

                },
                error: function () {
                    notify('Something went wrong.');
                }
            });

            if (selectedpreferredpid == "0") {
                $('#btn_AddSctn').val("Add section");
            }
            else {

                $('#btn_AddSctn').val("Add section for " + $("#PrjtDdl option:selected").text());
            }




        });



        $(document).on('change', ProjectDdlForPage, function () {

            setProjectPreferenceBS(ProjectDdlForPage);

        });


    </script>
    <script>

