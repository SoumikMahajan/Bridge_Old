                var url = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url = '/Budget/DeleteVersion';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url = 'Budget/DeleteVersion';
                }


                $.ajax({
                    type: "POST",
                    url: url,
                    data: { 'versionid': versionid },
                    success: function (data) {
                        if (data == 'SUCCESS') {
                            notify('Successfully deleted version ' + versionid, 'green');
                            window.location.reload();
                        }
                    },
                    error: function () { notify('Something went wrong'); }
                });

            }
            else if (mode == 'E') {

                var versionname = $('#ddl_selectversion option:selected').attr('data-versionname');

                $('#txt_budgetversionname').val(versionname);
                $('#hdnversionid').val(versionid);

