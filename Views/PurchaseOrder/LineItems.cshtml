        function areset(st, lt) {
            st = parseInt(st);
            lt = parseInt(lt);
            $('#lineitems tbody tr').each(function () {
                if (st < lt) {
                    var prev1 = parseInt($(this).find("td:eq(5)").html());
                    var prev2 = parseInt($(this).attr('data-id'));
                    if (prev1 == st) {
                        $(this).find("td:eq(5)").html(lt);
                        $(this).attr('data-id', lt);
                        return;
                    }
                    if (prev1 > st && prev1 <= lt) {
                        prev1 = prev1 - 1;
                        $(this).find("td:eq(5)").html(prev1);
                    }
                    if (prev2 > st && prev1 <= lt) {
                        prev2 = prev2 - 1;
                        $(this).attr('data-id', prev2);
                    }
                }
                else {
                    var prev1 = parseInt($(this).find("td:eq(5)").html());
                    var prev2 = parseInt($(this).attr('data-id'));
                    if (prev1 == st) {
                        $(this).find("td:eq(5)").html(lt);
                        $(this).attr('data-id', lt);
                        return;
                    }
                    if (prev1 >= lt && prev1 <= st) {
                        prev1 = prev1 + 1;
                        $(this).find("td:eq(5)").html(prev1);
                    }
                    if (prev2 >= lt && prev1 <= st) {
                        prev2 = prev2 + 1;
                        $(this).attr('data-id', prev2);
                    }
                }
            });
            //var table = $('#lineitems').DataTable();
            //table.draw();
        }
        function EditListitem(obj, lid) {
            //$('.editlineitempopup').show();
            for (var a = 0; a < budget.length; a++) {
                //console.log(budget[a]);
                if (budget[a][5] == lid) {
                    var totid = budget[a][2];// = totdata[i].TotalID;

                    var nonfreight = budget[a][36];// = totdata[i].TotalID;
                    if (nonfreight == 1) {
                        $('#item_nonfreight_edt').prop("checked", true);
                    }
                    else {
                        $('#item_nonfreight_edt').prop("checked", false);
                    }


                    var taxable = budget[a][34];// = totdata[i].TotalID;
                    if (taxable == 1) {
                        $('#item_taxable_edt').prop("checked", true);
                    }
                    else {
                        $('#item_taxable_edt').prop("checked", false);
                    }



                    var itemid = budget[a][5];
                    $('#itemID').val(itemid);
                    var item = budget[a][7];// = totdata[i].Item;
                    $('#edtitemname').val(item);
                    var itemdesc = budget[a][7];// = totdata[i].ItemDescription;
                    $('#edtdesc').val(itemdesc);

                    var modelnum = budget[a][9];
                    $('#edtmodelnum').val(specnum);

                    var specnum = budget[a][8];
                    $('#edtspecnum').val(specnum);
                    var vendor = budget[a][10];
                    $('#edtvendor').val(vendor);

                    var header = budget[a][29];
                    $('#edtcategory').val(header);

                    var notes = budget[a][16];
                    $('#edtnotes').val(notes);

                    

                  //  var qty = budget[a][12].replaceAll(',', '');// = totdata[i].Quantity;
                    var qty = replaceAll(budget[a][12],',', '');// = totdata[i].Quantity;
                    $('#edtqty').val(qty);
                    var uom = budget[a][22];// = totdata[i].UOMID;
                    var cost = replaceAll(budget[a][14],',', '');// = totdata[i].Cost;
                    $('#edtcost').val(cost);
                    //budget[i][13] = totdata[i].Note;
                    var wh = budget[a][23];// = totdata[i].ToWarehouse == 1 ? "<i class='fa fa-check'></i>" : "<i class='fa fa-times'></i>";
                    if (wh == 1) {
                        $('#edtwh').prop("checked", true);
                    }
                    else {
                        $('#edtwh').prop("checked", false);
                    }
                    
                    var obj = $('#uom').clone();
                    $('#edtuom').remove();
                    $(obj).attr('id', 'edtuom');
                    $('#uomselect').append(obj);
                    $('#edtuom').val(uom).change();
                    break;
                }
            }
            editlineitempopup();
            setTimeout(function () {
