                           { "title": "ItemDtldDesc", "class": "displaynone" },
                           { "title": "Extended" },
                           { "title": "R-Qty" },
                       ],
                       paging: false,
                       "initComplete": function () {
                           // $('#POLineItemsDetail_filter').find('input').hide();
                           // $('#POLineItemsDetail_filter').find('label').text('Search Description::');
                           // $('#POLineItemsDetail_filter').append('<input type="text" id="srchdsc" placeholder="Search"/>');

                           // $('#tableloader').hide();

                           // if (prevsrch != undefined) {
                           //     var table = $('#POLineItemsDetail').DataTable();
