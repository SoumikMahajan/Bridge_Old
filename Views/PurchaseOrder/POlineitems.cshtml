        function RowHtmlRender() {
            // alert(1);
            //  $('#project_filter').css('display', 'none');
            $('#POLineItemsDetail tbody tr').find("td:eq(0)").each(function () {
                var pid = $(this).html();
                $(this).html('<input type="button" class="buttonedit" onclick="EditPOLineItems(this,\'' + pid + '\');" style="margin-bottom:6px;" data-id="' + pid + '" /><input type="button" class="buttondelete" onclick="DeletePOLineItems(this,\'' + pid + '\');" style="margin-bottom:6px;" data-id="' + pid + '" />');

            });
        }
        function NvgtToAdditmsToPO() {
            var PurchaseOrderID = $('#Hdn_PurchaseOrderID').val();
            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/PurchaseOrder/AddItemsToPO';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'PurchaseOrder/AddItemsToPO';
            }
            url1 += "/" + PurchaseOrderID;
            window.location.href = url1;
        }


        function EditPOLineItems(obj, pid) {
            var url1 = '';

            var PurchsOrdrID = $('#Hdn_PurchaseOrderID').val();

            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/PurchaseOrder/EditPOLineItems';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'PurchaseOrder/EditPOLineItems';
            }

            url1 += "?PurchsOrdrID=" + PurchsOrdrID;
            url1 += "&POLineItemID=" + pid;

            window.location.href = url1;
        }

        function DeletePOLineItems(obj, pid) {
            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/PurchaseOrder/DeletePOLineItems/' + pid;
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'PurchaseOrder/DeletePOLineItems/' + pid;
            }
        }
