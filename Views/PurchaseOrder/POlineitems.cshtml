                           { "title": "Units" },
                           { "title": "Cost" },
                           { "title": "Total", "class": "displaynone" },
                           { "title": "Note", "class": "displaynone" },
                           { "title": "ToWarehouse", "class": "displaynone" },
                           { "title": "CommitAmountAdjust", "class": "displaynone" },
                           { "title": "DateCreated", "class": "displaynone" },
                           { "title": "CreatedBy_ID", "class": "displaynone" },
