    <script>
        var allconvrate;
        var allvendorlist = [];

        function addresslist() {
            var vendorid = $('#txt_VendorCO').val();
            console.log(vendorid);

            //if (vendorid == '' || vendorid == '0') {
            //    notify("Choose a vendor first");
            //    return;
            //}
            var obj = new Object();
            obj.Mode = 'GETPO';
            obj.VendorID = vendorid;
            obj.FldID = $("#Ddl_Project").val().trim();

            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "POMS_ContactAddressesProc";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var o1 = DBSP.call_DB_Procedure();
            o1 = o1.data;

            console.log(o1);
            var html = '';
            for (var a = 0; a < o1.length; a++) {

                var address1 = o1[a].Address1;
                var Tabheader = o1[a].Tabheader;
                html += '<p style="font-weight: bold;">' + Tabheader + '</p>'
                +'<p onclick="chooseaddress(this);" style="cursor:pointer;border: 1px solid black;padding: 15px;">' + address1 + '</span>';
            }



            $('#addresslist').html(html);

            $('#addresslistmodal').modal('show');

        }

        function chooseaddress(o) {
            var html = $(o).text();

            $('#txt_HotelZipCode').val(html);
            $('#addresslistmodal').modal('hide');
        }
    </script>

    

    <script type="text/javascript">

        $(function () {

            var date = new Date();
            var currentMonth = date.getMonth();
            var currentDate = date.getDate();
            var currentYear = date.getFullYear();

            $('#txt_DeliveryDate').datepickercustom({
                changeMonth: true,
                changeYear: true,
                dateFormat: 'MM dd yy'
                //minDate: new Date(currentYear, currentMonth, currentDate)
            });

            $('#txt_CheckDate').datepickercustom({
                changeMonth: true,
                changeYear: true,
                dateFormat: 'MM dd yy',
                minDate: new Date(currentYear, currentMonth, currentDate)
            });

        });


        function IsNumber(e) {
            var keyCode = e.which ? e.which : e.keyCode
            if ((keyCode > 47 && keyCode < 58) || (keyCode == 8) || (keyCode == 46)) {
                return true;
            }
            else {
                alert('Use Only Numeric value');
                return false;
            }
        }


    </script>

    <script type="text/javascript">

        $(function () {

            $('#btn_CreatePO').click(function () {

                $(this).addClass('pointer-events', 'none');
                var InvRcvdPartial = 'complete';
                //if ($('input:radio[name=InvRcvdPartial]:checked').val() == 'partial') {
                //    InvRcvdPartial = 'partial';
                //}
                //else if ($('input:radio[name=InvRcvdPartial]:checked').val() == 'complete') {
                //    InvRcvdPartial = 'complete';
                //}


             

                var Project = $('#Ddl_Project').val().trim();
                if (Project == "0") {
                    notify('You must select Project before saving the Purchase Order');
                    $('#Ddl_Project').focus();
                    return;
                }
               
                var VendorID = $('#txt_VendorName').attr('data-id'); //$('#txt_VendorName').val().trim();
               
                if (VendorID == "0" || VendorID == undefined) {
                   // errorfunc('txt_VendorName', 'You must select Vendor before saving the Project');
                    notify('You must select Vendor before saving the Purchase Order');
                    return;
                }

                var txt_ConversionRate = $('#txt_ConversionRate').val().trim();


                var Ddl_Buyer = $('#Ddl_Buyer').val().trim();
                if (Ddl_Buyer == "0") {
                    //$('#Ddl_Buyer').attr("style", "height:40px");
                    notify('You must select Buyer before saving the Purchase Order');
                    $('#Ddl_Buyer').focus();
                    return;
                }

                var Ddl_Shipment = $('#Ddl_Shipment').val().trim();
                var txt_Terms = $('#txt_Terms').val().trim();


                var txt_FOB = $('#txt_FOB').val().trim();


                var txt_ShipTo = $('#txt_ShipTo').val().trim();

                var VendorCO = $('#txt_VendorCO').attr('data-id'); 

                VendorCO = VendorCO == undefined ? "0" : VendorCO;

                var txt_InvoiceTo = $('#txt_InvoiceTo').val().trim();


                var address1 = $('#txt_HotelZipCode').val();

                var Remarks = $('#txt_Remarks').val().trim().replace("\\", "/");



                var url = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url = '/PurchaseOrder/SavePurchaseOrderDetail';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url = 'PurchaseOrder/SavePurchaseOrderDetail';
                }

                $.ajax({
                    type: "POST",
                    url: url,
                    data: {
                        'VendorID': VendorID, 'ProjectID': $('#Ddl_Project').val(), 'ConversionRate': $('#txt_ConversionRate').val(),
                        'CurrencyCode': $('#txt_CurrencyCode').attr('data-id'), 'BuyerID': $('#Ddl_Buyer').val(), 'ShipMethod': $('#Ddl_Shipment').val(),
                        'ShipDate': $('#txt_DeliveryDate').val(), 'CheckBackDate': $('#txt_CheckDate').val(), 'Terms': $("#txt_Terms option:selected").attr('data-id'),// $('#txt_Terms').val(),
                        'FOB': $('#txt_FOB').val(), 'Frieght': $('#txt_Freight').val(), 'Remark': Remarks,
                        'ShipTo': $('#txt_ShipTo').val(), 'VendorCO': VendorCO, 'InVoiceAddress': $('#txt_InvoiceTo').val(),
                        'Notes': $('#txt_Notes').val(), 'address1': address1, 'InvRcvdPartial': InvRcvdPartial
                    },
                    success: function (data) {
                        $(this).removeClass('pointer-events');
                        irrrrr = 0;

                        if (data != '') {
                            if (data.split('^').length > 0) {
                                if (data.split('^')[0] == 'Success') {
                                    notify("PO created Successfully",'green');
                                    var PONo = data.split('^')[1];
                                    if (PONo != '') {
                                        var url = '';
                                        if (LOCALORSERVERNEW == 'LOCAL') {
                                            url = '/PurchaseOrder/POEdit';
                                        }
                                        else if (LOCALORSERVERNEW == 'SERVER') {
                                            url = '/PurchaseOrder/POEdit';
                                        }
                                        url += "/" + PONo;

                                        window.location.href = url;

                                    }
                                }
                                else {
                                    notify('Something going wrong');
                                }
                            }
                            else {
                                notify('Something going wrong');
                            }

                        }
                        else {
                            notify('Something going wrong');
                        }
                    }
                });
            });
        });
    </script>
