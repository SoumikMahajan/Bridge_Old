                    <script>

    function projectddlchange(obj) {

        var pid = $(obj).val();

        if (pid == "0") {
            return;
        }

        var url1 = '';
        if (LOCALORSERVERNEW == 'LOCAL') {
            url1 = '/PurchaseOrder/PO_GetRequiredAndAssignedApprovers_Project';
        }
        else if (LOCALORSERVERNEW == 'SERVER') {

            url1 = 'PurchaseOrder/PO_GetRequiredAndAssignedApprovers_Project';
        }



        $.ajax({
            type: "POST",
            url: url1,
            async: false,
            data: { 'PID': pid },
            success: function (data) {
                if (data == "") {
                    data = 1;
                }
                if (parseInt(data) > 0) {
                    $('#btn_CreatePO').hide();
                    notify("Can not create purchase order. Not enough approvers");
                    return;

                }
                else {
                    $('#btn_CreatePO').show();
                }
            },
            error: function () { notify('Something went wrong'); }
        });






        var url1 = '';
        if (LOCALORSERVERNEW == 'LOCAL') {
            url1 = '/PurchaseOrder/shiptoaddress';
        }
        else if (LOCALORSERVERNEW == 'SERVER') {

            url1 = 'PurchaseOrder/shiptoaddress';
        }



        $.ajax({
            type: "POST",
            url: url1,
            async: false,
            data: { 'pid': pid },
            success: function (data) {
                
                var hoteladdress = data.split('^')[0];
                var legalname = data.split('^')[1];
                var projectname = data.split('^')[2];
                var ponote = data.split('^')[3];
                

                $('#txt_ShipTo').val(projectname);
                $('#txt_InvoiceTo').val(legalname);
                //$('#txt_HotelZipCode').text(hoteladdress);
                //$('#txt_Notes').text(ponote);

            },
            error: function () { notify('Something went wrong'); }
        });

        getVendorShippingWise(pid);


    }

    function getVendorShippingWise(pid) {
        var url1 = '';
        if (LOCALORSERVERNEW == 'LOCAL') {
            url1 = '/PurchaseOrder/GetVendorShipingPriorityCreate';
        }
        else if (LOCALORSERVERNEW == 'SERVER') {

            url1 = 'PurchaseOrder/GetVendorShipingPriorityCreate';
        }



        $.ajax({
            type: "POST",
            url: url1,
            async: false,
            data: { 'projectID': pid },
            success: function (data) {
                $('#txt_VendorCO').empty();
                $('#txt_VendorCO').append(data);
            },
            error: function () { notify('Something went wrong'); }
        });
    }
