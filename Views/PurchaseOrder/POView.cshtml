        function SearchText() {

            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/PurchaseOrder/GetVendorList';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'PurchaseOrder/GetVendorList';
            }

            $(function () {
                $('#txt_VendorName').autocomplete({
