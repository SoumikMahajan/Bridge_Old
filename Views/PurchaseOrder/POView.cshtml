    <script type="text/javascript">

        function LoadPOLineItems(sectionid) {

            $('#POLineItemsDetail tbody tr').css("opacity", "0.3");
            var table = $('#POLineItemsDetail').DataTable();
            table.clear().draw();

            var POID = $('#Hdn_PurchaseOrderID').val();

            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/PurchaseOrder/getPOlineitemsByPONo';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'PurchaseOrder/getPOlineitemsByPONo';
            }
            url1 += "?POID=" + POID;

            var totdata;




            $.get(url1)
               .success(function (response) {
                   totdata = JSON.parse(response);
                   totdata = totdata.data;

                   if (totdata.length == 0) {
                       var table = $('#POLineItemsDetail').DataTable();
                       table
                           .clear()
                           .draw();
                       //$('#tableloader').hide();
                       return;
                   };
                   POLineItems = [];
                   for (i = 0; i < totdata.length ; i++) {
                       POLineItems[i] = new Array();
                       POLineItems[i][0] = totdata[i].POLineItemID;
                       POLineItems[i][1] = "";
                       POLineItems[i][2] = totdata[i].TotalID;
                       POLineItems[i][3] = totdata[i].ProjectID;
                       POLineItems[i][4] = totdata[i].BudgetSectionID;
                       POLineItems[i][5] = totdata[i].LineItemID;
                       POLineItems[i][6] = totdata[i].ItemOrder;
                       POLineItems[i][7] = totdata[i].Item;
                       POLineItems[i][8] = totdata[i].SpecNum;
                       POLineItems[i][9] = totdata[i].ItemDescription;
                       POLineItems[i][10] = totdata[i].Vendor;
                       POLineItems[i][11] = totdata[i].Quantity;
                       POLineItems[i][12] = totdata[i].UOM;
                       POLineItems[i][13] = totdata[i].Cost;
                       POLineItems[i][14] = totdata[i].Quantity * totdata[i].Cost;
                       POLineItems[i][15] = totdata[i].Note;
                       POLineItems[i][16] = totdata[i].ToWarehouse == 1 ? "<i class='fa fa-check'></i>" : "<i class='fa fa-times'></i>";
                       POLineItems[i][17] = "0";//totdata[i].CommitAmountAdjust;
                       POLineItems[i][18] = totdata[i].DateCreated;
                       POLineItems[i][19] = totdata[i].CreatedBy_ID;
                       POLineItems[i][20] = totdata[i].Status;
                       POLineItems[i][21] = totdata[i].UOMID;
                       POLineItems[i][22] = totdata[i].ToWarehouse;
                       POLineItems[i][23] = totdata[i].Spacing;
                       POLineItems[i][24] = totdata[i].Header;
                       POLineItems[i][25] = totdata[i].ItemDtldDesc;
                       POLineItems[i][26] = totdata[i].Extended;
                       POLineItems[i][27] = totdata[i].ReceivedQuantity;

                   }
                   $('#POLineItemsDetail').dataTable().fnDestroy();
