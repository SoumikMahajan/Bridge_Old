    <script>
        function initmce() {

            var fontsize = "";
            for (var a = 5 ; a <= 22 ; a = a + 0.5) {
                fontsize += fontsize == "" ? a + "px" : " " + a + "px";
            }


            tinymce.init({
                selector: "#Answer",
                // paste_retain_style_properties: "font-size,color",
                fontsize_formats: fontsize,// "8px 9px 10px 12px 14px 18px 24px 36px",
                plugins: "textcolor,paste,autolink",
                paste_auto_cleanup_on_paste: false,
                //plugins: "paste",
                paste_postprocess: function (pl, o) {
                    // Content DOM node containing the DOM structure of the clipboard
                    //alert(o.node.innerHTML);

                    o.node.innerHTML = replaceAll(o.node.innerHTML.toUpperCase(), '&NBSP;', '&nbsp');
                    //o.node.innerHTML = o.node.innerHTML.toUpperCase();
                },

                toolbar: " undo redo | styleselect | bold italic underline strikethrough | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent| forecolor backcolor | fontsizeselect",

                //fontsize_formats: fontsize,//"8pt 8.5pt 9pt 9.5pt 10pt 10.5pt 11pt 12pt 14pt 18pt 24pt 36pt"
                menubar: false
                

            });

            tinymce.init({
                selector: "#editAnswer",
                // paste_retain_style_properties: "font-size,color",
                fontsize_formats: fontsize,// "8px 9px 10px 12px 14px 18px 24px 36px",
                plugins: "textcolor,paste",
                paste_auto_cleanup_on_paste: false,
                //plugins: "paste",
                paste_postprocess: function (pl, o) {
                    // Content DOM node containing the DOM structure of the clipboard
                    //alert(o.node.innerHTML);

                    o.node.innerHTML = replaceAll(o.node.innerHTML.toUpperCase(), '&NBSP;', '&nbsp');
                    //o.node.innerHTML = o.node.innerHTML.toUpperCase();
                },

                toolbar: " undo redo | styleselect | bold italic underline strikethrough | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent| forecolor backcolor | fontsizeselect",

                //fontsize_formats: fontsize,//"8pt 8.5pt 9pt 9.5pt 10pt 10.5pt 11pt 12pt 14pt 18pt 24pt 36pt"
                menubar: false


            });


        }
        $(document).ready(function () {

            getFAQ();
            initmce();
            

            $("#Ddl_Category").multiselect().multiselectfilter();

            $("#Ddl_Category").multiselect({ 'multiple': false });

            $("#Ddl_Category2").multiselect().multiselectfilter();

            $("#Ddl_Category2").multiselect({ 'multiple': false });

            $('#tblfaq').dataTable();

            populatecat();

        });


        
        //Category CRUD
        function populatecat() {
            var obj = new Object();
            obj.Mode = 'ADMINCATGET';



            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "POMS_FAQALL";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var Categorylist = DBSP.call_DB_Procedure();
            Categorylist = Categorylist.data;

           
            var html = "";
            for (var a = 0; a < Categorylist.length; a++) {
                html += "<option value='" + Categorylist[a].FldID + "'>" + Categorylist[a].Category + "</option>";
            }

            $("#Ddl_Category").html(html);
            $("#Ddl_Category2").html(html);

            $("#Ddl_Category").multiselect('refresh');
            $("#Ddl_Category2").multiselect('refresh');
        }
        function SaveCat() {

            var cattext = $('#Cattext').val().trim();
            var active = $('#activecat').is(':checked') ? '1' : '0';
            if (cattext == '') {
                notify("Category can not be blank.");
                return;
            }

            var obj = new Object();
            obj.Mode = 'ADMINCATSAVE';
            obj.Category = cattext;
            obj.IsActive = active;
            obj.SESSIONUSERBACKEND = "InsertedBy";



            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "POMS_FAQALL";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var Categorylist = DBSP.call_DB_Procedure();
            Categorylist = Categorylist.data;

            populatecat();
            $('#AddCatModal').modal('hide');
            $('#Cattext').val('');
            $('#activecat').prop('checked','checked')
        }
        function EditCat() {

            var cattext = $('#editCattext').val().trim();
            var active = $('#editactivecat').is(':checked') ? '1' : '0';

            var catid = $('#Ddl_Category').val();
            if (cattext == '') {
                notify("Category can not be blank.");
                return;
            }

            var obj = new Object();
            obj.Mode = 'ADMINCATEDIT';
            obj.Category = cattext;
            obj.IsActive = active;
            obj.FldID = catid;
            obj.SESSIONUSERBACKEND = "InsertedBy";



            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "POMS_FAQALL";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var Categorylist = DBSP.call_DB_Procedure();
            Categorylist = Categorylist.data;

            populatecat();
            $('#EditCatModal').modal('hide');
            


        }
        function DeleteCat() {
        }
        function addCategory() {
            $('#AddCatModal').modal('show');
        }
        function editCategory() {
            var catid = $('#Ddl_Category').val();

            var obj = new Object();
            obj.Mode = 'ADMINCATGETBYID';
            obj.FldID = catid;



            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "POMS_FAQALL";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var Categorylist = DBSP.call_DB_Procedure();
            Categorylist = Categorylist.data;

            $('#editCattext').val(Categorylist[0].Category);

            if (Categorylist[0].IsActive == "True") {
                $('#editactivecat').prop('checked', true);
            }
            else {
                $('#editactivecat').prop('checked', false);

            }


            $('#EditCatModal').modal('show');
        }
        //Category CRUD End

        function getFAQ() {

            var obj = new Object();
            obj.Mode = 'GETFAQADMIN';
          


            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "POMS_FAQALL";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var FAQList = DBSP.call_DB_Procedure();
            var o = FAQList.data;

            $('#tblfaq').dataTable().fnDestroy();

            var ob = new Array();

            for (var a = 0; a < o.length; a++) {
                var lnk = '<i style="color: #7792a8;cursor:pointer;" title="Edit FAQ" onclick="editFaq(\'' + o[a].FldID + '\');" class="fa fa-pencil mrg5L"></i>';
               
                ob[a] = new Array();
                ob[a][0] = lnk;
                ob[a][1] = o[a].Category;
                ob[a][2] = o[a].Question;
                ob[a][3] = o[a].Answer;
                ob[a][4] = o[a].FldID;
              

                ob[a][5] = o[a].IsActive == 'True' ? 'Y' : 'N';

            }
           

            //$('#tblhistory')
            $('#tblfaq').dataTable({
                "processing": true,
                fixedHeader: true,
                "data": ob,
                //"autoWidth": false,
                "columns":
                  [
                  { "title": "ID" },

                    { "title": "Category" },
                    { "title": "Question", },
                     { "title": "Answer" },
                  { "title": "ID","class" : "displaynone" },
                  { "title": "Active?" }

                  ],

                "initComplete": function () {

                },
                "aoColumnDefs": [
                    { 'bSortable': false, 'aTargets': [0] }
                ]
            });


        }

        function saveFAQ() {
            

            var Question = $('#question_cat').val().trim();
            var Answer = tinyMCE.get('Answer').getContent();
            var Answer2 = $('#Answer').text();
            var Catid = $('#Ddl_Category').val();

            if (Question == '') {
                notify("Question can not be blank.");
                return;
            }

            if (Answer == '<div>&nbsp;</div>') {
                notify("Answer can not be blank.");
                return;
            }
           
            var obj = new Object();
            obj.Mode = 'SAVEFAQ';
            obj.CategoryID = Catid;
            obj.Question = Question;
            obj.Answer = Answer;
            obj.SESSIONUSERBACKEND = "InsertedBy";


            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "POMS_FAQALL";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var Categorylist = DBSP.call_DB_Procedure();
            getFAQ();
            $('#question_cat').val('');
            tinymce.get('Answer').setContent('');
        }

        function editFaq(id) {
           
            var obj = new Object();
            obj.Mode = 'GETFAQADMINBYID';
            obj.FldID = id;



            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "POMS_FAQALL";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var FAQList = DBSP.call_DB_Procedure();
            var o = FAQList.data;
            

            $('#EditFAQModal').modal('show');
            $('#editFAQID').val(o[0].FldID);
            $('#editFAQQuestion').val(o[0].Question);
            $('#Ddl_Category2').val(o[0].CategoryID);
            $('#Ddl_Category2').multiselect('refresh');
            //$('#editAnswer').val(o[0].Answer);
            tinymce.get('editAnswer').setContent(o[0].Answer);
            if (o[0].IsActive == 'True') {

                $('#editactivefaq').prop('checked', true);
            }
            else {
                $('#editactivefaq').prop('checked', false);

            }
           // $('#Ddl_Category2').val(o[a]).
        }

        function EditSaveFAQ() {

            var FldID = $('#editFAQID').val();
            var catid = $('#Ddl_Category2').val();
            var question = $('#editFAQQuestion').val();
            var answer = tinyMCE.get('editAnswer').getContent();
            var isActive = $('#editactivefaq').is(':checked') ? '1' : '0';

            var obj = new Object();
            obj.Mode = 'EDITFAQ';
            obj.FldID = FldID;
            obj.CategoryID = catid;
            obj.Question = question;
            obj.Answer = answer;
            obj.IsActive = isActive;



            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "POMS_FAQALL";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var FAQList = DBSP.call_DB_Procedure();
            var o = FAQList.data;
            $('#EditFAQModal').modal('hide');
            getFAQ();
        }
        
    </script>
