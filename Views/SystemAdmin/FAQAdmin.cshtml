<body>

    <!-- Modal -->
<div id="AddCatModal" class="modal fade" role="dialog">
  <div class="modal-dialog">

    <!-- Modal content-->
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">&times;</button>
        <h4 class="modal-title">Add Category</h4>
      </div>
      <div class="modal-body">
       <div class="row">
           <div class="col-sm-12">
               <label>Category Name</label>
               <input type="text" id="Cattext" class="form-control" />
           </div>
           <div class="col-sm-4">
               <label for="activecat">Active?</label>
               <input type="checkbox" id="activecat" checked />
           </div>
       </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" onclick="SaveCat();">Save</button>
      </div>
    </div>

  </div>
</div>


    <!-- Modal -->
<div id="EditCatModal" class="modal fade" role="dialog">
  <div class="modal-dialog">

    <!-- Modal content-->
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">&times;</button>
        <h4 class="modal-title">Edit Category</h4>
      </div>
      <div class="modal-body">
       <div class="row">
           <div class="col-sm-12">
               <label>Category Name</label>
               <input type="text" id="editCattext" class="form-control" />
           </div>
           <div class="col-sm-4">
               <label for="editactivecat">Active?</label>
               <input type="checkbox" id="editactivecat" checked />
           </div>
       </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" onclick="EditCat();">Edit</button>
      </div>
    </div>

  </div>
</div>


      <!-- Modal -->
<div id="EditFAQModal" class="modal fade" role="dialog">
  <div class="modal-dialog" style="width:70%;">

    <!-- Modal content-->
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">&times;</button>
        <h4 class="modal-title">Edit Category</h4>
      </div>
      <div class="modal-body">
       <div class="row">
           <input type="hidden" id="editFAQID" />
           <div class="col-sm-6">
               <label>Category Name</label>
               <select id="Ddl_Category2" class="form-control">
                        <option>1</option>
                        <option>1</option>
                        <option>1</option>
                    </select>
           </div>
           <div class="col-sm-6">
               <label>Question</label>
             <input type="text" id="editFAQQuestion" class="form-control" />
              
           </div>

           <div class="col-sm-12">
               <label>Answer</label>
              <textarea id="editAnswer"></textarea>
              
           </div>
           <div class="col-sm-4">
                <label for="editactivefaq">Active?</label>
               <input type="checkbox" id="editactivefaq" checked />
           </div>
       </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" onclick="EditSaveFAQ();">Edit</button>
      </div>
    </div>

  </div>
</div>






    <div class="container-fluid" id="angulardiv" ng-app="Project" ng-controller="PO">


        <div class="row mrg10B">
            <div class="col-sm-12">
                <h3 class="section-header" style="margin-top: -20px; margin-bottom: 0px;">Add/Edit FAQ</h3>
            </div>
        </div>

        <div class="row">

            <div class="col-sm-12">
                <div class="col-sm-4">
                    <label style="width:100%;">Select Category
                        <span style="float:right;">
                            <i style="color: #7792a8;cursor:pointer;" title="Add New Category" onclick="addCategory();" class="fa fa-plus"></i>
                            <i style="color: #7792a8;cursor:pointer;" title="Edit Selected Category" onclick="editCategory();" class="fa fa-pencil mrg5L"></i>

                        </span>
                    </label>
                    <select id="Ddl_Category" class="form-control">
                        <option>1</option>
                        <option>1</option>
                        <option>1</option>
                    </select>
                </div>

                <div class="col-sm-8">
                    <label>Type Question</label>
                    <input type="text" id="question_cat" class="form-control" />

                </div>
            </div>

            <div class="col-sm-12 mrg10T" >
                <label>Answer</label>
                <textarea id="Answer" class="form-control" ></textarea>
            </div>


        </div>



         <div class="float-panel-container">
        <ul>
            <li onclick="saveFAQ();" title="Save FAQ" ><a href="javascript:void(0);"><i class="fa fa-save mrg5R"data-toggle="tooltip"></i><span class="tooltip-toggle">Save FAQ</span></a></li>
          
        </ul>
    </div>
        <hr />

            <div class="col-sm-12 mrg10T">
                <h3 class="section-header" style="margin-top: -20px; margin-bottom: 0px;">FAQ List</h3>
            </div>


        <div class="col-sm-12 mrg10T">
             <table id="tblfaq">
            <thead>
                <tr>
                    <th></th>
                    <th>Category</th>
                    <th>Question</th>
                    <th>Answer</th>
                    <th>ID</th>
                    <th>Active?</th>
                </tr>
            </thead>
        </table>

        </div>


    </div>
</body>

