            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'SystemAdmin/SelectBankAccount';
            }


            $.ajax({
                type: "POST",
                url: url,
                success: function (data) {
                    data = JSON.parse(data);
                    var dt = "";
                    var lineitems = new Array();
                    dt = data.data;
                    for (i = 0; i < dt.length ; i++) {
                        lineitems[i] = new Array();
                        if (dt[i].IsActive == 'True') {
                            lineitems[i][0] = "<input type='button' value='Edit' data-enable='Active' onclick='EditBankAcccount(this," + dt[i].BankAccountID + ");'>"
                                          + "<input type='button' value='Deactive' data-id='Deactive' onclick='ActiveDeactiveBankAccount(this," + dt[i].BankAccountID + ");'>";


                        }
                        else {
                            lineitems[i][0] = "<input type='button' value='Edit' data-enable='Deactive' onclick='EditBankAcccount(this," + dt[i].BankAccountID + ");'>"
                                          + "<input type='button' value='Active' data-id='Active' onclick='ActiveDeactiveBankAccount(this," + dt[i].BankAccountID + ");'>";
                        }

                        lineitems[i][1] = dt[i].Bank_Account;
                        //lineitems[i][2] = dt[i].UOM_ID;
                    }

                    $('#tblBankAccount').dataTable().fnDestroy();
                    $('#tblBankAccount').dataTable({
                        "processing": true,
                        "data": lineitems,
                        "columns":
                          [
                            { "title": "Action"},
                            { "title": "Bank Account" }

                          ],
                        "bSort": false,
                        "aoColumnDefs": [
                            { "bSortable": false, "aTargets": [ 0 ] }
                        ]

                    });
                }
            });
        }

        function EditBankAcccount(obj, BankAccountID) {
            if($(obj).val()=='Edit')
            {
                var previous_bankAccount=$(obj).parent("td").parent("tr").find("td").eq("1").html();
                $(obj).parent("td").parent("tr").find("td").eq("1").empty();
                $(obj).parent("td").parent("tr").find("td").eq("1").html("<input id='txtEditBankAccount' type='text' data-id="+ BankAccountID+" value='" + previous_bankAccount + "'/>");
                $(obj).val('Update');
            }
            else
            {
                var current_bankAccount=$(obj).parent("td").parent("tr").find("td").eq("1").find("#txtEditBankAccount").val();
                //alert(current_bankAccount);
                if(current_bankAccount == '')
                {
                    errorfunc('txtEditBankAccount', 'Bank Account Cannot Be Empty.');
                    return;
                }
                else
                {
                    var url = '';
                    if (LOCALORSERVERNEW == 'LOCAL') {
                        url = 'http://www.thebridgebytcg.com/SystemAdmin/UpdateBankAccount';
                    }
                    else if (LOCALORSERVERNEW == 'SERVER') {
                        url = 'SystemAdmin/UpdateBankAccount';
                    }

                    var Active;

                    if ($(obj).attr("data-enable") == 'Active') {
                        Active = '1';

                    }
                    else {
                        Active='0';
                    }
                    $.ajax({
                        type: "POST",
                        url: url,
                        data: { 'BankAccount': current_bankAccount,'IsActive':Active,'ID':BankAccountID},
                        success: function (data) {
                            if (data == "Exists"){
                                notify('Bank Account Already Exists');
                            }
                            else{
                                notify('Bank Account Updated Successfully','green');
                                GetAllBankAccount();
                            }


                        }  // function block is closed
                    });
                }


            }

        }

        function ActiveDeactiveBankAccount(obj, BankAccountID) {
            //var current_bankAccount=$(obj).parent("td").parent("tr").find("td").eq("1").html();
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = 'http://www.thebridgebytcg.com/SystemAdmin/UpdateBankAccount';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'SystemAdmin/UpdateBankAccount';
            }

            var Active;

            if ($(obj).attr("data-id") == 'Active') {
                Active = '1';

            }
            else {
                Active='0';
            }
            $.ajax({
                type: "POST",
                url: url,
                data: { 'BankAccount': '','IsActive':Active,'ID':BankAccountID},
                success: function (data) {
                    if(Active =='1')
                    {
                        notify('Bank Account Activated Successfully','green');
                    }
                    else
                    {
                        notify('Bank Account Deactivated Successfully','green');
                    }

                    GetAllBankAccount();


                }  // function block is closed
            });

        }


    </script>


