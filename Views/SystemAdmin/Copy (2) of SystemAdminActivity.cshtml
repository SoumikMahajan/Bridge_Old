    @*------------------------------------------ Confirmation Dialog Box Code Start------------------------*@

    <script type="text/javascript">       

        function  fnOpenNormalDialog(CurrectStatus, obj, ID, url) {
            $("#dialog-confirm").html("Are you sure want to " + CurrectStatus + " ?");

            // Define the Dialog and its properties.
            $("#dialog-confirm").dialog({
                resizable: false,
                modal: true,
               // title: "Modal",
                height: 200,
                width: 340,                
                buttons: {
                    "Yes": function () {
                        $(this).dialog('close');
                        callback(true, obj, ID, url);
                    },
                    "No": function () {
                        $(this).dialog('close');                       
                    }
                }
            });
        }

        function callback(value,obj, ID, url) {
            if (value) {              
                ActivateDeactivate(obj, ID, url);
            } else {
                alert('Else Part');
            }
        }
        
     </script>
    
