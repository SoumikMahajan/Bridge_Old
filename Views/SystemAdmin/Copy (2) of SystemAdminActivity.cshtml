    <script type="text/javascript">

        $(function () {

            $('#btn_OpenPopUp1').click(function () {
                $('#txtUOM').val('');
                $('#popupUOM').bPopup({
                    easing: 'easeOutBack', //uses jQuery easing plugin
                    speed: 450,
                    transition: 'slideDown',
                    modalColor: 'rgb(18, 54, 65)'
                });
            });

            $('#btn_AddUOM').click(function () {
                var UOM = $('#txtUOM').val().trim();
                if (UOM == "") {
                    errorfunc('txtUOM', 'UOM cannot be empty.');
                    return false;
                }
                else {
                    if (confirm('Are you sure want to add UOM?')) {
                        var url = '';
                        if (LOCALORSERVERNEW == 'LOCAL') {
                            url = 'http://www.thebridgebytcg.com/SystemAdmin/addUOM';
                        }
                        else if (LOCALORSERVERNEW == 'SERVER') {
                            url = 'SystemAdmin/addUOM';
                        }
                        $.ajax({
                            type: "POST",
                            url: url,
                            data: { 'UOM': UOM },
                            success: function (data) {
                                if (data != "") {
                                    var row = "<tr role='row'>"
                                              + "<td class='sorting_1'>"
                                              + "<input type='button' value='Edit' onclick='EditUOM(this," + data + ");'>"
                                              + "<input type='button' value='Deactive' data-id='Deactivate' name='0' onclick='ActDeactUOM(this," + data + ");'>"
                                              + "</td>"
                                              + "<td>" + UOM + "</td>"
                                              //+ "<td>" + data + "</td>"
                                              + "</tr>";

                                    $('#tblUOM > tbody > tr:first').before(row);
                                    notify('UOM added Successfully','green');
                                    $('.b-close').trigger('click');
                                }
                                else {
                                    notify('Unable to add duplicate entry..');
                                }

                            }  // function block is closed
                        });
                    }
                }  // First else is closed... 


            });

        });

        function EditUOM(obj, UOMID) {
            var btnVal = $(obj).val();
            var UOMOldVal = $(obj).parent().parent().children().eq(1).text();
            if (btnVal == 'Edit') {
                $(obj).val('Update');
                $(obj).attr('Style', 'background-color: crimson;');
                $(obj).parent().parent().children().eq(1).html('<input type="text" class="getUOM" value="' + UOMOldVal + '" style="height: 25px;width: 500px;" />');
            }
            else if (btnVal == 'Update') {
                var UOMNew = $(obj).parent().parent().children().find(".getUOM").val().trim();
                if (UOMNew == "") {
                    alert('UOM cannot be Blank');
                    $(obj).parent().parent().children().find(".getUOM").val('');
                    $(obj).parent().parent().children().find(".getUOM").focus();                    
                    return false;
                }
                $(obj).attr('Style', 'background:#208093;');
                var url = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url = 'http://www.thebridgebytcg.com/SystemAdmin/UpdateUOM';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url = 'SystemAdmin/UpdateUOM';
                }
                $.ajax({
                    type: "POST",
                    url: url,
                    data: { 'UOM': UOMNew, 'UOMID': UOMID },
                    success: function (data) {
                        if (data != "") {
                            $(obj).val('Edit');
                            $(obj).parent().parent().children().eq(1).html(UOMNew);
                            notify('UOM is updated Successfully.....','green');
                        }
                        else {
                            $(obj).val('Edit');
                            $(obj).parent().parent().children().eq(1).html(UOMNew);
                            notify('You have not updated UOM......');
                        }
                    }
                });
            }
        }

        function ActDeactUOM(obj, UOMID) {
            var CurrectStatus = $(obj).attr("data-id"); 
            fnOpenNormalDialog(CurrectStatus, obj, UOMID, 'ActivateDeActivateUOM');
        }
        
        @*------------------------------ Global Function for All Activate Deacticate Start----------------------------*@

        function ActivateDeactivate(obj, ID, url) {               
                var Status = $(obj).attr("name");
                
              
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url = 'http://www.thebridgebytcg.com/SystemAdmin/'+url;
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url = 'SystemAdmin/' + url;
                }                

                $.ajax({
                    type: "POST",
                    url: url,
                    data: { 'ID': ID, 'Status': Status },
                    success: function (data) {
                        if (data != "") {
                            if (data == "Failed") {
                                notify('Make the UOM as not default before making it disabled.');
                            }
                            else {
                                if (Status == 0) {
                                    $(obj).val('Active');
                                    $(obj).attr('Style', 'background-color: crimson;width:96px;');
                                    $(obj).attr("data-id", 'Activate');
                                    $(obj).attr("name", '1');
                                }
                                else {
                                    $(obj).val('Deactive');
                                    $(obj).attr('Style', 'background: #208093;crimson;width:96px;');
                                    $(obj).attr("data-id", 'Deactivate');
                                    $(obj).attr("name", '0');
                                }
                                notify('Information updated successfully.....','green');
                            }
                                                     
                        }
                        else {
                            notify('Problem to Perform Operation.....');
                        }
                    }
                });
        }

        @*------------------------------ Global Function for All Activate Deacticate Closed----------------------------*@
        
    </script>

    <script type="text/javascript">

        $(document).ready(function () {
