            }
            $.ajax({
                type: "POST",
                url: url,
                data: { 'WantToDefault': WantToDefault, 'UOM_ID': UOM_ID },
                success: function (data) {
                    if (data != "") {
                        notify('Information updated successfully.....','green');

                    }
