                type: "POST",
                url: url,
                success: function (data) {
                    data = JSON.parse(data);
                    var dt = "";
                    var lineitems = new Array();
                    dt = data.data;
                    $('#tblUOM').dataTable().fnDestroy();
                    for (i = 0; i < dt.length ; i++) {
                        lineitems[i] = new Array();
                        if (dt[i].Status == 1) {
                            if (dt[i].IsDefault == 1) {
                                lineitems[i][0] = '<input type="button" value="Edit" onclick="EditUOM(this,\'' + dt[i].UOM_ID + '\');"><input type="button" value="Deactive" data-id="Deactivate" name="0"  onclick="ActDeactUOM(this,\'' + dt[i].UOM_ID + '\');"><input type="button" value="Cancel Default" data-id="remove it as Default" name="remove it as Default"  onclick="ActDeactDefault(0,this,\'' + dt[i].UOM_ID + '\');">';
                            }
                            else {
                                lineitems[i][0] = '<input type="button" value="Edit" onclick="EditUOM(this,\'' + dt[i].UOM_ID + '\');"><input type="button" value="Deactive" data-id="Deactivate" name="0"  onclick="ActDeactUOM(this,\'' + dt[i].UOM_ID + '\');"><input type="button" value="Make Default" data-id="make it Default" name="make it Default"  onclick="ActDeactDefault(1,this,\'' + dt[i].UOM_ID + '\');">';
                            }
                        }
                        else {
                            if (dt[i].IsDefault == 1) {
                                lineitems[i][0] = '<input type="button" value="Edit" onclick="EditUOM(this,\'' + dt[i].UOM_ID + '\');"><input type="button" value="Active" data-id="Activate" name="1" style="width:95px;background-color: crimson;" onclick="ActDeactUOM(this,\'' + dt[i].UOM_ID + '\');">';//<input type="button" value="Cancel Default" data-id="remove it as Default" name="remove it as Default"  onclick="ActDeactDefault(0,this,\'' + dt[i].UOM_ID + '\');">
                            }
                            else {
                                lineitems[i][0] = '<input type="button" value="Edit" onclick="EditUOM(this,\'' + dt[i].UOM_ID + '\');"><input type="button" value="Active" data-id="Activate" name="1" style="width:95px;background-color: crimson;" onclick="ActDeactUOM(this,\'' + dt[i].UOM_ID + '\');">';//<input type="button" value="Make Default" data-id="make it Default" name="make it Default"  onclick="ActDeactDefault(1,this,\'' + dt[i].UOM_ID + '\');">
                            }                            
                        }
                        lineitems[i][1] = dt[i].UOM;
                        //lineitems[i][2] = dt[i].UOM_ID;
                    }
                    $('#tblUOM').dataTable({
                        "processing": true,                       
                        "data": lineitems,
                        "columns":
                          [
                            { "title": "Action"},
                            { "title": "Unit Of Measurement" }
                           // { "title": "UOMID" }

                          ],
                        "initComplete": function () {
                        },
                        "columnDefs": [ { "targets": 0, "orderable": false } ]
                    });
                }
            });

        });

        function ActDeactDefault(WantToDefault,obj,UOM_ID)
        {
            $("#dialog-confirm").html("Do you sure want to " + $(obj).attr('data-id') + " ?");

            // Define the Dialog and its properties.
            $("#dialog-confirm").dialog({
                resizable: false,
                modal: true,
                // title: "Modal",
                height: 200,
                width: 340,
                buttons: {
                    "Yes": function () {
                        $(this).dialog('close');
                        ActivateDeactivateDefaultFinal(WantToDefault, obj, UOM_ID);
                    },
                    "No": function () {
                        $(this).dialog('close');
                    }
                }
            });


            

        }
        function ActivateDeactivateDefaultFinal(WantToDefault, obj, UOM_ID) {

            

            if (WantToDefault == 0) {
                //alert(WantToDefault);
                $(obj).val('Make Default');
                //$(obj).attr('Style', 'background: #208093;crimson;width:96px;');
                $(obj).attr("data-id", 'make it Default');
                $(obj).attr("name", 'make it Default');
                $(obj).prop("onclick", null);
                $(obj).click(function () {
                    ActDeactDefault(1, this, UOM_ID);
                });
                //$(document).ready(function () {
                //    $(obj).prop("onclick", null);
                //    $(obj).click(function () {
                //        ActDeactDefault(1, this, UOM_ID);
                //    });
                //});

                //$("h2").on("click", "p.test", function () {
                //    alert($(this).text());
                //});


                //$(obj).html('<input type="button" value="Make Default" data-id="make it Default" name="make it Default"  onclick="ActDeactDefault(1,this,\'' + UOM_ID + '\');">');
            }
            else {
                //alert(WantToDefault);
                $(obj).val('Cancel Default');
                //$(obj).attr('Style', 'background-color: crimson;width:96px;');
                $(obj).attr("data-id", 'remove it as Default');
                $(obj).attr("name", 'remove it as Default');
                $(obj).prop("onclick", null);
                $(obj).click(function () {
                    ActDeactDefault(0, this, UOM_ID);
                });
                //$(document).ready(function () {
                //    $(obj).prop("onclick", null);
                //    $(obj).click(function () {
                //         ActDeactDefault(0, this, UOM_ID);
                //    });
                //});

                //$(obj).html('<input type="button" value="Cancel Default" data-id="remove it as Default" name="remove it as Default"  onclick="ActDeactDefault(0,this,\'' + UOM_ID + '\');">');
            }


            var url = '';
