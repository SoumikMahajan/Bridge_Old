        <script type="text/javascript">

            $(document).ready(function () {
                var url = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url = 'http://www.thebridgebytcg.com/SystemAdmin/CheckInvoiveAddressExists';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url = 'SystemAdmin/CheckInvoiveAddressExists';
                }
                $.ajax({
                    type: "POST",
                    url: url,
                    data: {},
                    asyn: false,
                    success: function (data) {
                        if (data == "Exists") {
                            $('#btn_OpenInvoiceAddressPopUp').hide();
                        }
                        else {
                            $('#btn_OpenInvoiceAddressPopUp').show();
                        }

                    }  // function block is closed
                });
                GetInvoiceAddressData();
            });


            $(function () {

                $('#btn_OpenInvoiceAddressPopUp').click(function () {
                    $('#txtInvoiceAddress2').val('');
                    $('#popupInvoice').bPopup({
                        easing: 'easeOutBack', //uses jQuery easing plugin
                        speed: 450,
                        transition: 'slideDown',
                        modalColor: 'rgb(18, 54, 65)'
                    });
                });

                $('#btn_AddInvoiceAddress').click(function () {
                    var Address = $('#txtInvoiceAddress2').val().trim();
                    var CountryID = $('#Ddl_InvCountry').val();
                    var StateID = $('#Ddl_InvState').val();
                    var City = $('#txt_InvCity').val().trim();
                    var PostalCode = $('#txt_InvZipCode').val().trim();

                    if (Address == "") {
                        errorfunc('txtInvoiceAddress2', 'Invoice Address cannot be empty.');
                        return false;
                    }

                    else {
                        if (confirm('Are you sure want to add invoice address?')) {
                            var url = '';
                            if (LOCALORSERVERNEW == 'LOCAL') {
                                url = 'http://www.thebridgebytcg.com/SystemAdmin/InsertInvoiceAddress';
                            }
                            else if (LOCALORSERVERNEW == 'SERVER') {
                                url = 'SystemAdmin/InsertInvoiceAddress';
                            }
                            $.ajax({
                                type: "POST",
                                url: url,
                                data: { 'InvoiceAddress': Address, 'CountryID': CountryID, 'StateID': StateID, 'City': City, 'PostalCode': PostalCode },
                                success: function (data) {
                                    if (data == "Success") {
                                        AppendInvoiceAddress(Address, CountryID == "0" ? "" : $('#Ddl_InvCountry option:selected').text(), CountryID, StateID == "0" ? "" : $('#Ddl_InvState option:selected').text(), StateID, City, PostalCode);
                                        notify('Invoice Address added Successfully', 'green');
                                        $('.b-close').trigger('click');
                                        $('#btn_OpenInvoiceAddressPopUp').hide();
                                    }


                                }  // function block is closed
                            });
                        }
                        else {
                            return false;
                        }
                    }  // First else is closed...


                });

            });

            function GetInvoiceAddressData() {
                var url = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url = 'http://www.thebridgebytcg.com/SystemAdmin/SelectInvoiceAddress';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url = 'SystemAdmin/SelectInvoiceAddress';
                }

                $.ajax({
                    type: "POST",
                    url: url,
                    data: {},
                    success: function (data) {
                        if (data != "") {
                            var AllInvoiceAddress = data.split('^');

                            AppendInvoiceAddress(AllInvoiceAddress[0], AllInvoiceAddress[2], AllInvoiceAddress[1],
                                AllInvoiceAddress[4], AllInvoiceAddress[3], AllInvoiceAddress[5], AllInvoiceAddress[6]);
                        }


                    }  // function block is closed
                });

            }



            function AppendInvoiceAddress(address, Country, CounytyID, State, StateID, City, PostalCode) {

                var row = "<tr role='row' >"
                                                  + "<td class='sorting_1' >"
                                                  + "<input type='button' value='Edit' onclick='EditInvoiceAddress(this);' />"
                                                  + "</td>"
                                                  + "<td id='invoice_value'>" + address + "</td>"
                                                  + "<td id='invoice_country' data-id='" + CounytyID + "'>" + Country + "</td>"
                                                  + "<td id='invoice_state' data-id='" + StateID + "'>" + State + "</td>"
                                                  + "<td id='invoice_city'>" + City + "</td>"
                                                  + "<td id='invoice_postalcode'>" + PostalCode + "</td>"
                                                  //+ "<td>" + data + "</td>"
                                                  + "</tr>";

                $('#tblInvoiceAddress tbody').append(row);


            }

            function EditInvoiceAddress(obj) {

                var btnVal = $(obj).val();
                var OldInvoiceAddress = $(obj).parent().parent().find("#invoice_value").html();
                var OldInvoiceCountry = $(obj).parent().parent().find("#invoice_country").attr('data-id');
                var OldInvoiceState = $(obj).parent().parent().find("#invoice_state").attr('data-id');
                var OldInvoiceCity = $(obj).parent().parent().find("#invoice_city").html();
                var OldInvoicePostalCode = $(obj).parent().parent().find("#invoice_postalcode").html();

                if (btnVal == 'Edit') {
                    $(obj).val('Update');
                    $(obj).attr('Style', 'background-color: crimson;');

                    var $ddlCountry = $("#Ddl_InvCountry").clone();
                    $ddlCountry.prop("id", "ddl_CountryEdit1");
                    $ddlCountry.val(OldInvoiceCountry);
                    $(obj).parent().parent().children().eq(1).html('<textarea id="txtInvoiceAddress1" value="' + OldInvoiceAddress + '" cols="50" rows="5">' + OldInvoiceAddress + '</textarea>');
                    $(obj).parent().parent().children().eq(2).html($ddlCountry);

                    $(obj).parent().parent().children().eq(3).html('<select id="ddl_StateEdit1"></select>');
                    $(obj).parent().parent().children().eq(4).html('<input type="text" value="' + OldInvoiceCity + '" id="txtEditInvoiceCity" />');
                    $(obj).parent().parent().children().eq(5).html('<input type="text" value="' + OldInvoicePostalCode + '" id="txtEditInvoicePostalCode" />');
                    $ddlCountry.prop("name", "ddl_StateEdit1");
                    GetCtryIDForProject($("#ddl_CountryEdit1"));
                    $("#ddl_StateEdit1").val(OldInvoiceState);
                    //$(obj).parent().parent().children().eq(1).html('<select id="ddl_StateEdit1"> </select>');
                    //$(obj).parent().parent().children().eq(1).html('<textarea id="txtInvoiceAddress1" value="' + OldInvoiceAddress + '" cols="50" rows="5">' + OldInvoiceAddress + '</textarea>');
                    //$(obj).parent().parent().children().eq(1).html('<textarea id="txtInvoiceAddress1" value="' + OldInvoiceAddress + '" cols="50" rows="5">' + OldInvoiceAddress + '</textarea>');
                }
                else if (btnVal == 'Update') {
                    var NewInvoiceAddress = $(obj).parent().parent().children().find("#txtInvoiceAddress1").val().trim();
                    var NewInvoiceCountry = $(obj).parent().parent().children().find("#ddl_CountryEdit1").val();
                    var NewInvoiceState = $(obj).parent().parent().children().find("#ddl_StateEdit1").val();
                    var NewInvoiceCity = $(obj).parent().parent().children().find("#txtEditInvoiceCity").val().trim();
                    var NewInvoicePostalCode = $(obj).parent().parent().children().find("#txtEditInvoicePostalCode").val().trim();

                    if (NewInvoiceAddress == "") {
                        errorfunc('txtInvoiceAddress1', 'Invoice Address cannot be empty.');
                        $(obj).parent().parent().children().find("#txtInvoiceAddress1").val('');
                        $(obj).parent().parent().children().find("#txtInvoiceAddress1").focus();
                        return false;
                    }

                    $(obj).attr('Style', 'background:#208093;');
                    var url = '';
                    if (LOCALORSERVERNEW == 'LOCAL') {
                        url = 'http://www.thebridgebytcg.com/SystemAdmin/UpdateInvoiceAddress';
                    }
                    else if (LOCALORSERVERNEW == 'SERVER') {
                        url = 'SystemAdmin/UpdateInvoiceAddress';
                    }
                    $.ajax({
                        type: "POST",
                        url: url,
                        data: { 'InvoiceAddress': NewInvoiceAddress, 'CountryID': NewInvoiceCountry, 'StateID': NewInvoiceState, 'City': NewInvoiceCity, 'PostalCode': NewInvoicePostalCode },
                        success: function (data) {
                            if (data == "Success") {
                                $(obj).val('Edit');
                                //$(obj).parent().parent().children().eq(1).html(NewInvoiceAddress);
                                notify('Invoice Address is updated Successfully.....','green');
                                $('#btn_OpenInvoiceAddressPopUp').hide();
                                irrrrr = 0;
                                window.location.reload();

                            }

                        }
                    });
                }
            }

            function GetCtryIDForProject(obj) {

                var StateBindID = $(obj).attr("name");

                var Cnrty = $(obj).find('option:selected').attr("name").split("_")[1];

                var url = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url = 'http://www.thebridgebytcg.com/adduser/getAllStateByCntryID';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url = 'adduser/getAllStateByCntryID';
                }

                $.ajax({
                    type: "POST",
                    url: url,
                    data: { 'CountryID': Cnrty },
                    success: function (data) {
                        if (data != null) {
                            $('#' + StateBindID).html(data);
                        }
                        else {

                        }
                    },
                    async: false
                });

            }

    </script>



