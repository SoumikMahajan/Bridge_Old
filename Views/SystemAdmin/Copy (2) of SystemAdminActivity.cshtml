    <script type="text/javascript">

        $(function () {
            GetInvoiceTerms();
            $('#btn_OpenInvoiceTermsPopUp').click(function () {
                $('#txtInvoiceTerms').val('');
                $("#lstInvoiceTermsStatus").val('1');
                $('#popupInvoiceTerms').bPopup({
                    easing: 'easeOutBack', //uses jQuery easing plugin
                    speed: 450,
                    transition: 'slideDown',
                    modalColor: 'rgb(18, 54, 65)'
                });
            });

            $("#btn_AddInvoiceTerms").click(function () {

                if ($("#txtInvoiceTerms").val() == '') {
                    errorfunc('txtInvoiceTerms', 'Invoice Terms cannot be empty.');
                    return false;
                }

                var url = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url = 'http://www.thebridgebytcg.com/SystemAdmin/TermsManagement';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url = 'SystemAdmin/TermsManagement';
                }

                var termsObj =
                    { ID: '', Term: $("#txtInvoiceTerms").val(), Status: $("#lstInvoiceTermsStatus").val() == '1' ? true : false, Mode: 'INSERTVENDORTERMS' };
                $.ajax({
                    type: "POST",
                    url: url,
                    data: termsObj,
                    asyn: false,
                    success: function (data) {
                        if (data == "EXISTS") {
                            notify('Invoice term exists!!!', 'RED');
                        }
                        else {
                            notify('Invoice term inserted successfully!!!', 'GREEN');
                        }
                        window.setTimeout(function () {
                            window.location.reload();
                        }, 2000);
                    }
                });

            });

        });

        $("#btn_EditInvoiceTerms").click(function () {

            if ($("#txtInvoiceTerms1").val() == '') {
                errorfunc('txtInvoiceTerms1', 'Invoice Terms cannot be empty.');
                return false;
            }

            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = 'http://www.thebridgebytcg.com/SystemAdmin/TermsManagement';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'SystemAdmin/TermsManagement';
            }

            var termsObj =
                { ID: $("#editInvoiceTermID").val(), Term: $("#txtInvoiceTerms1").val(), Status: $("#lstInvoiceTermsStatus1").val() == '1' ? true : false, Mode: 'UPDATEVENDORTERMS' };
            $.ajax({
                type: "POST",
                url: url,
                data: termsObj,
                asyn: false,
                success: function (data) {
                    if (data == "EXISTS") {
                        notify('Invoice term exists!!!', 'RED');
                    }
                    else {
                        notify('Invoice term updated successfully!!!', 'GREEN');
                    }
                    window.setTimeout(function () {
                        window.location.reload();
                    }, 2000);
                }
            });

        });



        function EditInvoiceTerms(obj) {
            var editID = $(obj).parent().parent().attr('data-rowid');
            $("#editInvoiceTermID").val(editID);

            $("#tblInvoiceTerms tbody tr").each(function (index, item) {

                if ($(this).attr('data-rowid') == editID) {
                    $("#txtInvoiceTerms1").val($(this).find('td:eq(1)').html());
                    $("#lstInvoiceTermsStatus1").val($(this).find('td:eq(2)').attr('data-flag'));
                }
            });

            $('#popupInvoiceTerms1').bPopup({
                easing: 'easeOutBack', //uses jQuery easing plugin
                speed: 450,
                transition: 'slideDown',
                modalColor: 'rgb(18, 54, 65)'
            });

        }
        function GetInvoiceTerms() {

            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = 'http://www.thebridgebytcg.com/SystemAdmin/GetTerms';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'SystemAdmin/GetTerms';
            }
            $.ajax({
                type: "GET",
                url: url,
                data: { 'mode': 'GETVENDORTERMS' },
                asyn: false,
                success: function (data) {
                    var termsObj = JSON.parse(data);

                    if (termsObj.length > 0) {
                        var html = '';

                        for (var i = 0; i < termsObj.length; i++) {
                            var flagString = '';
                            if (termsObj[i].Status == '1')
                                flagString = "<td data-flag='1'>" + '<i class="fa fa-check-circle" aria-hidden="true"></i>' + "</td>";
                            else
                                flagString = "<td data-flag='0'> " + '<i class="fa fa-times-circle" aria-hidden="true"></i>' + "</td>";

                            var row = "<tr role='row' data-rowid='" + termsObj[i].ID + "'>"
                                                  + "<td class='sorting_1' >"
                                                  + "<input type='button' value='Edit' onclick='EditInvoiceTerms(this);'/>"
                                                  + "</td>"
                                                  + "<td>" + termsObj[i].Term + "</td>"
                                                  + flagString +
                                                  + "</tr>";


                            $('#tblInvoiceTerms tbody').append(row);
                        }
                    }
                }
            });
        }



    </script>


