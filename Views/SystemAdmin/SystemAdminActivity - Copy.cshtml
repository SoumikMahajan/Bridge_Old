    <script>
        $(document).ready(function () {

            for (var a = 1; a <= 100; a++) {
                $('#ddl_maxfilesize').append("<option value='" + a + "'>" + a + " MB</option>");
            }

        var obj = new Object();
        obj.Mode = 'GET';
        obj.Size = $('#ddl_maxfilesize').val();


        var DBSP = new DB_SP_CONNECT();
        DBSP.ProcedureName = "POMS_MaxFileSize_Proc";
        DBSP.obj = obj;
        DBSP.isasync = false;
        var o1 = DBSP.call_DB_Procedure();
        o1 = o1.data;
        $('#ddl_maxfilesize').val(o1[0].Filesize);

        });

        function changemaxfilesize() {
            var obj = new Object();
            obj.Mode = 'UPDATE';
            obj.Size = $('#ddl_maxfilesize').val();


            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "POMS_MaxFileSize_Proc";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var o1 = DBSP.call_DB_Procedure();
            o1 = o1.data;
            notify("Updated MAX File Size that can be uploaded","GREEN");
        }

    </script>
