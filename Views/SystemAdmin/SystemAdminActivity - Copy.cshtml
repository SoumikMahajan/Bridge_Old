                        + "<th  rowspan='1' colspan='1' class='displaynone'></th>"
                        + "<th  rowspan='1' colspan='1'><input class='srch' data-indx='2' type='text'  style='padding: 2px 2%;    width: 100%;font-family:Arial, FontAwesome' placeholder=' &#xF002;'></th>"
                        + "</tr>";
                        $('#ProjectContactTypes').on('draw.dt', function () {
                            RowHtmlRender();
                        });
                        $('#ProjectContactTypes thead').append(html);
                        var table = $('#ProjectContactTypes').DataTable();
                        $('.srch').on('keyup change', function () {
                            var indx = $(this).attr('data-indx');
                            var txt = this.value;
                            table
                                   .column(indx)
                                   .search(txt)
                                   .draw();
                            RowHtmlRender();
                        });
                    });
            });
        }
        function RowHtmlRender() {
            $('#ProjectContactTypes tbody tr').find("td:eq(0)").each(function () {
                var pid = $(this).next().html(); // $(this).html(); //$(this).prev("td").html(); //
                var html = '';
                //html = '<input type="button" onclick="EditProjectType(this,\'' + pid + '\');" style="margin-bottom:6px;" data-id="' + pid + '" value="Edit" />';
                html = '<i  onclick="EditProjectType(this,\'' + pid + '\');" class="fa fa-pencil-square-o" data-id="' + pid + '" value="Edit"></i>';

                $(this).html(html);
            });
        }
        function ResetSearch() {
            var table = $('#ProjectContactTypes').DataTable();
            $('.srch').each(function () {
                this.value = '';
                var indx = $(this).attr('data-indx');
                var txt = this.value;
                table
                       .column(indx)
                       .search(txt)
                       .draw();
            });
            RowHtmlRender();
