    <script type="text/javascript">
        function IsNumber(e) {
            var keyCode = e.which ? e.which : e.keyCode
            if ((keyCode > 47 && keyCode < 58) || (keyCode == 8)) {
                return true;
            }
            else {
                alert('Use Only Numeric value');
                return false;
            }
        }
