                if($(this).attr('data-currencycode') == previous_curr)
                {

                    $(dropdown).val($(this).attr('value'));
                }

            });

            $('#txtacntnameedt').val(previous_bankAccount);
            $('#txtdescedt').val(previous_desc);

            $('#edtacntstatus').val($(obj).next('i').attr('name'));



            $('#divforcurredt').find('#ddlEditCurr').remove();

