        function opennow(obj){
            $(obj).after('<i class="fa fa-spinner fa-spin" aria-hidden="true"></i>');

            var urlw = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                urlw = '/Quickbook/AuthenticationAsync?connect=true';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                urlw = '/Quickbook/AuthenticationAsync?connect=true';
            }



            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Quickbook/checkValidityAsync';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = '/Quickbook/checkValidityAsync';
            }
            $.ajax({
                type: "POST",
                url: url,
                data: { },
                success: function (data) {
                    if (data != "INVALID") {
                        var c = confirm("There is an active connection for \"" + data.split("***")[0] + "\" set on " + data.split("***")[1] + ". Do you still want to Authenticate?");
                        $(obj).next('i').remove();
                        if(c){
                            myWindow = window.open(urlw,"","width=500,height=600");
                        }
                    }
                    else {
                        $(obj).next('i').remove();
                        myWindow = window.open(urlw,"","width=500,height=600");
                    }

                }  // function block is closed
            });



        }

        function checknow(obj){


            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Quickbook/checkValidityAsync';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = '/Quickbook/checkValidityAsync';
            }
            $.ajax({
                type: "POST",
                url: url,
                data: { },
                success: function (data) {
                    if (data != "INVALID") {
                        notify("There is an active connection for \"" + data.split("***")[0] + "\" set on " + data.split("***")[1] + ".","green");

                    }
                    else {
                        notify("There is no active connection.");
                    }

                }  // function block is closed
            });



        }

