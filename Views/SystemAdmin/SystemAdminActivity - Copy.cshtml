            $("#dialog-confirm").html("Do you sure want to " + $(obj).attr('data-id') + " ?");

            // Define the Dialog and its properties.
            $("#dialog-confirm").dialog({
                resizable: false,
                modal: true,
                // title: "Modal",
                height: 200,
                width: 340,
                buttons: {
                    "Yes": function () {
                        $(this).dialog('close');
                        ActivateDeactivateDefaultFinal(WantToDefault, obj, UOM_ID);
                    },
                    "No": function () {
                        $(this).dialog('close');
                    }
                }
            });




        }
        function ActivateDeactivateDefaultFinal(WantToDefault, obj, UOM_ID) {



