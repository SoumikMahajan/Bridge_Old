                    }
                    $('#tblUOM').dataTable({
                        "processing": true,                       
                        "data": lineitems,
                        "columns":
                          [
                            { "title": "Action"},
                            { "title": "Unit Of Measurement" }
                           // { "title": "UOMID" }

                          ],
                        "initComplete": function () {
                        },
                        "columnDefs": [ { "targets": 0, "orderable": false } ]
                    });
                }
            });

        });

        function ActDeactDefault(WantToDefault,obj,UOM_ID)
