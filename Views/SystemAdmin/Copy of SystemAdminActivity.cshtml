    <script type="text/javascript">
        function IsNumber(e) {
            var keyCode = e.which ? e.which : e.keyCode
            if ((keyCode > 47 && keyCode < 58) || (keyCode == 8)) {
                return true;
            }
            else {
                alert('Use Only Numeric value');
                return false;
            }
        }
        $(function () {

            $(document).ready(function () {
                var url = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url = 'http://www.thebridgebytcg.com/SystemAdmin/CheckSessionTimeExists';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url = 'SystemAdmin/CheckSessionTimeExists';
                }
                $.ajax({
                    type: "POST",
                    url: url,
                    data: {},
                    asyn: false,
                    success: function (data) {
                        if (data == "Exists") {
                            $('#btn_OpenSessionPopUp').hide();
                        }
                        else {
                            $('#btn_OpenSessionPopUp').show();
                        }

                    }  // function block is closed
                });

                GetSessionData();
            });

            $('#btn_OpenSessionPopUp').click(function () {
                $('#txtSession').val('');
                $('#popupSession').bPopup({
                    easing: 'easeOutBack', //uses jQuery easing plugin
                    speed: 450,
                    transition: 'slideDown',
                    modalColor: 'rgb(18, 54, 65)'
                });
            });

            $('#btn_AddSession').click(function () {
                var Session = $('#txtSession').val().trim();
                if (Session == "") {
                    errorfunc('txtSession', 'Session Time cannot be empty.');
                    return false;
                }
                if (Session == "0") {
                    errorfunc('txtSession', 'Session Time cannot be zero.');
                    $('#txtSession').val('');
                    $("#txtSession").focus();
                    return false;
                }
                else {
                    if (confirm('Are you sure want to add session time?')) {
                        var url = '';
                        if (LOCALORSERVERNEW == 'LOCAL') {
                            url = 'http://www.thebridgebytcg.com/SystemAdmin/InsertSessionTime';
                        }
                        else if (LOCALORSERVERNEW == 'SERVER') {
                            url = 'SystemAdmin/InsertSessionTime';
                        }
                        $.ajax({
                            type: "POST",
                            url: url,
                            data: { 'time': Session },
                            success: function (data) {
                                if (data == "Success") {
                                    AppendSesstion(Session);
                                    notify('Sesstion added Successfully');
                                    $('.b-close').trigger('click');
                                    $('#btn_OpenSessionPopUp').hide();
                                }


                            }  // function block is closed
                        });
                    }
                }  // First else is closed...


            });

        });

        function GetSessionData() {
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = 'http://www.thebridgebytcg.com/SystemAdmin/SelectSessionTime';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'SystemAdmin/SelectSessionTime';
            }

            $.ajax({
                type: "POST",
                url: url,
                data: {},
                success: function (data) {
                    if (data != "") {
                        AppendSesstion(data);
                    }


                }  // function block is closed
            });

        }

        function AppendSesstion(Session) {

            var row = "<tr role='row' >"
                                              + "<td class='sorting_1' >"
                                              + "<input type='button' value='Edit' onclick='EditSession(this);' />"
                                              + "</td>"
                                              + "<td id='session_value'>" + Session + "</td>"
                                              //+ "<td>" + data + "</td>"
                                              + "</tr>";

            $('#tblSession tbody').append(row);
        }

        function EditSession(obj) {

            var btnVal = $(obj).val();
            var OldSessionValue = $(obj).parent().parent().find("#session_value").html();
            if (btnVal == 'Edit') {
                $(obj).val('Update');
                $(obj).attr('Style', 'background-color: crimson;');
                $(obj).parent().parent().children().eq(1).html('<input type="text" id="txtSession1" value="' + OldSessionValue + '" onkeypress="return IsNumber(event);" style="height: 25px;width: 500px;" />');
            }
            else if (btnVal == 'Update') {
                var NewSessionValue = $(obj).parent().parent().children().find("#txtSession1").val().trim();
                if (NewSessionValue == "") {
                    errorfunc('txtSession1', 'Session Time cannot be empty.');
                    $(obj).parent().parent().children().find("#txtSession1").val('');
                    $(obj).parent().parent().children().find("#txtSession1").focus();
                    return false;
                }
                if (NewSessionValue == "0") {
                    $(obj).parent().parent().children().find("#txtSession1").val('');
                    $(obj).parent().parent().children().find("#txtSession1").focus();
                    errorfunc('txtSession1', 'Session Time cannot be zero.');
                    return false;
                }
                $(obj).attr('Style', 'background:#208093;');
                var url = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url = 'http://www.thebridgebytcg.com/SystemAdmin/UpdateSessionTime';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url = 'SystemAdmin/UpdateSessionTime';
                }
                $.ajax({
                    type: "POST",
                    url: url,
                    data: { 'time': NewSessionValue },
                    success: function (data) {
                        if (data == "Success") {
                            $(obj).val('Edit');
                            $(obj).parent().parent().children().eq(1).html(NewSessionValue);
                            notify('Session time is updated Successfully.....');
                        }

                    }
                });
            }
        }



    </script>

