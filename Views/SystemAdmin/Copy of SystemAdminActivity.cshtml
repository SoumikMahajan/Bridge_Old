                                lineitems[i][0] = '<input type="button" value="Edit" onclick="EditUOM(this,\'' + dt[i].UOM_ID + '\');"><input type="button" value="Deactive" data-id="Deactivate" name="0"  onclick="ActDeactUOM(this,\'' + dt[i].UOM_ID + '\');"><input type="button" value="Make Default" data-id="make it Default" name="make it Default"  onclick="ActDeactDefault(1,this,\'' + dt[i].UOM_ID + '\');">';
