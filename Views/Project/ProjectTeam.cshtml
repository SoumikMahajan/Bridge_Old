        function checkforusersOnexistingLvl(obj) {
            if($(obj).is(':checked')){
                $.ajax({
                    url: '@Url.Content("~/Project/CheckForExistingUserPerLevel")',
                    method: 'POST',
                    data: '{"Fldid":"' + $(obj).attr('data-userid') + '", "Levelid":"' + $(obj).attr("data-levelid") + '"}',
                    contentType: 'application/json;charset=utf-8',
                    dataType: 'json',
                    success: function (response) {
                        if (response !== undefined && response.mesg.split('%')[0] === 'failed') {
                            $(obj).removeAttr('checked');
                            alert(response.mesg.split('%')[1]);
                        }
                        else {
                            $(obj).attr('checked');
                            $('.editpolevelapprovers').trigger('click');
                        }
                    }, error: function (d) {
                        console.error(d.message);
                    }
                });
            }else{
                $(obj).removeAttr('checked');
                $('.editpolevelapprovers').trigger('click');
            }
        }


        function deleteApproverLevel(element,levelID){
            var ans = confirm("Do you want to delete?");
            if(ans==true){
                var obj = new Object();
                obj.LevelID = levelID;
                obj.SESSIONUSERBACKEND = 'UserID';
                obj.Mode = 'DeleteLevel';

                var DBSP = new DB_SP_CONNECT();
                DBSP.ProcedureName = "POMS_POApprovalLevelProc";
                DBSP.obj = obj;
                DBSP.isasync = false;
                var o = DBSP.call_DB_Procedure();
                o = o.data;
                //console.log(o);
                $(element).parent().parent().remove();
            }
        }



        function chcktotalapproversdata() {
            debugger;
            //var req = $('#RqrdPOApprvrsPerLevel').val();
            var req = 0;
            $('.levelheader').each(function (){
                var level = $(this).attr('data-levelid');
                var tota = 0;
                var DBSP;
                var obj;

                $('.lev' + level).each(function (){
                    if ($(this).find('p input').is(':checked')){
                        tota++;
                    }
                });
                obj = new Object();
                obj.ProjectID = $('#projectid').val();
                obj.LevelID = level;
                obj.SESSIONUSERBACKEND = 'UserID';
                obj.Mode = 'GETREQUIREDAPPROVERS';

                var DBSP = new DB_SP_CONNECT();
                DBSP.ProcedureName = "POMS_POApprovalLevelProc";
                DBSP.obj = obj;
                DBSP.isasync = false;
                var o = DBSP.call_DB_Procedure();
                o = o.data;
                req = o[0].NumOfUserToAprv_POITEMS;
                $('#ReqApprvDropdown_'.concat(level)).val(req);

                $(this).append(' ('+ tota +'/'+ req+')');
                if (tota < req) {
                    $(this).css('background', '#eda7b1');
                }
            });
        }

        function addnewlevel() {
            var c = confirm("Are you sure you want to add a new level approvers?");

            if (c) {
                var reqApprv = 1; //prompt('Enter required level')

                if (reqApprv !== null) {

                    if (/^[0-9]*$/g.test($.trim(reqApprv)) === false) {
                        alert('Only numbers are permitted.');
                        return false;
                    }
                    else if (Number($.trim(reqApprv)) < 1) {
                        alert('Number of required approvers cannot be less than 1.');
                        return false;
                    } else {
                        var result = CheckForassignedusercount($.trim(reqApprv));
                        if (result.split('%')[0] === 'failed') {
                            alert(result.split('%')[1]);
                            return false;
                        } else {

                            var resp = checkforPOapprovals();
                            if (resp.split('|')[0] === 'success') {
                                var obj = new Object();
                                obj.ProjectID = $('#projectid').val();
                                obj.SESSIONUSERBACKEND = 'UserID';
                                obj.LevelID = Number(reqApprv);

                                obj.Mode = 'ADDLEVEL';
                                var DBSP = new DB_SP_CONNECT();
                                DBSP.ProcedureName = "POMS_POApprovalLevelProc";
                                DBSP.obj = obj;
                                DBSP.isasync = false;
                                var o = DBSP.call_DB_Procedure();
                                o = o.data;

                                poapprovallevelset();
                                notify('New approval level added.', 'green');

                            } else {
                                alert(resp.split('|')[1]);
                            }
                        }
                    }
                } else {
                    return;
                }
            } else {
                return;
            }
            //var resp = checkforPOapprovals();
            //if(resp.split('|')[0] === 'success'){
            //    var c = confirm("Are you sure you want to add a new level approvers?");
            //    if(c){
            //        var obj = new Object();
