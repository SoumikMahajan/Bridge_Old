        function savefabpathname() { //save fab approval path name
            debugger;
            var fabnameID = '';
            var flag = false;
            var fabapprovalpathname = $('#fabapprovalpathname').val().trim();
            var ApprovalPathID = $('#fabpathid').val();
            var pathnameval = $('#selectTo option').toArray().map(item => item.value);

            if (fabapprovalpathname == "" || fabapprovalpathname == null) {
                notify("Please Enter Fabrication Path Name");
                flag = true;
                return;
            }

            var duplicatefabpathname = DuplicateFabricationName(fabapprovalpathname);

            if (document.getElementById("fabpathid").value == 0) {
                if (duplicatefabpathname != "0") {
                    notify("This Fabrication Path Name Already Exists!");
                    flag = true;
                    return;
                }
            }

            var check = duplicatedgroupCheck('.demogrpname');

            if (check === false) {
                return;
            }

            if (pathnameval == "" || pathnameval == null) {
                notify("Please Assign Group");
                flag = true;
                return;
            }

            var obj = new Object();
            obj.ProjectID = $('#projectid').val();
            obj.ApprovalPathName = fabapprovalpathname;
            obj.ApprovalPathID = ApprovalPathID;
            obj.Mode = 'SaveFabPathName';

            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "POMS_POApprovalLevelProc";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var o = DBSP.call_DB_Procedure();
            o = o.data;
            fabnameID = o[0].FldID;
            if (flag == false) {
                if (ApprovalPathID !== 'undefined' && ApprovalPathID !== null && ApprovalPathID !== '') {
                    deletegroupname(ApprovalPathID);
                }
                fab_editgrppath(fabnameID);
                document.getElementById("fabpathid").value = "";
            }

            //console.log(fabnameID);
        }



