                + "<th>Security Item</th>"
                + "<th>Assigned</th>"
                + "</tr>";
            ////console.log(response.data);

            var html = "";

            html += passhtml;

            html += "<tr><td><label style='padding:0px;width:100%;' for='prioritychk_" + securityid + "'>" + name + "</label></td>";
            if (isactive == "1") {
                html += '<td><input  type="checkbox" class="chkScrty edtScrty" value="1" id="prioritychk_' + securityid + '" checked></td></tr>';
