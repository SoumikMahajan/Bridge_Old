        function clicknew() {


            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Project/getProjectTeamDetails';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Project/getProjectTeamDetails';
            }

            var projectid = $('#projectid').val();
            url1 += "?projectid=" + projectid;


            $.ajax({
                url: url1,
                async: false,
                type: "POST",
                dataType: "JSON",
                contentType: "application/json; charset=utf-8",
                data: {},
                failed: function (error) {
                    alert("failed");
                },
                success: function (response) {

                    var data = response.data;
                    teamdetails = data;

                    for (var i = 0; i < teamdetails.length; i++) {
                        if (teamdetails[i].Usertype == "Manager") {
                            $('#manager_ddl').val(teamdetails[i].UserID);
                        }
                        else {
                            var uid = teamdetails[i].UserID;
                            $("#manager_ddl option[value='" + uid + "']").remove();
                        }
                    }

                    //console.log(teamdetails);


                }
            });


            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Project/getAllProjectTeammembersNew';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Project/getAllProjectTeammembersNew';
            }

            var projectid = $('#projectid').val();
            url1 += "?projectid=" + projectid;





            $.ajax({
                url: url1,
                type: "POST",
                dataType: "JSON",
                contentType: "application/json; charset=utf-8",
                data: {},
                failed: function (error) {
                    alert("failed");
                },
                success: function (response) {
                    var project;

                    var poapprovers = 0;
                    var budgetapprovers = 0;
                    var poitemapprovers = 0;

                    totdata = response;
                    totdata = totdata.data;
                    //console.log(totdata);
                    projectteam = [];
                    for (i = 0; i < totdata.length; i++) {
                        projectteam[i] = new Array();
                        projectteam[i][1] = totdata[i].Username;
                        projectteam[i][2] = totdata[i].TeammemberID;
                        projectteam[i][3] = totdata[i].SystemUserID;
                        projectteam[i][4] = totdata[i].Email;
                        projectteam[i][5] = totdata[i].ProjectusertypeID;
                        projectteam[i][6] = totdata[i].UsertypeName;
                        projectteam[i][7] = totdata[i].Security;



                        for (var k = 0; k < teamdetails.length; k++) {

                            if (teamdetails[k].UserID == totdata[i].SystemUserID && teamdetails[k].Usertype != "Manager") {

                                if (teamdetails[k].POApprover == "1") {

                                    if (projectteam[i][5] != '3') {
                                        poapprovers++;
                                    }

                                    projectteam[i][8] = '<i style="cursor:pointer;" class="fa fa-check" data-userid="' + totdata[i].TeammemberID + '" onclick="POApprover(this,0);"></i>';
                                }
                                else {
                                    projectteam[i][8] = '<i style="cursor:pointer;" class="fa fa-times" data-userid="' + totdata[i].TeammemberID + '" onclick="POApprover(this,1);"></i>';
                                }
                                //projectteam[i][6] = teamdetails[k].POApprover;
                                if (teamdetails[k].BudgetApprover == "1") {

                                    if (projectteam[i][5] != '3') {
                                        budgetapprovers++;
                                    }

                                    projectteam[i][9] = '<i style="cursor:pointer;" class="fa fa-check" data-userid="' + totdata[i].TeammemberID + '" onclick="BudgetApprover(this,0);"></i>';
                                }
                                else {
                                    projectteam[i][9] = '<i style="cursor:pointer;" class="fa fa-times" data-userid="' + totdata[i].TeammemberID + '" onclick="BudgetApprover(this,1);"></i>';
                                }
                                //projectteam[i][7] = teamdetails[k].BudgetApprover;
                                if (teamdetails[k].POItemApprover == "1") {
                                    if (projectteam[i][5] != '3') {
                                        poitemapprovers++;
                                    }
                                    projectteam[i][10] = '<i style="cursor:pointer;" class="fa fa-check" data-userid="' + totdata[i].SystemUserID + '" onclick="POItemApprover(this,0);"></i>';
                                }
                                else {
                                    projectteam[i][10] = '<i style="cursor:pointer;" class="fa fa-times" data-userid="' + totdata[i].SystemUserID + '" onclick="POItemApprover(this,1);"></i>';
                                }
                                //projectteam[i][8] = teamdetails[k].POItemApprover;
                                break;
                            }

                            else {
                                projectteam[i][8] = '';
                                projectteam[i][9] = '';
                                projectteam[i][10] = '';
                            }

                        }

                        var teammemberid = totdata[i].TeammemberID;
                        if (projectteam[i][6] != 'Manager') {
                            var html = '<i style="cursor:pointer; font-size: 17px;" onclick="EditProjectMember(this,\'' + teammemberid + '\');" class="fa fa-pencil" data-id="' + teammemberid + '"></i>';// '<input type="button" class="buttonedit"  onclick="EditProjectMember(this,\'' + teammemberid + '\');" style="margin-bottom:6px;" data-id="' + teammemberid + '" />';
                            html += '<i style="cursor:pointer; font-size: 17px;" class="fa fa-trash mrg10L" data-id="' + teammemberid + '" onclick="DeleteProjectMember(this,\'' + teammemberid + '\');" ></i>';//<input type="button" class="buttondelete"   style="margin-bottom:6px;" data-id="' + teammemberid + '" />';
                        }
                        else {
                            var html = '';
                        }

                        projectteam[i][0] = html;

                    }

                    $('#POApprvrs').text(poapprovers);
                    $('#BgtApprvrs').text(budgetapprovers);
                    $('#POItemApprvrs').text(poitemapprovers);

                    if (parseInt($('#RqrdPOItemApprvrs_ddl').val()) > parseInt(poitemapprovers)) {

                        $('#POItemApprvrs').parent().parent().css('background', '#e7c3c3');
                    }

                    if (parseInt($('#RqrdBgtApprvrs_ddl').val()) > parseInt(budgetapprovers)) {

                        $('#BgtApprvrs').parent().parent().css('background', '#e7c3c3');
                    }

                    if (parseInt($('#RqrdPOApprvrs_ddl').val()) > parseInt(poapprovers)) {

                        $('#POApprvrs').parent().parent().css('background', '#e7c3c3');
                    }



                    // var poitemapprovers = 0;

                    $('#projectteam').dataTable().fnDestroy();
                    // //console.log(projectteam);
                    $('#projectteam').dataTable({
                        "processing": true,
                        "data": projectteam,
                        "columns": [
                            { "title": "Action", "class": "leftposition" },
                            { "title": "User name", "class": "leftposition" },
                            { "title": "TeammemberID", "class": "displaynone" },
                            { "title": "SystemUserID", "class": "displaynone" },
                            { "title": "Email", "class": "leftposition" },

                            { "title": "ProjectusertypeID", "class": "displaynone" },
                            { "title": "User Type Name", "class": "leftposition" },
                            { "title": "Security", "class": "displaynone" },
                            { "title": "PO", "class": "leftposition" },
                            { "title": "Budget", "class": "leftposition" },
                            { "title": "Fabrication", "class": "leftposition" }


                        ]
                        ,

                        "initComplete": function () {

                            //var o = $('#projectteam_filter label').find('input');
                            //$(o).attr('placeholder', '&#xF002;');
                            //$(o).addClass('awesome');
                            //setTimeout(function () {
                            //    $('#projectteam_filter label').html($(o)[0].outerHTML);
                            //}, 5000);


                            ////console.log(o);


                            var neededpoapprovers = $('#RqrdPOApprvrs_ddl').val();
                            var neededbudgetapprovers = $('#RqrdBgtApprvrs_ddl').val();
                            var neededpoitemapprovers = $('#RqrdPOItemApprvrs_ddl').val();

                            if ($('#projectteam thead tr').length == 1) {

                                $('#projectteam thead tr:eq(0)').find('th:eq(8)').append('(' + poapprovers + '/' + 1 + ')');
                                $('#projectteam thead tr:eq(0)').find('th:eq(9)').append('(' + budgetapprovers + '/' + neededbudgetapprovers + ')');
                                //$('#projectteam thead tr:eq(0)').find('th:eq(10)').append('(' + poitemapprovers + '/' + neededpoitemapprovers + ')');
                                $('#projectteam thead tr:eq(0)').find('th:eq(10)').append('(' + poitemapprovers + '/' + 1 + ')');
                            }
                            else {

                                $('#projectteam thead tr:eq(1)').find('th:eq(8)').append('(' + poapprovers + '/' + 1 + ')');
                                $('#projectteam thead tr:eq(1)').find('th:eq(9)').append('(' + budgetapprovers + '/' + neededbudgetapprovers + ')');
                                //$('#projectteam thead tr:eq(1)').find('th:eq(10)').append('(' + poitemapprovers + '/' + neededpoitemapprovers + ')');
                                $('#projectteam thead tr:eq(1)').find('th:eq(10)').append('(' + poitemapprovers + '/' + 1 + ')');

                            }
                            RowHtmlRender();

                            if ($('#projectteam thead tr').length == 1) {
                                var rowheadhtml = '<tr><th style="width:10%; border:none;"></th>'
                                    + '<th style="width:18%;border:none;"></th>'
                                    + '<th style="width:18%;border:none;"></th>'
                                    + '<th style="width:18%;border:none;"></th>'

                                    + '<th style="width:18%;text-align:center !important;" colspan="3">Approvers</th></tr>';

                                $('#projectteam thead').prepend(rowheadhtml);
                            }


                        },
                        "aoColumnDefs": [
                            { 'bSortable': false, 'aTargets': [0, 6] }
                        ],
                        "order": [[1, "asc"]]
                    });
                    var html = "";


                    var table = $('#projectteam').DataTable();
                    $('.srch').on('keyup change', function () {
                        var indx = $(this).attr('data-indx');
                        var txt = this.value;
                        table
                            .column(indx)
                            .search(txt)
                            .draw();
                        RowHtmlRender();
                    });
                }
            });








        }



