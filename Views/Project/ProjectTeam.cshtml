    <script type="text/javascript">

        function changeManager() {
            var ProjectID = $('#projectid').val();
            var UserID = $('#manager_ddl').val();

            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Project/changeManager';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Project/changeManager';
            }

            $.ajax({
                url: url1,
                async: false,
                type: "POST",
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                data: "{ 'ProjectID' : '" + ProjectID + "','UserID' : '" + UserID + "'}",
                failed: function (error) {
                    alert("failed");
                },
                success: function (response) {
                    if (response == 'SUCCESS') {
                        notify("Updated successfully", 'green');
                    }
                    else {
                        notify("Error!!!");

                        window.location.reload();
                    }
                }
            });

        }

        function changenumberstoapprovebudget(obj) {
            var Number = $(obj).val();
            var ProjectID = $('#projectid').val();

            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Project/changeBudgetApprovernumber';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Project/changeBudgetApprovernumber';
            }

            $.ajax({
                url: url1,
                async: false,
                type: "POST",
