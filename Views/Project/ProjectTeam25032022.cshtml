        function CheckForassignedusercount(ReqFld) {
            var obj = new Object();
            obj.ProjectID = $('#projectid').val();
            obj.Mode = 'CHECKFORUNASSIGNEDUSER';
            obj.LevelID = Number(ReqFld);

            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "[dbo].[POMS_POApprovalLevelProc]";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var o = DBSP.call_DB_Procedure();
            return o.data[0]['resp'];
        }

        function checkforPOapprovals(){
            var obj = new Object();
            obj.ProjectID = $('#projectid').val();
            obj.Mode = 'CHECKFORAPPROVALMEMBER';

            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "POMS_POApprovalLevelProc";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var o = DBSP.call_DB_Procedure();
            return (o.data[0]['']);
        }


        function updateModalApproversLevelOnClose() {
            var incLvlCnt = 0;
            $('#lvlprt').each(function (){
                incLvlCnt++;
            });
            return incLvlCnt;
        }

        function checkforactivecheckboxes(){
            var req = $('#RqrdPOApprvrsPerLevel').val();
            var lvCnt = 0;
            $('#poapprovalleveldiv #lvlPart').each(function(){
                lvCnt++;
            });

            var isCheckedCnt = 0;
            $('#lvlPart:has(.levelpo) input[type="checkbox"]').each(function(){
                if($(this).is(':checked')){
                    isCheckedCnt++;         
                }
            }); 

            return (isCheckedCnt / lvCnt) !== Number(req) ? false : true;
        }
        
        function editpolevelapprovers(){
            //if(checkforactivecheckboxes() === true) {
                var l = '';
                var str = '';

                $('.levelpo').find('p input').each(function () {
                    var levelid = $(this).parent().parent().attr('data-levelid');
                    var userid = $(this).parent().parent().attr('data-userid');
                    if(l == '' || l != levelid) {
                        str += str == '' ? levelid + '^' : '$' + levelid + '^';
                    }
                    if($(this).is(':checked')) {
                        str += '^' + userid;
                    }
                    l = levelid;
                });

                notify('Saving data...','yellow-load');
                setTimeout(function (){
                    for(var i = 0; i < str.split('$').length; i++){
                        var str2 = str.split('$')[i];
                        var levelid = str2.split('^^')[0];
                        var userids = str2.split('^^')[1];

                        levelid = levelid.replace('^','');

                        var obj = new Object();
                        obj.ProjectID = $('#projectid').val();
                        obj.LevelID = levelid;
                        obj.SESSIONUSERBACKEND = 'UserID';
                        obj.UserIDs = userids;
                        obj.Mode = 'EDITUSERSLEVEL';

                        var DBSP = new DB_SP_CONNECT();
                        DBSP.ProcedureName = "POMS_POApprovalLevelProc";
                        DBSP.obj = obj;
                        DBSP.isasync = false;
                        var o = DBSP.call_DB_Procedure();
                        o = o.data;

                        notify('Saved successfully.', 'GREEN');
                    }
                    poapprovallevelset();

                }, 200);
            //}
            //else {
            //    alert('Levels do not match required number of approvers');
            //}
        }



