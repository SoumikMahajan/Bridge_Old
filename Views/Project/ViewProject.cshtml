<script type="text/javascript">
    $(document).ready(function () {
        clicknew();
        $('.paginate_button').live('click', function () {
            RowHtmlRender();
        });
    });
    function clicknew() {
        $(document).ready(function () {
            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Project/GetProjectContactDetailJSON';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Project/GetProjectContactDetailJSON';
            }
            var pid = $('#ProjectID').val();

            if (pid == '') {
                return;
            }

            url1 += "?ProjectContactID=" + pid;
            var totdata;
            $.get(url1)
                .success(function (response) {
                    var project;
                    totdata = JSON.parse(response);
                    // //console.log(totdata);
                    var project = new Array();
                    for (i = 0; i < totdata.length ; i++) {
                        project[i] = new Array();
                        project[i][0] = totdata[i].ProjectContact_ID;// Convert.ToString(dr["ProjectContact_ID"]);
                        project[i][1] = "";
                        project[i][2] = totdata[i].ContactName;// Convert.ToString(dr["ContactName"]);
                        project[i][3] = totdata[i].Address;// Convert.ToString(dr["Address"]);
                        project[i][4] = totdata[i].City;// Convert.ToString(dr["City"]);
                        project[i][5] = totdata[i].State;// Convert.ToString(dr["State"]);
                        project[i][6] = totdata[i].Country;// Convert.ToString(dr["Country"]);
                        project[i][7] = totdata[i].Telephone;// Convert.ToString(dr["Telephone"]);
                        project[i][8] = totdata[i].MobilePhone;// Convert.ToString(dr["MobilePhone"]);
                        project[i][9] = totdata[i].Fax;// Convert.ToString(dr["Fax"]);
                        project[i][10] = totdata[i].Email;// Convert.ToString(dr["Email"]);
                        project[i][11] = totdata[i].DateCreate;// Convert.ToString(dr["DateCreate"]);
                        project[i][12] = totdata[i].ContactType_ID;// Convert.ToString(dr["ContactType_ID"]);
                        project[i][13] = totdata[i].ProjectID;// Convert.ToString(dr["ProjectID"]);
                        project[i][14] = totdata[i].Status;// Convert.ToString(dr["Status"]);
                    }
                    $('#projectcontacts').dataTable({
                        "processing": true,
                        "data": project,
                        "columns": [
                            { "title": "ProjectContact_ID", "class": "displaynone" },
                            { "title": "Action" },
                            { "title": "ContactName" },
                            { "title": "Address" },
                            { "title": "City" },
                            { "title": "State" },
                            { "title": "Country" },
                            { "title": "Telephone" },
                            { "title": "MobilePhone" },
                            { "title": "Fax" },
                            { "title": "Email" },
                            { "title": "DateCreate", "class": "displaynone" },
                            { "title": "ContactType" },
                            { "title": "ProjectID", "class": "displaynone" },
                            { "title": "Status", "class": "displaynone" }
                        ]
                        ,
                        "initComplete": function () {
                            RowHtmlRender();
                        },
                        "aoColumnDefs": [
                            { 'bSortable': false, 'aTargets': [0, 1] }
                        ]
                    });
                    var html = "";

                    //$('#projectcontacts tfoot th').each(function () {
                    //    var title = $('#example thead th').eq($(this).index()).text();
                    //    $(this).html('<input type="text" placeholder="Search ' + title + '" />');
                    //});

                    html = "<tr>"
                    + "<th  rowspan='1' colspan='1'><input type='button' value='Reset' onclick='ResetSearch();' style='margin-bottom:6px;' /></th>"
                    + "<th  rowspan='1' colspan='1'><input class='srch' data-indx='2' type='text' placeholder='Search '></th>"
                    + "<th  rowspan='1' colspan='1'><input class='srch' data-indx='3' type='text' placeholder='Search '></th>"
                    + "<th  rowspan='1' colspan='1'><input class='srch' data-indx='4' type='text' placeholder='Search '></th>"
                    + "<th rowspan='1' colspan='1'><input class='srch' data-indx='5'  type='text' placeholder='Search '></th>"
                    + "<th rowspan='1' colspan='1'><input class='srch' data-indx='6'  type='text' placeholder='Search '></th>"
                    + "<th rowspan='1' colspan='1'><input class='srch' data-indx='7'  type='text' placeholder='Search '></th>"
                    + "<th rowspan='1' colspan='1'><input class='srch' data-indx='8'  type='text' placeholder='Search '></th>"
                    + "<th rowspan='1' colspan='1'><input class='srch' data-indx='9'  type='text' placeholder='Search '></th>"
                    + "<th rowspan='1' colspan='1'><input class='srch' data-indx='10'  type='text' placeholder='Search '></th>"
                    + "<th rowspan='1' colspan='1'><input class='srch' data-indx='11'  type='text' placeholder='Search '></th>"

                    + "</tr>";

                    // $('#projectcontacts').find("tr:eq(1)").find("th:eq(1)").html("<a><input type='button' value='Reset' onclick='ResetContactSearch();' style='margin-bottom:6px;' /></a>");
                    //

                    $('#projectcontacts').on('draw.dt', function () {

                        RowHtmlRender();
                    });
                    $('#projectcontacts thead').append(html);
                    var table = $('#projectcontacts').DataTable();
                    $('.srch').on('keyup change', function () {
                        var indx = $(this).attr('data-indx');
                        var txt = this.value;
                        table
                               .column(indx)
                               .search(txt)
                               .draw();
                        RowHtmlRender();
                    });
                });


        });
    }
    function RowHtmlRender() {
        // $('#project thead tr').find("th:eq(1)").html('Action').removeClass('sorting_asc');
        $('#projectcontacts_filter').css('display', 'none');
        $('#projectcontacts tbody tr').find("td:eq(1)").each(function () {
            var pid = $(this).prev("td").html();
            //var zz = $(this).html();
            var html = '';
            var isseletcted = $('#Isselected').val();
            if (isseletcted != "0") {
                //html = '<input type="button" value="" onclick="EditProjectContact(this,\'' + pid + '\');" style="margin-bottom:6px;" data-id="' + pid + '" class="buttonedit" />';
                //html += '<input type="button" value="" onclick="DeleteProjectContact(this,\'' + pid + '\');" style="margin-bottom:6px;" data-id="' + pid + '" class="buttondelete" />';
                html = "N/A";
                $(this).html(html);
            }
        });



    }
    function ResetSearch() {

        var table = $('#projectcontacts').DataTable();
        $('.srch').each(function () {
            this.value = '';
            var indx = $(this).attr('data-indx');
            var txt = this.value;
            table
                   .column(indx)
                   .search(txt)
                   .draw();
        });

        RowHtmlRender();

    }
    $(function () {
        $('select[name="projectcontacts_length"]').live('change', function () {
            RowHtmlRender();
        });
    });
    function EditProjectContact(obj, pid) {
        var prid = $('#ProjectID').val();
        var url1 = '';
        if (LOCALORSERVERNEW == 'LOCAL') {
            url1 = '/Project/EditProjectContact/' + pid;
        }
        else if (LOCALORSERVERNEW == 'SERVER') {
            url1 = '/Project/EditProjectContact/' + pid;
        }
        window.location.href = url1 + "?Projectid=" + prid;
    }


    function DeleteProjectContact(obj, pid) {
        var rw = $(obj).parent().parent();
        // //console.log(rw);
        var url1 = '';
        if (LOCALORSERVERNEW == 'LOCAL') {
            url1 = '/Project/DeleteProjectContact';
        }
        else if (LOCALORSERVERNEW == 'SERVER') {
            url1 = 'Project/DeleteProjectContact';
        }


        $.ajax({
            type: "POST",
            url: url1,
            async: false,
            dataType: "text",
            contentType: "application/json; charset=utf-8",
            data: "{ 'ProjectID' : '" + pid + "'}",
            success: function (data) {
                if (data == 'SUCCESS') {
                    var table = $('#projectcontacts').DataTable();
                    table
                    .row(rw)
                    .remove()
                    .draw();
                    RowHtmlRender();
                }
            },
            error: function () {
                alert('Something went wrong.');
            }
        });



    }



</script>
