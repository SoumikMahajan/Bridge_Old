    <script type="text/javascript">
        var allcomments;
        var projectcomments;

    </script>

    <script type="text/javascript">

        $(function () {


            $('input').attr('readonly', 'readonly');
            $('textarea').attr('readonly', 'readonly');
            $('input[type="button"]').remove();
            $('select').attr("disabled", true);
            $('#fileupload_Edt').attr("disabled", true);
            $('#fileupload_Edt3').attr("disabled", true);
            $('#fileupload_Edt2').attr("disabled", true);
            $('.fileinput-button').hide();
            // $("#Ddl_Clftion").multiselect();
            loadprojectcomments();
            //loadallcomments();



        });

        function loadallcomments() {
            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Project/getAllcomments';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Project/getAllcomments';
            }
            var pid = $('#ProjectID').val();

            if (pid == '') {
                return;
            }




            $.ajax({
                type: "POST",
                url: url1,
                async: false,
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                data: "{ 'projectID' : '" + '' + "'}",
                success: function (response) {
                    ////console.log(response);
                    response = JSON.parse(response);
                    allcomments = response.data;

                    createallcommentslist();

                },
                error: function () {
                    alert('Something went wrong.');
                }
            });
        }
        function loadprojectcomments() {
            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Project/getAllcommentsproject';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Project/getAllcommentsproject';
            }
            var pid = $('#ProjectID').val();

            if (pid == '') {
                return;
            }

            $.ajax({
                type: "POST",
                url: url1,
                async: false,
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                data: "{ 'projectID' : '" + pid + "'}",
                async: false,
                success: function (response) {
                    // //console.log(response);
                    response = JSON.parse(response);
                    response = projectcomments = response.data;

                    var html = "";
                    var Commentid = "";
                    var Comment = "";
                    var Createddate = "";

                    for (var i = 0; i < response.length; i++) {
                        Commentid = response[i].Commentid;
                        Comment = response[i].Comment;
                        Createddate = response[i].Createddate;
                        html += "<span class='remove' data-id='" + Commentid + "' ><span>" + Comment + " ( " + Createddate + " )" + "</span></span>";
                    }

                    $('#ProjectComments').html(html);

                },
                error: function () {
                    alert('Something went wrong.');
                }
            });
        }

        function createallcommentslist() {
            var html = "";
            var Commentid = "";
            var Comment = "";
            var Createddate = "";
            var isactive = 1;


            for (var i = 0; i < allcomments.length; i++) {
                isactive = 1;
                Commentid = allcomments[i].Commentid;
                Comment = allcomments[i].Comment;
                Createddate = allcomments[i].Createddate;

                for (var a = 0; a < projectcomments.length; a++) {


                    if (projectcomments[a].Commentid == allcomments[i].Commentid) {
                        isactive = 0;
                    }

                }

                if (isactive == 1) {
                    html += "<option value='" + Commentid + "'>" + Comment + "</option>";
                }
                else {
                    html += "<option disabled value='" + Commentid + "'>" + Comment + "</option>";

                }
            }

            $("#Ddl_Clftion").html("");


            $("#Ddl_Clftion").html(html);



            //.multiselectfilter({ label: "Search" });


            $("#Ddl_Clftion").multiselect("refresh").multiselectfilter();

            $('.ui-multiselect-menu').css('width', '450px');
            $('.ui-multiselect').css('width', '450px');


        }


        function deleteprojectcomment(obj, commentid) {
            // $(obj).parent().remove();

            var isconfirmed = confirm("Do you really want to delete?");
            if (!isconfirmed) {
                return;
            }

            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Project/deleteprojectcomment';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Project/deleteprojectcomment';
            }
            var pid = $('#ProjectID').val();

            if (pid == '') {
                return;
            }

            $.ajax({
                type: "POST",
                url: url1,
                async: false,
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                data: "{ 'projectID' : '" + pid + "','commentID':'" + commentid + "'}",
                async: false,
                success: function (response) {
                    $(obj).parent().remove();

                    loadprojectcomments();
                    loadallcomments();
                },
                error: function () {
                    alert('Something went wrong.');
                }
            });




            //alert(commentid);
        }

        function addcommentnew() {
            var comment = $('#newcomment').val().trim();

            var pid = $('#ProjectID').val();

            if (pid == '') {
                return;
            }
            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Project/addnewComment';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Project/addnewComment';
            }
            $.ajax({
                type: "POST",
                url: url1,
                async: false,
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                data: "{ 'projectID' : '" + pid + "','comment' : '" + comment + "'}",
                success: function (data) {



                    if (data == 'SUCCESS') {
                        $('#newcomment').val('');
                        loadprojectcomments();
                        loadallcomments();

                    }

                    else {
                        alert("Comment not inserted as duplicate exists...");
                        $('#newcomment').focus();
                    }





                },
                error: function () {
                    alert('Something went wrong.');
                }
            });




        }

        function addcomment() {


            var commentids = $('#Ddl_Clftion').val();

            if (commentids == null || commentids == "") {
                alert("Please select comments!!!");
                return;
            }
            // $('#Ddl_Clftion').addAttr('disabled');




            var pid = $('#ProjectID').val();

            if (pid == '') {
                return;
            }
            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Project/addcomments';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Project/addcomments';
            }
            $.ajax({
                type: "POST",
                url: url1,
                async: false,
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                data: "{ 'projectID' : '" + pid + "','commentids' : '" + commentids + "'}",
                success: function (data) {
                    loadprojectcomments();
                    loadallcomments();
                },
                error: function () {
                    alert('Something went wrong.');
                }
            });


        }
    </script>
