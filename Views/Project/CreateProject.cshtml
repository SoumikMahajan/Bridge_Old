<script type="text/javascript">
    function delobject1(val, obj) {
        delete filedata[val];
        $(obj).parent().remove();
    }
    function delobject2(val, obj) {
        delete filedata2[val];
        $(obj).parent().remove();
    }
    function delobject3(val, obj) {
        delete filedata3[val];
        $(obj).parent().remove();
    }

    function uploadfiles(projectid, mode) {
        //projectid = 1;
        //mode = "TC";
        var formData = new FormData();
        if (mode == "TC") {
            for (var key in filedata2) {
                formData.append(key, filedata2[key]);
            }
        }
        else if (mode == "PF") {
            for (var key in filedata) {
                formData.append(key, filedata[key]);
            }
        }
        else if (mode == "ISF") {
            for (var key in filedata3) {
                formData.append(key, filedata3[key]);
            }
        }
        var url1 = '';
        if (LOCALORSERVERNEW == 'LOCAL') {
            url1 = '/UploadFile/Upload';
        }
        else if (LOCALORSERVERNEW == 'SERVER') {
            url1 = 'UploadFile/Upload';
        }
        url1 += "?projectid=" + projectid + "&mode=" + mode;
        $.ajax({
            type: "POST",
            url: url1,
            data: formData,
            //async:false,
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                // alert('success!!');
            },
            error: function (error) {
                //alert("errror");
            }
        });
    }
</script>
