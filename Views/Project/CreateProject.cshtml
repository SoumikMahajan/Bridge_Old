<link href="~/css/jquery.dataTables.min.css" rel="stylesheet" />
<script src="~/Scripts/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/plug-ins/1.10.10/api/fnFilterClear.js"></script>
<script type="text/javascript">

    var vendorco = new Array();
    var vendorcocount = 0;
    $(document).ready(function () {
        var ddlVendorClassification;
        var urltemp = '';

        bindVendorClassification();
        getVenderDetails();

        $('.b-close').click(function () {
            var table = $('#vendorlist').dataTable();
            table.fnFilterClear();
            $("#Ddl_Vendor_Clftion").multiselect("uncheckAll");



        });



    });

    function checkPrevCheckVendor(Vendor_ID) {

        if (vendorcocount != 0) {
            for (i = 0; i < vendorcocount; i++) {
                if (vendorco[i] == Vendor_ID) {
                    return true;
                }
            }
            return false;
        }
        else {
            return false;
        }
    }

    function getVenderDetails() {
        if (LOCALORSERVERNEW == 'LOCAL') {
            urltemp = '/Project/getVendors';
        }
        else if (LOCALORSERVERNEW == 'SERVER') {

            urltemp = 'Project/getVendors';
        }
        var totdata;
        var vendors = new Array();
        $.get(urltemp)

            .success(function (response) {
                totdata = JSON.parse(response);
                totdata = totdata.data;

                for (i = 0; i < totdata.length ; i++) {
                    vendors[i] = new Array();
                    var id = totdata[i].Vendor_ID;

                    if (checkPrevCheckVendor(totdata[i].Vendor_ID))

                        vendors[i][0] = '<input type="checkbox" name="vendor" value="' + totdata[i].Vendor_ID + '" data-index="' + totdata[i].Vendor_ID + '" class="chkVendor" onclick=addVendor(this); checked="true">';
                    else
                        vendors[i][0] = '<input type="checkbox" name="vendor" value="' + totdata[i].Vendor_ID + '" data-index="' + totdata[i].Vendor_ID + '" class="chkVendor" onclick=addVendor(this);>';

                    vendors[i][1] = totdata[i].ParentVendorName;
                    vendors[i][2] = totdata[i].ContactFirstname + ' ' + totdata[i].ContactLastname;
                    vendors[i][3] = deletespaces(totdata[i].Classifications);
                    vendors[i][4] = totdata[i].Currency;
                    vendors[i][5] = totdata[i].City;
                    vendors[i][6] = totdata[i].State;
                    vendors[i][7] = totdata[i].CurrCode;
                }

                //$('#vendorlist').not("tr:first").remove();

                $('#vendorlist').dataTable({
                    "data": vendors,
                    "paging": true,
                    "columns": [
                        { "title": "Actions" },
                        { "title": "Vendor" },
                        { "title": "Contact Name" },
                        { "title": "Vendor Category" },
                        { "title": "Currency" },
                        { "title": "City" },
                        { "title": "State/Prov" },
                        { "title": "Currcode", "class": "displaynone" }


                    ],
                    //"lengthMenu": [[ 10, 50, -1], [ 10, 50, "All"]],
                    "initComplete": function () {

                        //var ddl = "<select><option>1</option><option>2</option></select>";
                        var html = "";
                        html = "<tr>"
                            + "<th><span onclick='resetsrch();' style='cursor:pointer;'><i class='fa fa-undo'></i></span></th>"
                            + "<th rowspan='1' colspan='1'><input class='srch' type='text' data-indx='1' placeholder='Search Vendor'></th>"
                            + "<th rowspan='1' colspan='1'><input class='srch' type='text' data-indx='2' placeholder='Search Contact Name'></th>"
                            //+ "<th rowspan='1' colspan='1'><input class='srch' type='text' data-indx='3' placeholder='Search Vendor Category'></th>"
                            + "<th rowspan='1' colspan='1'>" + ddlVendorClassification + "</th>"
                            + "<th rowspan='1' colspan='1'><input class='srch' type='text' data-indx='4' placeholder='Search Currency'></th>"
                            + "<th rowspan='1' colspan='1'><input class='srch' type='text' data-indx='5' placeholder='Search City'></th>"
                            + "<th rowspan='1' colspan='1'><input class='srch' type='text' data-indx='6' placeholder='Search State/Prov'></th>";
                        $('#vendorlist thead').append(html);


                        $("#Ddl_Vendor_Clftion").multiselect().multiselectfilter();

                        $("#Ddl_Vendor_Clftion").multiselect({
                            close: function () {
                                var clsearch = $('#Ddl_Vendor_Clftion').val();
                                if (clsearch == null)
                                    clsearch = '';
                                var srchtxt = '';
                                var tmp = clsearch;

                                for (var i = 0; i < tmp.length; i++) {
                                    var id = tmp[i];
                                    for (var a = 0; a < classarray.length ; a++) {
                                        if (classarray[a].classid == id) {
                                            if (srchtxt == '') {
                                                srchtxt += deletespaces(classarray[a].classname);
                                            }
                                            else {
                                                srchtxt += '|' + deletespaces(classarray[a].classname);
                                            }
                                        }
                                    }
                                }
                                var table = $('#vendorlist').DataTable();
                                table.column(3).search(srchtxt, true).draw();

                            }
                        });
                        var table = $('#vendorlist').DataTable();
                        // table.column(2).search("fname|ff", true).draw();
                        $('.srch').on('keyup change', function () {
                            var indx = $(this).attr('data-indx');
                            var txt = this.value;
                            table
                                   .column(indx)
                                   .search(txt)
                                   .draw();
                            //RowHtmlRender();
                        });
                        $('#vendorlist_filter').remove();
                        $('#vendorlist_length').remove();
                    },
                    "pagingType": "full_numbers",
                    "aoColumnDefs": [
                        { 'bSortable': false, 'aTargets': [0] }
                    ]
                });


            });

    }




    function bindVendorClassification() {
        var urltemp = '';
        if (LOCALORSERVERNEW == 'LOCAL') {
            urltemp = '/Project/getClassification';
        }
        else if (LOCALORSERVERNEW == 'SERVER') {
            urltemp = 'Project/getClassification';
        }
        $.ajax({
            type: "POST",
            url: urltemp,
            async: false,
            data: {},
            success: function (data) {

                ddlVendorClassification = "<select id='Ddl_Vendor_Clftion' multiple='multiple'>"
                data = JSON.parse(data);
                ////console.log(data);

                classarray = data.data;

                for (var a = 0; a < classarray.length ; a++) {

                    //ddlfrcllsfictn += "<opiton>" + 'test' + "</option>";
                    ddlVendorClassification += "<option text='" + classarray[a].classname + "' value='" + classarray[a].classid + "'>" + deletespaces(classarray[a].classname) + "</option>";
                }

                ddlVendorClassification += "</select>";
                //alert(ddlfrcllsfictn);

            },
            error: function () { notify('Something went wrong'); }
        });
    }

    function deletespaces(str) {
        var newstr = '';
        for (var i = 0; i < str.length; i++) {
            if (str[i] != ' ') {
                newstr += str[i];
            }
        }
        return newstr;

    }

    function addVendor(obj) {

        if ($(obj).is(":checked")) {

            vendorco[vendorcocount] = $(obj).val();

            vendorcocount++;
        }
        else {
            for (i = 0; i < vendorcocount; i++) {
                if (vendorco[i] == $(obj).val()) {
                    vendorco[i] = "-1";
                }
            }
        }


    }

    function saveVendorCODetails(mode, project_code) {
        if (LOCALORSERVERNEW == 'LOCAL') {
            urltemp = '/Project/SaveVendorCODetails';
        }
        else if (LOCALORSERVERNEW == 'SERVER') {

            urltemp = 'Project/SaveVendorCODetails';
        }
        //alert(mode);
        if (mode == "SaveProjectDetail") {
            $.ajax({
                type: "POST",
                url: urltemp,
                async: false,
                data: { 'vedor_details': JSON.stringify(vendorco), 'project_id': project_code },
                success: function (data) {


                },
                error: function () { notify('Something went wrong'); }
            });
        }
    }
</script>

