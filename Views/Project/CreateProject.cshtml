    <script type="text/javascript">
       
        $(function () {

            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Project/getAllPurchaseOrderComments';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                //url1 = urlsuffix + "/" + 'Project/getAllProjectList';
                url1 = 'Project/getAllPurchaseOrderComments';
            }

            // alert(url1);
            var totdata;
            $.get(url1)
                .success(function (response) {


                    var project;
                    totdata = JSON.parse(response).data;
                    //console.log(totdata);
                    var project = new Array();
                    for (i = 0; i < totdata.length ; i++) {
                        project[i] = new Array();
                        // project[i][0] = '<input type="button" class="buttonedit btnhover" onclick="GetThisComment(this);" style="margin-bottom:6px;" />';
                        project[i][0] = '<i class="fa fa-hand-o-right" style="cursor:pointer;" title="Select this Comment" onclick="GetThisComment(this);" aria-hidden="true"></i>';

                        project[i][1] = totdata[i].ProjectNumber;
                        project[i][2] = totdata[i].ProjectName;
                        project[i][3] = unescape(totdata[i].Comment); //totdata[i].Comment;
                    }
                    //console.log(project);
                    $('#POLists').dataTable({
                        "processing": true,
                        "data": project,
                        "columns": [
                            { "title": "" },
                            { "title": "Project Number" },
                            { "title": "Project Name" },
                            { "title": "Comment" }
                        ]
                        ,
                        "initComplete": function () {
                            //RowHtmlRender();

                            var html = "";
                            html = "<tr>"
                                + '<th></th>'
                                + "<th rowspan='1' colspan='1'><input class='srch' type='text' data-indx='1' placeholder='Search Project'></th>"
                                + "<th rowspan='1' colspan='1'><input class='srch' type='text' data-indx='2' placeholder='Search Project Name'></th>"
                                + "<th></th>"
                                + "</tr>";

                            $('#POLists thead').append(html);
                            var table = $('#POLists').DataTable();

                            $('.srch').on('keyup change', function () {
                                var indx = $(this).attr('data-indx');
                                var txt = this.value;
                                table
                                       .column(indx)
                                       .search(txt)
                                       .draw();
                                RowHtmlRender();
                            });
                            RowHtmlRender();
                        },
                        "aoColumnDefs": [
                            { 'bSortable': false, 'aTargets': [0, 3] }
                        ]
                    });

                });
        });

        function RowHtmlRender() {
            $('#POLists_filter').css('display', 'none');
            //$('#POLists tbody tr').find("td:eq(0)").each(function () {
            //    $(this).html('<input type="button" class="buttonedit btnhover" onclick="GetThisComment(this);" style="margin-bottom:6px;" />');
            //});
        }
        function GetThisComment(obj) {
            $('#txt_PrchsOrdrCmmnts').val('');

            var elem = document.createElement('textarea');
            elem.innerHTML = $(obj).parent("td").parent("tr").find("td:eq(3)").html();
            var decoded = elem.value;
            elem.remove();

            //$('#txt_PrchsOrdrCmmnts').val($(obj).parent("td").parent("tr").find("td:eq(3)").html().toString());
            $('#txt_PrchsOrdrCmmnts').val(decoded);

            auto_grow($('#txt_PrchsOrdrCmmnts'));
            $('#txt_PrchsOrdrCmmnts').focus();
            $("#poListPopUp").modal("hide");
        }
        function auto_grow(element) {
            $(element).css("height", "60px");
            $(element).css("height", (document.getElementById("txt_PrchsOrdrCmmnts").scrollHeight + "px"));


           // element.style.height = "5px";
           // element.style.height = (element.scrollHeight) + "px";
        }
       

       
    </script>
    
