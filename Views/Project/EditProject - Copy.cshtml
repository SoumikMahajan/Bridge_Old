        function loadallcomments() {
            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Project/getAllcomments';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Project/getAllcomments';
            }
            var pid = $('#ProjectID').val();

            if (pid == '') {
                return;
            }




            $.ajax({
                type: "POST",
                url: url1,
                async: false,
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                data: "{ 'projectID' : '" + '' + "'}",
                success: function (response) {
                    ////console.log(response);
                    response = JSON.parse(response);
                    allcomments = response.data;

                    createallcommentslist();

                },
                error: function () {
                    alert('Something went wrong.');
                }
            });
        }
        function loadprojectcomments() {
            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Project/getAllcommentsproject';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Project/getAllcommentsproject';
            }
            var pid = $('#ProjectID').val();

            if (pid == '') {
                return;
            }

            $.ajax({
                type: "POST",
                url: url1,
                async: false,
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                data: "{ 'projectID' : '" + pid + "'}",
                async: false,
                success: function (response) {
                    // //console.log(response);
                    response = JSON.parse(response);
                    response = projectcomments = response.data;

                    var html = "";
                    var Commentid = "";
                    var Comment = "";
                    var Createddate = "";

                    for (var i = 0; i < response.length; i++) {
                        Commentid = response[i].Commentid;
                        Comment = unescape(response[i].Comment);
                        Createddate = response[i].Createddate;
                        html += "<span class='remove' data-id='" + Commentid + "' ><a onclick='deleteprojectcomment(this,\"" + Commentid + "\")' title='Remove this comment'>x</a><span>" + Comment + " ( " + Createddate + " )" + "</span></span>";
                    }

                    $('#ProjectComments').html(html);

                },
                error: function () {
                    alert('Something went wrong.');
                }
            });
        }


        function loadprojectaccounts() {
            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Project/getAllprojectaccounts';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Project/getAllprojectaccounts';
            }
            var pid = $('#ProjectID').val();

            if (pid == '') {
                return;
            }

            $.ajax({
                type: "POST",
                url: url1,
                async: false,
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                data: "{ 'projectID' : '" + pid + "'}",
                async: false,
                success: function (response) {
                    // //console.log(response);
                    response = JSON.parse(response);
                    response = projectaccounts = response.data;

                    var html = "";
                    var FldID = "";
                    var ProjectID = "";
                    var AccountNumber = "";
                    var IsActive = "";
                    var Description = "";
                    var Description_ORIG = "";

                    for (var i = 0; i < response.length; i++) {
                        FldID = response[i].FldID;
                        ProjectID = response[i].ProjectID;
                        AccountNumber = response[i].AccountNumber;
                        IsActive = response[i].IsActive
                        Description = response[i].Description
                        Description_ORIG = response[i].Description

                        if (Description.trim() != "") {
                            Description = " ---- " + Description;
                        }


                        html += "<span title='Accnt No.:-" + AccountNumber + "    Desc:-" + Description_ORIG + "' data-desc='" + Description_ORIG + "' data-accountnumber='" + AccountNumber + "' class='remove accountclass' data-id='" + FldID + "' >"
                            + '<i title="Edit Account" class="mrg5R fa fa-pencil-square-o" style="font-size: 1.3em;cursor:pointer;" onclick="EditPAccount(this);"></i>'
                            + "<a onclick='deleteprojectaccount(this,\"" + FldID + "\")' title='Remove this account'>x</a><span>" + AccountNumber + Description + "</span></span>";
                    }

                    $('#ProjectAccounts').html(html);

                },
                error: function () {
                    alert('Something went wrong.');
                }
            });
        }


        function EditPAccount(o) {
            var id = $(o).parent().attr('data-id');
            var accnumber = $(o).parent().attr('data-accountnumber');
            var accdesc = $(o).parent().attr('data-desc');
            $('#paccountedit').modal('show');

            $('#paccntno').val(accnumber);
            $('#paccntdesc').val(accdesc);
            $('#paccntid').val(id);
            console.log(id);


        }
        function editpaccountsave() {
            var id = $('#paccntid').val();
            var accnumber = $('#paccntno').val();
            var accdesc = $('#paccntdesc').val();
            if (accnumber.trim() == "") {
                notify("Please enter Account number");
                return;
            }
            var obj = new Object();
            obj.FliID = id;
            obj.AccntDesc = accdesc;
            obj.AccntNumber = accnumber;


            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "POMS_EditProjectAccounts";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var o = DBSP.call_DB_Procedure();
            o = o.data;
            loadprojectaccounts();
            
            notify("Account updated successfully!!!", "GREEN");
            $('#divQBSLoading').append('Syncing Account from QBO ' + '<i class="fa fa-spinner fa-spin mrg10L" aria-hidden="true"></i>');
            $('#paccountedit').modal('hide');
            setTimeout(function () {
                
                UpdateQBSAccount();

            }, 300);

        }


