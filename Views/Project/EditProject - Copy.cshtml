    <script>
        $(function () {

            //console.log(parseFloat($('#ytdpurchasenumber').text().trim()));
        var newnumber = formatNumber(parseFloat($('#ytdpurchasenumber').text().trim()));
       // newnumber = isNaN(newnumber) ? '0.00' : newnumber;
        $('#ytdpurchasenumber').text(newnumber + ' ' + $('#ytdpurchasenumber').text().trim().split(' ' )[1]);
    });
    function formatNumber(number) {
        number = parseFloat(number);
        var number = number.toFixed(2) + '';
        var x = number.split('.');
        var x1 = x[0];
        var x2 = x.length > 1 ? '.' + x[1] : '';
        var rgx = /(\d+)(\d{3})/;
        while (rgx.test(x1)) {
            x1 = x1.replace(rgx, '$1' + ',' + '$2');
        }
        return x1 + x2;
    }
    </script>


