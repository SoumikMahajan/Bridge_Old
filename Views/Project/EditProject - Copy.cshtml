    <script type="text/javascript">
        $(function () {
            var date = new Date();
            var currentMonth = date.getMonth();
            var currentDate = date.getDate();
            var currentYear = date.getFullYear();

            currentMonth = currentMonth + 1;

            currentMonth = currentMonth < 9 ? '0' + currentMonth : currentMonth;
            currentDate = currentDate < 9 ? '0' + currentDate : currentDate;

            //$('#To_Date').val(date.toDateString());
           
            $('#To_Date').val(currentYear + '.' + currentMonth + '.' + currentDate);


            //$('#Date_Range').val(new Date(currentYear, 0, 1).toDateString());

            var date = new Date(currentYear, 1, 1);
            currentMonth = date.getMonth();
            currentDate = date.getDate();
            currentYear = date.getFullYear();

            currentMonth = currentMonth < 9 ? '0' + currentMonth : currentMonth;
            currentDate = currentDate < 9 ? '0' + currentDate : currentDate;

            //$('#Date_Range').val(currentYear + '.' + currentMonth + '.' + currentDate);
            $('#Date_Range').val($('#ytdpurchasenumber').attr('data-firstdate'));

            $('#Date_Range').datepicker({
                changeMonth: true,
                changeYear: true,
                dateFormat: 'yy.mm.dd'
                , onSelect: function () {
                    FetchDate();
                }
            });
            $('#To_Date').datepicker({
                changeMonth: true,
                changeYear: true,
                dateFormat: 'yy.mm.dd',
                // minDate: new Date(currentYear, currentMonth, currentDate),
                onSelect: function () {
                    FetchDate();
                }
            });
            FetchDate();
        });
        function FetchDate() {
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Project/GetProject';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Project/GetProject';
            }
            var dataTable = "";
            var dt = "";
            var us = new Array();
            $.ajax({
                type: "POST",
                url: url,
                data: "{ 'From': '" + $('#Date_Range').val() + "', 'Todate': '" + $('#To_Date').val() + "','ProjectID':'" + $('#ProjectID').val() + "'}",
                contentType: "application/json; charset=utf-8",
                dataType: "JSON",
                success: function (data) {

                    if (data != '') {
                        dt = data.data;
                        //if (dt.length == 0) {
                        //    return;
                        //}
                        $('#ProjectList').dataTable().fnDestroy();

                        var tot = 0;
                        var curr = '';

                        if (dt.length >= 0) {
                            for (i = 0; i < dt.length ; i++) {
                                us[i] = new Array();

                                us[i][0] = '<a href="#" onclick=" Click(event,' + dt[i].ParentVendor_ID + ',' + $('#ProjectID').val() + ')" >' + dt[i].ParentVendorName + '</a>';

                                us[i][1] = dt[i].Total;

                               
                            }
                            $('#ProjectList').dataTable({
                                "processing": true,
                                "data": us,
                                "drawCallback": function (settings) {
                                    var tot = 0;
                                    var curr = '';
                                    $('#ProjectList tbody tr').each(function () {
                                        var vl = parseFloat(replaceAll($(this).find('td:eq(1)').find('.totalval').text(),',',''));
                                        tot += vl;
                                        curr = $(this).find('td:eq(1)').find('.totalcurrency').text();
                                      //  $(this).find('td:eq(1)').find('.totalval').text(formatNumber(vl));
                                    });
                                    var htm = isNaN(tot) ? '0' : formatNumber(tot) + " " + curr;
                                    $('#ProjectList thead').find('tr:eq(1)').find('th:eq(1)').html(htm);
                                    //console.log('DataTables has redrawn the table');
                                },


                                "columns":
                                  [
                                    { "title": "Vendor Common Name", "class": "leftposition" },

                                    { "title": "Amount","class" : "rightposition" },
                                  ],
                                "initComplete": function () {

                                    $('#ProjectList tbody tr').each(function () {
                                        var vl = parseFloat($(this).find('td:eq(1)').find('.totalval').text());
                                        tot += vl;
                                        curr = $(this).find('td:eq(1)').find('.totalcurrency').text();
                                        $(this).find('td:eq(1)').find('.totalval').text(formatNumber(vl));
                                    });


                                    $('#ProjectList_filter').remove();
                                    $('#ProjectList_length').remove();
                                }
                            });
                            var html = "";
                            html = "<tr>"

                                  + "<th class='leftposition' rowspan='1' colspan='1'><input class='srch' style='padding: 2px 2%;font-family:Arial, FontAwesome' placeholder='&#xF002;' data-indx='0' type='text' ></th>"

                              + "<th class='rightposition'>" + formatNumber(tot) + " " + curr + "</th>"
                                  + "</tr>";

                            $('#ProjectList thead').find('tr:eq(1)').remove();


                            if (dt.length != 0) {
                                $('#ProjectList thead').append(html);

                            }



                            var table = $('#ProjectList').DataTable();
                            $('.srch').on('keyup change', function () {
                                var indx = $(this).attr('data-indx');
                                var txt = this.value;
                                table
                                       .column(indx)
                                       .search(txt)
                                       .draw();

                            });
                        }
                        else {
                        }

                    }
                }
            })
        }
        function Click(e, VendorID, ProjectID) {

            e.preventDefault();

            var obj = new Object();
            obj.ProjectID = ProjectID;
            obj.VendorID = VendorID;


            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "POMS_GetPOFromProjectPage";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var o = DBSP.call_DB_Procedure();
            o = o.data;
            //console.log(o);

            var poids = '';

            for (var a = 0; a < o.length; a++) {
                poids += poids == '' ? o[a].PurchaseOrderID : "," + o[a].PurchaseOrderID;
            }

            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/PurchaseOrder/POList';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = urlchanger('PurchaseOrder/POList');
            }

            url += "?ID=" + poids;
            window.open(url);

        }
