            url1 = '/Project/DeleteProjectContact';
        }
        else if (LOCALORSERVERNEW == 'SERVER') {
            url1 = 'Project/DeleteProjectContact';
        }


        $.ajax({
            type: "POST",
            url: url1,
            async: false,
            dataType: "text",
            contentType: "application/json; charset=utf-8",
            data: "{ 'ProjectID' : '" + pid + "'}",
