    function trimText2(str) {


        var result = str;

        if (str.length > 90) {
            result = str.substring(0, 75) + '...' + str.substring(parseInt(str.length) - 10);





            //result += '.' + str.split('.')[1];
            ////console.log(result);
        }
        return result;
    }

    function trimText(str) {


        var result = str;

        if (str.length > 30) {
            result = str.substring(0, 15) + '...' + str.substring(parseInt(str.length) - 10);





            //result += '.' + str.split('.')[1];
            ////console.log(result);
        }
        return result;
    }

