    <script type="text/javascript">
        $(function () {
            $('#Btn_Excel1').click(function () {
                var AllProjectID = $('#txt_Project').val();
                var AllSectionID = $('#txt_Section').val();
                var OrderPattern = "";

                if (AllProjectID == null) {
                    notify('Please Select Project');
                    return;
                }

                if (AllSectionID == null) {
                    AllSectionID = "0";
                }

                if (OrderPattern == "") {
                    OrderPattern = "0";
                }
                else {

                    OrderPattern = OrderPattern.substr(0, (OrderPattern.length - 1));
                }



                var url1 = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url1 = '/Reports/BudgetReportByItemExportFile';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url1 = 'Reports/BudgetReportByItemExportFile';
                }
                url1 += "?ProjectID=" + AllProjectID;
                url1 += "&SectionID=" + AllSectionID;
                url1 += "&order=" + OrderPattern;
                var totdata = '';
                $.get(url1)
                   .success(function (response) {
                       var html = "";

                       var url2 = '';
                       if (response == '0') {
                           notify('No records found!!!');
                           return;
                       }
                       if (LOCALORSERVERNEW == 'LOCAL') {
                           totdata = response;
                       }
                       else if (LOCALORSERVERNEW == 'SERVER') {
                           totdata = "/POMS/" + response;
                       }


                       //totdata = response;
                       window.location = totdata;
                   });
            });
        });

    </script>

    <script type="text/javascript">
        $(function () {
            $('#Btn_Excel2').click(function () {
                var AllProjectID = $('#txt_Project').val();
                var AllSectionID = $('#txt_Section').val();
                var OrderPattern = "";

                if (AllProjectID == null) {
                    notify('Please Select Project');
                    return;
                }

                if (AllSectionID == null) {
                    AllSectionID = "0";
                }

                $(".sort_div").find("span").each(function (index, item) {

                    var orderIndex = $(this).attr("data-id");

                    if (typeof (orderIndex) != 'undefined') {

                        if (orderIndex == "1")
                            OrderPattern += '1';


                    }

                });
                if (OrderPattern == "") {
                    OrderPattern = "0";
                }

                var url1 = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url1 = '/Reports/BudgetReportSummaryExportFile';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url1 = 'Reports/BudgetReportSummaryExportFile';
                }
                url1 += "?ProjectID=" + AllProjectID;
                url1 += "&SectionID=" + AllSectionID;
                url1 += "&order=" + OrderPattern;
                var totdata = '';
                $.get(url1)
                   .success(function (response) {
                       var html = "";

                       var url2 = '';
                       if (response == '0') {
                           notify('No records found!!!');
                           return;
                       }
                       if (LOCALORSERVERNEW == 'LOCAL') {
                           totdata = response;
                       }
                       else if (LOCALORSERVERNEW == 'SERVER') {
                           totdata = "/POMS/" + response;
                       }


                       //totdata = response;
                       window.location = totdata;
                   });
            });
        });

    </script>





    <style type="text/css">
        .remove { /* width: 450px; */
            border: 1px solid #060506;
            -moz-border-radius: 2px;
            -webkit-border-radius: 2px;
            display: block;
            padding: 5px;
            text-decoration: none;
            background: rgba(82, 103, 121, 0.75);
            color: #E2E2E2;
            margin-right: 5px;
            margin-bottom: 5px;
            font-family: helvetica;
            font-size: 13px;
            position: relative;
        }

            .remove a {
                cursor: pointer;
                position: absolute;
                top: -5px;
                right: -6px;
                font-size: 0.9em;
                color: white;
                background: black;
                border-radius: 100px;
                padding: 7px;
                line-height: 9px;
            }

        .ui-widget-header {
            background: grey;
        }

        .ui-widget-overlay {
            position: fixed;
        }

        .ui-dialog .ui-dialog-titlebar-close span {
            margin: -8px;
        }

        #popupforvendorlist .bMulti {
            background-color: #fff;
            border-radius: 10px 10px 10px 10px;
            box-shadow: 0 0 25px 5px #999;
            color: #111;
            display: none;
            min-width: 450px;
            padding: 25px;
            height: 400px;
        }

        .button {
            background-color: #2b91af;
            border-radius: 10px;
            box-shadow: 0 2px 3px rgba(0,0,0,0.3);
            color: #fff;
            cursor: pointer;
            display: inline-block;
            padding: 10px 20px;
            text-align: center;
            text-decoration: none;
        }

            .button.b-close, .button.bClose {
                border-radius: 7px 7px 7px 7px;
                box-shadow: none;
                font: bold 131% sans-serif;
                padding: 0 6px 2px;
                position: absolute;
                right: -7px;
                top: -7px;
                z-index: 9999;
            }

        .spn {
            border: #208093 1px solid;
            color: #208093;
            margin: 0px 0px;
            width: 100%;
            height: 35px;
            float: left;
            /* color: #b31001; */
            padding: 5px 2%;
            background: rgb(235, 235, 228);
        }
    </style>





</head>
<body>

    <div class="container-fluid" id="angulardiv" ng-app="Reports" ng-controller="Reports">


