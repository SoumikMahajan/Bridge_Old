     <link href="~/css/jquery.dataTables.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery.dataTables.min.js"></script>

    

    <link href="~/css/Misc.css" rel="stylesheet" />

    <script type="text/javascript">





        $.get("returntable")
                .success(function (response) {
                    var project;
                   // //console.log(response);
                    totdata = JSON.parse(response + "]");
                   // //console.log(totdata);
                    var project = new Array();

                    for (i = 0; i < totdata.length ; i++) {

                        project[i] = new Array();
                        project[i][0] = totdata[i].classification;
                        project[i][1] = totdata[i].id;

                        project[i][2] = totdata[i].order;

                        project[i][3] = totdata[i].order;

                    }


                    $('#projectcontacts').dataTable({
                        "processing": true,
                        "data": project,
                        "columns": [
                            { "title": "classification" },
                            { "title": "id" },
                            { "title": "order","class" : "displaynone"},
                            { "title": "order","class" : "displaynone" }
                        ],
                        paging: false,
                        "initComplete": function () {
                            abc();
                        },
                        "aoColumnDefs": [
                            { 'bSortable': false, 'aTargets': [0, 1] }
                        ],
                        "order": [[2, "asc"]]

                    });





                });
        function reset() {
            var rwcnt = 1;
            $('#projectcontacts tbody tr').each(function () {
                $(this).find("td:eq(2)").html(rwcnt);
                $(this).attr('data-id',rwcnt++);

            });

            }
        function abc() {



            $('#projectcontacts tbody tr').each(function () {
                
                var pid = $(this).find("td:eq(3)").html();
                $(this).attr('data-id', pid);

            });
           


            $("#projectcontacts tbody").sortable(


                      {
                          cursor: "move",
                          start: function (event, ui) {
                              // 0 based array, add one
                              var obj = ui.item;
                              $(obj).css('background', 'rgb(237, 153, 188)');
                              //console.log('start');
                          },

                          update: function (event, ui) {
                              // 0 based array, add one
                              var obj = ui.item;
                              var obj2 = ui.item.prev('tr');
                             
                              var st = $(obj).attr('data-id');
                              var lt = $(obj2).attr('data-id');
                              
                           
                              if (lt < st) {
                                  obj2 = ui.item.next('tr');
                                  lt = $(obj2).attr('data-id');
                              }
                              
                              
                             
                              //alert('Prev: ' + st + ' Final: ' + lt);
                              

                              $.ajax({
                                  type: "POST",
                                  url: "sortcolumns",
                                  async: false,
                                  dataType: "text",
                                  contentType: "application/json; charset=utf-8",
                                  data: "{ 'prev': '" + st + "','current' : '" + lt +"'}",
                                  success: function (data) {
                                      reset();
                                  },
                                  error: function () {
                                      alert('Something went wrong.');
                                  }
                              });


                          },

                          stop: function (event, ui) {
                              var obj = ui.item;
                              $(obj).css('background', '');
            }
                          // end of drag
                      });

        }



    </script>


</head>
<body>
    <div>


              <table id="projectcontacts" class="display  compact" cellspacing="0" width="100%">
                <thead>
                    <tr>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        
                    </tr>
                </thead>




            </table>


    </div>
</body>
</html>
