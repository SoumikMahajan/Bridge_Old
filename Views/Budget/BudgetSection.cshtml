        $(function () {
            var pid = $("#PrjtDdl option:selected").attr('data-id');
            getsections(pid, '', '');
            getpdetails(pid);
            if ($("#PrjtDdl option:selected").attr('data-id') == "0") {
                $('#btn_AddSctn').val("Add section");
            }
            else {
                $('#btn_AddSctn').val("Add section for " + $("#PrjtDdl option:selected").text());
            }
            $('#PrjtDdl').change(function () {
                if ($("#PrjtDdl option:selected").attr('data-id') == "0") {
                    $('#btn_AddSctn').val("Add section");
                }
                else {
                    $('#btn_AddSctn').val("Add section for " + $("#PrjtDdl option:selected").text());
                }
                var pid = $("#PrjtDdl option:selected").attr('data-id');
                getsections(pid, $('#txt_srchnumber').val().trim(), $('#txt_srchname').val().trim());
                getpdetails(pid);
            });
            $('#btn_AddSctn').click(function () {
                var pid = $('#PrjtDdl').find(":selected").attr('data-id');
                //if (pid == 0) {
                //    notify("Please select Project");
                //    return;
                //}
                var sectionname = $('#txt_BudgetDesc').val().trim();
                var sectionnumber = parseInt($('#txt_BudgetNumber').val().trim());
                if (isNaN(sectionnumber)) {
                    errorfunc('txt_BudgetNumber', 'Please enter a valid section number');
                    notify("Please enter a valid section number");
                    return;
                }
                sectionnumber = parseInt(sectionnumber);
                if (sectionnumber > 999) {
                    notify("Please use numbers between 1 - 999");
                    return;
                }
                else if (sectionnumber <= 9) {
                    sectionnumber = "00" + sectionnumber;
                }
                else if (sectionnumber <= 99) {
                    sectionnumber = "0" + sectionnumber;
                }
                if (sectionname == '') {
                    errorfunc('txt_BudgetDesc', 'Please add section name')
                    notify('Add section name');
                    return;
                }
                var url = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url = '/budget/addProjectSection';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
