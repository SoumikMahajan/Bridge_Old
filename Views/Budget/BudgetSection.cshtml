                                 var obj = ui.item;
                                 $(obj).css('background', '#86ABC2');
                                 // //console.log('start');
                             },
                             update: function (event, ui) {
                                 var obj = ui.item;
                                 var obj2 = ui.item.prev();
                                 var st = $(obj).attr('data-orderindex');
                                 var lt = $(obj2).attr('data-orderindex');
                                 if (parseInt(lt) < parseInt(st)) {
                                     obj2 = ui.item.next();
                                     lt = $(obj2).attr('data-orderindex');
                                 }
                                 // alert('Prev: ' + st + ' Final: ' + lt);
                                 if (lt == undefined) {
                                     lt = 1;
                                 }
                                 var url1 = '';
                                 if (LOCALORSERVERNEW == 'LOCAL') {
                                     url1 = '/Budget/sortsections';
                                 }
                                 else if (LOCALORSERVERNEW == 'SERVER') {
                                     url1 = '/Budget/sortsections';
                                 }
                                 var projectid = $("#PrjtDdl option:selected").attr('data-id');
                                 $.ajax({
                                     type: "POST",
                                     url: url1,
                                     async: false,
                                     dataType: "text",
                                     contentType: "application/json; charset=utf-8",
                                     data: "{ 'prev': '" + st + "','current' : '" + lt + "','projectid' : '" + projectid + "'}",
                                     success: function (data) {
                                         notify('Reordered Successfully row ' + st + ' has been shifted to row ' + lt,'green');
                                         getsections(projectid, '', '')
                                     },
                                     error: function () {
                                         notify('Something went wrong.');
                                     }
                                 });
                             },
                             stop: function (event, ui) {
                                 var obj = ui.item;
                                 $(obj).css('background', '');
                             }
                             // end of drag
                         });
                    $('#filtered2').html(' Filtered Subtotal : ' + totcost)
                }
            });
        }
