    <div id="addnewsection" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Add Section</h4>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-sm-6 req">
                            <label>Number</label>
                            <input type="text" class="numberonly form-control" id="txt_BudgetNumber" />
                        </div>
                        <div class="col-sm-6 req">
                            <label>Section Name</label>
                            <input type="text" id="txt_BudgetDesc" class="form-control alltoupper" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-poms" id="btn_AddSctn">Add Section</button>
                </div>
            </div>
        </div>
    </div>
    <div class="float-panel-container">
        <ul>
            <li onclick="openaddsectionpopup();" title="Add New Section"><a href="javascript:void(0);"><i class="fa fa-plus mrg5R" ></i><span class="tooltip-toggle">Add New Section</span></a></li>
        </ul>
    </div>
    <script>
        function openaddsectionpopup() {
            $('#addnewsection').modal('show');
        }
        var ProjectDdlForPage = $('#PrjtDdl'); //The project dropdown ID
        $(document).ready(function () {
          
            var selectedpreferredpid = getProjectPreference();
            console.log(selectedpreferredpid + "  >>>>>>>>>>>>>>>>>>>>>>>>");


            if (selectedpreferredpid.split(',').length > 0) {
                selectedpreferredpid = selectedpreferredpid.split(',')[0];
            }
            $(ProjectDdlForPage).find('option').each(function () {
                if ($(this).attr('data-id') == selectedpreferredpid) {
                    $(this).attr("selected", "true");
                }
            });
            $(ProjectDdlForPage).multiselect('refresh');
            var width = '100%';
            $('.ui-multiselect').css('width', width);
            $('.ui-multiselect-menu').css('width', '39.5%');
            $('.ui-state-default').css('color', '#C31001');
            $('.ui-multiselect').css('height', '34px');
            $('.ui-multiselect').css('margin-top', '5px');
            //To call page specific dropdown change event
            ProjectNameAtLabel(ProjectDdlForPage);
            var pid = selectedpreferredpid;
            getsections(pid, '', '');
            getpdetails(pid);
            if (selectedpreferredpid == "0") {
                $('#btn_AddSctn').val("Add section");
            }
            else {
                $('#btn_AddSctn').val("Add section for " + $("#PrjtDdl option:selected").text());
            }
        });
        $(document).on('change', ProjectDdlForPage, function () {
            setProjectPreferenceBS(ProjectDdlForPage);
        });
    </script>
</body>
</html>
