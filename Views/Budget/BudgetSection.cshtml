    <script type="text/javascript">
        function getpdetails(pid) {
            var filtered1url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                filtered1url = '/Budget/getProjectDetail';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                //url1 = urlsuffix + "/" + 'Project/getAllProjectList';
                filtered1url = '/Budget/getProjectDetail';
            }
            filtered1url += '?ProjectID=' + pid;
            $.ajax({
                type: "POST",
                url: filtered1url,
                async: false,
                data: {},
                success: function (response) {
                    var filtered1html = response;
                    $('#filtered1').html(filtered1html.replace('{', '').replace('}', ''));
                }
            });
        }
        function numberWithCommas(x) {
            var parts = x.toString().split(".");
            parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");
            return parts.join(".");
        }
        $(function () {
            $(".SectionRangeonly").live('keypress', function (e) {
                //if the letter is not digit then display error and don't type anything
                if (e.which != 45 && e.which != 44 && e.which != 8 && e.which != 0 && (e.which < 48 || e.which > 57)) {
