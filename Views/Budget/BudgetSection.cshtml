                    $(this).html("Number " + '<i class="fa fa-sort-asc"></i>');
                    orderClause = 'asc';
                   
                }
                else {
                    sortorderglobal = "desc";
                    $(this).removeClass('asc');
                    $(this).addClass('desc');
                    $(this).html("Number " + '<i class="fa fa-sort-desc"></i>');
