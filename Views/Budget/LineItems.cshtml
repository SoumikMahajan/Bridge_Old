        function ForAdjustTxt(obj) {
            $("#lineitems tbody").addClass("disable-sort");
            EditHeadeChk = '1';
            $(obj).focus();
        }
        function UpdateAdjust(obj) {
            var adjust = parseFloat($(obj).val());

            var rw = $(obj).parent().parent();
            var commit = parseFloat(replaceAll($(rw).find("td:eq(24)").html(), ',', '')).toFixed(2);
            var adjustreal = parseFloat(replaceAll($(rw).find("td:eq(32)").html(), ',', '')).toFixed(2);

            $(rw).find("td:eq(31)").html(adjust);
            var budget_cost = parseFloat(replaceAll($(rw).find("td:eq(15)").html(), ',', '')).toFixed(2);
            var remaining = Math.max((budget_cost - commit), 0);
            remaining = Math.round(parseFloat(remaining) * 100) / 100;

            if (parseFloat(adjust) > parseFloat(remaining)) {
                notify("Adjustment is greater than remaining. Not updated.");
                $(obj).val(adjustreal);
                return;
            }




            $("#lineitems tbody").removeClass("disable-sort");
            EditHeadeChk = '0';

            if (adjust == '' || isNaN(adjust)) { adjust = 0; }
            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Budget/UpdateAdjust';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Budget/UpdateAdjust';
            }
            var rw = $(obj).parent().parent();
            var LineitemID = parseInt($(rw).find("td:eq(5)").html());
            $.ajax({
                type: "POST",
                url: url1,
                async: false,
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                data: "{ 'LineItemID' : '" + LineitemID + "','AdjustedAmount': '" + adjust + "'}",
                success: function (data) {
                    if (data == 'SUCCESS') {
                        var rw = $(obj).parent().parent();
                        var commit = parseFloat(replaceAll($(rw).find("td:eq(24)").html(), ',', '')).toFixed(2);
                        $(rw).find("td:eq(31)").html(adjust);
                        var budget_cost = parseFloat(replaceAll($(rw).find("td:eq(15)").html(), ',', '')).toFixed(2);
                        var remaining = Math.max((roundnumber(budget_cost) - roundnumber(commit) - adjust), 0);
                        var variance = Math.max((budget_cost - commit - remaining), (budget_cost - commit - remaining - adjust));
                        $(rw).find("td:eq(25)").html(numberWithCommas(formatNumber(parseFloat(remaining))));
                        $(rw).find("td:eq(27)").html(numberWithCommas(formatNumber(parseFloat(variance))));
                        notify('Successfully Updated.', 'green');




                    }
                },
                error: function () {
                    notify('Something went wrong.');
                }
            });
            $(obj).blur();
        }
        function AdjstKeyUP(e, obj) {
            var k = e.keyCode;
            if (k == 13) {
                UpdateAdjust(obj);
            }
        }



