    <script>
        var versionFlag = false;
        var currentVersionName = "";
        var fromTypeFlag = false;
        (function ($) {
            $.widget("custom.combobox", {
                _create: function () {
                    this.wrapper = $("<span>")
                        .addClass("custom-combobox")
                        .insertAfter(this.element);
                    this.element.hide();
                    this._createAutocomplete();
                    this._createShowAllButton();
                },
                _createAutocomplete: function () {
                    var selected = this.element.children(":selected"),
                        value = selected.val() ? selected.text() : "";
                    this.input = $("<input>")
                        .appendTo(this.wrapper)
                        .val(value)
                        .attr("title", "")
                        .addClass("custom-combobox-input ui-widget ui-widget-content ui-state-default ui-corner-left")
                        .autocomplete({
                            delay: 0,
                            minLength: 0,
                            source: $.proxy(this, "_source")
                        })
                        .tooltip({
                            tooltipClass: "ui-state-highlight"
                        })
                        .on('mouseup', function () {
                            $(this).select();
                        });
                    $(this).blur();
                    this._on(this.input, {
                        autocompleteselect: function (event, ui) {
                            ui.item.option.selected = true;
                            this._trigger("select", event, {
                                item: ui.item.option
                            });
                        },
                        autocompletechange: "_removeIfInvalid"
                    });
                },
                _createShowAllButton: function () {
                    var input = this.input,
                        wasOpen = false;
                    $("<a>")
                        .attr("tabIndex", -1)
                        .attr("title", "Show All Items")
                        .tooltip()
                        .appendTo(this.wrapper)
                        .button({
                            icons: {
                                primary: "ui-icon-triangle-1-s"
                            },
                            text: false
                        })
                        .removeClass("ui-corner-all")
                        .addClass("custom-combobox-toggle ui-corner-right")
                        .mousedown(function () {
                            wasOpen = input.autocomplete("widget").is(":visible");
                        })
                        .click(function () {
                            input.focus();
                            input.blur();
                            // Close if already visible
                            if (wasOpen) {
                                return;
                            };
                            // Pass empty string as value to search for, displaying all results
                            input.autocomplete("search", "");
                        });
                },
                _source: function (request, response) {
                    var matcher = new RegExp($.ui.autocomplete.escapeRegex(request.term), "i");
                    response(this.element.children("option").map(function () {
                        var text = $(this).text();
                        if (this.value && (!request.term || matcher.test(text))) return {
                            label: text,
                            value: text,
                            option: this
                        };
                    }));
                },
                _removeIfInvalid: function (event, ui) {
                    // Selected an item, nothing to do
                    if (ui.item) {
                        var selected = this.element;
                        return;
                    };
                    // Search for a match (case-insensitive)
                    var default_text = "";
                    var value = this.input.val(),
                        valueLowerCase = value.toLowerCase(),
                        valid = false;
                    currentVersionName = value;
                    var selectedVal = -1;
                    this.element.children("option").each(function () {
                        if ($(this).val() == "default") {
                            default_text = $(this).text();
                        };
                        if ($(this).text().toLowerCase() === valueLowerCase) {
                            this.selected = valid = true;
                            selectedVal = $(this).val();
                            //$('#ddl_selectversion option[value="0"]').text("value");
                            return false;
                        };
                    });
                    fromTypeFlag = true;
                    // Found a match, nothing to do
                    if (valid) {
                        versionFlag = true;
                        return;
                    }
                    else {
                        versionFlag = false;
                        var pid = $("#Ddl_SelPro option:selected").attr('data-id');
                        var url1 = '';
                        if (LOCALORSERVERNEW == 'LOCAL') {
                            url1 = '/Budget/saveVersionName';
                        }
                        else if (LOCALORSERVERNEW == 'SERVER') {
                            //url1 = urlsuffix + "/" + 'Project/getAllProjectList';
                            url1 = 'Budget/saveVersionName';
                        }
                        url1 += "?pid=" + pid + "&versionname=" + currentVersionName;
                        var totdata;
                        $.get(url1)
                            .success(function (response) {
                                $('#ddl_selectversion option[value="0"]').text(currentVersionName);
                                notify('Version name successfully saved.', "GREEN");
                            });
                        return;
                    }
                },
                _destroy: function () {
                    this.wrapper.remove();
                    this.element.show();
                },
                refresh: function () {
                    selected = this.element.children(":selected");
                    this.input.val(selected.text());
                },
                select: function (event, ui) {
                    ui.item.option.selected = true;
                    self._trigger("selected", event, {
                        item: ui.item.option
                    });
                    select.trigger("change");
                },
                change: function (event, ui) {
                    if (!ui.item) {
                        var matcher = new RegExp("^" + $.ui.autocomplete.escapeRegex($(this).val()) + "$", "i"),
                            valid = false;
                        select.children("option").each(function () {
                            if ($(this).text().match(matcher)) {
                                this.selected = valid = true;
                                return false;
                            };
                        });
                        if (!valid) {
                            //versionFlag = false;
                        }
                        else {
                            //alert($(this).val());
                            //versionFlag = true;
                        };
                    };
                }
            });
        })(jQuery);
        $(function () {
            //$("#ddl_selectversion").combobox();
            $("#ddl_selectversion").combobox({
                select: function (event, ui) {
                    fromTypeFlag = false;
                    if ($(this).val() == 0) {
                        $('#lbl_BudgetVersion').html('Version Number : ' + $('#Currentversion').val());
                        var versionid = $(this).val().toString();
                        if (versionid == '0') {
                            $('.forcurrentversiononly').removeClass('displaynone');
                            $('#prevversionsection').addClass('displaynone');
                            $('#currversionsection').removeClass('displaynone');
                            $('#lineitemsforprev').addClass('displaynone');
                            $('#lineitemsforprev_info').addClass('displaynone');
                            $('#lineitems').removeClass('displaynone');
                            $('#lineitems_info').removeClass('displaynone');
                            $('#prevversionexport').hide();
                            return;
                        }
                    }
                    else {
                        var versionid = $(this).val().toString();
                        $('#lbl_BudgetVersion').html('Version Number : ' + $(this).find('option:selected').text());
                        $('.forcurrentversiononly').addClass('displaynone');
                        $('#lineitems').addClass('displaynone');
                        $('#lineitems_info').addClass('displaynone');
                        $('#lineitemsforprev').removeClass('displaynone');
                        $('#lineitemsforprev_info').removeClass('displaynone');
                        $('#currversionsection').addClass('displaynone');
                        $('#prevversionsection').removeClass('displaynone');
                        $('#prevversionexport').show();
                        var pid = $("#Ddl_SelPro option:selected").attr('data-id');
                        var url1 = '';
                        if (LOCALORSERVERNEW == 'LOCAL') {
                            url1 = '/Budget/getAllPreviousProjectSection';
                        }
                        else if (LOCALORSERVERNEW == 'SERVER') {
                            //url1 = urlsuffix + "/" + 'Project/getAllProjectList';
                            url1 = 'Budget/getAllPreviousProjectSection';
                        }
                        url1 += "?projectid=" + pid + "&versionid=" + versionid;
                        // alert(url1);
                        var totdata;
                        $.get(url1)
                            .success(function (response) {
                                var html = "";
                                totdata = response;
                                totdata = JSON.parse(totdata).data;
                                for (var a = 0; a < totdata.length; a++) {
                                    var id = totdata[a].id;
                                    var name = totdata[a].sectionname;
                                    var Sectionnumber = totdata[a].Sectionnumber;
                                    html += "<option value='" + id + "'>" + Sectionnumber + "-" + name + "</option>";
                                }
                                $('#Ddl_SelProSecPreviousVersion').html(html);
                                if (html == "") {
                                    //call here
                                }
                                var sectionid = $('#Ddl_SelProSecPreviousVersion').val();
                                // loaditems(sectionid);
                                $("#Ddl_SelProSecPreviousVersion").multiselect({
                                    multiple: false
                                    //,header: "Select an option"
                                    , noneSelectedText: "Select a Section   "
                                    //,selectedList: 1
                                }).multiselectfilter();
                                $('.ui-multiselect').css('width', '100%');
                                //$('.ui-multiselect-menu').css('width', '39.5%');
                                $('.ui-multiselect-menu').css('width', '39.5%');
                                $('.ui-state-default').css('color', '#C31001');
                                $('.ui-multiselect').css('height', '34px');
                                $('.ui-multiselect').css('margin-top', '5px');
                                bindpreviouslineitems($('#Ddl_SelProSecPreviousVersion'));
                            });
                    }
                }
            });
            $("#toggle").on("click", function () {
                $("#ddl_selectversion").toggle();
            });
        });
    </script>
    <script type="text/javascript">
        var budget = new Array();
        var spacing = new Array();
        var offsecurity = new Array();
