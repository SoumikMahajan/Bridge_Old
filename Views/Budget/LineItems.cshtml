        function loaditems(sectionid) {
            var url7 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url7 = '/Budget/getApprovalStatusForSentBudget';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url7 = 'Budget/getApprovalStatusForSentBudget';
            }
            url7 += "?projectID=" + $('#Ddl_SelPro option:selected').attr('data-id');
            var approvaldata;
            var html = "";
            $.get(url7)
                .success(function (response) {
                    approvaldata = JSON.parse(response).data;
                    var innerhtml = "";
                    var SentForApprovalDate = "";
                    var DateWhenBudgetApproved = "";
                    var NumOfUserToAprv_Budget;
                    var AlreadyApprovedvr;
                    var alreadyapproved = "";
                    var alreadyapproved1 = "";
                    var toapprove = "";
                    var toapprove1 = "";
                    var textstatusforapproval = "";
                    for (var i = 0; i < approvaldata.length; i++) {
                        var ManagerName = approvaldata[i].ManagerName;
                        var UserName = approvaldata[i].UserName;
                        var Approved = approvaldata[i].Approved;
                        SentForApprovalDate = approvaldata[i].SentForApprovalDate;
                        NumOfUserToAprv_Budget = approvaldata[i].NumOfUserToAprv_Budget;
                        DateWhenBudgetApproved = approvaldata[i].DateWhenBudgetApproved;
                        AlreadyApprovedvr = approvaldata[i].AlreadyApproved;
                        UserApprovedDate = approvaldata[i].UserApprovedDate;
                        var titleinner = '';
                        if (Approved == '1') {
                            if (ManagerName != "") {
                                titleinner = "By " + ManagerName + ". ";
                            }
                            else {
                                titleinner = "Self Approved ";
                            }
                            titleinner += "On " + UserApprovedDate;
                            if (alreadyapproved1 == "") {
                                alreadyapproved1 += '<span style="cursor:pointer;" title="' + titleinner + '"><i class="fa fa-check mrg5R" style="color: #449d44;"></i>' + UserName + "</span>";
                            }
                            else {
                                alreadyapproved1 += ', <span style="cursor:pointer;" title="' + titleinner + '"><i title="' + titleinner + '" class="fa fa-check mrg5R" style="color: #449d44;"></i>' + UserName + "</span>";
                            }
                            if (alreadyapproved == "") {
                                alreadyapproved += UserName;
                            }
                            else {
                                alreadyapproved += ", " + UserName;
                            }
                        }
                        else {
                            if (toapprove1 == "") {
                                toapprove1 += '<i class="fa fa-times mrg5R" style="color: #E33747;"></i>' + UserName;
                            }
                            else {
                                toapprove1 += ', <i class="fa fa-times mrg5R" style="color: #E33747;"></i>' + UserName;
                            }
                            if (toapprove == "") {
                                toapprove += UserName;
                            }
                            else {
                                toapprove += ", " + UserName;
                            }
                        }
                        //innerhtml += "<button type='button' class='btn btn-poms glyphicon glyphicon-search'>" + UserName + "</button>";
                    }
                    if (AlreadyApprovedvr == "") {
                        AlreadyApprovedvr = 0;
                    }
                    if (parseInt(NumOfUserToAprv_Budget) > parseInt(AlreadyApprovedvr)) {
                        textstatusforapproval = ". Budget is not yet approved.";
                    }
                    else {
                        textstatusforapproval = ". Budget was approved on " + DateWhenBudgetApproved + ".";
                        toapprove1 = "";
                    }
                    var totapp = parseInt(NumOfUserToAprv_Budget);
                    var widthAlreadyApproved = (100 / totapp) * AlreadyApprovedvr;
                    var widthNumOfUserToAprv_Budget = 100 - parseInt(widthAlreadyApproved);
                    if (approvaldata.length > 0) {
                        if (alreadyapproved1.trim() != "" && parseInt(NumOfUserToAprv_Budget) > parseInt(AlreadyApprovedvr)) {
                            alreadyapproved1 += " | ";
                        }
                        // $('#budgetsentforapprovalyes').show();
                        html = "<div class='col-sm-12'>"
                            + "<label>Sent for approval on " + SentForApprovalDate
                            + textstatusforapproval
                            + "</label>"
                            //+ "<span>"
                            //+ innerhtml
                            //+ "</span>"
                            + "<div class='progress displaynone'>"
                            + "<div class='progress-bar progress-bar-success' title='" + alreadyapproved + "' role='progressbar' style='width:" + parseInt(widthAlreadyApproved) + "%'>"
                            + AlreadyApprovedvr + " Has Approved (" + alreadyapproved + ")"
                            + "</div>"
                            + "<div class='progress-bar progress-bar-warning' title='" + toapprove + "' role='progressbar' style='width:" + widthNumOfUserToAprv_Budget + "%'>"
                            + (parseInt(NumOfUserToAprv_Budget) - parseInt(AlreadyApprovedvr)) + " To approve (" + toapprove + ")"
                            + "</div>"
                            + "</div>"
                            + "</div>"
                            + "<div class='col-sm-12'><strong>"
                            + alreadyapproved1 + toapprove1
                            + "</strong></div>";
                        $('#budgetsentforapprovalyes').html(html);
                    }
                    else {
                        $('#budgetsentforapprovalyes').html("Budget not yet submitted for approval.");
                    }
                });
