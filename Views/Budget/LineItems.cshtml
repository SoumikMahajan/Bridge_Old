                url = '/budget/GetSpacing';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'budget/GetSpacing';
            }
            $.ajax({
                type: "POST",
                url: url,
                data: {},
                success: function (data) {
                    // //console.log(data);
                    spacing = JSON.parse(data).data;
                    var ddlstr = '<select  id="spacing" style="border: #208093 1px solid;color: #208093;margin: 6px 0px;width: 90%;">';
                    //                    ddlstr += "<option value='" + "0" + "'>" + "None" + "</option>";
                    ddlstr += "<option value='" + "0" + "'>" + "No" + "</option>";
