            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/AuthorityCheck/GetAllSecurityHidden';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'AuthorityCheck/GetAllSecurityHidden';
            }

            $.ajax({
                type: "POST",
                url: url,
                data: {},
                success: function (data) {
                    data = JSON.parse(data);
                    offsecurity = data.data;
                    for (var a = 0; a < offsecurity.length; a++) {
                        $('.' + offsecurity[a].Classname).remove();
                    }
                },
                error: function () { notify('Something went wrong'); }
            });
        }
