                        ddlstr += "<option value='" + spacing[a].FldID + "'>" + spacing[a].Spacingname + "</option>";
                    }
                    ddlstr += '</select>';
                    $('#spacingddl').html(ddlstr);
                    // $('body').append(ddlstr);
                    // alert(ddlstr);
                },
                error: function () { notify('Something went wrong'); }
            });
        });
        function updatespacing(LineitemID, SpacingID) {
            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Budget/changespacing';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Budget/changespacing';
            }
            var sectionid = $('#Ddl_SelProSec').val();
            $.ajax({
                type: "POST",
                url: url1,
                async: false,
