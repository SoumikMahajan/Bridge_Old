    <script type="text/javascript">
        $(document).ready(function () {
            $("#UpldLineItems2").click(function () {
                //alert(1);
                var sheetname = "";
                for (var i = 0; i < $('.sheetselect').length; i++) {
                    if ($('.sheetselect')[i].checked) {
                        sheetname = $('.sheetselect')[i].value;
                    }
                }
                var formData = new FormData();
                var totalFiles = document.getElementById("FileUpload").files.length;
                if (totalFiles > 1) {
                    notify('Single file at a time');
                    return;
                }
                for (var i = 0; i < totalFiles; i++) {
                    var file = document.getElementById("FileUpload").files[i];
                    formData.append("FileUpload", file);
                }
                var sectionid = $('#Ddl_SelProSec').val();
                formData.append("Sheetname", sheetname);
                var upldurl = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    upldurl = '/Budget/LineItems1';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    upldurl = 'Budget/LineItems1';
                }
                var txt = $(this).val();
                $(this).val('Please wait');
                upldurl += '?sectionid=' + sectionid;
                $.ajax({
                    type: "POST",
                    url: upldurl,
                    data: formData,
                    dataType: 'text',
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        $('#sheetselectorpopup').modal('hide');
                        $('#UpldLineItems').val("Upload");
                        if (isNaN(response)) {
                            notify(response);
                        }
                        else if (response == "0") {
                            notify("No items in the excel sheet.");
                        }
                        else {
                            var sectionid = $('#Ddl_SelProSec').val();
                            loaditems(sectionid);
                            notify(response + " Items added successfully.", 'green');
                            $('#FileUpload').replaceWith($('#FileUpload').val('').clone(true));
                        }
                    },
                    failed: function (error) {
                        $('#UpldLineItems').val(txt)
                        notify("error");
                    },
                    error: function (text) {
                        $('#UpldLineItems').val(txt)
                        notify(text);
                    }
                });
            });
            $("#UpldLineItems").click(function () {
                //alert(1);
                var formData = new FormData();
                var totalFiles = document.getElementById("FileUpload").files.length;
                if (totalFiles > 1) {
                    notify('Single file at a time');
                    return;
                }
                for (var i = 0; i < totalFiles; i++) {
                    var file = document.getElementById("FileUpload").files[i];
                    formData.append("FileUpload", file);
                }
                var sectionid = $('#Ddl_SelProSec').val();
                var upldurl = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    upldurl = '/Budget/LineItemschecksheet';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    upldurl = 'Budget/LineItemschecksheet';
                }
                var txt = $(this).val();
                $(this).val('Please wait');
                upldurl += '?sectionid=' + sectionid;
                $.ajax({
                    type: "POST",
                    url: upldurl,
                    data: formData,
                    dataType: 'text',
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        var html = "<p style=' font-size: 1.3em;'>The file contains " + response.split(',').length + " sheets."
                            + "Please select a sheet for uploading.</p>";
                        $('#sheetselectorpopup').modal('show');
                        for (var a = 0; a < response.split(',').length; a++) {
                            var vl = response.split(',')[a];
                            if (vl.indexOf("'") == 0) {
                                vl = vl.substring(1, vl.length - 1);
                            }
                            var vlshow = vl.substring(0, vl.length - 1);
                            if (a == 0) {
                                html += "<label><input name='sheetnm' checked class='sheetselect' value='" + vl + "' type='radio'> " + vlshow + "</label>";
                            }
                            else {
                                html += "<br />" + "<label><input name='sheetnm' class='sheetselect' value='" + vl + "' type='radio'> " + vlshow + "</label>";
                            }
                        }
                        $('#sheetselector').html(html);
                        //console.log(response);
                    },
                    failed: function (error) {
                        $('#UpldLineItems').val(txt)
                        notify("error");
                    },
                    error: function (text) {
                        $('#UpldLineItems').val(txt)
                        notify(text);
                    }
                });
            });
        });
    </script>
