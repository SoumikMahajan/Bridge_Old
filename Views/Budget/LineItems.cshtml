    <script>

        $('#Move_Next').click(function () {

            SaveEditDetails();

            var LineItemID = $('#itemID').val();

            var BudgetsectionID = $('#Ddl_SelProSec').val();

            var mode = 'Next';

            GetNavAndLineItems(LineItemID, BudgetsectionID, mode);

        });


        $('#Move_Previous').click(function () {

            SaveEditDetails();

            var LineItemID = $('#itemID').val();

            var BudgetsectionID = $('#Ddl_SelProSec').val();

            var mode = 'Previous';

            GetNavAndLineItems(LineItemID, BudgetsectionID, mode);

        });

        function SaveEditDetails() {



            var itemname = $('#edtitemname').val();
            //if (itemname.trim() == "") {
            //    notify("Please enter Itemname");
            //    $('#edtitemname').focus();
            //    return;
            //}
            var header = $('#edtcategory').val().trim();
            var notes = $('#edtnotes').val().trim();
            var taxable = $('#item_taxable_edt').is(':checked') ? "1" : "0";
            var nonfreight = $('#item_nonfreight_edt').is(':checked') ? "1" : "0";
            var itemdescription = $('#edtdesc').val();
            if (itemdescription.trim() == "") {
                notify("Please enter itemdescription");
                $('#edtdesc').focus();
                return;
            }
            var uom = $('#edtuom').val();
            if (uom == 0) {
                //notify("Please select UOM");
                //$('#edtuom').focus();
                //return;
                uom = "56";
            }
            var itemquantity = $('#edtqty').val();
            if (itemquantity.trim() == "" || isNaN(itemquantity) || itemquantity == 0) {
                //notify("Please enter valid itemquantity");
                //$('#edtqty').focus();
                //return;
                itemquantity = "0";
            }
            var cost = $('#edtcost').val();
            if (cost.trim() == "" || isNaN(cost) || cost == 0) {
                //notify("Please enter valid cost");
                //$('#edtcost').focus();
                //return;
                cost = "0";
            }
            var towh = $('#edtwh').is(':checked') ? "1" : "0";
            var itemID = $('#itemID').val();
            var BudgetsectionID = $('#Ddl_SelProSec').val();
            var specnum = $('#edtspecnum').val();
            var modelnum = $('#edtmodelnum').val();
            if (specnum.trim() == "") {
                //notify("Please enter Spec number");
                //$('#specnum').focus();
                //return;
            }
            var vendor = $('#edtvendor').val();
            if (vendor.trim() == "") {
                //notify("Please enter Vendor");
                //$('#vendor').focus();
                //return;
            }
            var tmpcnfrm = true;
            var urlq = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                urlq = '/budget/checkstatus';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                urlq = 'budget/checkstatus';
            }
            var flag = false;
            var versionname = '';
            $.ajax({
                type: "POST",
                url: urlq,
                async: false,
                data: {
                    'itemname': itemname, 'itemdescription': itemdescription, 'uom': uom, 'itemquantity': itemquantity, 'cost': cost,
                    'towh': towh, 'BudgetSectionID': BudgetsectionID, 'itemID': itemID,
                    'specnum': specnum, 'vendor': vendor, 'modelnum': modelnum,
                    'header': header, 'notes': notes, 'taxable': taxable, 'nonfreight': nonfreight
                },
                success: function (data) {
                    if (data == '1' && $('#IsBudgetApproved').val() == '1') {
                        tmpcnfrm = confirm("This is an approved budget. Changing the total will make the budget unapproved. Do you want to continue?");
                        if (tmpcnfrm) {
                            versionname = prompt("Please enter a budget version name:");
                            if (versionname == '') {
                                tmpcnfrm = confirm("Want to save with blank version name?");
                            }
                            flag = true;
                        }
                    }
                    else if ($('#IsSentForApproval').val() == '1' && data == '1') {
                        tmpcnfrm = confirm("Budget already sent for approval.Changing the item total will cancel the approval request. Do you want to continue?");
                    }
                },
                error: function () { notify('Something went wrong'); }
            });
            if (!tmpcnfrm) {
                return;
            };
            //var notes = $('#notes').val();

            var committedcost = $('#edtitemcommitted').val();
            var remainingcost = $('#edtitemremaining').val();
            var adjust = $('#edtitemadjust').val();



            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/budget/editLineItems';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'budget/editLineItems';
            }
            $.ajax({
                type: "POST",
                url: url,
                async: false,
                data: {
                    'itemname': itemname, 'itemdescription': itemdescription, 'uom': uom, 'itemquantity': itemquantity, 'cost': cost,
                    'towh': towh, 'BudgetSectionID': BudgetsectionID, 'itemID': itemID,
                    'specnum': specnum, 'vendor': vendor, 'modelnum': modelnum,
                    'header': header, 'notes': notes, 'taxable': taxable, 'nonfreight': nonfreight,
                    'committed': committedcost, 'remaining': remainingcost, 'adjust': adjust
                },
                success: function (data) {
                    if (data == 'SUCCESS') {
                        if (flag) {
                            //UnLockBudget2(versionname);
                            return;
                        }
                        var sectionid = $('#Ddl_SelProSec').val();
                        //loaditems(sectionid);
                        loaditems_new(sectionid);
                        //$('#popupforitemedit').modal('hide');
                        //$('.btnclse').click();

                        // this should be called once the oage is loaded to load only the items table ( To avoid multiple unnecessary calls)
                        // $('#popupforitemedit').modal('hide');
                        //notify('Lineitem Successfully Updated.', 'green');
                        if ($('#IsSentForApproval').val() == "1" && $('#IsBudgetChanged').val() == "1") {
                            $('#svsndAprvl').css('display', '');
                            $('#svsndAprvl').parent().css('display', '');
                        }
                    }

                },
                error: function () { notify('Something went wrong'); }
            });

        }

        function GetNavAndLineItems(LineItemID, BudgetsectionID, mode) {


            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Budget/GetNavAndLineItems';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Budget/GetNavAndLineItems';
            }

            $.ajax({
                type: "POST",
                url: url1,
                async: false,
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                data: "{ 'LineItemID': '" + LineItemID + "', 'BudgetsectionID': '" + BudgetsectionID + "','mode': '" + mode + "'}",
                success: function (response) {




                    totdata = JSON.parse(response);


                    totdata = totdata.data;


                    for (i = 0; i < totdata.length; i++) {



                        var nonfreight = totdata[i].nonfreight;
                        if (nonfreight == 1) {
                            $('#item_nonfreight_edt').prop("checked", true);
                        }
                        else {
                            $('#item_nonfreight_edt').prop("checked", false);
                        }
                        var taxable = totdata[i].Taxable;
                        if (taxable == 1) {
                            $('#item_taxable_edt').prop("checked", true);
                        }
                        else {
                            $('#item_taxable_edt').prop("checked", false);
                        }

                        var ct = numberWithCommas(formatNumber(parseFloat(totdata[i].Commit)));
                        var committedcost = replaceAll(ct, ',', '');


                        var budget_cost = parseFloat(totdata[i].Quantity * totdata[i].Cost);

                        var commit = parseFloat(totdata[i].Commit);
                        var adj = parseFloat(totdata[i].Adjust);

                        var remaining = Math.max((roundnumber(budget_cost) - roundnumber(commit) - adj), 0);
                        var rc = numberWithCommas(formatNumber(parseFloat(remaining)));
                        var remainingcost = replaceAll(rc, ',', '');

                        var ad = parseFloat(totdata[i].Adjust);
                        ad = isNaN(ad) ? "0.00" : ad;
                        var adjust = replaceAll(ad.toString(), ',', '');

                        $('#edtitemcommitted').val(committedcost);
                        $('#edtitemremaining').val(remainingcost);
                        $('#edtitemadjust').val(adjust);

                        //var itemid = totdata[i].LineItemID;
                        $('#itemID').val(totdata[i].LineItemID);

                        //var item = totdata[i].ItemDescription;
                        $('#edtitemname').val(totdata[i].ItemDescription);

                        //var itemdesc = totdata[i].ItemDescription;
                        $('#edtdesc').val(totdata[i].ItemDescription);

                        //var modelnum = totdata[i].Model;

                        $('#edtmodelnum').val(totdata[i].Model);


                        var TotalID = totdata[i].TotalID;
                        var stng = "Edit Line Item - " + TotalID;

                        $('.TotalID').text(stng);


                        //var specnum = totdata[i].SpecNum;
                        $('#edtspecnum').val(totdata[i].SpecNum);

                        //var vendor = totdata[i].Vendor;
                        $('#edtvendor').val(totdata[i].Vendor);

                        //var header = totdata[i].Header;
                        $('#edtcategory').val(totdata[i].Header);

                        //var notes = totdata[i].Note;
                        $('#edtnotes').val(totdata[i].Note);

                        //var qty = totdata[i].Quantity
                        $('#edtqty').val(totdata[i].Quantity);

                        var uom = totdata[i].UOMID;


                        //var cost = totdata[i].Cost;
                        $('#edtcost').val(totdata[i].Cost);


                        var wh = totdata[i].ToWarehouse;

                        if (wh == 1) {
                            $('#edtwh').prop("checked", true);
                        }
                        else {
                            $('#edtwh').prop("checked", false);
                        }
                        var obj = $('#uom').clone();
                        $('#edtuom').remove();
                        $(obj).attr('id', 'edtuom');
                        $('#uomselect').append(obj);
                        $('#edtuom').val(uom).change();

                        //$('#popupforitemedit').modal('show');
                        break;
                    }
                },
                error: function () {
                    notify('Something went wrong.');
                }



            });

            editlineitempopup();
            setTimeout(function () {
                cancelselections();
            }, 0);
        }




    </script>

