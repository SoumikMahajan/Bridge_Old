        $(function () {
            var pid = $("#PrjtDdl option:selected").attr('data-id');
            getsections(pid, '', '');
            getpdetails(pid);
            if ($("#PrjtDdl option:selected").attr('data-id') == "0") {
                $('#btn_AddSctn').val("Add section");
            }
            else {
                $('#btn_AddSctn').val("Add section for " + $("#PrjtDdl option:selected").text());
            }
            $('#PrjtDdl').change(function () {
                if ($("#PrjtDdl option:selected").attr('data-id') == "0") {
                    $('#btn_AddSctn').val("Add section");
                }
                else {
                    $('#btn_AddSctn').val("Add section for " + $("#PrjtDdl option:selected").text());
                }
                var pid = $("#PrjtDdl option:selected").attr('data-id');
                getsections(pid, $('#txt_srchnumber').val().trim(), $('#txt_srchname').val().trim());
                getpdetails(pid);
            });
            $('#btn_AddSctn').click(function () {
                var pid = $('#PrjtDdl').find(":selected").attr('data-id');
                if (pid == 0) {
                    notify("Please select Project");
                    return;
                }
                var sectionname = $('#txt_BudgetDesc').val().trim();
                var sectionnumber = parseInt($('#txt_BudgetNumber').val().trim());
                if (isNaN(sectionnumber)) {
                    errorfunc('txt_BudgetNumber', 'Please enter a valid section number');
                    notify("Please enter a valid section number");
                    return;
                }
                sectionnumber = parseInt(sectionnumber);
                if (sectionnumber > 999) {
                    notify("Please use numbers between 1 - 999");
                    return;
                }
                else if (sectionnumber <= 9) {
                    sectionnumber = "00" + sectionnumber;
                }
                else if (sectionnumber <= 99) {
                    sectionnumber = "0" + sectionnumber;
                }
                if (sectionname == '') {
                    errorfunc('txt_BudgetDesc', 'Please add section name')
                    notify('Add section name');
                    return;
                }
                var url = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url = '/budget/addProjectSection';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url = 'budget/addProjectSection';
                }
                $.ajax({
                    type: "POST",
                    url: url,
                    data: { 'projectid': pid, 'sectionname': sectionname, 'sectionnumber': sectionnumber },
                    success: function (data) {
                        if (data == 'SUCCESS') {
                            notify('Budget section added.', 'green');
                            window.setTimeout(function () {
                                window.location.reload();
                            }, 3000);

                        }
                        else {
                            notify("Section not added duplicat exists!!!");
                        }
                    },
                    error: function () { notify('Something went wrong'); }
                });
            });
        });
        function hideallexpanded() {
            $('.sectiondiv').css('background', '#208093');
            $('.sectiondiv').css('height', 'auto');
            $('.sectiondiv').find('span').show();
            $('.sectiondiv').find('div').show();
            $('.sectiondiv').find('input').remove();
            $('.sectiondiv').find('.minus').remove();
            $('.sectiondiv').find('i').show();
            $('.sectiondiv i').attr('onclick', 'sectionclicked(this);');
        }
        function sectionclicked(obj) {
            var id = $(obj).parent().parent().attr('id');
            var name = $(obj).parent().parent().find('.name').text();
            var order = $(obj).parent().parent().find('.order').text();
            $('#sectioneditorid').val(id);
            $('#sectioneditorname').val(name);
            $('#sectioneditornumber').val(order);
            $('#sectioneditor').modal('show');
            return;
            //$('#sectioneditor').modal('toggle');
            //$('#sectioneditor').modal('hide');
            $('.sectiondiv').css('background', '#208093');
            $('.sectiondiv').css('height', 'auto');
            $('.sectiondiv').find('span').show();
            $('.sectiondiv').find('input').remove();
            $('.sectiondiv').find('.minus').remove();
            $('.sectiondiv').find('i').show();
            $('.sectiondiv i').attr('onclick', 'sectionclicked(this);');
            //alert(1);
            // $(obj).parent().css('background', '#7c97a8');//.css('height', 'auto');
            $(obj).attr('onclick', '');
            $(obj).parent().parent().find('span').hide();
            $(obj).parent().parent().find('div').hide();
            $(obj).hide();
            var html = '<i onclick="hideallexpanded();" style="" class="fa fa-minus-circle minus"></i>';
            html += '<input type="text" style="color: black;margin: 5px;" value="' + name + '">';
            html += '<input type="text" style="color: black;margin: 5px;" class="numberonly" value="' + order + '"><input type="button" style="color: black;margin: 5px;" value="Save changes" onclick="editsection(this,\'' + id + '\');" />';
            html += '<input type="button" style="color: black;margin: 5px;" value="Remove section" onclick="removesection(this,\'' + id + '\');" />';
            $(obj).parent().parent().append(html);
            //alert(obj);
        }
        function removesection(obj, id) {
            var a = confirm("You really want to delete the section?");
            if (!a) {
                return;
            }
            else {
                var url = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url = '/budget/deleteProjectSection';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url = 'budget/deleteProjectSection';
                }
                $.ajax({
                    type: "POST",
                    url: url,
                    data: { 'sectionid': id },
                    success: function (data) {
                        if (data == 'SUCCESS') {
                            var prnt = $(obj).parent();
                            $(prnt).remove();
                            var pid = $("#PrjtDdl option:selected").attr('data-id');
                            getsections(pid, $('#txt_srchnumber').val().trim(), $('#txt_srchname').val().trim());
                        }
                        else if (data == "DATAEXISTS") {
                            notify("Lineitems exists.Not removed.");
                        }
                        else {
                            notify("Something went wrong.");
                        }
                    },
                    error: function () { notify('Something went wrong'); }
                });
            }
        }
        function removesectionnew() {
            var id = $('#sectioneditorid').val();
            var a = confirm("You really want to delete the section?");
            if (!a) {
                return;
            }
            else {
                var url = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url = '/budget/deleteProjectSection';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url = 'budget/deleteProjectSection';
                }
                $.ajax({
                    type: "POST",
                    url: url,
                    data: { 'sectionid': id },
                    success: function (data) {
                        if (data == 'SUCCESS') {
                            notify("Successfully Deleted.");
                            $('#sectioneditor').modal("hide");
                            window.location.reload();
                        }
                        else if (data == "DATAEXISTS") {
                            notify("Lineitems exists.Not removed.");
                        }
                        else {
                            notify("Something went wrong.");
                        }
                    },
                    error: function () { notify('Something went wrong'); }
                });
            }
        }
        function editsection(obj, id) {
            var sectionname = '';
            var sectionnumber = '';
            var chksctnnm = '0';
            var a = 0;
            $(obj).parent().find('input[type="text"]').each(function () {
                if (a == 0) {
                    sectionname = $(this).val();
                    //alert(sectionname);
                    if (sectionname.trim() == '') {
                        chksctnnm = '1';
                        notify("Please add section name");
                        return;
                    }
                    a++;
                }
                else {
                    sectionnumber = parseInt($(this).val());
                    if (isNaN(sectionnumber)) {
                        notify("Please enter a valid section number");
                        return;
                    }
                    sectionnumber = parseInt(sectionnumber);
                    if (sectionnumber > 999) {
                        notify("Please use numbers between 1 - 999");
                        return;
                    }
                    else if (sectionnumber <= 9) {
                        sectionnumber = "00" + sectionnumber;
                    }
                    else if (sectionnumber <= 99) {
                        sectionnumber = "0" + sectionnumber;
                    }
                }
            });
            if (chksctnnm == '1') {
                return;
            }
            if (sectionname.trim() == '') {
                return;
            }
            if (isNaN(sectionnumber) || sectionnumber > 999) {
                return;
            }
            var pid = $('#PrjtDdl').find(":selected").attr('data-id');
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/budget/editProjectSection';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'budget/editProjectSection';
            }
            $.ajax({
                type: "POST",
                url: url,
                data: { 'sectionid': id, 'sectionname': sectionname, 'projectid': pid, 'sectionnumber': sectionnumber },
                success: function (data) {
                    if (data == 'SUCCESS') {
                        var prnt = $(obj).parent();
                        $(obj).parent().find('span').text(sectionnumber + "-" + sectionname);
                        $('.sectiondiv').css('background', '#208093');
                        $('.sectiondiv').css('height', 'auto');
                        $('.sectiondiv').find('span').show();
                        $('.sectiondiv').find('div').show();
                        $('.sectiondiv').find('input').remove();
                        $('.sectiondiv').find('.minus').remove();
                        $('.sectiondiv').find('i').show();
                        $('.sectiondiv i').attr('onclick', 'sectionclicked(this);');
                        var pid = $("#PrjtDdl option:selected").attr('data-id');
                        getsections(pid, $('#txt_srchnumber').val().trim(), $('#txt_srchname').val().trim());
                        //$(obj).parent().css('height', 'auto');
                        //$(obj).parent().find('span').show();
                        //$(obj).parent().find('input').remove();
                        //$(obj).parent().find('.minus').remove();
                        //$(obj).remove();
                        //window.setTimeout(function () {
                        //    $(prnt).attr('onclick', 'sectionclicked(this);');
                        //}, 1000);
                    }
                    else if (data == "DATAEXISTS") {
                        notify("Lineitems exists Not updated.");
                    }
                    else if (data == "DUPLICATE") {
                        notify("Duplicate Exists Not updated.");
                    }
                    else {
                        notify("Not updated.");
                    }
                },
                error: function () { notify('Something went wrong'); }
            });
        }
        function editsectionnew() {
            var id = $('#sectioneditorid').val();
            var sectionname = $('#sectioneditorname').val();
            if (sectionname.trim() == '') {
                chksctnnm = '1';
                notify("Please add section name");
                return;
            }
            var sectionnumber = $('#sectioneditornumber').val();
            if (isNaN(sectionnumber)) {
                notify("Please enter a valid section number");
                return;
            }
            sectionnumber = parseInt(sectionnumber);
            if (sectionnumber > 999) {
                notify("Please use numbers between 1 - 999");
                return;
            }
            else if (sectionnumber <= 9) {
                sectionnumber = "00" + sectionnumber;
            }
            else if (sectionnumber <= 99) {
                sectionnumber = "0" + sectionnumber;
            }
            var chksctnnm = '0';
            var pid = $('#PrjtDdl').find(":selected").attr('data-id');
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/budget/editProjectSection';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'budget/editProjectSection';
            }
            $.ajax({
                type: "POST",
                url: url,
                data: { 'sectionid': id, 'sectionname': sectionname, 'projectid': pid, 'sectionnumber': sectionnumber },
                success: function (data) {
                    if (data == 'SUCCESS') {
                        notify("Successfully Edited.",'green');
                      //  $('#sectioneditor').modal("hide");

                        window.setTimeout(function () {
                            window.location.reload();
                        }, 3000);



                    }
                    else if (data == "DATAEXISTS") {
                        notify("Lineitems exists Not updated.");
                    }
                    else if (data == "DUPLICATE") {
                        notify("Duplicate Exists Not updated.");
                    }
                    else {
                        notify("Not updated.");
                    }
                },
                error: function () { notify('Something went wrong'); }
            });
        }
        function srch() {
            var pid = $("#PrjtDdl option:selected").attr('data-id');
            getsections(pid, $('#txt_srchnumber').val().trim(), $('#txt_srchname').val().trim());
        }
    </script>
    <style>
        .srch {
            width: 45%;
            margin-left: 1%;
            /* float: left; */
            margin-top: 20px;
        }
    </style>
    <script type="text/javascript">
        $(document).ready(function () {
            $("#PrjtDdl").multiselect({
                multiple: false
                //,header: "Select an option"
                , noneSelectedText: "Select a Project"
                //,selectedList: 1
            }).multiselectfilter();
            var width = '100%';
            $('.ui-multiselect').css('width', width);
            //$('.ui-multiselect-menu').css('width', '39.5%');
            $('.ui-multiselect-menu').css('width', '39.5%');
            $('.ui-state-default').css('color', '#C31001');
            $('.ui-multiselect').css('height', '34px');
            $('.ui-multiselect').css('margin-top', '5px');
        });
        function ProjectNameAtLabel(obj) {
            var Projectval = $(obj).find("option:selected").attr('data-id');
            Projectval = Projectval == null ? "" : Projectval.toString();
            var ProjectText = $(obj).find('option:selected').text();
            ProjectText = ProjectText == null ? "" : ProjectText.toString();
            if (Projectval.toString() == null || Projectval.toString() == undefined || Projectval.toString() == 'undefined') {
                $('#lbl_ProjectName').html('No project has been selected.');
                return;
            }
            if (Projectval.toString() == '0') {
                $('#lbl_ProjectName').html('No project has been selected.');
            }
            else {
                $('#lbl_ProjectName').html('Selected Project : ' + $(obj).find('option:selected').text());
            }
        }
    </script>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-12">
                <h3 class="section-header">Budget section</h3>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12 req">
                <label>Project</label>
                <select id="PrjtDdl" onchange="ProjectNameAtLabel(this);" class="form-control">
                    <option data-id='0'>---Select Project---</option>
                    @Html.Raw(ViewData["getAllProjectName"])
                </select>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <label id="lbl_ProjectName">No project has been selected.</label>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div id="filtered1" style="overflow-y: auto; color: #7792A8; font-size: 13pt; font-weight: bold;">
                </div>
            </div>
        </div>
        <div class="row mrg10T">
            <div class="col-sm-6">
                <input placeholder="Search By Number" type="text" onkeyup="srch();" id="txt_srchnumber" class="SectionRangeonly form-control" />
                @*class="numberonly"*@
            </div>
            <div class="col-sm-6">
                <input placeholder="Search By Name" type="text" onkeyup="srch();" id="txt_srchname" class="form-control" />
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div id="filtered2" style="overflow-y: auto; color: #748FA5; font-size: 13pt; font-weight: bold;">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div id="projectsections" style="max-height: 500px; overflow-y: auto;">
                </div>
            </div>
        </div>
    </div>
    <!-- Modal -->
    <div id="sectioneditor" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Edit Section</h4>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <input type="hidden" id="sectioneditorid" />
                        <div class="col-sm-6">
                            <label>Section Name</label>
                            <input type="text" class="form-control" id="sectioneditorname" />
                        </div>
                        <div class="col-sm-6">
                            <label>Section Number</label>
                            <input type="text" class="form-control" id="sectioneditornumber" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-info" onclick="removesectionnew();">Remove Data</button>
                    <button type="button" class="btn btn-info" onclick="editsectionnew();">Save Data</button>
                </div>
            </div>
        </div>
    </div>
    <div id="addnewsection" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Add Section</h4>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-sm-6 req">
                            <label>Section number</label>
                            <input type="text" class="numberonly form-control" id="txt_BudgetNumber" />
                        </div>
                        <div class="col-sm-6 req">
                            <label>Section Name</label>
                            <input type="text" id="txt_BudgetDesc" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-poms" id="btn_AddSctn">Add Section</button>
                </div>
            </div>
        </div>
    </div>
    <div class="float-panel-container">
        <ul>
            <li onclick="openaddsectionpopup();"><a href="javascript:void(0);"><i class="fa fa-plus mrg5R" title="Add New Section" data-toggle="tooltip"></i><span class="tooltip-toggle">Add New Section</span></a></li>
        </ul>
    </div>
    <script>
        function openaddsectionpopup() {
            $('#addnewsection').modal('show');
        }
        var ProjectDdlForPage = $('#PrjtDdl'); //The project dropdown ID
        $(document).ready(function () {
            var selectedpreferredpid = getProjectPreference();
            if (selectedpreferredpid.split(',').length > 0) {
                selectedpreferredpid = selectedpreferredpid.split(',')[0];
            }
            $(ProjectDdlForPage).find('option').each(function () {
                if ($(this).attr('data-id') == selectedpreferredpid) {
                    $(this).attr("selected", "true");
                }
            });
            $(ProjectDdlForPage).multiselect('refresh');
            var width = '100%';
            $('.ui-multiselect').css('width', width);
            $('.ui-multiselect-menu').css('width', '39.5%');
            $('.ui-state-default').css('color', '#C31001');
            $('.ui-multiselect').css('height', '34px');
            $('.ui-multiselect').css('margin-top', '5px');
            //To call page specific dropdown change event
            ProjectNameAtLabel(ProjectDdlForPage);
            var pid = selectedpreferredpid;
            getsections(pid, '', '');
            getpdetails(pid);
            if (selectedpreferredpid == "0") {
                $('#btn_AddSctn').val("Add section");
            }
            else {
                $('#btn_AddSctn').val("Add section for " + $("#PrjtDdl option:selected").text());
            }
        });
        $(document).on('change', ProjectDdlForPage, function () {
            setProjectPreferenceBS(ProjectDdlForPage);
        });
    </script>
</body>
</html>
