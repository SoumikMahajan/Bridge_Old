            else if (FieldNameRight == "BCONVRT") {
                FieldNameRight = "Conv";
            }//Conversion Rate</option) { }//
            else if (FieldNameRight == "BITMAPPRVL") {
                FieldNameRight = "ActionType";
            }//Item Approvals</option) { }//
            else if (FieldNameRight == "BFOB") {
                FieldNameRight = "FOB";
            }//FOB</option) { }//
            else if (FieldNameRight == "BARRVLDT") {
                FieldNameRight = "ArrivalDate";
            }//Arrival Date</option) { }//
            else if (FieldNameRight == "BCHKBCK") {
                FieldNameRight = "CheckBackDate";
            }//Check back</option) { }//
            else if (FieldNameRight == "BITMSTTS") {

                FieldNameRight = "ItemStatus";
            }//Item Status</option) { }//
            else if (FieldNameRight == "BINV") {
                FieldNameRight = "Inv";
            }//Invoice</option) { }//
            else if (FieldNameRight == "BPOQTY") {

                FieldNameRight = "Qty";
            }//PO Qty</option) { }//
            else if (FieldNameRight == "BRQTY") {
                FieldNameRight = "ReceivedQuantity";
            }//R-Qty</option) { }//
            else if (FieldNameRight == "BSHPVIA") {
                FieldNameRight = "ShipMethod";
            }//Ship via</option) { }//
            else if (FieldNameRight == "BSHPTO") {
                FieldNameRight = "ShipTo";
            }//Ship To</option) { }//
            else if (FieldNameRight == "BFRGHT") {
                FieldNameRight = "Freight";
            }//Freight</option) { }//
            else if (FieldNameRight == "BRMRKS") {
                FieldNameRight = "Remarks";
            }//Remarks</option) { }//

            else if (FieldNameRight == "VPOLNITMNMBR") { FieldNameRight = "POLineItemID"; }//PO LineItem Number</option) { }//
            else if (FieldNameRight == "VSPCNMBR") { FieldNameRight = "SpecNum"; }//Spec Number</option) { }//
            else if (FieldNameRight == "VITMDESC") { FieldNameRight = "ItemDescription"; }//Item Description</option) { }//
            else if (FieldNameRight == "VITMAPPRVL") { FieldNameRight = "ItemApprovals"; }//Item Approvals</option) { }//
            else if (FieldNameRight == "VITMSTTS") { FieldNameRight = "ItemStatus"; }//ItemStatus</option) { }//
            else if (FieldNameRight == "VRQTY") { FieldNameRight = "ReceivedQuantity"; }//R-Qty</option) { }//
            else if (FieldNameRight == "VINV") { FieldNameRight = "Invoice"; }//Invoice</option) { }//
            else if (FieldNameRight == "VPOQTY") { FieldNameRight = "Quantity"; }//PO Qty</option) { }//


            if (SearchOptionRight == "GREATERTHAN") {
                SearchOptionRight = ">";
            }
            else if (SearchOptionRight == "LESSTHAN") {
                SearchOptionRight = "<";
            }
            else if (SearchOptionRight == "EQUALS") {
                SearchOptionRight = "=";
            }
            else if (SearchOptionRight == "MATCH") {
                SearchOptionRight = "like";
            }
            else if (SearchOptionRight == "NOTMATCH") {
                SearchOptionRight = "not like";
            }

            if (FieldNameRight == null || FieldNameRight == '0') {
                notify("Please Select search field crieteria");
                return;
            }
            if (SearchOptionRight == null || SearchOptionRight == '0') {
                notify("Please Select search operator");
                return;
            }

            if (SearchVal == null || SearchVal.trim() == '') {
                notify("Please Select search value");
                return;
            }

            var wclause = "";


            if ($('#ThirdSearchDdlRight').hasClass('displayoff')) {
                wclause = "convert(datetime," + FieldNameRight + ",103)" + " " + SearchOptionRight + " convert(datetime,'" + SearchVal + "',103)";
            }


            else if (SearchOptionRight == "like" || SearchOptionRight == "not like") {
                wclause = FieldNameRight + " " + SearchOptionRight + " '^" + SearchVal + "^'";

            }
            else {
                wclause = FieldNameRight + " " + SearchOptionRight + " " + SearchVal;
            }

            return wclause;


        }


