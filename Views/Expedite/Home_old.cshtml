        function OpenHistoryPopUp(obj, obj2) {

            

            var url1 = '';

            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = 'http://www.thebridgebytcg.com/PurchaseOrder/isManager';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                //url1 = urlsuffix + "/" + 'Project/getAllProjectList';
                url1 = 'PurchaseOrder/isManager';
            }


            $.ajax({
                type: "POST",
                dataType: "JSON",
                sync: false,
                contentType: "application/json; charset=utf-8",
                url: url1,
                data: "{ 'PurchaseOrderID': '" + obj2 + "'}",
                success: function (data) {

                    $('#hdn_isManager').val(data);
                }

            });



            $('#Hdn_POLineItemID').val(obj);
            $('#Hdn_PurchaseOrderID').val(obj2);

            approvallist();

            jQuery('#popupforHistory').bPopup({
                easing: 'easeOutBack', //uses jQuery easing plugin
                speed: 450,
                transition: 'slideDown',
                modalColor: 'rgb(18, 54, 65)',
                position: [0, 0]
            });


            

        }
    </script>

