                contentType: "application/json; charset=utf-8",
                url: url,
                data: "{ 'POLineItemApprovalID': '" + POLineItemApprovalID + "','ActionType' : '" + ActionType + "','ActionDate' : '" + ActionDate + "','Comment' : '" + Comment + "','FileName' : '" + FileName + "','ActionByProjectManager' : '" + ActionByProjectManager + "'}",
                success: function (data) {
                    var lastinsertedid = data;
                    //alert(data);




                    var url2 = '';
                    if (LOCALORSERVERNEW == 'LOCAL') {
                        url2 = 'http://www.thebridgebytcg.com/UploadFile/UploadForApprovals?fileid=';
                    }
                    else if (LOCALORSERVERNEW == 'SERVER') {

                        url2 = 'UploadFile/UploadForApprovals?fileid=';
                    }

                    url2 += lastinsertedid;
                    var data = new FormData();

                    data.append('file-1', $('#file_' + POLineItemApprovalID)[0].files[0]);


                    $.ajax({
                        type: "POST",
                        async: false,
                        dataType: "json",
                        cache: false,
                        contentType: false,
                        processData: false,
                        url: url2,
                        data: data,
                        success: function (data) {
                            approvallist();
                        }

                    });

                    approvallist();
                }

            });

        }

        function ddl_actiontype_change(id, obj) {


            var ddlid = $(obj).val();

            if (ddlid == "1" || ddlid == "6") {



                $('#datepicker_' + id).show();


            }
            else {
                $('#datepicker_' + id).hide();
            }


            if (ddlid == "1") {

                BindUserOnchange('GETUSERSFORRECEIVE', id);

            }
            else if (ddlid == "4") {
                BindUserOnchange('GETUSERSFORCOMMENT', id);

            }
            else if (ddlid == "6") {
                BindUserOnchange('GETUSERSFORSEND', id);

            }
            else {
                BindUserOnchangeForApproveReject(id);
            }




        }

        function BindUserOnchange(Mode, id) {
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = 'http://www.thebridgebytcg.com/PurchaseOrder/GetUsers';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {

                url = 'PurchaseOrder/GetUsers';
            }


            $.ajax({
                type: "POST",
                async: false,
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                url: url,
                data: "{ 'Mode': '" + Mode + "'}",
                success: function (data) {


                    var html = '';
                    var userddl = "";
                    userddl = data;
                    html += "<option value='0'>---Select User---</option>" + userddl + "</select>";

                    $('#ddl_selectuser_' + id).html(html);



                }

            });

        }

        function BindUserOnchangeForApproveReject(ItemApprovalID) {


            var PurchaseOrderID = $('#Hdn_PurchaseOrderID').val();
            var html = "";
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = 'http://www.thebridgebytcg.com/PurchaseOrder/CheckManager';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {

                url = 'PurchaseOrder/CheckManager';
            }


            $.ajax({
                type: "POST",
