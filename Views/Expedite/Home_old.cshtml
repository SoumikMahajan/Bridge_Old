    <script type="text/javascript">

        function EditExpediteNote(obj,objself) {

            var rw = $(objself).parent().parent();
            ////console.log(rw);

            var status = $(rw).find('td').eq('0').html();
            var note = $(rw).find('td').eq('1').html();
            var rqty = $(rw).find('td').eq('2').html();
            var rdate = $(rw).find('td').eq('3').html();
            var ref = $(rw).find('td').eq('4').html();

            var newddl = $('#ddl_ItemStatus').clone();
            $(newddl).attr('id', 'newddl_ItemStatus');

            var html = "";
            html += "<input type='text' id='edtnote' value='" + note + "'/>";
            html += "<input type='text' id='edtrqty' value='" + rqty + "'/>";
            html += "<input type='text' id='edtrdate' value='" + rdate + "'/>";
            html += "<input type='text' id='edtref' value='" + ref + "'/>";
            html += "<input type='button' id='edtref' data-id='" + obj + "' value='Save' onclick='editexpeditenote(this);'/>";




            
            $('#popupforeditexpediteinner').html('');
            $('#popupforeditexpediteinner').append(newddl);
            $('#popupforeditexpediteinner').append(html);


            var currentDate = new Date();
            
            $('#edtrdate').datepicker();
           
            $('#edtrdate').datepicker({ dateFormat: 'dd-mm-yy' });


            $("#newddl_ItemStatus option").each(function () {
                if ($(this).text() == status) {
                    $(this).attr('selected', 'selected');
                }
            });


            jQuery('#popupforeditexpedite').bPopup({
                easing: 'easeOutBack', //uses jQuery easing plugin
                speed: 450,
                transition: 'slideDown',
                modalColor: 'rgb(18, 54, 65)',
                position: [0, 0]
            });
            
            
        }

        function editexpeditenote(obj) {

            var FldID = $(obj).attr('data-id');
            var ItemStatus = $('#newddl_ItemStatus').val();
            var POLineItemExpediteNote = $('#edtnote').val();
            var ReceiveQty = $('#edtrqty').val();
            var ReceiveDate = $('#edtrdate').val();
            var Reference = $('#edtref').val();

            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = 'http://www.thebridgebytcg.com/Expedite/UpdateExpediteNotes';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {

                url = 'Expedite/UpdateExpediteNotes';
            }


            $.ajax({
                type: "POST",
                async: false,
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                url: url,
                data: "{ 'FldID': '" + FldID + "','POLineItemID' : '" + '' + "','ItemStatus' : '" + ItemStatus + "','POLineItemExpediteNote' : '"
                    + POLineItemExpediteNote + "','ReceiveQty' : '" + ReceiveQty + "','ReceiveDate' : '" + ReceiveDate + "','Reference' : '" + Reference + "'}",
                success: function (data) {
                    $('#popupforeditexpedite').bPopup().close();

                    

                    var POLineItemID = $('#Hdn_POLineItemID').val(); // Dynamic

                    DdlLineItemStatusByProjectID(POLineItemID);
                    ViewPOExpediteHistory(POLineItemID);
                    ViewPOLineItemExpediteHistory(POLineItemID);

                }

            });



        }

