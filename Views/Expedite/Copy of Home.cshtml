        function approvallist() {

            var ItemnameForSearch = $('#srchfrname').val();
            if (ItemnameForSearch == undefined) {
                ItemnameForSearch = "";
            }

            ItemnameForSearch = ItemnameForSearch.trim();

            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = 'http://www.thebridgebytcg.com/PurchaseOrder/getApprovalItemsexpeditepage';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {

                url = 'PurchaseOrder/getApprovalItemsexpeditepage';
            }


            $.ajax({
                type: "POST",
                dataType: "JSON",
                sync: false,
                contentType: "application/json; charset=utf-8",
                url: url,
                data: "{ 'POLineitemID': '" + $('#Hdn_POLineItemID').val() + "','ItemnameForSearch' : '" + ItemnameForSearch + "'}",
                success: function (data) {
                    data = data.data;
                    var html = "";



                    for (var i = 0; i < data.length; i++) {

                        var itemid = data[i].ItemID;

                        //$("#ddlItemApprovalType option[value='" + itemid + "']").remove();
                        //$("#ddlItemApprovalType option[value='" + itemid + "']").attr('disabled', 'disabled');


                        var id = data[i].ItemApprovalID;
                        var approverstatus = Check_ApproverStatusPOItems(id);
                        var approvedby = approverstatus.split('^')[0];
                        var requiredby = approverstatus.split('^')[1];
                        var progress = "Approved By: " + approvedby + " Out of " + requiredby + "</br><progress value='" + approvedby + "' max='" + requiredby + "'></progress>";
                        var action = "<br /><label style='padding: 0px;'>Action: </label><select class='form-control' onchange='ddl_actiontype_change(\"" + id + "\",this);' id='ddl_actiontype_" + id + "'>";
                        action += "<option value='0'>---Select Action---</option>" + getallowedactions(id) + "</select>";

                        var isManager = $('#hdn_isManager').val();

                        if (isManager == "1") {

                            action += "<label style='padding: 0px;'>On Behalf of:</label><select class='form-control' onchange='ddl_userselectformanager_change(\"" + id + "\",this);' id='ddl_selectuser_" + id + "'></label>";
                            var userddl = "";
                            userddl = checkismanager(id);
                            action += "<option value='0'>---Select User---</option>" + userddl + "</select>";
                        }

                        action += "<p id='datepicker_" + id + "' style='display:none;'>Date: <input type='text' readonly  class='dtpicker' data-mindate='" + data[i].ActionDate + "'></p>";


                        var rspn = data[i].History.length + 1;

                        html += "<tr>";
                        html += "<td valign='top' rowspan='" + rspn + "'>" + "<button type='button' onclick='saveactionapproval(\"" + id + "\");' class='btn btn-poms' value='Save'>Save</button>" + "</td>";

                        if (approvedby == requiredby) {
                            html += "<td valign='top' style='text-align: center;'  rowspan='" + rspn + "'>" + data[i].ItemName + "</td>";
                        }
                        else {
                            html += "<td style='text-align:center;' valign='top' style='text-align: center;'  rowspan='" + rspn + "'>" + data[i].ItemName + "</td>";

                        }


                        //html += "<td rowspan='" + rspn + "'>" + action + "</td>";
                        //html += "<td rowspan='" + rspn + "'>" + "<textarea id='textarea_" + id + "'></textarea>" + "</td>";
                        //html += "<td rowspan='" + rspn + "'>" + "<input class='choosefile' style='width: 84px;' type='file' id='file_" + id + "' />" + "<span style='float: left; color: rgb(32, 128, 147);'></span></td>";

                        html += "<td valign='top' rowspan='" + rspn + "'>"
                            + ""
                            + progress
                            + ""
                            + "" + action + "";
                        html += "<label>Comment :</label>" + "<textarea class='form-control no-resize' rows='4' id='textarea_" + id + "'></textarea>" + "";
                        html += "Attachment :<br/>" + "<input onchange='filechange(this);' multiple type='file' id='file_" + id + "' />" + "<span style='float: left; color: rgb(32, 128, 147);'></span></td>";

                        var action = data[i].ActionType;

                        html += "<td>" + action + " on <span style='color:green'><strong>" + data[i].ShowDate + "</span></strong> by <span style='color:green'><strong>" + data[i].Username + "</strong></span></td>";
                        html += "<td></td></tr>";

                        for (var j = 0 ; j < data[i].History.length; j++) {

                            var fname = '';
                            if (LOCALORSERVERNEW == 'LOCAL') {
                                fname = 'http://www.thebridgebytcg.com/Assets/Approvals/';
                            }
                            else if (LOCALORSERVERNEW == 'SERVER') {

                                fname = 'Assets/Approvals/';
                            }

                            var ManagerName = data[i].History[j].ManagerName;
                            var username = data[i].History[j].Username;
                            var finalusername = "";
                            if (ManagerName.trim() == "") {
                                finalusername = "<span style='color:green'><strong>" + username + "</strong>";
                            }
                            else {
                                finalusername = "<span style='color:green'><strong>" + ManagerName + "</span></strong> On behalf of <span style='color:green'><strong>" + username + "</strong>";
                            }

                            fname += data[i].History[j].FileNamePhysical;
                            var fnameshow = data[i].History[j].FileNameToShow;

                            var action = data[i].History[j].ActionType;

                            if (action == "Add Comment") {
                                action = "Commented";
                            }
                            else if (action == "Approve") {
                                action = "Approved";
                            }
                            else if (action == "Reject") {
                                action = "Rejected";
                            }
                            else if (action == "Send") {
                                action = "Sent";
                            }
                            else if (action == "Receive") {
                                action = "Received";
                            }

                            html += "<tr>";

                            html += "<td style='padding: 5px;'>" + action + " on <span style='color:green'><strong>"
                                  + data[i].History[j].ShowDate
                                  + "</strong></span> by " + finalusername + "&nbsp;<u><a target='_blank' href='" + fname + "'>" + fnameshow + "</a></u></span></td>";
                            html += "<td>" + data[i].History[j].comment + "</td>"
                            html += "</tr>";

                        }
                    }

                    if (html == "") {
                        $('#itemapprovals tbody').html("<tr><td style='text-align: center;' colspan='6'>No data available</td></tr>");
                    }
                    else {
                        $('#itemapprovals tbody').html(html);
                    }
                    $('.dtpicker').each(function () {
                        var currentDate = new Date();
                        var mindate = $(this).attr('data-mindate');
                        $(this).datepicker({ minDate: mindate, maxDate: +0 });
                        $(this).datepicker("setDate", currentDate);
                        $(this).datepicker({ dateFormat: 'dd-mm-yy' });
                    });
                }

            });

        }



        function Check_ApproverStatusPOItems(POLineItemApprovalID) {
            var result = "";
            var PurchaseOrderID = $('#Hdn_PurchaseOrderID').val();
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = 'http://www.thebridgebytcg.com/PurchaseOrder/Check_ApproverStatusPOItems';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {

                url = 'PurchaseOrder/Check_ApproverStatusPOItems';
            }


            $.ajax({
                type: "POST",
                async: false,
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                url: url,
                data: "{ 'PurchaseOrderID': '" + PurchaseOrderID + "','POLineItemApprovalID' : '" + POLineItemApprovalID + "'}",
                success: function (data) {

                    result = data;
                }

            });


            return result;
        }
