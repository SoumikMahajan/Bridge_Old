        function saveactionapproval(POLineItemApprovalID) {

            var FileName = "";

            if ($('#file_' + POLineItemApprovalID)[0].files[0] != undefined) {
                FileName = $('#file_' + POLineItemApprovalID)[0].files[0].name;
            }

            //var len = $('#ddl_selectuser_' + POLineItemApprovalID).length();
            var isManager = $('#hdn_isManager').val();

            var ActionType = $('#ddl_actiontype_' + POLineItemApprovalID).val();
            if (ActionType == 0) {
                notify("Please select an Action");
                return;
            }

            var ActionByProjectManager = "0";

            if (isManager == "1") {

                var ActionByProjectManager = $('#ddl_selectuser_' + POLineItemApprovalID).val();

                if (isManager == "1" && ActionByProjectManager == "0" && (ActionType == "2" || ActionType == "3")) {
                    notify("Please select  a user");
                    return;
                }

            }

            //alert(ActionByProjectManager);

            //return;










            var ActionDate = "";

            if (ActionType == "1" || ActionType == "6") {

                ActionDate = $('#datepicker_' + POLineItemApprovalID).find('input').val();

            }


            var Comment = $('#textarea_' + POLineItemApprovalID).val().trim();

            if (Comment == "" && (ActionType == "3" || ActionType == "4")) {
                notify("Please add comment");
                return;
            }

            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = 'http://www.thebridgebytcg.com/PurchaseOrder/AddPOApprovalItem';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {

                url = 'PurchaseOrder/AddPOApprovalItem';
            }


            $.ajax({
                type: "POST",
                async: false,
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                url: url,
                data: "{ 'POLineItemApprovalID': '" + POLineItemApprovalID + "','ActionType' : '" + ActionType + "','ActionDate' : '" + ActionDate + "','Comment' : '" + Comment + "','FileName' : '" + FileName + "','ActionByProjectManager' : '" + ActionByProjectManager + "'}",
                success: function (data) {
                    var lastinsertedid = data;
                    //alert(data);




                    var url2 = '';
                    if (LOCALORSERVERNEW == 'LOCAL') {
                        url2 = 'http://www.thebridgebytcg.com/UploadFile/UploadForApprovals?fileid=';
                    }
                    else if (LOCALORSERVERNEW == 'SERVER') {

                        url2 = 'UploadFile/UploadForApprovals?fileid=';
                    }

                    url2 += lastinsertedid;
                    var data = new FormData();

                    data.append('file-1', $('#file_' + POLineItemApprovalID)[0].files[0]);


                    $.ajax({
                        type: "POST",
                        async: false,
                        dataType: "json",
                        cache: false,
                        contentType: false,
                        processData: false,
                        url: url2,
                        data: data,
                        success: function (data) {
                            approvallist();
                        }

                    });

                    approvallist();
                }

            });

        }

        function ddl_actiontype_change(id, obj) {


            var ddlid = $(obj).val();

            if (ddlid == "1" || ddlid == "6") {



                $('#datepicker_' + id).show();


            }
            else {
                $('#datepicker_' + id).hide();
            }


            if (ddlid == "1") {

                BindUserOnchange('GETUSERSFORRECEIVE', id);

            }
            else if (ddlid == "4") {
