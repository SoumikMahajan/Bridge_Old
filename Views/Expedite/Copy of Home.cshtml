        function saveNoteDetail(POLineItemID, ItemStatus, Note, recvdQty, recvdDate, reference) {
            var url = "";
            if (isNaN(recvdQty)) {
                recvdQty = "0.00";
            }
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = 'http://www.thebridgebytcg.com/Expedite/SaveNots';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Expedite/SaveNots';
            }

            $.ajax({
                type: "POST",
                url: url,
                data: { 'POLineItemID': POLineItemID, 'ItemStatus': ItemStatus, 'Notes': Note, 'ReceivedQty': recvdQty, 'RcvdDate': recvdDate, 'Reference': reference },
                success: function (data) {


                    if (data != "") {

                        var totalrows = $('.currentlyediting').find('td').length;

                        var ststuscellnumber;
                        var receivedqtycellnumber;

                        if (totalrows <= 9) {
                            ststuscellnumber = 5;
                            receivedqtycellnumber = 6;
                        }
                        else {
                            ststuscellnumber = 11;
                            receivedqtycellnumber = 14;

                        }

                        var prev = parseFloat($('.currentlyediting').find('td:eq(' + receivedqtycellnumber + ')').html());
                        var curr = parseFloat(isNaN(recvdQty) || recvdQty == "" ? 0 : recvdQty);

                        $('.currentlyediting').find('td:eq(' + ststuscellnumber + ')').html($('#ddl_ItemStatus option:selected').text());
                        $('.currentlyediting').find('td:eq(' + receivedqtycellnumber + ')').html(Math.round(parseFloat(prev + curr) * 100) / 100);

                        $('#statusdiv').find('progress').attr('value', prev + curr);
                        var progressbar = $('#statusdiv').find('progress');
                        var newtxt = "Received " + Math.round(parseFloat(prev + curr) * 100) / 100 + " Out of " + $('#statusdiv').find('progress').attr('max');


                        $('#statusdiv').find('label').text(newtxt);
                        $('#statusdiv').find('label').append("<br/>");
                        $('#statusdiv').find('label').append(progressbar);

                        var ivar = $('.currentlyediting').find('td:eq(0) i');
                        var onclickattr = $(ivar).attr('onclick');
                        var newv = "'" + Math.round(parseFloat(prev + curr) * 100) / 100 + '^' + onclickattr.split(',')[1].split('^')[1];


                        var newonclick = onclickattr.split(',')[0] + ',' + newv + ',' + onclickattr.split(',')[2];

                        $(ivar).attr('onclick', newonclick);


                        $('#ddl_ItemStatus').val('0');
                        $('#ItemExpediteNote').val('');
                        $('#txt_ReturnQty').val('');
                        $('#txt_RecvdDate').val('');
                        $('#txt_Reference').val('');

                        //$('#tblPOLineItemExpediteHistory').html(data);
                        $('#tblPOLineItemExpediteHistoryBody').html(data);

                        notify('Expedite Note added Successfully', 'green');
                        $('.notification').fadeOut(3000);
                        //$('.b-close').trigger('click');

                        DdlLineItemStatusByProjectID(POLineItemID);
                    }
                }
            });
        }


