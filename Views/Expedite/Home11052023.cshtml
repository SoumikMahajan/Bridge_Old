                error: function () { notify('Something went wrong'); }
            });
        }

        $(document).on('click', '.vendor-acc', function () {

            var elemID = $(this).attr('id');
            var vid_pid = $(this).attr('id').split('_');
            if (vid_pid != null && vid_pid.length == 2) {
                var elem = $(this).next('div');
                if (!$(elem).hasClass('loaded')) {
                    $(elem).addClass('loaded');
                    $(this).find('.prog-vendor-item').append('<i class="fa fa-spinner fa-spin"></i>');
                    setTimeout(function () {
                        var html = BindVendorPOLineItem(vid_pid[0], vid_pid[1], elemID);
                        $(elem).html('').append(html);
                        $(".inneraccordion").multiaccordion({ defaultIcon: 'ui-icon-plusthick' });
                        $(".inneraccordion").multiaccordion("init");
                        $(".inneraccordion").multiaccordion("close");
                    }, 100);
                }
                $(this).prev('h3').append('<i class="fa fa-spinner fa-spin" style="float:right;"></i>');
            }
        });

        $(document).on('click', '#refreshVendorPO', function () {

            $('#refreshVendorPO').addClass("fa-spin");
            $('#VndrPrt').html('');
            window.setTimeout(function () {
                loadVendorPart();
                window.setTimeout(function () {
                    $('#ByVendor>h3').trigger('click');
                    $('#refreshVendorPO').removeClass("fa-spin");
                }, 400);
            }, 100);
        });

        //Updated by suvradeep on 26-08-2020
        function BindVendorPOLineItem(vid, pid, objvendorsectionid) {
            debugger;
            var clause = $('#HiddenClause').val();
            //$('#HiddenClause').val('');

            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Expedite/getPurchaseOrdersByContactID';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Expedite/getPurchaseOrdersByContactID';
            }
            url1 += "?VendorID=" + vid + "&projectid=" + pid + "&Query=" + clause;

            var html = "";

            $.ajax({
                type: "POST",
                url: url1,
                async: false,
                data: {},
                success: function (response) {
                    // console.log(response);
                    var totdata = JSON.parse('{' + response + '}');
                    var PurchaseOrders = totdata.PurchaseOrders;
                    var PurchaseOrders_len = PurchaseOrders.length;

                    var cnt = 0;
                    var displayflag = '';
                    if (PurchaseOrders_len == 0) {
                        displayflag = 'displaynone';
                    }
                    else {
                        for (var b = 0; b < PurchaseOrders.length; b++) {

                            var LineItems_len = PurchaseOrders[b].LineItems.length;

                            if (LineItems_len != 0) {
                                cnt++;
                            }
                        }

                        if (cnt == 0) {
                            displayflag = 'displaynone';
                        }
                    }
                    for (var b = 0; b < PurchaseOrders.length; b++) {
                        if (PurchaseOrders[b].LineItems.length == 0) {
                            continue;
                        }
                        var addHeader = true;
                        var autoh = '100%';
                        if (b != 0) {
                            addHeader = false;
                        }

                        var PONUMBER = PurchaseOrders[b].TotalPOID;
                        var Buyer = PurchaseOrders[b].Buyer;
                        var Terms = PurchaseOrders[b].Terms;
                        var Currency = PurchaseOrders[b].Currency;
                        var ConversionRate = PurchaseOrders[b].ConversionRate;
                        var FOB = PurchaseOrders[b].FOB;
                        var ArrivalDate = PurchaseOrders[b].ArrivalDate;
                        var CheckBackDate = PurchaseOrders[b].CheckBackDate;
                        var POStatus = PurchaseOrders[b].POStatus;
                        var NumOfUserToAprv_PO = PurchaseOrders[b].NumOfUserToAprv_PO;
                        var ShipTo = PurchaseOrders[b].ShipTo;
                        var ShipMethod = PurchaseOrders[b].ShipMethod;
                        var Freight = PurchaseOrders[b].Freight;
                        var Remarks = PurchaseOrders[b].Remarks;
                        var Confirmation = PurchaseOrders[b].Confirmation;
                        var Committed = PurchaseOrders[b].Committed;
                        var PONOTEHTML = PurchaseOrders[b].PONOTESTATUS;
                        var VendorCO = PurchaseOrders[b].VendorCO;
                        var TempPOID = PurchaseOrders[b].PONUMBER;

                        if (PurchaseOrders[b].Committed == "1") {
                            Committed = "Y";
                        }
                        else {
                            Committed = "N";
                        }

                        if (PurchaseOrders[b].PONOTESTATUS == "YES") {
                            PONOTEHTML = '<i onclick="openponotepopup(\'' + PurchaseOrders[b].LineItems[0].POLineItemID.split('#')[0] + '\');" class="fa fa-asterisk mrg10L" aria-hidden="true" style="cursor:pointer;" title="This PO has notes"></i>';
                        }
                        else {
                            PONOTEHTML = "";
                        }

                        var LineItems = PurchaseOrders[b].LineItems;
                        var LineItems_len = LineItems.length;
                        var displayflag = '';

                        if (LineItems_len == 0) {
                            displayflag = 'displaynone';
                        }

                        html += '<div class="inneraccordion odd ' + displayflag + '" style="font-size:0.75em;">'
                        html += "<h3 style='height:" + autoh + "'>"
                        html += "<table class='display makedisable no-footer dataTable table'>"
                        if (addHeader) {
                            html += "<thead>"
                                + "<th style='width:6%;'  class='leftposition'>PO#</th>"
                                + "<th style='width:12%;' class='leftposition'>Buyer</th>"
                                + "<th style='width:5%;'  class='leftposition'>Currency</th>"
                                + "<th style='width:7%;'  class='rightposition'>Conv. Rate</th>"
                                + "<th style='width:7%;'  class='leftposition'>Arrival Date</th>"
                                + "<th style='width:7%;'  class='leftposition'>Ship Method</th>"
                                + "<th style='width:11%;' class='leftposition'>Freight</th>"
                                + "<th style='width:11%;' class='leftposition'>Ship To</th>"
                                + "<th style='width:7%;' class='leftposition'>Committed</th>"
                                + "<th style='width:12%;' class='leftposition'>Vendor(CO)</th>"
                                + "<th style='width:7%;' class='leftposition'>Remarks</th>"
                                + "<th style='width:8%;padding-right:15px !important;' class='rightposition'>(" + LineItems_len + ")</th>"
                                + "<thead>"
                            addHeader = false;
                        }

                        html += "<tbody><tr> "
                            + "<td style='width:6%;'  class='leftposition'>" + '<a href="/PurchaseOrder/POEdit/' + TempPOID + '" target="_blank">' + PONUMBER + '</a>' + PONOTEHTML
                            + "</td>"
                            + "<td style='width:12%;'  class='leftposition'>" + Buyer + "</td>"
                            + "<td style='width:5%;' class='leftposition'>" + Currency + "</td>"
                            + "<td style='width:7%;' class='rightposition'>" + ConversionRate + "</td>"
                            + "<td style='width:7%;' class='leftposition'>" + ArrivalDate + "</td>"
                            + "<td style='width:7%;'>" + ShipMethod + "</td>"

                            + "<td style='width:11%;' class='leftposition'>" + Freight + "</td>"
                            + "<td style='width:11%;' class='leftposition'>" + ShipTo + "</td>"
                            + "<td style='width:7%;' class='leftposition'>" + Committed + "</td>"
                            + "<td style='width:12%;' class='leftposition'>" + VendorCO + "</td>"
                            + "<td style='width:7%;' class='leftposition'>" + Remarks + "</td>"
                            + "<td style='width:8%;padding-right:15px !important;'  class='leftposition'>Approved " + POStatus + "/" + NumOfUserToAprv_PO + "</td>"
                            + "</tr>"
                            + "</table>";

                        html += "</h3>";
                        html += "<div style='display:none' class='content'>";

                        html += "<table id='POitemTable' class='display makedisable no-footer dataTable table' style='width:100%;color:black;'>"
                            + "<tr>"
                            + "<th style='width:5%;'>Action</th>"
                            + "<th  style='width:10%;' class='leftposition'>PO LineItem ID</th>"
                            + "<th  style='width:10%;' class='leftposition'>Spec Num</th>"
                            + "<th  style='width:25%;' class='leftposition'>Item Description</th>"
                            + "<th  style='width:10%;' class='leftposition'>Fabrication Approvals</th>"
                            + "<th  style='width:10%;' class='leftposition'>Item Status</th>"
                            + "<th  style='width:10%;' class='rightposition'>Quantity</th>"
                            + "<th  style='width:10%;' class='leftposition'>Invoice</th>"
                            + "<th  style='width:10%;' class='leftposition'>Expected Arrival Date</th>"
                            + "<th  style='width:10%;' class='rightposition'>Received Quantity</th>"
                            + "</tr>";

                        debugger;


                        for (var ii = 0; ii < LineItems.length; ii++) {

                            debugger;

                            var POLineItemID = LineItems[ii].POLineItemID.split('#')[0];
                            var POLineItemIDShow = LineItems[ii].POLineItemID.split('#')[1];
                            var SpecNum = LineItems[ii].SpecNum;
                            var ItemDescription = LineItems[ii].ItemDescription;
                            var ItemApprovals = LineItems[ii].ItemApprovals;
                            var NumOfUserToAprv_PO = LineItems[ii].NumOfUserToAprv_PO;
                            var ItemStatus = LineItems[ii].ItemStatus;
                            var ActionType = LineItems[ii].ActionType;
                            var ReceivedQuantity = isNaN(parseFloat(LineItems[ii].ReceivedQuantity)) ? '0' : LineItems[ii].ReceivedQuantity;
                            var Invoice = LineItems[ii].Invoice;
                            var Arrivedon = LineItems[ii].Arrivedon;
                            var Quantity = LineItems[ii].Quantity;
                            var Numofexpnotes = LineItems[ii].cnt;
                            var RequiredApproved = LineItems[ii].RequiredApproved;
                            if (Numofexpnotes > 0) {
                                Numofexpnotes = '<i class="fa fa-asterisk mrg10L" aria-hidden="true" style="cursor:pointer;" title="This item has ' + Numofexpnotes + ' notes"></i>';
                            }
                            else {
                                Numofexpnotes = '';
                            }

                            var innerhtml = "";
                            var actiontype = LineItems[ii].ActionType;


                            for (var l = 0; l < actiontype.split(',').length; l++) {

                                color = actiontype.split(',')[l].split('^')[1];
                                var TotalApproved = actiontype.split(',')[l].split('^')[3];
                                var PolineIteApprovedID = actiontype.split(',')[l].split('^')[2];

                                var RequiredApprovedBasedOnPolineIteApprovedID = RequiredApprovedtest(PolineIteApprovedID);

                                if (color == "Approve") {

                                    if (parseInt(TotalApproved) == parseInt(RequiredApprovedBasedOnPolineIteApprovedID)) {

                                        color = "rgb(3, 148, 43)";

                                    }
                                    else {

                                        color = "rgb(136, 144, 142)";

                                    }

                                    //if (parseInt(TotalApproved) != parseInt(RequiredApproved)) {



                                    //    color = "rgb(136, 144, 142)";

                                    //}
                                    //else {

                                    //    color = "rgb(3, 148, 43)";

                                    //}

                                    //color = "rgb(3, 148, 43)";
                                }
                                else if (color == "Receive" || color == "Send") {
                                    color = "rgb(136, 144, 142)";
                                }
                                else if (color == "Added" || color == "PathSet") {
                                    color = "#242224";
                                }
                                else {
                                    color = "red";
                                }

                                var stng1 = "";
                                var stng2 = "";

                                if (actiontype.split(',')[l].split('^')[4] != null && actiontype.split(',')[l].split('^')[4] != "" && actiontype.split(',')[l].split('^')[4] != undefined) {
                                    stng1 = actiontype.split(',')[l].split('^')[4];
                                }
                                if (actiontype.split(',')[l].split('^')[5] != null && actiontype.split(',')[l].split('^')[5] != "" && actiontype.split(',')[l].split('^')[5] != undefined) {
                                    stng2 = '(' + actiontype.split(',')[l].split('^')[5] + ')';
                                }

                                var stng = stng1 + ' ' + stng2;

                                innerhtml += "<span title='" + actiontype.split(',')[l].split('^')[1] + "' style='color:" + color + ";'>";
                                innerhtml += stng;
                                innerhtml += "</span><br/>";

                            }

                            var rqtypoqty = ReceivedQuantity + '^' + Quantity;


                            html += "<tr> <input type='hidden' id='hdn_POID' value='" + TempPOID + "'>";
                            html += "<td class='leftposition'>"
                                + '<i class="fa fa-pencil-square-o"  style="cursor:pointer;" onclick="ExpediteNotesByPOLineItemsVendor(\'' + POLineItemID + '\',\'' + rqtypoqty + '\',\'' + 1 + '\',this,\'' + TempPOID + '\');"></i>'
                                + Numofexpnotes
                                + "</td>";

                            html += "<td class='leftposition'>" + POLineItemIDShow + "</td>";
                            html += "<td class='leftposition'>" + SpecNum + "</td>";
                            html += "<td class='leftposition'>" + ItemDescription + "</td>";
                            html += "<td class='leftposition'>" + '<p style="cursor:pointer;" onclick="OpenHistoryPopUp(\'' + POLineItemID + '\',\'' + PurchaseOrders[b].PONUMBER + '\',this)">' + innerhtml + '</p>' + "</td>";
                            html += "<td class='leftposition'>" + ItemStatus + "</td>";
                            html += "<td class='rightposition'>" + numberWithCommas(formatNumber(parseFloat(Quantity))) + "</td>";
                            html += "<td  class='leftposition'>" + Invoice + "</td>";
                            html += "<td  class='leftposition'>" + Arrivedon + "</td>";
                            html += "<td  class='rightposition'>" + numberWithCommas(formatNumber(parseFloat(ReceivedQuantity))) + "</td>";
                            html += "</tr>";

                        }
                        html += "</table>";
                        html += "</div>";
                        html += "</div>";
                    }
                    $('#' + objvendorsectionid).find('.prog-vendor-item').empty();
                },
                error: function () { notify('Something went wrong'); }
            });

            return html;
        }

        function RequiredApprovedtest(PolineIteApprovedID) {
            var obj = new Object();
            obj.POLineItemApprovalID = PolineIteApprovedID;
            obj.Mode = 'RequiredbasedOnpolineitemID';
            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "POMS_POItemApprovalAll";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var o = DBSP.call_DB_Procedure();
            o = o.data;

            var NumberToApprovPO = o[0].NumberToApprovPO;
            return NumberToApprovPO;
        }

