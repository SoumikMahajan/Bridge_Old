        function loadVendorPart_Query(query) {

            var url1 = '';
            var pid = $('#PrjtDdl').val();
            pid = pid == null ? "" : pid.toString();
            if (pid.toString() == null || pid.toString() == undefined || pid.toString() == 'undefined' || pid == "") {
                return;
            }
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Expedite/getAllVendors_Query';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Expedite/getAllVendors_Query';
            }
            //url1 += "?projectid=" + pid + "&Query=" + query;//----------------------------------------- Dev3 04/08/2022
            var flag = $("#FirstSearchDdlLeft").val();//------------------------------------------------- Dev3 04/08/2022 

            if (flag === "BSHIPTO") { //----------------------------------------------------------------- Dev3 04/08/2022 start
                url1 += "?projectid=" + pid + "&Query=" + query + "&flag=" + flag;
            }
            else {
                url1 += "?projectid=" + pid + "&Query=" + query + "&flag=" + "";
            }//------------------------------------------------------------------------------------------ Dev3 04/08/2022 End


            var totdata;
            $('#VndrPrt').html('');
