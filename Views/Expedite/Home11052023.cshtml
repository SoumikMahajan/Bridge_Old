        function saveactionapproval(POLineItemApprovalID) { //update by esolz dev 2
            debugger;
            var ProjectID = $('#PrjtDdl').val();
            var POLineItemID = $('#Hdn_POLineItemID').val();
            var FabPathGrpName = $('#ddl_grpname_' + POLineItemApprovalID).children("option:selected").text();
            var ApprovalPathID = $('#ddl_grpname_' + POLineItemApprovalID).children("option:selected").val();

            var FileName = "";
            for (var a = 0; a < $('#file_' + POLineItemApprovalID)[0].files.length; a++) {
                FileName += FileName == '' ? $('#file_' + POLineItemApprovalID)[0].files[a].name : "^^^" + $('#file_' + POLineItemApprovalID)[0].files[a].name;
            }

            //var len = $('#ddl_selectuser_' + POLineItemApprovalID).length();
            var isManager = $('#hdn_isManager').val();

            var FabPathApprovalID = CheckFabPathApprovedID(POLineItemApprovalID);

            var currentstatus = CheckCurrentStatus(POLineItemApprovalID);

            var ActionType = $('#ddl_actiontype_' + POLineItemApprovalID).val();


            if ((currentstatus == "Received" || currentstatus == "Approved" || currentstatus == "PathSet" || currentstatus == "Rejected") && (FabPathApprovalID == ApprovalPathID)) {
                if (ActionType == 0) {
                    notify("Please select an Action");
                    return;
                }
            }



            var ActionByProjectManager = "0";

            if (isManager == "1") {

                var ActionByProjectManager = $('#ddl_selectuser_' + POLineItemApprovalID).val();

                if (isManager == "1" && ActionByProjectManager == "0" && (ActionType == "1" || ActionType == "6" || ActionType == "2" || ActionType == "3")) {
                    notify("Please select  a user");
                    return;
                }

            }

            //alert(ActionByProjectManager);

            //return;


            var ActionDate = "";

            if (ActionType == "1" || ActionType == "6" || ActionType == "2" || ActionType == "3") {

                ActionDate = $('#datepicker_' + POLineItemApprovalID).find('input').val();

            }

            //if (ApprovalPathID == "0" && (ActionType == "1" || ActionType == "2" || ActionType == "3" || ActionType == "7")) {
            //    notify("Please Select Fabrication Approval Path");
            //    return;
            //}
            if (ApprovalPathID == "0") {
                notify("Please Select Fabrication Approval Path");
                return;
            }


            if ((FabPathApprovalID != ApprovalPathID)) {
                deletepolineitem(POLineItemApprovalID);
                //notify("The Process Is Already Ongoing,If You Want To Change Then Amend First!!");
                //return;
            }


            //if (ActionType == '1' || ActionType == '2' || ActionType == '3' || ActionType == '7') {
            //    if (FabPathApprovalID != ApprovalPathID) {
            //        notify("The Process Is Already Ongoing,If You Want To Change Then Amend First!!");
            //        return;
            //    }
            //}

            var Comment = $('#textarea_' + POLineItemApprovalID).val().trim();

            if (Comment == "" && (ActionType == "3" || ActionType == "7" || ActionType == "4")) {
                notify("Please add comment");
                return;
            }

            var c = true;
            if (ActionType == "7") {
                c = confirm("This is an approved item, all approval will be cancelled. Are you sure you want to amend the item?");
            }
            if (!c) {
                return;
            }

            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/PurchaseOrder/AddPOApprovalItem';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {

                url = 'PurchaseOrder/AddPOApprovalItem';
            }


            $.ajax({
                type: "POST",
                async: false,
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                url: url,
                data: "{ 'POLineItemApprovalID': '" + POLineItemApprovalID + "','ActionType' : '" + ActionType + "','ActionDate' : '" + ActionDate + "','Comment' : '" + Comment + "','FileName' : '" + FileName + "','ActionByProjectManager' : '" + ActionByProjectManager + "','ProjectID' : '" + ProjectID + "','FabPathGrpName' : '" + FabPathGrpName + "','POLineItemID' : '" + POLineItemID + "','ApprovalPathID' : '" + ApprovalPathID + "'}",
                success: function (data) {
                    var lastinsertedid = data;
                    //alert(data);




                    var url2 = '';
                    if (LOCALORSERVERNEW == 'LOCAL') {
                        url2 = '/UploadFile/UploadForApprovals?fileid=';
                    }
                    else if (LOCALORSERVERNEW == 'SERVER') {

                        url2 = 'UploadFile/UploadForApprovals?fileid=';
                    }

                    url2 += lastinsertedid;
                    var data = new FormData();
                    for (var a = 0; a < $('#file_' + POLineItemApprovalID)[0].files.length; a++) {
                        // FileName += FileName == '' ? $('#file_' + POLineItemApprovalID)[0].files[0].name : "^^^" + $('#file_' + POLineItemApprovalID)[0].files[0].name;
                        data.append('file-' + a, $('#file_' + POLineItemApprovalID)[0].files[a]);
                    }
                    //data.append('file-1', $('#file_' + POLineItemApprovalID)[0].files[0]);
                    $.ajax({
                        type: "POST",
                        async: false,
                        dataType: "json",
                        cache: false,
                        contentType: false,
                        processData: false,
                        url: url2,
                        data: data,
                        success: function (data) {
                            // window.location.reload();
                        }
                    });

                    notify("Added successfully", "green");

                    approvallist();
                }

            });

        }

        function ddl_actiontype_change(id, obj) {

            debugger;
            var ddlid = $(obj).val();

            //if (ddlid == "1") {
            //    $('#ddl_grpname_' + id).prop('disabled', false);
            //}

            if (ddlid == "1" || ddlid == "6" || ddlid == "2" || ddlid == "3") {


                $('#datepicker_' + id).show();

                var date = new Date();
                var currentMonth = date.getMonth();
                var currentDate = date.getDate();
                var currentYear = date.getFullYear();
                var obj = $('#datepicker_' + id).find('input');
                $(obj).datepickercustom({
                    changeMonth: true,
                    changeYear: true,
                    dateFormat: 'MM dd yy',
                    maxDate: new Date(currentYear, currentMonth, currentDate)
                });

            }
            else {
                $('#datepicker_' + id).hide();
            }


            if (ddlid == "1") {

                BindUserOnchange('GETUSERSFORRECEIVE', id);

            }
            else if (ddlid == "4") {
                BindUserOnchange('GETUSERSFORCOMMENT', id);

            }
            else if (ddlid == "6") {
                BindUserOnchange('GETUSERSFORSEND', id);

            }
            else if (ddlid == "7") {

                BindUserOnchange('GETUSERSFORAMEND', id);

            }
            else if (ddlid == "2") {

                BindUserOnchange('GETUSERSFORAPPROVEREJECT', id);

            }
            else if (ddlid == "3") {

                BindUserOnchange('GETUSERSFORAPPROVEREJECT', id);

            }
            else {
                var userlist = $('#ddl_selectuser_' + id);
                userlist.html("");
                userlist.append("<option value='0'>---Select Action---</option>")
            }
            //else {
            //    //BindUserOnchange('GETUSERSFORAPPROVEREJECT', id);
