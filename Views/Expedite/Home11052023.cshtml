        function SecondSearchDdlOnChangeLeft(obj) {

            if ($(obj).val() == "0") {
                $('#ThirdSearchDdlLeft,.ThirdSearchDdlLefttxt').val("");
            }

            $('.ThirdSearchDdlLefttxt').removeClass('displayoff');
            $('.ThirdSearchDdlLefttxt').addClass('TakeVal');
            $('.ThirdSearchDdlLefttxt').addClass('displayon');
            $('.ThirdSearchDdlLefttxt').attr('id', 'ThirdSearchDdlLefttxtid');
            $('.ThirdSearchDdlLeftddl').removeAttr('id');
            //if (obj == 'GREATERTHAN') {
            //    return;
            //}
            //else if (obj == 'LESSTHAN') {
            //    return;
            //}
            if (obj == 'EQUALS') {
                return;
            }
            else if (obj == 'MATCH') {
                return;
            }
            else if (obj == 'NOTMATCH') {
                return;
            }

            var optionhtml = "";
            ResetThirdSearchDdlLeft();

            var selectedFirstddlLeft = $('#FirstSearchDdlLeft').val();
            //alert(selectedFirstddlLeft);
            if ($(obj).val().trim() == "") {
                ResetThirdSearchDdlLeft();
                return;
            }

            if (selectedFirstddlLeft.trim() == 'VITMDESC' || selectedFirstddlLeft.trim() == 'BVENDR') {
                optionhtml = SecondDdlHtml('SECONDTYPE');
                //console.log(optionhtml);
                //$('#SecondSearchDdlRight').html(optionhtml);
                //$('#SecondSearchDdlRight').html(optionhtml);

                $('.ThirdSearchDdlLefttxt').removeClass('displayoff');
                $('.ThirdSearchDdlLefttxt').addClass('TakeVal');
                $('.ThirdSearchDdlLefttxt').addClass('displayon');

                return;
            }
            else if (selectedFirstddlLeft.trim() == 'BARRVLDT' || selectedFirstddlLeft.trim() == 'BCHKBCK') {
                $('#ThirdSearchDdlLeftDtPckr').removeClass('displayoff');
                $('#ThirdSearchDdlLeftDtPckr').addClass('TakeVal');
                $('#ThirdSearchDdlLeftDtPckr').addClass('displayon');

                $('#ThirdSearchDdlLeft').removeClass('TakeVal');
                $('#ThirdSearchDdlLeft').removeClass('displayon');
                $('#ThirdSearchDdlLeft').addClass('displayoff');

                $('.ThirdSearchDdlLefttxt').removeClass('TakeVal');
                $('.ThirdSearchDdlLefttxt').removeClass('displayon');
                $('.ThirdSearchDdlLefttxt').addClass('displayoff');
            }
            else if (selectedFirstddlLeft.trim() == 'VRQTY') {
                $('#ThirdSearchDdlLeft').removeClass('displayoff');
                $('#ThirdSearchDdlLeft').addClass('TakeVal');
                $('#ThirdSearchDdlLeft').addClass('displayon');
            }
            else {

                if ((selectedFirstddlLeft.trim() == 'VITMAPPRVL') || (selectedFirstddlLeft.trim() == 'VITMSTTS')
                    || (selectedFirstddlLeft.trim() == 'BPOVAL') || (selectedFirstddlLeft.trim() == 'BBUYR')
                    || (selectedFirstddlLeft.trim() == 'BTRMS') || (selectedFirstddlLeft.trim() == 'BCRRNCY')
                    || (selectedFirstddlLeft.trim() == 'BITMAPPRVL') || (selectedFirstddlLeft.trim() == 'BITMSTTS') || (selectedFirstddlLeft.trim() == 'VITMAPPRVLSTS')
                    || (selectedFirstddlLeft.trim() == 'BISCOMMITTED') || (selectedFirstddlLeft.trim() == 'BSHIPTO')) {


                    $('.ThirdSearchDdlLefttxt').removeClass("displayon").addClass('displayoff');
                    $('.ThirdSearchDdlLeftddl').removeClass("displayon").addClass("displayoff");

                    $('.ThirdSearchDdlLefttxt').removeAttr('id');
                    $('.ThirdSearchDdlLeftddl').attr('id', 'ThirdSearchDdlLeft');

                    if ($(obj).val() == "0") {
                        $('#ThirdSearchDdlLeft').removeClass('displayoff').removeClass('displayon').empty();
                    }
                    else {

                        $('.ThirdSearchDdlLeftddl').val("");
                        makedropdown(selectedFirstddlLeft.trim(), 'L');
                        $('#ThirdSearchDdlLeft').removeClass('displayoff').addClass('TakeVal displayon');
                    }
                }
                else {
                    $('.ThirdSearchDdlLefttxt').attr('id', 'ThirdSearchDdlLeft');
                    $('.ThirdSearchDdlLeftddl').removeAttr('id');
                }

                //$('#ThirdSearchDdlLeft').removeClass('displayoff');
                //$('#ThirdSearchDdlLeft').addClass('TakeVal');
