    <script type="text/javascript">

        function loadBudgetPart() {

            var url1 = '';
            var pid = $('#PrjtDdl').val();
            pid = pid == null ? "" : pid.toString();
            if (pid.toString() == null || pid.toString() == undefined || pid.toString() == 'undefined') {
                return;
            }
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Expedite/getAllProjectSection';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Expedite/getAllProjectSection';
            }
            url1 += "?projectid=" + pid;

            $.ajax({
                type: "POST",
                async: false,
                url: url1,
                data: {},
                success: function (response) {
                    var html = '';
                    var result = JSON.parse(response);
                    var totdata = result.data;
                    var totlen = totdata.length;

                    for (var a = 0; a < totdata.length; a++) {
                        var id = totdata[a].id;
                        var name = totdata[a].sectionname;
                        var order = totdata[a].Sectionnumber;
                        var BudgItemCount = totdata[a].BudgItemCount;
                        html += '<div class="accordion odd">';
                        html += "<h3 class='budget-acc' id='" + id + "'>";
                        html += "<div class='row'>";
                        html += "<div class='col-sm-2'><span style='color:#03539A;'>Number: </span>" + order;
                        html += "</div>";
                        html += "<div class='col-sm-2'><span style='color:#03539A;'>Name: </span>" + name;
                        html += "</div>";
                        html += "<div class='mrg10L;'>(" + BudgItemCount + ")&nbsp;&nbsp;<span class='prog-bdgt-item'></span></div>";
                        html += "</h3><div class='budget-item content'></div></div>";
                    }

                    $('#bsectioncount').html('(' + totlen + ')');
                    $('#BdgtSctn').html(html);
                    $(".accordion").multiaccordion();
                    $(".accordion").multiaccordion("close");
                },
                error: function () {
                    notify('Something went wrong');
                }
            });
        }

        $(document).on('click', '.budget-acc', function () {

            var budgetSectionID = $(this).attr('id');
            if (budgetSectionID != null) {
                var elem = $(this).next('div');
                if (!$(elem).hasClass('loaded')) {
                    $(elem).addClass('loaded');
                    $(this).find('.prog-bdgt-item').append('<i class="fa fa-spinner fa-spin"></i>');
                    setTimeout(function () {
                        var html = BindBudgetLineItem(budgetSectionID, budgetSectionID);
                        $(elem).html('').append(html);
                        $(".inneraccordion").multiaccordion({ defaultIcon: 'ui-icon-plusthick' });
                        $(".inneraccordion").multiaccordion("init");
                        $(".inneraccordion").multiaccordion("close");
                    }, 100);
                }
            }
        });

        $(document).on('click', '#refreshBudgetPO', function () {

            $('#refreshBudgetPO').addClass("fa-spin");
            $('#BdgtSctn').html('');
            window.setTimeout(function () {
                loadBudgetPart();
                window.setTimeout(function () {
                    $('#ByBudget>h3').trigger('click');
                    $('#refreshBudgetPO').removeClass("fa-spin");
                }, 400);
            }, 100);
        });

        function BindBudgetLineItem(budgetSectionID, objbudgetsectionid) {

            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Expedite/getPOItems';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Expedite/getPOItems';
            }
            url1 += "?budgetSectionID=" + budgetSectionID;

            var html = "";

            $.ajax({
                type: "POST",
                url: url1,
                async: false,
                data: {},
                success: function (response) {
                    //console.log(response);
                    var result = JSON.parse(response);
                    var item = result.data;

                    for (var i = 0; i < item.length ; i++) {
                        var des = item[i].Description;
                        var deslen = des.length;
                        var displayflag = '';
                        if (deslen == 0) {
                            //displayflag = 'displaynone';
                        }
                        var cl = '';
                        if (i != '0') {
                            cl = 'displaynone';
                        }
                        html += '<div class="inneraccordion odd display_' + deslen + ' ' + displayflag + '" style="font-size:0.75em;">'
                        html += "<h3 style='height:auto;'>"
                             + "<table class='display makedisable no-footer table dataTable' style='width:100%;color:black;' ><thead>"
                             + "<tr class='" + cl + "'>"
                             + "<th style='width: 28%;'>Item#</th>"
                             + "<th style='width: 28%;'>Spec</th>"
                             + "<th style='width: 28%;'>Desc</th>"
                             + "<th style='width: 16%;'></th>"
                             + "</tr>"
                             + "<tr></thead><tbody>"
                             + "<td style='width: 28%;'>"
                             + item[i].ItemNumber
                             + "</td>"
                              + "<td style='width: 28%;'>"
                             + item[i].SpecNum
                             + "</td>"
                              + "<td style='width: 28%;'>"
                             + item[i].ItemDescription.substring(0, 30)
                             + "</td>"
                              + "<td style='width: 16%;'>"
                             + "(" + deslen + ")"
                             + "</td>"
                             + "</tr></tbody>"
                             + "</table>"
                             + "</h3>";
                        html += "<div class='content' style='font-size:0.75em;height:50px;display:none'><table class='display makedisable no-footer table dataTable' style='width:100%;color:black;font-size:12px;' >"
                        html += "<tr>"
                                + "<th style='width:4%;'>Action</th>"
                                + "<th  style='width:7%;'>PO Number</th>"
                                + "<th  style='width:7%;'>Vendor</th>"
                                + "<th  style='width:7%;'>Vendor CO</th>"
                                + "<th class='displaynone'>Buyer</th>"
                                + "<th  style='width:10%;'>Payment Sch.</th>"
                                + "<th class='displaynone'>Curr</th>"
                                + "<th class='displaynone'>Conv</th>"
                                + "<th class='displaynone'>Fabrication Approvals</th>"
                                + "<th  style='width:7%;'>FOB</th>"
                                + "<th  style='width:6%;'>Arrival Date</th>"
                                + "<th  style='width:6%;'>Check back</th>"
                                + "<th  style='width:5%;'>Item Status</th>"
                                + "<th  style='width:7%;'>Inv</th>"
                                + "<th  style='width:4%;'>PO Qty</th>"
                                + "<th  style='width:4%;'>R-Qty</th>"
                                + "<th  style='width:5%;'>Ship Via</th>"
                                + "<th  style='width:6%;'>Ship To</th>"
                                + "<th  style='width:6%;'>Freight</th>"
                                + "<th  style='width:6%;'>Remarks</th>"
                                + "<th  style='width:3%;'>Committed</th>"
                                + "</tr>";
                        for (var k = 0; k < des.length; k++) {
                            var POLineItemID = des[k].POLineItemID;
                            var innerhtml = "";
                            var actiontype = des[k].ActionType;
                            for (var l = 0; l < actiontype.split(',').length; l++) {
                                color = actiontype.split(',')[l].split('^')[1];
                                if (color == "Approve") {
                                    color = "rgb(3, 148, 43)";
                                }
                                else if (color == "Receive" || color == "Send") {
                                    color = "rgb(136, 144, 142)";
                                }
                                else if (color == "Added") {
                                    color = "#242224";
                                }
                                else {
                                    color = "red";
                                }
                                innerhtml += "<span title='" + actiontype.split(',')[l].split('^')[1] + "'   name='" + color + "' style='color:" + color + ";'>";
                                innerhtml += actiontype.split(',')[l].split('^')[0];
                                innerhtml += "</span><br/>";
                            }
                            var Numofexpnotes = des[k].cnt;
                            if (Numofexpnotes > 0) {
                                Numofexpnotes = '<i class="fa fa-asterisk mrg10L" aria-hidden="true" style="cursor:pointer;" title="This item has ' + Numofexpnotes + ' notes"></i>';
                            }
                            else {
                                Numofexpnotes = '';
                            }
                            var rqtypoqty = des[k].ReceivedQuantity + '^' + des[k].Qty;
                            html += "<tr>"
                                    + "<td>"
                                    + '<i class="fa fa-pencil-square-o"  style="cursor:pointer;" onclick="ExpediteNotesByPOLineItems(\'' + POLineItemID + '\',\'' + rqtypoqty + '\',this,\'' + des[k].POID.split('#')[0] + '\');"></i>'
                                    + Numofexpnotes
                                    + "</td>"
                                    + "<td>"
                                + '<a href="/PurchaseOrder/POEdit/' + des[k].POID.split('#')[0] + '" target="_blank">'+ des[k].POID.split('#')[1]
                                    + "</a></td>"
                                    + "<td>"

                                    + des[k].VendorName

                                    + "</td>"
                                    + "<td>"

                                    + des[k].VendorCO

                                    + "</td>"
                                    + "<td class='displaynone'>"
                                    + des[k].BuyerName
                                    + "</td>"
                                    + "<td>"
                                    + des[k].Terms
                                    + "</td>"
                                    + "<td class='displaynone'>"
                                    + des[k].Currency
                                    + "</td>"
                                    + "<td class='displaynone'>"
                                    + des[k].Conv
                                    + "</td >"
                                    + "<td class='displaynone'>"
                                    + '<p style="cursor:pointer;" onclick="OpenHistoryPopUp11(\'' + POLineItemID + '\',\'' + des[k].POID.split('#')[1] + '\')">' + innerhtml + '</p>'
                                    + "</td>"
                                    + "<td>"
                                    + des[k].FOB
                                    + "</td>"
                                    + "<td>"
                                    + des[k].ArrivalDate
                                    + "</td>"
                                    + "<td>"
                                    + des[k].CheckBackDate
                                    + "</td>"
                                    + "<td>"
                                    + des[k].ItemStatus
                                    + "</td>"
                                    + "<td>"
                                    + des[k].Inv
                                    + "</td>"
                                    + "<td>"
                                    + numberWithCommas(formatNumber(parseFloat(des[k].Qty)))
                                    + "</td>"
                                    + "<td>"
                                    + numberWithCommas(formatNumber(parseFloat(des[k].ReceivedQuantity)))
                                    + "</td>"
                                    + "<td>"
                                    + des[k].ShipMethod
                                    + "</td>"
                                    + "<td>"
                                    + des[k].ShipTo
                                    + "</td>"
                                    + "<td>"
                                    + des[k].Freight
                                    + "</td>"
                                    + "<td>"
                                    + des[k].Remarks
                                    + "</td>"
                                    + "<td>"
                                    + des[k].IsCommitted
                                    + "</td>"
                                    + "</tr>";
                        }
                        html += "</table></div></div>";
                    }
                    $('#' + objbudgetsectionid).find('.prog-bdgt-item').empty();
                },
                error: function () { notify('Something went wrong'); }
            });

            return html;
        }

