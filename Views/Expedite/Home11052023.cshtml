                $('#ThirdSearchDdlLeftDtPckr').removeClass('displayon');
                $('#ThirdSearchDdlLeftDtPckr').addClass('displayoff');

            }

            if ($('#FirstSearchDdlLeft').val().trim() == 'VINV') {
                $('#ThirdSearchDdlLeft').addClass('displayon');
            }
