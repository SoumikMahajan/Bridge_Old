    <script>
        function getFabType() {

            debugger;

            var html = "";
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/PurchaseOrder/getAllApprovatItems';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {

                url = 'PurchaseOrder/getAllApprovatItems';
            }


            $.ajax({
                type: "POST",
                async: false,
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                url: url,

                success: function (data) {
                    html = data;
                    $("#ddlItemApprovalType").html("");
                    $("#ddlItemApprovalType").html(html);
                    //$("#ddlItemApprovalType").selectpicker('refresh');
                }

            });
            return html;


        }

        function selectApproval() {

            debugger;

            $("#expeditenotelistNew").css('display', 'block');

            var html = '';
            var ItemApprovalID = $('#ddlItemApprovalType').val();
            var ItemApprovalDesc = $('#descforitem').val();
            var LineItemID = $(".addFab").data('id');



            var exists = false;
            if (ItemApprovalID == 0) {
                notify('Select Fabrication Approval Type');
                return;
            }

            if (ItemApprovalDesc == "") {
                notify('Enter Fabrication Approval Description.');
                return;
            }


            var url = "";

            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/PurchaseOrder/checkItemApprovalExistenceCheck';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'PurchaseOrder/checkItemApprovalExistenceCheck';
            }

            $.ajax({
                type: "POST",
                url: url,
                async: false,
                contentType: "application/json; charset=utf-8",
                data: "{ \"id\":\"" + LineItemID + "\", \"desc\" : \"" + encodeURI(ItemApprovalDesc) + "\",\"typeid\":\"" + ItemApprovalID + "\"}",
                success: function (data) {
                    if (data != "0") {
                        notify("Description already exists");
                        exists = true;
                        return;

                    }
                }
            });



            $('.remove').each(function () {
                var nowdesc = $(this).attr('data-desc');
                if (nowdesc == ItemApprovalDesc) {
                    if (ItemApprovalID == $(this).attr('data-index')) {
                        notify("Description already exists");
                        exists = true;
                        return;
                    }
                }

            });


            $("#expeditenotelistNew:has(p)").empty();



            if (exists == false) {
                html += "<span class='remove_note' data-desc='" + ItemApprovalDesc + "' data-index='" + ItemApprovalID + "'>"
                    + "<a onclick='removeItemApproval(\"" + ItemApprovalID + "\",this);'>x</a><span>"
                    + $("#ddlItemApprovalType option[value='" + ItemApprovalID + "']").text() + " - " + ItemApprovalDesc + "</span></span>";
                $('#expeditenotelistNew').append(html);
            }
            if ($('.remove_note').length > 0) {
                $('#approvalfinaladd').show();
            }
            else {
                $('#approvalfinaladd').hide();

            }
            $("#ddlItemApprovalType").val("0");
            $("#descforitem").val("");


        }

        function removeItemApproval(ItemApprovalID, obj) {

            if (confirm("Do you want to delete Fabrication Approval?")) {

                $(obj).parent().remove();

            }
            if ($('.remove_note').length > 0) {
                $('#approvalfinaladd').show();
            }
            else {
                $('#approvalfinaladd').hide();

            }
        }

        function addmultipleapproval() {

            var POLineItemID = $(".addFab").data('id');

            var managerID = $('#hdn_isManager').val();

            $('.remove_note').each(function () {

                var o = $(this);
                var ItemApprovalID = $(this).attr('data-index');
                var ItemApprovalDesc = $(this).attr('data-desc');

                var url = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url = '/PurchaseOrder/SavePOApprovalItem';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {

                    url = 'PurchaseOrder/SavePOApprovalItem';
                }


                $.ajax({
                    type: "POST",
                    url: url,
                    async: false,
                    data: { 'POLineItemID': POLineItemID, 'ItemApprovalDesc': encodeURI(ItemApprovalDesc), 'ItemApprovalID': ItemApprovalID },
                    success: function (data) {

                        //$('#popupforItemApproval').modal('hide');
                        $(o).remove();

                    },
                    failed: function () {

                    }

                });



            });


            $('#approvalfinaladd').hide();

            approvallist(POLineItemID, managerID);


        }
    </script>

