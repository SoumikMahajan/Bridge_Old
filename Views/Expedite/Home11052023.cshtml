        $(function () {

            $("#filename").change(function (e) {

                var ext = $("input#filename").val().split(".").pop().toLowerCase();

                if ($.inArray(ext, ["csv"]) == -1) {
                    alert('Upload CSV File');
                    $('#filename').on(e);
                    return false;
                }

                if (e.target.files != undefined) {

                    var reader = new FileReader();
                    reader.onload = function (e) {
                        var csvval = e.target.result.split("\n");
                        var inputrad = "";

                        var Track = 0;

                        for (var rowIndex = 0; rowIndex < csvval.length - 1; rowIndex++) {

                            var rowVal = csvval[rowIndex].split(",");   // get Entire row value one by one

                            for (var j = 0; j < rowVal.length; j++) {

                                if (rowIndex == 0) {              // If rowIndex==0 then it will for first Row which is column

                                    // Below code is for Column name validation

                                    if (j == 0) {
                                        var val = rowVal[j];
                                        val = val.substring(1, val.length);
                                        if (!(val == 'Item#')) {
                                            alert('Invalid Column Name.Valid One "Item#"');
                                            Track = 1;
                                            break;
                                        }
                                    }
                                    else if (j == 1) {
                                        if (!(rowVal[j] == 'Expedite Notes')) {
                                            alert('Invalid Column Name.Valid One "Expedite Notes"');
                                            Track = 1;
                                            break;
                                        }
                                    }
                                    else if (j == 2) {
                                        if (!(rowVal[j] == 'Received Quantity')) {
                                            alert('Invalid Column Name.Valid One "Received Quantity"');
                                            Track = 1;
                                            break;
                                        }
                                    }
                                    else if (j == 3) {
                                        if (!(rowVal[j] == 'Received Date')) {
                                            alert('Invalid Column Name.Valid One "Received Date"');
                                            Track = 1;
                                            break;
                                        }
                                    }
                                    else if (j == 4) {
                                        var val = rowVal[j];
                                        val = val.substring(0, val.length - 2);
                                        if (!(val == 'Reference#')) {
                                            alert('Invalid Column Name.Valid One "Reference#"');
                                            Track = 1;
                                            break;
                                        }
                                    }

                                    // Column Name Validation Part closed

                                }
                                else {    // Below code validate Cell value

                                    if (rowVal.length == 5) {
                                        var cellVal = rowVal[j];

                                        if (j == 0) {
                                            cellVal = cellVal.substring(1, cellVal.length);
                                            if (cellVal == "") {
                                                Track = 1;
                                                alert(rowIndex + ' Row, Items# column value cannot be empty');
                                                break;
                                            }
                                        }
                                        else if (j == 1) {
                                            if (cellVal == "") {
                                                Track = 1;
                                                alert(rowIndex + ' Row,Expedite Notes column value cannot be empty');
                                                break;
                                            }
                                        }
                                        else if (j == 2) {
                                            if (cellVal == "") {
                                                Track = 1;
                                                alert(rowIndex + ' Row, Receive Quantity column value cannot be empty');
                                                break;
                                            }
                                        }
                                        else if (j == 3) {
                                            if (cellVal == "") {
                                                Track = 1;
                                                alert(rowIndex + ' Row, Receive Date column value cannot be empty');
                                                break;
                                            }
                                        }
                                        else if (j == 4) {
                                            cellVal = cellVal.substring(0, cellVal.length - 2);
                                            if (cellVal == "") {
                                                Track = 1;
                                                alert(rowIndex + ' Row, #Refernce column value cannot be empty');
                                                break;
                                            }
                                        }
                                    }
                                    else {
                                        Track = 1;
                                        alert(rowIndex + ' Column does not contain appropriate value');
                                        break;
                                    }
                                }
                            }    // inner for loop is closed........

                        }

                        ////////////////////////////////////////////////

                        if (Track == 0) {

                            if (confirm("Do you want to Upload file Information?")) {

                                for (var v = 1; v < csvval.length - 1; v++) {
                                    var csvvalue = csvval[v].split(",");

                                    var url = "";
                                    if (LOCALORSERVERNEW == 'LOCAL') {
                                        url = '/Expedite/SaveBulkRecord?Bulk=' + csvvalue;
                                    }
                                    else if (LOCALORSERVERNEW == 'SERVER') {
                                        url = 'Expedite/SaveBulkRecord?Bulk=' + csvvalue;
                                    }
                                    //var POID = $('#PrjtDdl option:selected').attr('data-id');
                                    var POID = $('#PrjtDdl').val();
                                    POID = POID == null ? "" : POID.toString();

                                    if (POID.toString() == null || POID.toString() == undefined || POID.toString() == 'undefined') {
                                        return;
                                    }

                                    url += "&POID=" + POID;
                                    $.ajax({
                                        type: "POST",
                                        url: url,
                                        //data: { 'Bulk': csvvalue },
                                        success: function (data) {
                                            if (data != "") {

                                            }
                                        }
                                    });
                                }
                                notify("Information uploaded successfully", 'green');
                                $('.notification').fadeOut(3000);
                            }
                        }
                        $('#filename').val('');
                    };
                    reader.readAsText(e.target.files.item(0));
                    return false;
                }
                // return false;
            });

        });
    </script>

