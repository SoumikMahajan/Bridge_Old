                        html += "<div style='position: relative;width: 25%;float: left;margin-left: 15px;'><span style='color:#03539A;'>Contact:</span> " + Contactname + "</div>"
                        html += "<div style='position: relative;width: auto;float: left;margin-left: 15px;display:none;'>" + Title + "</div>"
                        html += "<div style='position: relative;width: auto;float: left;margin-left: 15px;display:none;'>" + City + "</div>"
                        html += "<div style='position: relative;width: auto;float: left;margin-left: 15px;display:none;'>" + Phone + "</div>"
                        html += "<div style='position: relative;width: auto;float: left;margin-left: 15px;display:none;'>" + Fax + "</div>"
                        html += "<div style='position: relative;width: 25%;float: left;margin-left: 15px; '><span style='color:#03539A;'>Email:</span> " + Email + "</div>"
                        html += "<div class='mrg10L;'>(" + cnt + ")&nbsp;&nbsp;<span class='prog-vendor-item'></span></div>"
                        html += "</h3><div class='vendor-po content'></div></div>";
                    }
                    $('#vsectioncount').html(' (' + totlen + ')');
                    $('#VndrPrt').html(html);
                    $(".accordion").multiaccordion();
