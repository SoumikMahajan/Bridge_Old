                    if (!isNaN(text)) {
                        var prev = parseFloat($('.currentlyediting').find('td:last-child').html());
                        var rcvqnty = parseFloat(Math.round(parseFloat(prev - text) * 100) / 100);
                        var rcvqnty1 = parseFloat(Math.round(parseFloat(prev - text) * 100) / 100).toFixed(2);
                        var newtxt = "Received " + rcvqnty + " Out of " + $('#statusdiv').find('label').attr('data-max');

                        $('.currentlyediting').find('td:last-child').html(rcvqnty1);
                        $('#statusdiv').find('label').text(newtxt);

                        var ivar = $('.currentlyediting').find('td:eq(0) i');
                        var onclickattr = $(ivar).attr('onclick');
                        var newv = "'" + Math.round(parseFloat(prev - text) * 100) / 100 + '^' + onclickattr.split(',')[1].split('^')[1];


                        var newonclick = onclickattr.split(',')[0] + ',' + newv + ',' + onclickattr.split(',')[2] + ',' + onclickattr.split(',')[3];

                        $(ivar).attr('onclick', newonclick);
                    }
                 
                }
                else {
                    var $row = $(obj).closest("tr");
                    var text = parseFloat($row.find('td:eq(4)').text());
                    if (!isNaN(text)) {
                        var prev = parseFloat($('.currentlyediting').find('td:eq(15)').html());
                        var rcvqnty = parseFloat(Math.round(parseFloat(prev - text) * 100) / 100);
                        var rcvqnty1 = parseFloat(Math.round(parseFloat(prev - text) * 100) / 100).toFixed(2);
                        var newtxt = "Received " + rcvqnty + " Out of " + $('#statusdiv').find('label').attr('data-max');

                        $('.currentlyediting').find('td:eq(15)').html(rcvqnty1);
                        $('#statusdiv').find('label').text(newtxt);

                        var ivar = $('.currentlyediting').find('td:eq(0) i');
                        var onclickattr = $(ivar).attr('onclick');
                        var newv = "'" + Math.round(parseFloat(prev - text) * 100) / 100 + '^' + onclickattr.split(',')[1].split('^')[1];


                        var newonclick = onclickattr.split(',')[0] + ',' + newv + ',' + onclickattr.split(',')[2];

                        $(ivar).attr('onclick', newonclick);
                    }
                    
                }
                var POLineItemID = $('#Hdn_POLineItemID').val(); // Dynamic

                var obj = new Object();
                obj.mode = 'DELETE';
                obj.FldID = id;


                var DBSP = new DB_SP_CONNECT();
                DBSP.ProcedureName = "ExpediteNoteOperation";
                DBSP.obj = obj;
                DBSP.isasync = false;
                var o = DBSP.call_DB_Procedure();
                o = o.data;





                DdlLineItemStatusByProjectID(POLineItemID);
                ViewPOExpediteHistory(POLineItemID);
                ViewPOLineItemExpediteHistory(POLineItemID);



            }
        }

