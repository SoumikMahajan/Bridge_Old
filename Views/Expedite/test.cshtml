</script>*@

            </div>
            <div class="jquery-script-clear"></div>
        </div>
    </div>
    <h1 style="margin: 150px auto 30px auto; text-align: center">jQuery multiAccordion Plugin Examples</h1>
    <!-- example 1 -->
    <div class="accordion blue ui-accordion ui-widget">
        <h3 class="ui-accordion-header ui-state-active ui-accordion-header-active"><span class="ui-icon ui-accordion-header-icon ui-icon-minusthick"></span>Simple Accordion 1</h3>
