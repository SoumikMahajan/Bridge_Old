    function clicknew() {
        $(document).ready(function () {
            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Project/GetProjectContactDetailJSON';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Project/GetProjectContactDetailJSON';
            }
