                    + "<th rowspan='1' colspan='1'><input class='srch' data-indx='6'  type='text' placeholder='Search '></th>"
                    + "<th rowspan='1' colspan='1'><input class='srch' data-indx='7'  type='text' placeholder='Search '></th>"
                    + "<th rowspan='1' colspan='1'><input class='srch' data-indx='8'  type='text' placeholder='Search '></th>"
                    + "<th rowspan='1' colspan='1'><input class='srch' data-indx='9'  type='text' placeholder='Search '></th>"
                    + "<th rowspan='1' colspan='1'><input class='srch' data-indx='10'  type='text' placeholder='Search '></th>"
                    + "<th rowspan='1' colspan='1'><input class='srch' data-indx='11'  type='text' placeholder='Search '></th>"

                    + "</tr>";

                    // $('#projectcontacts').find("tr:eq(1)").find("th:eq(1)").html("<a><input type='button' value='Reset' onclick='ResetContactSearch();' style='margin-bottom:6px;' /></a>");
                    //

                    $('#projectcontacts').on('draw.dt', function () {

                        RowHtmlRender();
                    });
                    $('#projectcontacts thead').append(html);
                    var table = $('#projectcontacts').DataTable();
                    $('.srch').on('keyup change', function () {
                        var indx = $(this).attr('data-indx');
                        var txt = this.value;
                        table
                               .column(indx)
                               .search(txt)
                               .draw();
                        RowHtmlRender();
                    });
                });


        });
    }
    function RowHtmlRender() {
        // $('#project thead tr').find("th:eq(1)").html('Action').removeClass('sorting_asc');
        $('#projectcontacts_filter').css('display', 'none');
        $('#projectcontacts tbody tr').find("td:eq(1)").each(function () {
            var pid = $(this).prev("td").html();
            //var zz = $(this).html();
            var html = '';
            var isseletcted = $('#Isselected').val();
            if (isseletcted != "0") {
                
                html = '<i class="fa fa-ban"" ></i>';
                $(this).html(html);
            }
        });



    }
    function ResetSearch() {

        var table = $('#projectcontacts').DataTable();
        $('.srch').each(function () {
            this.value = '';
            var indx = $(this).attr('data-indx');
            var txt = this.value;
            table
                   .column(indx)
                   .search(txt)
                   .draw();
        });

        RowHtmlRender();

    }
    $(function () {
        $('select[name="projectcontacts_length"]').live('change', function () {
            RowHtmlRender();
        });
    });
    function EditProjectContact(obj, pid) {
        var prid = $('#ProjectID').val();
        var url1 = '';
        if (LOCALORSERVERNEW == 'LOCAL') {
            url1 = '/Project/EditProjectContact/' + pid;
        }
        else if (LOCALORSERVERNEW == 'SERVER') {
            url1 = 'Project/EditProjectContact/' + pid;
        }
        window.location.href = url1 + "?Projectid=" + prid;
    }


    function DeleteProjectContact(obj, pid) {
        var rw = $(obj).parent().parent();
        // //console.log(rw);
        var url1 = '';
        if (LOCALORSERVERNEW == 'LOCAL') {
            url1 = '/Project/DeleteProjectContact';
        }
        else if (LOCALORSERVERNEW == 'SERVER') {
            url1 = 'Project/DeleteProjectContact';
        }


        $.ajax({
            type: "POST",
            url: url1,
            async: false,
            dataType: "text",
            contentType: "application/json; charset=utf-8",
            data: "{ 'ProjectID' : '" + pid + "'}",
            success: function (data) {
                if (data == 'SUCCESS') {
                    var table = $('#projectcontacts').DataTable();
                    table
                    .row(rw)
                    .remove()
                    .draw();
                    RowHtmlRender();
                }
            },
            error: function () {
                alert('Something went wrong.');
            }
        });



    }



</script>

