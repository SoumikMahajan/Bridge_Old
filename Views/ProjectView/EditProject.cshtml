                        "initComplete": function () {
                            RowHtmlRender();
                        },
                        "aoColumnDefs": [
                            { 'bSortable': false, 'aTargets': [0, 1] }
                        ]
                    });
                    var html = "";

                    //$('#projectcontacts tfoot th').each(function () {
                    //    var title = $('#example thead th').eq($(this).index()).text();
                    //    $(this).html('<input type="text" placeholder="Search ' + title + '" />');
                    //});

                    html = "<tr>"
                    + "<th  rowspan='1' colspan='1'><input type='button' value='Reset' onclick='ResetSearch();' style='margin-bottom:6px;' /></th>"
                    + "<th  rowspan='1' colspan='1'><input class='srch' data-indx='2' type='text' placeholder='Search '></th>"
                    + "<th  rowspan='1' colspan='1'><input class='srch' data-indx='3' type='text' placeholder='Search '></th>"
