            currentMonth = currentMonth < 9 ? '0' + currentMonth : currentMonth;
            currentDate = currentDate < 9 ? '0' + currentDate : currentDate;

            //$('#To_Date').val(date.toDateString());
            $('#To_Date').val(currentYear + '.' + currentMonth + '.' + currentDate);


            //$('#Date_Range').val(new Date(currentYear, 0, 1).toDateString());

            var date = new Date(currentYear, 1, 1);
            currentMonth = date.getMonth();
            currentDate = date.getDate();
            currentYear = date.getFullYear();

            currentMonth = currentMonth < 9 ? '0' + currentMonth : currentMonth;
            currentDate = currentDate < 9 ? '0' + currentDate : currentDate;

            $('#Date_Range').val(currentYear + '.' + currentMonth + '.' + currentDate);

            $('#Date_Range').datepicker({
                changeMonth: true,
                changeYear: true,
                dateFormat: 'yy.mm.dd'
                , onSelect: function () {
                    FetchDate();
                }
            });
            $('#To_Date').datepicker({
                changeMonth: true,
                changeYear: true,
                dateFormat: 'yy.mm.dd',
               // minDate: new Date(currentYear, currentMonth, currentDate),
                onSelect: function () {
                    FetchDate();
                }
            });
            FetchDate();
        });
        function FetchDate() {
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Project/GetProject';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Project/GetProject';
            }
            var dataTable = "";
            var dt = "";
            var us = new Array();
            $.ajax({
                type: "POST",
                url: url,
                data: "{ 'From': '" + $('#Date_Range').val() + "', 'Todate': '" + $('#To_Date').val() + "','ProjectID':'" + $('#ProjectID').val() + "'}",
                contentType: "application/json; charset=utf-8",
                dataType: "JSON",
                success: function (data) {
                    
                    if (data != '') {
                        dt = data.data;
                        //if (dt.length == 0) {
                        //    return;
                        //}
                        $('#ProjectList').dataTable().fnDestroy();
                        if (dt.length >= 0) {
                            for (i = 0; i < dt.length ; i++) {
                                us[i] = new Array();
                                
                                us[i][0] = '<a href="#" onclick=" Click(event,' + dt[i].ParentVendor_ID + ',' + $('#ProjectID').val() + ')" >' + dt[i].ParentVendorName + '</a>';
                                
                                us[i][1] = dt[i].Total;
                               
                            }
                            $('#ProjectList').dataTable({
                                "processing": true,
                                "data": us,
                                "columns":
                                  [
                                    { "title": "Vendor Common Name" },
                                
                                    { "title": "Amount" },
                                  ],
                                "initComplete": function () {

                                    
                                    $('#ProjectList_filter').remove();
                                    $('#ProjectList_length').remove();
                                }
                            });
                            var html = "";
                            html = "<tr>"
                                  
                                  + "<th rowspan='1' colspan='1'><input class='srch' style='padding: 2px 2%;' data-indx='0' type='text' placeholder='Vendor Common Name '></th>"

                              + "<th></th>"
                                  + "</tr>";

                            $('#ProjectList thead').find('tr:eq(1)').remove();


                            if (dt.length != 0) {
                                $('#ProjectList thead').append(html);

                            }
                            


                            var table = $('#ProjectList').DataTable();
                            $('.srch').on('keyup change', function () {
                                var indx = $(this).attr('data-indx');
                                var txt = this.value;
                                table
                                       .column(indx)
                                       .search(txt)
                                       .draw();
                                
                            });
                        }
                        else {
                        }
                       
                    }
                }
            })
        }
        function Click(e, VendorID, ProjectID) {

            e.preventDefault();

            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/VendorView/SearchPoList';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'VendorView/SearchPoList';
            }

            url += "?ProjectID=" + ProjectID + "&VendorID=" + VendorID + "&Status=ALL";
            window.location.href = url;
           
        }
        function Popup() {
            $('#popupforTaxComment2').bPopup({
                easing: 'easeOutBack', //uses jQuery easing plugin
                speed: 450,
                transition: 'slideDown',
                modalColor: 'rgb(18, 54, 65)'
            });
           
        }
    </script>


