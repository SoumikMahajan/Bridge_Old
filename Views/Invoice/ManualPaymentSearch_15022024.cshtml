    function syncallpaymentnumber() {
        
        var t = 0;
        $('#tblPayment tbody tr').each(function () {
            if ($(this).find('td:eq(11)').find('i').length > 0) {
                //console.log($(this).find('td:eq(11)').find('i').html());
                //getpaymentfromQBOall($(this).find('td:eq(11)').find('i'));
                t++;
            }
        });
        if (t == 0) {
            notify("No payment to sync.");
            return;
        }

        t = 0;

        var c = confirm("Are you sure, you want to Sync all payments? This may take some time depending on the number of payments.");
        if (!c) {
            return;
        }

        $('#qbdetailsmodal').modal('show');
        $('#qbstatus').html('Syncing data from QBO. Please wait ' + '<i class="fa fa-spinner fa-spin" aria-hidden="true"></i>');
        

        setTimeout(function () {

            $('#tblPayment tbody tr').each(function () {
                if ($(this).find('td:eq(11)').find('i').length > 0) {
                    //console.log($(this).find('td:eq(11)').find('i').html());
                    getpaymentfromQBOall($(this).find('td:eq(11)').find('i'));
                    t++;
                }
            });

            notify("Synced " + t + " payment(s).", "green");
            $('#qbdetailsmodal').modal('hide');
            setTimeout(function () {
                irrrrr = 0;
                window.location.reload();
            }, 3000);
            //getPaymentDetailsInAdvance();

        }, 1000);



        

    }

