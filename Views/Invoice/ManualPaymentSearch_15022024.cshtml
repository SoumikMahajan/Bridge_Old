                EditPayment(newPayid, "0", amt, Status);
                var c2 = confirm("The data has been saved.Do you want to send the data to QBO right now?");

                if (c2) {
                    EditPayment(newPayid, "1");
                }
                //EditPayment(PaymentID, mode, amt, Status)
            },500);


            

        }
    });



    $("#btnUpdatePayment").on("click", function () {

        if ($("#txt_EditPaymentDate").val() == '') {
            notify("Please Select Payment Date!!!", "red");
            return false;
        }

        if ($("#Ddl_EditPaymentType").val() == '-1') {
            notify("Please Select Payment Type!!!", "red");
            return false;
        }

        if ($("#DDl_EditBank").val() == '0') {
            notify("Please Select Bank Account!!!", "red");
            return false;
        }

        if ($("#Ddl_EditPaymentType").val() == '1' && $("#txtEditPaymentNumber").val() == '') {
            notify("Please Enter Payment Number!!!", "red");
            return false;
        }

        var url = '';
        if (LOCALORSERVERNEW == 'LOCAL') {
            url = '/Invoice/UpdatePaymentMainDetails';
        }
        else if (LOCALORSERVERNEW == 'SERVER') {
            url = 'Invoice/UpdatePaymentMainDetails';
        }
        var convrate = $("#txtEditExrate").val();

        $.ajax({
            type: "POST",
            url: url,
            data: "{ 'ManualPaymentID': '" + $("#hdnEditPayment").val() + "', 'PaymentDate': '" + $("#txt_EditPaymentDate").val()
                + "','PaymentType':'" + $("#Ddl_EditPaymentType").val() + "','PaymentMemo':'" + $("#txtEditMemo").val()
                + "','PaymentNumber':'" + $("#txtEditPaymentNumber").val() + "','TotalPaymentAmount':'" + $("#txtEditTotalAmount").val()
                + "','BankAccountID':'" + $("#DDl_EditBank").val() + "','convrate' : '" + convrate + "','convrate2' : '" + $('#txtEditExrate1').val() + "'}",
            contentType: "application/json; charset=utf-8",
            dataType: "text",
            async: false,
            success: function (data) {
                if (data != 'Error') {
                    //console.log("Hi");
                   
                    $("#tblInvoiceDetails tbody tr").each(function () {
                        var InvoiceAmount = $(this).find("td:eq(6)").find("input[type=text]").val();
                        var PaymentItemID = $(this).find("td:eq(10)").html();
                        url = '';
                        if (LOCALORSERVERNEW == 'LOCAL') {
                            url = '/Invoice/UpdatePaymentItemDetails';
                        }
                        else if (LOCALORSERVERNEW == 'SERVER') {
                            url = 'Invoice/UpdatePaymentItemDetails';
                        }
                        $.ajax({
                            type: "POST",
                            url: url,
                            data: "{ 'ManualPaymentItemID': '" + PaymentItemID + "', 'InvoiceAmount': '" + InvoiceAmount + "'}",
                            contentType: "application/json; charset=utf-8",
                            dataType: "text",
                            async: false,
                            success: function (data) {
                                if (data == "Error") {
                                    notify("Some thing went wrong!!!", "red");
                                    return;
                                }
                               
                                
                            }
                        });
                    });

                    if (data != '') {
                        var cnf = confirm("This payment is associated with a QBO Payment, Do you want to update to QBO?");
                        if (cnf) {
                            //console.log("MMMM>>>" + data);
                            delete_cookie("UPDATEQBO");
                            setCookie("UPDATEQBO", data);
                           
                            EditPayment($("#hdnEditPayment").val(), '1');
                        }
                        else {
                            notify("Payment successfully updated", "green");
                            irrrrr = 0;
                            setTimeout(function () {
                                window.location.reload();
                            }, 4000);
                        }

                    }
                    else {
                        notify("Payment successfully updated", "green");
                        irrrrr = 0;
                        setTimeout(function () {
                            window.location.reload();
                        }, 4000);
                    }

                }
                else {
                    notify('Payment can not be updated, duplicate number exists', 'red');
                }
            }
             , error: function () {
                 notify('QBO is not accessible/Some error occuurred!');
                 setTimeout(function () {
                     window.location.reload();
                 }, 4000);
             }

        });


    });

</script>

