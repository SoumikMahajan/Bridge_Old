    function getpaymentfromQBO(obj) {
        var paymentid = $(obj).attr('data-qboid');
        var pnumber = $(obj).parent().parent().find('td:eq(5)').html();
        var amt = parseFloat($(obj).parent().parent().find('td:eq(9)').html());

        //console.log(paymentid);

        $('#qbdetailsmodal').modal('show');
        $('#qbstatus').html('Fetching information from QBO for ' + pnumber + '. Please wait ' + '<i class="fa fa-spinner fa-spin" aria-hidden="true"></i>');

        var tableheader = "<table class='table'><thead><tr>"
        + "<th style='display:none;'>Action</th>"
        + "<th>Check #</th>"
        + "<th style='display:none;'>Status</th>"
        + "<th>Vendor</th>"
        + "<th  class='rightposition'>Total</th>"
      
        + "</tr></thead><tbody>";
        var html = '';

        var url = '';
        if (amt > 0) {
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Quickbook/getCheckDetails';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Quickbook/getCheckDetails';
            }
        }
        else {
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Quickbook/getCheckDetailsJ';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Quickbook/getCheckDetailsJ';
            }
        }
        setTimeout(function () {

            $.ajax({
                type: "POST",
                url: url,
                data: "{ \"paymentid\": \"" + paymentid + "\"}",
                contentType: "application/json; charset=utf-8",
                dataType: "JSON",
                async: false,
                success: function (data) {
                    console.log(data);

                    console.log("***************!!!!!!!!!!!!!!!");
                    if (data.data.length == 0) {
                        notify("Could not update payment!!!");
                        $('#qbdetailsmodal').modal('hide');
                        return;
                    }

                    if (data.data[0].QBOID == "") {
                        obj = $(obj).parent();
                        $(obj).html('-');
                        $(obj).prev('td').html('Pending');
                        $('#qbdetailsmodal').modal('hide');
                        return;
                    }


                    data = data.data;
                    var total = 0;

                    for (var a = 0; a < data.length; a++) {
                        total += parseFloat(data[a].Total);
                        var action = '';
                        if (data[a].Status == 'Voided') {
                            action = '';
                            html += "<tr style='background:#facbcb;'>"
                       + "<td style='display:none;'>" + "" + "</td>"
                       + "<td>" + data[a].Checknumber + "</td>"

                       + "<td style='display:none;'>" + data[a].Status + "</td>"
                       + "<td>" + data[a].Vendor + "</td>"
                       + "<td class='rightposition'>" + formatNumber(data[a].Total) + "</td></tr>";
                        }
                        else {
                            html += "<tr data-SystemToken='" + data[a].SystemToken + "' data-SyncToken='" + data[a].SyncToken + "' data-QBOID='" + data[a].QBOID + "' >"
                       + "<td style='display:none;'>" + '<i onclick="voidpayment(this);" title="Delete This Payment" style="cursor:pointer;color: #e24848;font-size: 1.4em;" class="fa fa-stop-circle" aria-hidden="true"></i>' + "</td>"
                       + "<td>" + data[a].Checknumber + "</td>"

                       + "<td  style='display:none;'>" + data[a].Status + "</td>"
                       + "<td>" + data[a].Vendor + "</td>"
                       + "<td class='rightposition'>" + formatNumber(data[a].Total) + "</td></tr>";

                        }
                       
                    }


                    $('#qbstatus').html(tableheader + html + "<tr><td colspan='2' style='text-align:right;'>Total:</td><td style='text-align:right;'>" + formatNumber(total) + "</td>" + "</tbody></table>");
                    if (data[0].Checknumber == '' || data[0].Checknumber == '-') {
                        $('#qbstatus').html('Not yet printed');
                        $(obj).prev('span').html('Not Printed');
                    }
                    else {
                        $('#qbstatus').html('Payment number is: ' + data[0].Checknumber);
                        $(obj).prev('span').html(data[0].Checknumber);

                    }

                   
                   
                        $('#qbdetailsmodal').modal('hide');
                   
                },
                error: function () {
                    notify("Some thing went wrong!!!");
                }
            });



        }, 300);

        


    }



