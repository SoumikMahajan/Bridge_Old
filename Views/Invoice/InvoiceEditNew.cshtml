        function CalculateTaxes(val, type, total) {
            var t = 0;
            if (type == '%') {
                t = total * val / 100;
            }
            else {
                t = val;
            }
           
            t = isNaN(parseFloat(t)) ? 0 : t;
            ////console.log(t);
          
            return t;

        }
        function calculatepercent(obj) {


            if ($(obj).val() > 100) {
                $(obj).val('100');
            }
            $('#tblInvoiceItems tbody').find('tr').each(function () {

                var p = $(this).find('td:eq(1)').find('input').val();
                var total = $(this).attr('data-total').replace(',', '');
                var vl = parseFloat(total) * parseFloat(p) / 100;

                var TaxVal = '';
                var Taxtype = '';

                var tottax1 = 0;
                TaxVal = $(this).attr('data-Tax1Val');
                Taxtype = $(this).attr('data-Tax1type');

                tottax1 = CalculateTaxes(TaxVal, Taxtype, vl);

                var tottax2 = 0;
                TaxVal = $(this).attr('data-Tax2Val');
                Taxtype = $(this).attr('data-Tax2type');

                tottax2 = CalculateTaxes(TaxVal, Taxtype, vl);


                var tottax3 = 0;
                TaxVal = $(this).attr('data-Tax3Val');
                Taxtype = $(this).attr('data-Tax3type');

                tottax3 = CalculateTaxes(TaxVal, Taxtype, vl);


                vl += parseFloat(tottax1) + parseFloat(tottax2) + parseFloat(tottax3);

                $(this).find('td:eq(10)').html(isNaN(vl) ? 0 : formatNumber(vl));
                $(this).find('td:eq(9)').find('input:eq(0)').val(formatNumber(tottax1));
                $(this).find('td:eq(9)').find('input:eq(1)').val(formatNumber(tottax2));
                $(this).find('td:eq(9)').find('input:eq(2)').val(formatNumber(tottax3));

            });


            SyncAll();


        }

