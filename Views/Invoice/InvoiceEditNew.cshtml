    <script type="text/javascript">
        function ReverseInvoice() {
            var InvoiceID = $('#Hdn_InvoiceNumber').val();
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Invoice/ReverseInvoice';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Invoice/ReverseInvoice';
            }
            $.ajax({
                type: "POST",
                url: url,
                datatype: "json",
                contentType: "application/json; charset=utf-8",
                data: "{ \"InvoiceID\" : \"" + InvoiceID + "\"}",
                async: false,
                success: function (data) {
                    notify("Invoice Reversed");
                    window.location.reload();
                },
                error: function () { notify('Something went wrong'); }
            });
        }
    </script>

    <script type="text/javascript">
        $(function () {

            getPaymentInformation($('#Hdn_InvoiceNumber').val());

        });
        function getPaymentInformation(InvoiceNumber) {
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Invoice/getPaymentInformation';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Invoice/getPaymentInformation';
            }

            url += "?InvoiceNumberVendor=" + InvoiceNumber;

            $.ajax({
                type: "POST",
                url: url,
                datatype: "json",
                contentType: "application/json; charset=utf-8",
                data: "",
                success: function (data) {
                   
                    if (data == null || data == '') {

                    }
                    else {
                        if (data.split('^').length > 1) {

                            $('#chk_IsPaid').prop('checked', data.split('^')[0] == "1" ? true : false);
                            $('#txt_ChequeNumber').val(data.split('^')[1]);
                            $('#txt_ChequeDate').datepicker("setDate", new Date(data.split('^')[2]));
                            $('#txt_ChequeAmount').val(data.split('^')[3]);
                            $('#txt_Tax1').val(data.split('^')[4]);
                            $('#txt_Tax2').val(data.split('^')[5]);
                            $('#txt_Tax3').val(data.split('^')[6]);                           
                            $('#txt_OtherTax').val(data.split('^')[7]);

                        }
                    }


                },
                error: function () { notify('Something went wrong'); }
            });
        }
        $(function () {

            var date = new Date();
            var currentMonth = date.getMonth();
            var currentDate = date.getDate();
            var currentYear = date.getFullYear();

            $('#txt_ChequeDate').datepicker({
                changeMonth: true,
                changeYear: true,
                //dateFormat: 'MM dd yy'
                dateFormat: 'yy/mm/dd'
                //,minDate: new Date(currentYear, currentMonth, currentDate)
            });
            $('#txt_ChequeDate').datepicker("setDate", date);

        });
        function SavePaymentInformation() {
            var chk_IsPaid = '0';
            var txt_ChequeNumber = '';
            var txt_ChequeDate = '';
            var txt_ChequeAmount = '0';
            var txt_Tax1 = '0';
            var txt_Tax2 = '0';
            var txt_Tax3 = '0';
            var txt_OtherTax = '0';



            if ($('#chk_IsPaid').is(":checked") == true) {
                chk_IsPaid = '1';
            }
            else {
                chk_IsPaid = '0';
            }



            txt_ChequeNumber = $('#txt_ChequeNumber').val();
            txt_ChequeDate = $('#txt_ChequeDate').val();
            txt_ChequeAmount = $('#txt_ChequeAmount').val() == "" ? '0' : $('#txt_ChequeAmount').val();
            txt_Tax1 = $('#txt_Tax1').val() == "" ? '0' : $('#txt_Tax1').val();
            txt_Tax2 = $('#txt_Tax2').val() == "" ? '0' : $('#txt_Tax2').val();
            txt_Tax3 = $('#txt_Tax3').val() == "" ? '0' : $('#txt_Tax3').val();
            txt_OtherTax = $('#txt_OtherTax').val() == "" ? '0' : $('#txt_OtherTax').val();

            
            var InvoiceID = $('#Hdn_InvoiceNumber').val();
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Invoice/SavePaymentInformation';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Invoice/SavePaymentInformation';
            }
            $.ajax({
                type: "POST",
                url: url,
                datatype: "json",
                contentType: "application/json; charset=utf-8",
                data: "{\"InvoiceID\" : \"" + InvoiceID + "\",\"chk_IsPaid\" : \"" + chk_IsPaid + "\",\"txt_ChequeNumber\" : \"" + txt_ChequeNumber + "\",\"txt_ChequeDate\" : \"" + txt_ChequeDate + "\",\"txt_ChequeAmount\" : \"" + txt_ChequeAmount + "\",\"txt_Tax1\" : \"" + txt_Tax1 + "\",\"txt_Tax2\" : \"" + txt_Tax2 + "\",\"txt_Tax3\" : \"" + txt_Tax3 + "\",\"txt_OtherTax\" : \"" + txt_OtherTax + "\"}",
                async: false,
                success: function (data) {
                    notify(data);
                },
                error: function () { notify('Something went wrong'); }
            });

        }
    </script>

</head>
