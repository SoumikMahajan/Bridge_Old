        function QtySet(obj) {

            var qty = isNaN(parseFloat($(obj).val())) ? 0 : parseFloat($(obj).val());

            var rw = $(obj).parent().parent();


            var p = '0';
            if ($(rw).find('td:eq(1) span').length > 0) {
                p = $(rw).find('td:eq(1) span').text().replace(',', '');
            }
            else {
                p = $(rw).find('td:eq(1) input').val().replace(',', '');
            }


             
            var cost = $(rw).find('td:eq(8)').html().replace(',', '');//8 - 
            var t1 = $(rw).find('td:eq(9) input:eq(0)').val().replace(',','');
            var t2 = $(rw).find('td:eq(9) input:eq(1)').val().replace(',','');
            var t3 = $(rw).find('td:eq(9) input:eq(2)').val().replace(',','');

           
            var tot = $(rw).attr('data-total').replace(',', '');
            var vl = cost * qty * p / 100;

            //if (parseFloat(tot) < parseFloat(vl))
            //{
            //    notify('Amount exceeds remaining.');
            //}



            var tottax = parseFloat(t1) + parseFloat(t2) + parseFloat(t3);
            vl += isNaN(tottax) ? 0 : tottax;

            $(rw).find('td:eq(10)').html(vl);


            SyncAll();
        }

