        function fetch(obj) {


            //cancelselectionsinvoice();


            var percent = $('#percentage').val();
            var poidall = '';


            if (obj == "onlyselected") {

                $('.selectedrow').each(function () {


                    if (!$(this).hasClass('noselect')) {

                        $(this).addClass('noselect');

                        var poid = $(this).find('td:eq(0)').html();
                        poidall += poidall == "" ? poid : "^" + poid;
                    }


                });

            }
            else {

                $('#tblPOItemSelector tbody tr').each(function () {


                    if (!$(this).hasClass('noselect')) {
                        $(this).addClass('noselect');
                        var poid = $(this).find('td:eq(0)').html();
                        poidall += poidall == "" ? poid : "^" + poid;
                    }

                });
            }

            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Invoice/getInvoiceDataAfterSelectingForEdit';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Invoice/getInvoiceDataAfterSelectingForEdit';
            }

            cancelselections();

           // alert(poidall);
            var InvoiceID = $('#Hdn_InvoiceNumber').val();



            $.ajax({
                type: "POST",
                url: url,
                datatype: "json",
                contentType: "application/json; charset=utf-8",
                data: "{ \"PoidAll\" : \"" + poidall + "\", \"percent\" : \"" + percent + "\",\"InvoiceID\" : \"" + InvoiceID + "\"}",
                async: false,
                success: function (data) {
                    data = JSON.parse(data).data;

                    BuildInvoiceTable(data);
                    CalculateOtherFields();

                },
                error: function () { notify('Something went wrong'); }
            });

           
        }


        function CalculateOtherFields() {

            var SubTotalInvoice = '';
            var TotalTax1 = 0;
            var TotalTax2 = 0;
            var TotalTax3 = 0;
            var TotalInvoice = 0;
            var Amount = 0.00;

            $('#tblInvoiceItems tbody tr').each(function () {


                //alert($(this).attr('data-rowid'));

                Amount += parseFloat($(this).find('td').eq(10).text().replace(',',''));

                var TempTotalTax1 = $(this).find('td').eq(9).find('input[type="text"]').eq(0).val().replace(',', '');
                var TempTotalTax2 = $(this).find('td').eq(9).find('input[type="text"]').eq(1).val().replace(',', '');
                var TempTotalTax3 = $(this).find('td').eq(9).find('input[type="text"]').eq(2).val().replace(',', '');


                TotalTax1 += isNaN(parseFloat(TempTotalTax1)) ? 0 : parseFloat(TempTotalTax1);
                TotalTax2 += isNaN(parseFloat(TempTotalTax2)) ? 0 : parseFloat(TempTotalTax2);
                TotalTax3 += isNaN(parseFloat(TempTotalTax3)) ? 0 : parseFloat(TempTotalTax3);

            });


            $('#txt_SubtotalInvoice').val(formatNumber(Amount));
            $('#txt_TotalTax1').val(formatNumber(isNaN(TotalTax1) ? 0 : TotalTax1));
            $('#txt_TotalTax2').val(formatNumber(isNaN(TotalTax2) ? 0 : TotalTax2));
            $('#txt_TotalTax3').val(formatNumber(isNaN(TotalTax3) ? 0 : TotalTax3));
            TotalInvoice = parseFloat(Amount) + TotalTax1 + TotalTax2 + TotalTax3;
            $('#txt_TotalInvoice').val(formatNumber(TotalInvoice));

        }

        function fetchreverse(obj) {

            cancelselections();

            if (obj == "onlyselected") {


                $('.selectedrowforinvoice').each(function () {
                    $(this).remove();
                    var poitemidinvoice = $(this).attr('data-rowid');

                    $('#tblPOItemSelector tbody tr').each(function () {
                        var poitemidselector = $(this).find("td:eq(0)").html();
                        if (poitemidselector == poitemidinvoice) { $(this).removeClass('noselect'); }
                    });

                });



            }
            else {



                $('#tblInvoiceItems tbody tr').each(function () {
                    $(this).remove();

                });

                $('#tblPOItemSelector tbody tr').each(function () {
                    $(this).removeClass('noselect');
                });

            }

            SyncAll();


        }

        function BuildInvoiceTable(data) {



            var percent = parseFloat($('#percentage').val());
            var html = "";

            var tax1name = '';
            var tax2name = '';
            var tax3name = '';

            for (var i = 0; i < data.length; i++) {

                var tmptot = parseFloat(data[i].Total * percent / 100);

                var tottax1 = 0;
