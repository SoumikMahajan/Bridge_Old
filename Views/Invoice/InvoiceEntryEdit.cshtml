     <script type="text/javascript">
         $(function () {

             var table = $('#tblPOItemSelector').DataTable();

             table
                 .clear()
                 .draw();
             $('#tblPOItemSelector_filter').hide();
             $('#tblPOItemSelector_length').hide();

             
             var date = new Date();
             var currentMonth = date.getMonth();
             var currentDate = date.getDate();
             var currentYear = date.getFullYear();

             $('#txt_InvoiceDate').datepicker({
                 changeMonth: true,
                 changeYear: true,
                 dateFormat: 'MM dd yy'
                 //,minDate: new Date(currentYear, currentMonth, currentDate)
             });
             $('#txt_InvoiceDate').datepicker("setDate", date);


             $('#txt_InvoiceNumber').keypress(function (event) {
                 var keycode = (event.keyCode ? event.keyCode : event.which);
                 if (keycode == '13') {
                     if ($('#txt_InvoiceNumber').val() == '') {
                         alert('Please enter Invoice Number');
                     }                     
                     else {
                         getInvoiceDetails($('#txt_InvoiceNumber').val());
                     }
                 }
             });
         });
    </script>
    <script type="text/javascript">

        //Worked For 3_11_2015
        function getInvoiceDetails(InvoiceNumber) {
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Invoice/GetInvoice';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Invoice/GetInvoice';
            }

            url += "?InvoiceNumberVendor=" + InvoiceNumber;
           // url += "&PONumber=" + PONumber;           


            $.ajax({
                type: "POST",
                url: url,
                datatype: "json",
                contentType: "application/json; charset=utf-8",
                data: "",
                success: function (data) {
                    //Added By Subhabrata Mondal 3_11_2015
                    select_Invoive_Details(InvoiceNumber);
                    selectpo(data);
                    
                },
                error: function () { notify('Something went wrong'); }
            });
        }


        function select_Invoive_Details(InvoiceNumber)
        {

            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Invoice/GetInvoiceDetails';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Invoice/GetInvoiceDetails';
            }

            url += "?InvoiceNumberVendor=" + InvoiceNumber;
            $.ajax({
                type: "POST",
                url: url,
                datatype: "json",
                contentType: "application/json; charset=utf-8",
                data: "",
                success: function (data) {
                    //Added By Subhabrata Mondal 3_11_2015
                    var invoice = JSON.parse(data);
                    setInvoiceDetails(invoice);
                    getProjectAccount1(invoice.ProjectAccount, $('#Ddl_ProjectAccount'));
                    //alert(invoice.ProjectAccount);
                    //$('#Ddl_ProjectAccount').val(invoice.ProjectAccount);
                    ShowInvoiceTable(invoice);
                },
                error: function () { notify('Something went wrong'); }
            });
        }

        function setInvoiceDetails(invoice)
        {
            //alert(invoice.TotalInvoice);
            $("#txt_TotalInvoiceAmount").val(invoice.InvoiceAmount);
            $("#txt_InvoiceMemo").val(invoice.Memo);
            $("#txt_Terms").val(invoice.Terms);
            $("#txt_SubtotalInvoice").val(invoice.Subtotal);
            $("#txt_TotalTax1").val(invoice.Tax1);
            $("#txt_TotalTax2").val(invoice.Tax2);
            $("#txt_TotalTax3").val(invoice.Tax3);
            $("#txt_TotalInvoice").val(invoice.TotalInvoice);
            $('#txt_InvoiceDate').datepicker("setDate", new Date(invoice.InvoiceDate));
            
            
        }

        function getProjectAccount1(ProjectAccount, $Ddl_ProjectAccount) {
            //
            // var ProjectID = $('#Hdn_ProjectID').val();

            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Invoice/GetAllProjectAccount';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Invoice/GetAllProjectAccount';
            }
            url += "?ProjectAccount=" + ProjectAccount;

            $.ajax({
                type: "POST",
                url: url,
                datatype: "json",
                contentType: "application/json; charset=utf-8",
                data: "",
                success: function (data) {
                    var html = '<option value="0">--Select Project Account--</option>';
                    html += data;
                    $('#Ddl_ProjectAccount').html(html);
                    
                },
                error: function () { notify('Something went wrong'); }
            });

        }

        function ShowInvoiceTable(invoice) {

            var Ddlhtml = "<select>" + $('#Ddl_ProjectAccount').clone().html() + "<select>";
            var html2 = '';
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Invoice/GetInvoiceItemDetails';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Invoice/GetInvoiceItemDetails';
            }
            url += "?InvoiveID=" + invoice.InvoiceNumber;

            $.ajax({
                type: "POST",
                url: url,
                datatype: "json",
                contentType: "application/json; charset=utf-8",
                data: "",
                success: function (data) {

                    var invoice_items = JSON.parse(data);
                    var html="";
                    $.each(invoice_items,function(index)
                    {
                       
                        
                            url = '';
                            if (LOCALORSERVERNEW == 'LOCAL') {
                                url = '/Invoice/GetAllProjectAccount';
                            }
                            else if (LOCALORSERVERNEW == 'SERVER') {
                                url = 'Invoice/GetAllProjectAccount';
                            }
                            url += "?ProjectAccount=" + invoice.ProjectAccount;

                            $.ajax({
                                type: "POST",
                                url: url,
                                datatype: "json",
                                contentType: "application/json; charset=utf-8",
                                data: "",
                                async:false,
                                success: function (data) {
                                    html2 = '<option value="0">--Select Project Account--</option>';
                                    
                                    html2 += data;
                                    

                                },
                                error: function () { notify('Something went wrong'); }
                            });
                        
                            
                       
                        var innerhtml = "";
                        //var total = parseFloat(data[i].Tax1) + parseFloat(data[i].Tax2) + parseFloat(data[i].Tax3) + parseFloat(data[i].Total);
                        innerhtml = "<tr >"
                                  + ">"
                                  + "<td>" + "<input type='text' value='" + invoice_items[index].Percent + "' class='percentclass' onkeyup='calculatepercent(this);' />" + "</td>"
                                  + "<td>" + invoice_items[index].PurchaseOrderNumber + "</td>"
                                  + "<td>" + invoice_items[index].POLineItemNumber + "</td>"
                                  + "<td>" + invoice_items[index].Spec + "</td>"
                                  + "<td>" + "<input type='text' value='" + invoice_items[index].Description + "' />" + "</td>"
                                  + "<td>" + invoice_items[index].Note + "</td>"
                                  + "<td>" + invoice_items[index].Quantity + "</td>"
                                  + "<td>" + invoice_items[index].Amount + "</td>"
                                  + "<td>" + "Tax" + "</td>"
                                  + "<td>" + invoice_items[index].LineItemTotal + "</td>"
                                  //+ "<td>" + "Account" + "</td>"
                                  //+ "<td>" + Ddlhtml + "</td>"
                        +"<td><select>"+
                        html2
                               +"</select></td>"   

                                  + "</tr>";
                        

                        ////console.log($('#Ddl_ProjectAccount').clone().html());
                        html += innerhtml;

                    })
                    $('#tblInvoiceItems').find("tr:gt(0)").remove();
                    $('#tblInvoiceItems tbody').append(html);

                },
                error: function () { notify('Something went wrong'); }
            });
           

            SyncAll();
        }

        //Worked For 3_11_2015

        function selectpo(obj) {
            var poid = obj;// $(obj).find('td:eq(0)').text();
            //var ProjectID = $(obj).find('td:eq(6)').text();
            //$('#Hdn_ProjectID').val(ProjectID);
            //getProjectAccount(ProjectID);
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Invoice/getPOLineItemSelectorBasedOnPO';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Invoice/getPOLineItemSelectorBasedOnPO';
            }
            url += "?POID=" + poid;
            $.get(url)
            .success(function (response) {
                totdata = JSON.parse(response);
                totdata = totdata.data;
                // //console.log(totdata);
                if (totdata.length == 0) {
                    var table = $('#tblPOItemSelector').DataTable();
                    table
                        .clear()
                        .draw();
                    return;
                };
                POLineItemSelector = [];
                for (i = 0; i < totdata.length ; i++) {
                    POLineItemSelector[i] = new Array();
                    POLineItemSelector[i][0] = totdata[i].POLineItemID;
                    POLineItemSelector[i][1] = "<input type='button' value='Select' />";
                    POLineItemSelector[i][2] = totdata[i].TotalID;
                    POLineItemSelector[i][3] = totdata[i].SpecNum;
                    POLineItemSelector[i][4] = totdata[i].ItemDescription;
                    POLineItemSelector[i][5] = totdata[i].Quantity;
                    POLineItemSelector[i][6] = totdata[i].Amount;
                    POLineItemSelector[i][7] = totdata[i].AmountRemaining;
                    POLineItemSelector[i][8] = (i + 1);
                    POLineItemSelector[i][9] = totdata[i].Amount;
                }
                $('#tblPOItemSelector').dataTable().fnDestroy();
                $('#tblPOItemSelector').dataTable({
                    "processing": true,
                    "data": POLineItemSelector,
                    "columns": [
                        { "title": "POLineItemID", "class": "displaynone" },
                        { "title": "Action", "class": "displaynone" },
                        { "title": "Item #", "class": "selectpo" },
                        { "title": "Spec" },
                        { "title": "Description" },
                        { "title": "QTY" },
                        { "title": "Amount" },
                        { "title": "Remaining" },
                        { "title": "RowIndex", "class": "displaynone" },
                        { "title": "Total", "class": "displaynone" }
                    ],
                    paging: false,
                    "initComplete": function () {
                        $('#tblPOItemSelector_filter').hide();
                    },
                    "order": [[2, "asc"]],
                    "aoColumnDefs": [
                       // { 'bSortable': false, 'aTargets': [0, 1, 2, 3, 4, 5,6,7] }
                    ]
                });
                var i = 1;
                $('#tblPOItemSelector tbody tr').each(function () {
                    $(this).find("td:eq(8)").html(i++);
                });
            });
        }
    </script>
    <script type="text/javascript">
        function fetch(obj) {
            var percent = $('#percentage').val();
            var poidall = '';
            if (obj == "onlyselected") {
                $('.selectedrow').each(function () {
                    if (!$(this).hasClass('noselect')) {
                        $(this).addClass('noselect');
                        var poid = $(this).find('td:eq(0)').html();
                        poidall += poidall == "" ? poid : "^" + poid;
                    }
                });
            }
            else {
                $('#tblPOItemSelector tbody tr').each(function () {
                    if (!$(this).hasClass('noselect')) {
                        $(this).addClass('noselect');
                        var poid = $(this).find('td:eq(0)').html();
                        poidall += poidall == "" ? poid : "^" + poid;
                    }
                });
            }
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Invoice/getInvoiceDataAfterSelecting';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Invoice/getInvoiceDataAfterSelecting';
            }
            cancelselections();
            $.ajax({
                type: "POST",
                url: url,
                datatype: "json",
                contentType: "application/json; charset=utf-8",
                data: "{ \"PoidAll\" : \"" + poidall + "\", \"percent\" : \"" + percent + "\"}",
                success: function (data) {
                    data = JSON.parse(data).data;
                    BuildInvoiceTable(data);
                },
                error: function () { notify('Something went wrong'); }
            });
        }
    </script>
</head>
<body>
    <input type="hidden" id="Hdn_ProjectID" value="0" />
    <div class="main_container" id="angulardiv">
      
        <div class="logo_container_heading">Invoice Edit</div>
        <div class="edit_vendor_full">
