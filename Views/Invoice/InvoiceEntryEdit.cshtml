                                        <th>QTY</th>
                                        <th>Amount</th>
                                        <th>Remaining</th>
                                        <th class="displaynone">RowIndex</th>
                                        <th class="displaynone">Total</th>

                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </fieldset>
                </div>
            </div>

            <div class="edit_vendor_half" style=" padding-top: 45px;">
                
                    <div style="position:relative;width:38%; float:left;">
                        <div class="user_panel_container">
                            <label style=" padding: 0px 0px;">Invoice Date</label>
                            <input type="text" id="txt_InvoiceDate" />
                        </div>
                        <div class="user_panel_container">
                            <label style=" padding: 0px 0px;">Invoice Number</label>
