                        <select id="txt_Terms">
                            <option value="0">--Select Terms--</option>
                            @Html.Raw(ViewData["getAllTerms"])
                        </select>
                    </div>
                    <div class="user_panel_container" style="width: 48%; margin-left:4%;">
