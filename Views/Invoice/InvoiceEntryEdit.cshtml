        <label style="height: 25px;top: -7px;position: relative;">Apply %</label>
        <input type="text" value="100" id="percentage" class="floatonly" style="height: 25px;top: -7px;position: relative;" />
        <input type="button" class="singledown" onclick="fetch('onlyselected');" />
        <input type="button" class="doubledown" onclick="fetch('all');" />

        <input type="button" class="singleup" />
        <input type="button" class="doubleup" />
        


        <div class="user_panel_container">
           
            <fieldset style="min-height:230px;">
                <legend>Invoice</legend>
                <div>
                    <table cellpadding="0" cellspacing="0" border="0" class="display no-footer dataTable" id="tblInvoiceItems" style="text-align: center;">
                        <thead>
                            <tr class="theader">
                           
                                <th>Percent</th>
                                <th>PO #</th>
                                <th>Item #</th>
                                <th>Spec</th>
                                <th>Description</th>
