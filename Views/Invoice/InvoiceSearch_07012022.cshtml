                            + totdata[i].InvoiceNumberVendor + '</a>';


                        InvoiceList[i][2] = totdata[i].LegalName;
                        InvoiceList[i][3] = totdata[i].ProjectNumber;
                        InvoiceList[i][4] = totdata[i].Subtotal;
                        InvoiceList[i][5] = formatNumber(totdata[i].Tax1);
                        InvoiceList[i][6] = formatNumber(totdata[i].Tax2);
                        InvoiceList[i][7] = formatNumber(totdata[i].Tax3);
                        InvoiceList[i][8] = formatNumber(totdata[i].TotalInvoice.replace(',', ''));

                        InvoiceList[i][9] = totdata[i].InvoiceNumber;


                    }

                    $('#tblinvoice').dataTable().fnDestroy();

                    $('#tblinvoice').dataTable({
                        "processing": true,
                        "data": InvoiceList,
                        "columns": [
