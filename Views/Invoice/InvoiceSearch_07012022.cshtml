                        url = '/Invoice/InvoiceEdit/';
                    }
                    else if (LOCALORSERVERNEW == 'SERVER') {
                        url = urlchanger('Invoice/InvoiceEdit/');
                    }

                    for (i = 0; i < totdata.length ; i++) {
                        InvoiceList[i] = new Array();

                        InvoiceList[i][0] = '<a target="_blank" href="' + url + totdata[i].InvoiceNumber + '">' + '<i class="fa fa-hand-o-right selectable" style="cursor:pointer;"></i>' + '</a>';

                        InvoiceList[i][1] = totdata[i].InvoiceNumberVendor;
