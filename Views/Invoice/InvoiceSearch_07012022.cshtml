        function SearchInvoice() {

            var fromdate = $('#fromsearch').val();
            var todate = $('#tosearch').val();


            var invoicenumber = $('#txt_invoice').val();
            if (invoicenumber == null) {
                invoicenumber = "";
            }

            var vendorid = $('#txt_Project3').val();
            if (vendorid == null) {
                vendorid = "";
            }
            //if (invoicenumber == '' && vendorid == '')
            //{
            //    notify('Please enter a search crieteria');
            //    return;
            //}
            var ProjectID = $('#txt_Project').val();
            if (ProjectID == null) {
                ProjectID = "";
            }


            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Invoice/GetInvoiceList';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Invoice/GetInvoiceList';
            }
            text="Loading Invoices. Please wait...";
            mode = "alert-warning";
            sign = "<i class='fa fa-spinner fa-spin mrg5R'></i>";
            var html = "<div class='container alert " + mode + "  notification col-sm-12' role='alert' style='z-index:99999; cursor: pointer;' onclick='removenotification();'>"
                + "<span style='width:90%;float:left;'>"
                + sign
                + text
                + "</span>"
                + "</div>";

            $('body').append(html);
            setTimeout(function () {
            $.ajax({
                type: "POST",
                url: url,
                datatype: "json",
                contentType: "application/json; charset=utf-8",
                data: "{ \"VendorID\" : \"" + vendorid + "\",\"InvoiceNumber\" : \"" + invoicenumber
                    + "\",\"ProjectID\": \"" + ProjectID + "\",\"fromdate\" : \"" + fromdate + "\",\"todate\":\"" + todate + "\"}",
                success: function (data) {


                    totdata = JSON.parse(data);
                    //totdata = totdata.data;

                    if (totdata.length == 0) {


                        var table = $('#tblinvoice').DataTable();

                        table
                            .clear()
                            .draw();


                        return;
                    };

                    InvoiceList = [];

                    var url = '';
                    if (LOCALORSERVERNEW == 'LOCAL') {
                        url = '/Invoice/InvoiceEdit/';
                    }
                    else if (LOCALORSERVERNEW == 'SERVER') {
                        url = 'Invoice/InvoiceEdit/';
                    }

                    for (i = 0; i < totdata.length ; i++) {
                        InvoiceList[i] = new Array();
                        InvoiceList[i][0] = totdata[i].InvoiceNumber;
                        InvoiceList[i][1] = totdata[i].InvoiceDate;
                        InvoiceList[i][2] = totdata[i].LegalName;
                        InvoiceList[i][3] = totdata[i].InvoiceNumberVendor;
                        InvoiceList[i][4] = totdata[i].ProjectNumber;
                        InvoiceList[i][5] = totdata[i].CurrencyCode;
                        InvoiceList[i][6] = formatNumber4(totdata[i].Exrate);
                        InvoiceList[i][7] = formatNumber(totdata[i].Subtotal.replace(',', ''));
                        InvoiceList[i][8] = formatNumber(totdata[i].Tax1);
                        InvoiceList[i][9] = formatNumber(totdata[i].Tax2);
                        InvoiceList[i][10] = formatNumber(totdata[i].Tax3);
                        InvoiceList[i][11] = formatNumber(totdata[i].Paymenttotal.replace(',', ''));
                    }

                    $('#tblinvoice').dataTable().fnDestroy();

                    $('#tblPayment').dataTable().fnDestroy();
                    if ($('#tblinvoice thead tr').length > 1) {
                        $('#tblinvoice thead tr:eq(1)').remove();
                    }



                    $('#tblinvoice').dataTable({
                        "processing": true,
                        "data": InvoiceList,
                        "columns": [
                                        { "title": "", "class": "displaynone" },
                                        { "title": "Date", "class": "leftposition" },
                                        { "title": "Vendor", "class": "leftposition" },
                                        { "title": "Invoice #", "class": "leftposition" },
                                        { "title": "Project", "class": "leftposition" },
                                        { "title": "Currency", "class": "rightposition" },
                                        { "title": "Fx Rate", "class": "rightposition" },
                                        { "title": "Subtotal", "class": "rightposition" },
                                        { "title": "Tax1", "class": "rightposition" },
                                        { "title": "Tax2", "class": "rightposition" },
                                        { "title": "Tax3", "class": "rightposition" },
                                        { "title": "Payment", "class": "rightposition" }

                        ],
                        paging: false,
                        "initComplete": function () {
                            $('#tblinvoice_filter').hide();
                            $('#tblinvoice_length').hide();
                            AddtableTdTextAlign('#tblinvoice', '4^5^6^7^8', 'right', false);
                            AddtableThTextAlign('#tblinvoice', '4^5^6^7^8', 'center', true);

                            $('#tblinvoice tbody tr').each(function () {
                                var id = $(this).find('td:eq(0)').html();

                                var amtt = parseFloat($(this).find('td:eq(7)').html());

                                if (amtt >= 0) {
                                    $(this).find('td').attr('onclick', 'gotoInvoice("' + id + '")');
                                }
                                else {
                                   $(this).find('td').attr('onclick', 'gotoCredit("' + id + '")');
                                   
                                }

                               
                                $(this).find('td').css('cursor', 'pointer');

                                if ($(this).find('td:eq(11)').html() != '0.00') {
                                    $(this).find('td:eq(11)').attr('onclick', 'gotoPayment("' + id + '")');
                                    $(this).find('td:eq(11)').css('cursor', 'pointer');
                                    $(this).find('td:eq(11)').css('text-decoration', 'underline');
                                    $(this).find('td:eq(11)').css('color', 'blue');
                                }

                            });


                        },
                        "order": [[1, "desc"]],
                        "aoColumnDefs": [
                            { 'bSortable': false, 'aTargets': [0] }
                        ]
                    });

                    var html = "";
                    html = "<tr>"
                          + "<th rowspan='1' colspan='1'><input class='srch' style='width:100%;padding: 2px 2%; font-family:Arial, FontAwesome' placeholder=' &#xF002;' data-indx='1' type='text'></th>"
                          + "<th rowspan='1' colspan='1'><input class='srch' style='width:100%;padding: 2px 2%; font-family:Arial, FontAwesome' placeholder=' &#xF002;' data-indx='2' type='text'></th>"
                          + "<th rowspan='1' colspan='1'><input class='srch' style='width:100%;padding: 2px 2%; font-family:Arial, FontAwesome' placeholder=' &#xF002;' data-indx='3' type='text'></th>"
                          + "<th rowspan='1' colspan='1'><input class='srch' style='width:100%;padding: 2px 2%; font-family:Arial, FontAwesome' placeholder=' &#xF002;' data-indx='4' type='text'></th>"
                          + "<th rowspan='1' colspan='1'><input class='srch' style='width:100%;padding: 2px 2%; font-family:Arial, FontAwesome' placeholder=' &#xF002;' data-indx='5' type='text'></th>"
                          + "<th rowspan='1' colspan='1'><input class='srch rightposition' style='width:100%;padding: 2px 2%; font-family:Arial, FontAwesome' placeholder=' &#xF002;' data-indx='6' type='text'></th>"
                          + "<th rowspan='1' colspan='1'><input class='srch rightposition' style='width:100%;padding: 2px 2%; font-family:Arial, FontAwesome' placeholder=' &#xF002;' data-indx='7' type='text'></th>"
                          + "<th rowspan='1' colspan='1'><input class='srch rightposition' style='width:100%;padding: 2px 2%; font-family:Arial, FontAwesome' placeholder=' &#xF002;' data-indx='8' type='text'></th>"
                          + "<th rowspan='1' colspan='1'><input class='srch rightposition' style='width:100%;padding: 2px 2%; font-family:Arial, FontAwesome' placeholder=' &#xF002;' data-indx='9' type='text'></th>"
                          + "<th rowspan='1' colspan='1'><input class='srch rightposition' style='width:100%;padding: 2px 2%; font-family:Arial, FontAwesome' placeholder=' &#xF002;' data-indx='10' type='text'></th>"
                          + "<th rowspan='1' colspan='1'><input class='srch rightposition' style='width:100%;padding: 2px 2%; font-family:Arial, FontAwesome' placeholder=' &#xF002;' data-indx='11' type='text'></th>"
                          + "</tr>";

                    if ($('#tblinvoice thead tr').length == 1) {
                        $('#tblinvoice thead').append(html);
                    }

                    var table = $('#tblinvoice').DataTable();
                    $('.srch').on('keyup change', function () {
                        var indx = $(this).attr('data-indx');
                        var txt = this.value;
                        table
                               .column(indx)
                               .search(txt)
                               .draw();
                    });
                    $('.notification').fadeOut(3000);
                },
                error: function () { notify('Something went wrong'); }
            });
        }, 100);

        }

        function formatNumber4(number) {
            number = parseFloat(number);
            var number = number.toFixed(4) + '';
            var x = number.split('.');
            var x1 = x[0];
            var x2 = x.length > 1 ? '.' + x[1] : '';
            var rgx = /(\d+)(\d{3})/;
            while (rgx.test(x1)) {
                x1 = x1.replace(rgx, '$1' + ',' + '$2');
            }
            return x1 + x2;
        }


        function gotoPayment(id) {

            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Invoice/setFormanualsearch';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Invoice/setFormanualsearch';
            }
            $.ajax({
                type: "POST",
                url: url,
                async : false,
                datatype: "json",
                contentType: "application/json; charset=utf-8",
                data: "{ \"id\" : \"" + id + "\"}",
                success: function (data) {

                    var url = '';
                    if (LOCALORSERVERNEW == 'LOCAL') {
                        url = '/Invoice/ManualPaymentSearch';
                    }
                    else if (LOCALORSERVERNEW == 'SERVER') {
                        url = 'Invoice/ManualPaymentSearch';
                    }

                 
                    window.open(url);
                },
                error: function () { notify('Something went wrong'); }
            });



        }

        function gotoCredit(id) {
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Invoice/EditCreditNote/';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Invoice/EditCreditNote/';
            }

            url += id;
            window.open(url);

        }

        //function gotoCredit(id) {
        //    var url = '';
        //    if (LOCALORSERVERNEW == 'LOCAL') {
        //        url = '/Invoice/CreditNoteEdit/';
        //    }
        //    else if (LOCALORSERVERNEW == 'SERVER') {
        //        url = 'Invoice/CreditNoteEdit/';
        //    }

        //    url += id;
        //    window.open(url);

        //}

        function gotoInvoice(id) {
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Invoice/InvoiceEdit/';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Invoice/InvoiceEdit/';
            }

            url += id;
            window.open(url);

        }
        function PopulateVendor() {

            return;

            var projectid = $('#txt_Project').val();
            if (projectid == null) {
                projectid = "";
            }


            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Invoice/GetAllParentVendorSearch';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Invoice/GetAllParentVendorSearch';
            }
            $.ajax({
                type: "POST",
                url: url,
                datatype: "json",
                contentType: "application/json; charset=utf-8",
                data: "{ \"ProjectID\" : \"" + projectid + "\"}",
                success: function (data) {


                    $('#txt_Project3').html(data);
                    $("#txt_Project3").multiselect("refresh").multiselectfilter();

                    var width = '100%';
                    $('.ui-multiselect').css('width', width);
                    $('.ui-multiselect-menu').css('width', '39.5%');
                    $('.ui-state-default').css('color', '#C31001');
                    $('.ui-multiselect').css('height', '34px');
                    $('.ui-multiselect').css('margin-top', '5px');


                },
                error: function () { notify('Something went wrong'); }
            });

        }

        function formatNumber(number) {
            number = parseFloat(number);
            var number = number.toFixed(2) + '';
            var x = number.split('.');
            var x1 = x[0];
            var x2 = x.length > 1 ? '.' + x[1] : '';
            var rgx = /(\d+)(\d{3})/;
            while (rgx.test(x1)) {
                x1 = x1.replace(rgx, '$1' + ',' + '$2');
            }
            return x1 + x2;
        }
    </script>
</head>
<body>

    <input type="hidden" id="poidhdn" value="@ViewData["poidhdn"]" />


    <div class="container-fluid" id="angulardiv" style="zoom:0.95;">


        <div class="row">
            <div class="col-sm-12">
                <h3 class="section-header">Invoice Search</h3>
            </div>
        </div>


        <div class="row">




            <div class="col-sm-3">
                <label>Vendor</label>
                <select id="txt_Project3" multiple="multiple" class="form-control">
                    @*<option value="0">--Select Project--</option>*@
                    @Html.Raw(ViewData["parentVendor"])
                </select>
            </div>




            <div class="col-sm-2">
                <label>Vendor Invoice #</label>
                <input type="text" id="txt_invoice" class="form-control" />
                @*<select id="txt_invoice" multiple="multiple" class="form-control">

                    @Html.Raw(ViewData["invoicenumber"])
                </select>*@

            </div>

            <div class="form-group col-sm-1">
                <label>Date</label>

                <select class="form-control datecontrol" data-from="fromsearch" data-to="tosearch">
                    <option value="13" data-val="All">ALL</option>
                    <option value="1" data-val="custom">Custom</option>
                    <option value="2" data-val="last365">Last 365 Days</option>
                    <option value="3" data-val="today">Today</option>
                    <option value="4" data-val="yesterday">Yesterday</option>
                    <option value="5" data-val="thisweek">This Week</option>
                    <option value="6" data-val="thismonth">This Month</option>
                    <option value="7" data-val="thisquarter">This Quarter</option>
                    <option value="8" data-val="thisyear">This Year</option>

                    <option value="9" data-val="lastweek">Last Week</option>
                    <option value="10" data-val="lastmonth">Last Month</option>
                    <option value="11" data-val="lastquarter">Last Quarter</option>
                    <option value="12" data-val="lastyear">Last Year</option>

                </select>
            </div>


            <div class="col-sm-1">
                <label>From</label>
                <input type="text" id="fromsearch" placeholder="YYYY.MM.DD" class="form-control" />
            </div>



            <div class="col-sm-1">
                <label>To</label>
                <input type="text" id="tosearch" placeholder="YYYY.MM.DD" class="form-control" />
            </div>

            <div class="col-sm-3">
                <label>Project</label>
                <select id="txt_Project" multiple="multiple" onchange="PopulateVendor();" class="form-control">
                    @*<option value="0">--Select Project--</option>*@
                    @Html.Raw(ViewData["getAllProjectNameNumber"])
                </select>
            </div>



            <div class="col-sm-1">
                <button type="button" class="btn btn-poms mrg20T" style="height: 26px;padding: 2px;width: 100px;" value="Search" onclick="SearchInvoice();">Search</button>
            </div>

        </div>INVOICE LIST

        <div class="row mrg10T">
            <div class="col-sm-12">
                <h3 class="section-header">Invoice List</h3>
            </div>
        </div>

        <div class="row mrg10T">

            <div class="col-sm-12">
                <table cellpadding="0" cellspacing="0" border="0" class="display" id="tblinvoice" style="text-align: center;">
                    <thead>
                        <tr>
                            <th class="displaynone">Action</th>
                            <th style="width:150px !important;" class="leftposition">Date</th>
                            <th style="width:200px !important;" class="leftposition">Vendor</th>
                            <th style="width:150px !important;" class="leftposition">Invoice #</th>
                            <th style="width:200px !important;" class='rightposition'>Project</th>
                            <th style="width:100px !important;" class='rightposition'>Currency</th>
                            <th style="width:150px !important;" class='rightposition'>FX Rate</th>
                            <th style="width:150px !important;" class='rightposition'>Subtotal</th>
                            <th style="width:150px !important;" class='rightposition'>Tax 1</th>
                            <th style="width:150px !important;">Tax 2</th>
                            <th style="width:150px !important;">Tax 3</th>
                            <th style="width:150px !important;">Payment</th>
                        </tr>
                    </thead>
                </table>
            </div>

        </div>



        <script>
            $(document).ready(function () {
                var id = $('#poidhdn').val();
                if (id != "") {
                    SearchInvoiceFirst();
                }
            });
        </script>





    </div>
</body>
</html>
