            ProjectText = ProjectText == null ? "" : ProjectText.toString();


            if (Projectval.toString() == null || Projectval.toString() == undefined || Projectval.toString() == 'undefined') {
                $('#lbl_ProjectName').html('No vendor has been selected.');
                return;
            }

            if (Projectval.toString() == '0') {
                $('#lbl_ProjectName').html('No vendor has been selected.');
            }
            else {
                $('#lbl_ProjectName').html('Selected vendor : ' + $(obj).find('option:selected').text());
            }


        }
          </script>

    <script>
        function gotoinvoices() {
            
            var totid = "";
            $('#tblPOSelector tbody tr').each(function () {
                var poid = $(this).find('td:eq(0)').html();
                totid += totid == "" ? poid : "^" + poid;
            });

            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Invoice/invoicesearch';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Invoice/invoicesearch';
            }
            url += "/" + totid;

            window.open(url);


        }
    </script>
