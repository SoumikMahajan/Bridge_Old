        function taxablecalc() {

            $('#tblInvoiceItems tbody').find('tr').each(function () {

                var tr = $(this).find('td:eq(9)');

                var tb1 = $(tr).find('input:eq(0)');
                var tb2 = $(tr).find('input:eq(1)');
                var tb3 = $(tr).find('input:eq(2)');


                var cnt = 3;

                if ($(tb1).hasClass('displaynone')) {
                    cnt--;
                }
                else {
                    if ($(tr).find('.txremove1').length == 0) {

                        $(tb1).after('<i  onclick="removeaddtaxfield(this,\'R\');" style="color:red;float:left;" class="txremove1 mrg5L mrg10T fa fa-times"></i>');
                    }
                }

                if ($(tb2).hasClass('displaynone')) {
                    cnt--;
                }

                else {
                    if ($(tr).find('.txremove2').length == 0) {
                        $(tb2).after('<i  onclick="removeaddtaxfield(this,\'R\');" style="color:red;float:left;" class="txremove2 mrg5L mrg10T fa fa-times"></i>');
                    }
                }

                if ($(tb3).hasClass('displaynone')) {
                    cnt--;
                }
                else {
                    if ($(tr).find('.txremove3').length == 0) {
                        $(tb3).after('<i  onclick="removeaddtaxfield(this,\'R\');" style="color:red;float:left;" class="txremove3 mrg5L mrg10T fa fa-times"></i>');
                    }
                }



                if (cnt != 3) {
                    if ($(tr).find('.newaddtax').length == 0) {
                        $(tr).append('<i class="mrg5T newaddtax fa fa-plus-square" style="color:#7792A8;float:left;" onclick="removeaddtaxfield(this,\'A\');"></i>');
                    }
                }
                else {
                    $(tr).find('.newaddtax').remove();
                }

            });

        }

        function removeaddtaxfield(obj, mode) {
            if (mode == 'R') {
                $(obj).prev('input').addClass('displaynone');
                $(obj).prev('input').val("0.00");
                $(obj).remove();
            }
            else {

                var tr = $(obj).parent();

                var tb1 = $(tr).find('input:eq(0)');
                var tb2 = $(tr).find('input:eq(1)');
                var tb3 = $(tr).find('input:eq(2)');

                if ($(tb1).hasClass('displaynone')) {
                    $(tb1).val('0.00');
                    $(tb1).removeClass('displaynone');

                }
                else if ($(tb2).hasClass('displaynone')) {
                    $(tb2).val('0.00');
                    $(tb2).removeClass('displaynone');

                }
                else if ($(tb2).hasClass('displaynone')) {
                    $(tb2).val('0.00');
                    $(tb2).removeClass('displaynone');

                }
                else if ($(tb3).hasClass('displaynone')) {
                    $(tb3).val('0.00');
                    $(tb3).removeClass('displaynone');

                }

                           
                

            }
            taxablecalc();
            SyncLowerTable();
            SyncAll();
        
        }


