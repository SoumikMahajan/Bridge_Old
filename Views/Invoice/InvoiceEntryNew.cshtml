    <script>
        var POSelector = new Array();
        var POLineItemSelector = new Array();

        $(function () {



            $("#Ddl_Vendors").change(function () {

                $('#gotoinvoices').show();

                $('#POIdEdit').html('<a href="javascript:void(0);">PO # <span></span></a>');

                var str = "" + $("#Ddl_Vendors").val();

                var vendors = str.replace(/,/g, "^");

                var url = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url = '/Invoice/getPOSelectorBasedOnVendor';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url = 'Invoice/getPOSelectorBasedOnVendor';
                }

                url += "?VendorID=" + vendors;


                $.get(url)
                .success(function (response) {

                    totdata = JSON.parse(response);
                    totdata = totdata.data;


                    // //console.log(totdata);
                    if (totdata.length == 0) {


                        var table = $('#tblPOSelector').DataTable();

                        table
                            .clear()
                            .draw();


                        return;
                    };

                    POSelector = [];


                    for (i = 0; i < totdata.length ; i++) {
                        POSelector[i] = new Array();

                        POSelector[i][0] = totdata[i].POID;

                        POSelector[i][1] = "<input type='checkbox' class='poselector_chk' />";

                        POSelector[i][2] = totdata[i].TotalID.split('-')[0] + '-' + totdata[i].TotalID.split('-')[2];
                        POSelector[i][3] = formatNumber(totdata[i].Total);
                        POSelector[i][4] = formatNumber(totdata[i].Remaining);
                        POSelector[i][6] = formatNumber(totdata[i].Tax);
                        POSelector[i][5] = totdata[i].Terms;

                        POSelector[i][7] = totdata[i].ProjectID;
                        POSelector[i][8] = totdata[i].Vendor_ID;


                    }


                    $('#tblPOSelector').dataTable().fnDestroy();

                    $('#tblPOSelector').dataTable({
                        "processing": true,
                        "data": POSelector,
                        "columns": [
                                        { "title": "POID", "class": "displaynone" },
                                        { "title": "Action" },
                                        { "title": "PO Number", "class": "selectpo" },
                                        { "title": "Amount" },
                                        { "title": "Amount Remaining" },
                                        { "title": "Terms" },
                                        { "title": "Taxes" }
                                        , { "title": "ProjectID", "class": "displaynone" }
                                        , { "title": "VendorId", "class": "displaynone" }

                        ],
                        paging: false,
                        "initComplete": function () {
                            $('#tblPOSelector_filter').hide();

                            AddtableTdTextAlign('#tblPOSelector', '3^4^6', 'right', false);
                        },
                        "order": [[2, "asc"]],
                        "aoColumnDefs": [
                           // { 'bSortable': false, 'aTargets': [0, 1, 2, 3, 4, 5] }
                        ]
                    });


                    $('#tblPOSelector tbody tr').each(function () {
                        $(this).find('td:eq(1) input').attr('onclick', 'selectpo(this);');
                    });



                });




            });


        });



        function selectpo(obj) {

            obj = $(obj).parent().parent();


            $('#POIdEdit').html('<a href="javascript:void(0);">PO #<span></span></a>');

            $('#tblInvoiceItems tbody').html('');

            var table = $('#tblPOItemSelector').DataTable();

            table.clear().draw();


            $('#tblPOItemSelector_filter').hide();
            $('#tblPOItemSelector_length').hide();

            var poid = $(obj).find('td:eq(0)').text();
            var vendorid = $('#Ddl_Vendors').val();



            $('#hdn_vendorid').val(vendorid);

            


            var rspnsurl = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                rspnsurl = '/PurchaseOrder/POEdit/' + poid;
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                rspnsurl = 'PurchaseOrder/POEdit/' + poid;
            }

            $('#POIdEdit').html('<a href="' + rspnsurl + '" target="_blank" data-id="' + poid + '" > PO # <span></span></a>');

            var ProjectID = $(obj).find('td:eq(7)').text();

            $('#Hdn_ProjectID').val(ProjectID);


            $('#Hdn_TotalPOValue').val($(obj).find('td:eq(3)').text());
            $('#Hdn_TotalPOTaxes').val($(obj).find('td:eq(6)').text());

            ForToolTip();

            getProjectAccount(ProjectID);

            var poid = '';

            var terms = "";
            var termscount = 0;

            $('.poselector_chk').each(function () {
                var curterms = "";

                if ($(this).is(':checked')) {
                    curterms = $(this).parent().parent().find('td:eq(5)').html();
                    if (curterms != "") {
                     
                        if (terms == "") {
                            terms = curterms;
                            termscount++;
                        }
                        else {
                            
                            if (terms != curterms) {
                                terms = curterms;
                                termscount++;
                            }
                        }
                    }
                    poid += poid == "" ? $(this).parent().parent().find('td:eq(0)').html() : "^" + $(this).parent().parent().find('td:eq(0)').html();
                }

            });

          

            if (termscount == 1) {
                $("#txt_Terms option:contains(" + terms + ")").prop('selected', true);

            }
            else {
                $("#txt_Terms option:contains(" + "--Select Terms--" + ")").prop('selected', true);
            }

            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Invoice/getPOLineItemSelectorBasedOnPO';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Invoice/getPOLineItemSelectorBasedOnPO';
            }

            url += "?POID=" + poid;

            $('#hdn_poid').val(poid);


            $.get(url)
            .success(function (response) {



                totdata = JSON.parse(response);
                totdata = totdata.data;




                // //console.log(totdata);
                if (totdata.length == 0) {


                    var table = $('#tblPOItemSelector').DataTable();

                    table
                        .clear()
                        .draw();


                    return;
                };

                POLineItemSelector = [];


                for (i = 0; i < totdata.length ; i++) {
                    POLineItemSelector[i] = new Array();

                    POLineItemSelector[i][0] = totdata[i].POLineItemID;

                    POLineItemSelector[i][1] = "<input type='button' value='Select' />";

                    POLineItemSelector[i][2] = totdata[i].TotalID;
                    POLineItemSelector[i][3] = totdata[i].SpecNum;
                    POLineItemSelector[i][4] = totdata[i].ItemDescription;
                    POLineItemSelector[i][5] = formatNumber(totdata[i].Quantity);
                    POLineItemSelector[i][6] = formatNumber(totdata[i].Amount);
                    POLineItemSelector[i][7] = formatNumber(totdata[i].AmountRemaining);
                    POLineItemSelector[i][8] = (i + 1);
                    //POLineItemSelector[i][9] = totdata[i].Amount;
                    POLineItemSelector[i][9] = totdata[i].AmountRemaining;
                    POLineItemSelector[i][10] = formatNumber(totdata[i].PercentPaid);


                }


                $('#tblPOItemSelector').dataTable().fnDestroy();

                $('#tblPOItemSelector').dataTable({
                    "processing": true,
                    "data": POLineItemSelector,
                    "columns": [
                        { "title": "POLineItemID", "class": "displaynone" },
                        { "title": "Action", "class": "displaynone" },
                        { "title": "Item #", "class": "selectpo" },
                        { "title": "Spec" },
                        { "title": "Description" },
                        { "title": "QTY" },
                        { "title": "PO Cost" },
                        { "title": "Remaining","class" : "underline" },
                        { "title": "RowIndex", "class": "displaynone" },
                        { "title": "Total", "class": "displaynone" },
                    { "title": "%" }

                    ],
                    paging: false,
                    "initComplete": function () {

                      

                        $('#tblPOItemSelector_filter').hide();
                        $('#tblPOItemSelector thead tr').find('th:eq(7)').removeClass('underline');

                        $('#tblPOItemSelector tr').each(function () {
                            $(this).find('td:eq(7)').css('cursor', 'pointer');
                            $(this).find('td:eq(7)').attr('onclick', 'getotherinvoices(this);');
                        });

                    },
                    "order": [[2, "asc"]],
                    "aoColumnDefs": [

                    ]
                });

                var i = 1;
                $('#tblPOItemSelector tbody tr').each(function () {
                    $(this).find("td:eq(8)").html(i++);
                });



            });



        }

    </script>


    <script>

        function getotherinvoices(obj) {
            var rw = $(obj).parent();
            var itemid = $(rw).find('td:eq(0)').html();

           

            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Invoice/getotherinvoices';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Invoice/getotherinvoices';
            }

            cancelselections();

            $.ajax({
                type: "POST",
                url: url,
                datatype: "json",
                contentType: "application/json; charset=utf-8",
                data: "{ \"itemid\" : \"" + itemid + "\"}",
                async: false,
                success: function (data) {

                    var totdata = JSON.parse(data);
                    totdata = totdata.data;

                    if (totdata.length == 0) {
                        var table = $('#tblprevinvoice').DataTable();
                        table
                            .clear()
                            .draw();
                        return;
                    };

                    var prevdata = [];

                    for (i = 0; i < totdata.length ; i++) {

                        prevdata[i] = [];

                        prevdata[i][0] = totdata[i].InvoiceDate;
                        prevdata[i][1] = formatNumber(totdata[i].InvoiceAmount);
                        prevdata[i][2] = formatNumber(totdata[i].Amount);
                        prevdata[i][3] = formatNumber(totdata[i].Quantity);
                        prevdata[i][4] = formatNumber(totdata[i].Percent);
                        prevdata[i][5] = formatNumber(totdata[i].LineItemTotal);

                    }


                    $('#tblprevinvoice').dataTable().fnDestroy();

                    $('#tblprevinvoice').dataTable({
                        "processing": true,
                        "data": prevdata,
                        "columns": [
                            { "title": "Invoice Date"},
                            { "title": "Invoice Amt" },
                            { "title": "Item Cost" },
                            { "title": "Item Qty" },
                            { "title": "%" },
                            { "title": "Total" },
                        ],
                        paging: false,
                        "initComplete": function () {
                        },
                        "order": [[2, "asc"]],
                        "aoColumnDefs": [
                        ]
                    });
                    $('#previnvoice').modal('show');   
                },
                error: function () { notify('Something went wrong'); }
            });


        }

        $(function () {

            $('#tblPOItemSelector').on('draw.dt', function () {
                cancelselections();
                var i = 1;
                $('#tblPOItemSelector tbody tr').each(function () {
                    $(this).find("td:eq(8)").html(i++);
                });

            });

            $('#tblPOItemSelector tr').live('click', function (event) {

                if ($(this).hasClass('theader')) {
                    return;
                }
                var clickedrowindex = $(this).find("td:eq(8)").html();

                if (!event.ctrlKey && !event.shiftKey) {
                    var ln = $('.selectedrow').length;
                    var hclass = false;
                    hclass = $(this).hasClass('selectedrow');
                    cancelselections();

                    if (!hclass || ln > 1 || ln == 0) {
                        $(this).addClass('selectedrow');
                    }
                    else if (ln == 1) {
                        $(this).removeClass('selectedrow');
                    }
                }

                else if (event.ctrlKey) {

                    var hclass = false;
                    hclass = $(this).hasClass('selectedrow');

                    if (!hclass) {
                        $(this).addClass('selectedrow');
                    }
                    else {
                        $(this).removeClass('selectedrow');
                    }

                }

                else if (event.shiftKey) {

                    var closestrow = 99999999;
                    var closestrowindex = 0;

                    $('.selectedrow').each(function () {

                        if ($(this).hasClass('selectedrow')) {
                            var id = $(this).find("td:eq(8)").html();

                            var diff = id - clickedrowindex;


                            diff = diff < 0 ? 0 - diff : diff;
                            if (closestrow > diff) {
                                closestrow = diff;
                                closestrowindex = id;
                            }

                        }

                    });





                    var startpoint = 0;
                    var endpoint = 0;
                    startpoint = clickedrowindex > closestrowindex ? closestrowindex : clickedrowindex;
                    endpoint = clickedrowindex > closestrowindex ? clickedrowindex : closestrowindex;
                    cancelselections();

                    $('#tblPOItemSelector tbody tr').each(function () {

                        var currrowindex = $(this).find("td:eq(8)").html();
                        if (currrowindex >= startpoint && currrowindex <= endpoint) {
                            $(this).addClass('selectedrow');
                        }

                    });







                }























                $('#tblPOItemSelector tbody tr').each(function () {

                    if ($(this).hasClass('selectedrow')) {

                        $(this).find('td').css('background-color', 'rgb(201, 240, 249)');
                    }
                    else {
                        if ($(this).hasClass('odd')) {
                            $(this).find('td').css('background-color', '#f9f9f9');
                        }
                        else {
                            $(this).find('td').css('background-color', '#fff');

                        }
                    }


                });




            });


            $('#tblInvoiceItems tr .selectable').live('click', function (event) {


                var obj = $(this).parent().parent();


                if ($(obj).hasClass('theader')) {
                    return;
                }
                var clickedrowindex = $(obj).attr('data-rowindex');

                if (!event.ctrlKey && !event.shiftKey) {
                    var ln = $('.selectedrowforinvoice').length;
                    var hclass = false;
                    hclass = $(obj).hasClass('selectedrowforinvoice');
                    cancelselectionsinvoice();

                    if (!hclass || ln > 1 || ln == 0) {
                        $(obj).addClass('selectedrowforinvoice');
                    }
                    else if (ln == 1) {
                        $(obj).removeClass('selectedrowforinvoice');
                    }
                }

                else if (event.ctrlKey) {

                    var hclass = false;
                    hclass = $(obj).hasClass('selectedrowforinvoice');

                    if (!hclass) {
                        $(obj).addClass('selectedrowforinvoice');
                    }
                    else {
                        $(obj).removeClass('selectedrowforinvoice');
                    }

                }

                else if (event.shiftKey) {

                    var closestrow = 99999999;
                    var closestrowindex = 0;

                    $('.selectedrowforinvoice').each(function () {

                        if ($(this).hasClass('selectedrowforinvoice')) {
                            var id = $(this).attr('data-rowindex');

                            var diff = id - clickedrowindex;


                            diff = diff < 0 ? 0 - diff : diff;
                            if (closestrow > diff) {
                                closestrow = diff;
                                closestrowindex = id;
                            }

                        }

                    });





                    var startpoint = 0;
                    var endpoint = 0;
                    startpoint = clickedrowindex > closestrowindex ? closestrowindex : clickedrowindex;
                    endpoint = clickedrowindex > closestrowindex ? clickedrowindex : closestrowindex;
                    cancelselectionsinvoice();

                    $('#tblInvoiceItems tbody tr').each(function () {

                        var currrowindex = $(this).attr('data-rowindex');
                        if (currrowindex >= startpoint && currrowindex <= endpoint) {
                            $(this).addClass('selectedrowforinvoice');
                        }

                    });







                }























                $('#tblInvoiceItems tbody tr').each(function () {

                    if ($(this).hasClass('selectedrowforinvoice')) {

                        $(this).find('td').css('background-color', 'rgb(201, 240, 249)');
                    }
                    else {
                        if ($(this).hasClass('odd')) {
                            $(this).find('td').css('background-color', '#f9f9f9');
                        }
                        else {
                            $(this).find('td').css('background-color', '#fff');

                        }
                    }


                });




            });


        });


        function cancelselections() {

            //$('#lineitems tr').removeClass('selectedrow');

