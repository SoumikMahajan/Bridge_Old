        function GetExchangeConversion(exValue) {
            var exchangeValue = exValue;
            var currentExchngRate = parseFloat($('#exchngrate').val().trim());
            if (currentExchngRate > 0) {
                exchangeValue = parseFloat(currentExchngRate * exchangeValue).toFixed(2);
            }
            return exchangeValue;
        }

        function dataedited(val, obj) {

            //console.log('%%%%%%');

            $(obj).removeAttr('data-edited');
            $(obj).attr('data-edited', val);
