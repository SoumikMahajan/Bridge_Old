        function ChangeItemadjust(op) {
            var percent, qty, amnt, total, step, totalshow, newp, newtotal, remaining;

            $('.selectedrowforinvoice').each(function () {
                remaining = parseFloat($(this).attr('data-remaining'));
                qty = replaceAll($(this).find('td:eq(7) input').val(), ',', '');
                amnt = replaceAll($(this).find('td:eq(8) input').val(), ',', '');
                percent = replaceAll($(this).find('td:eq(1) input').val(), ',', '');
                total = parseFloat(qty) * parseFloat(amnt) * parseFloat(percent) / 100;
                totalshow = replaceAll($(this).find('td:eq(11)').html(), ',', '');
                totalshow = parseFloat(totalshow);

                if (op == '+') {
                    newtotal = totalshow + 1 / 100;
                    totalshow = totalshow + 1 / 100;
                }

                else {
                    newtotal = totalshow - 1 / 100;
                    totalshow = totalshow - 1 / 100;

                }
                newp = 100 * newtotal / (parseFloat(qty) * parseFloat(amnt));

                if (remaining < totalshow) {
                    notify("Can not exceed remaining!");
                    return;
                }

                $(this).find('td:eq(1) input').val(newp);
                $(this).find('td:eq(1) input').trigger('keyup');




                // $(this).find('td:eq(11)').html(newtotal);

            });

        }

