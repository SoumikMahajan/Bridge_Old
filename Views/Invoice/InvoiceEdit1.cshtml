    <script>

        function getbalance(name) {
            $('#bnkbalance').html('<i class="fa fa-spinner fa-spin" aria-hidden="true"></i>');

            setTimeout(function () {
                var data = qbcheckbankaccount(name);

                $('#bnkbalance').html('');
                if (data == 'Unauthorized-401') {
                    notify("Unauthorized access to QBO. System not yet authorized to use any QB account");


                }
                else if (data != "INVALID") {
                  //  $('#bnkbalance').html(formatNumber(data.split('^^^')[0].split('(')[0]) + ' (' + data.split('^^^')[0].split('(')[1]);
                    $('#bnkbalance').html(formatNumber(data.split('^^^')[0].split(' (')[0]) + ' ' + data.split('^^^')[0].split(' (')[1].split(')')[0]);
                }
                else {
                    $('#bnkbalance').html('Does not exist in QBO');
                }
            }, 200);


        }
        function qbcheckbankaccount(name) {
            var response = '';

            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/QuickBook/CheckBankAccount';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'QuickBook/CheckBankAccount';
            }
            $.ajax({
                type: "POST",
                url: url,
                data: "{ 'name': '" + name + "'}",
                contentType: "application/json; charset=utf-8",
                dataType: "text",
                async: false,
                success: function (data) { response = data; }
            });

            return response;

        }



        function ProjectNameAtLabel(obj) {
            var Projectval = $(obj).find("option:selected").attr('data-id');
            Projectval = Projectval == null ? "" : Projectval.toString();


            var ProjectText = $(obj).find('option:selected').text();
            ProjectText = ProjectText == null ? "" : ProjectText.toString();


            if (Projectval.toString() == null || Projectval.toString() == undefined || Projectval.toString() == 'undefined') {
                $('#lbl_ProjectName').html('No vendor has been selected.');
                return;
            }

            if (Projectval.toString() == '0') {
                $('#lbl_ProjectName').html('No vendor has been selected.');
            }
            else {
                $('#lbl_ProjectName').html('Selected vendor : ' + $(obj).find('option:selected').text());
            }


        }
    </script>

