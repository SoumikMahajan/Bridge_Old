                else {
                    if ($(tr).find('.txremove1').length == 0) {

                        $(tb1).after('<i  onclick="removeaddtaxfield(this,\'R\');" style="color:red;float:left;" class="txremove1 mrg5L mrg10T fa fa-times"></i>');
