            url += "?VendorID=" + vendors;
            url += "&Invoiceid=" + $('#Hdn_InvoiceNumber').val();
           


            $.ajax({
                type: "POST",
                url: url,
                datatype: "json",
                contentType: "application/json; charset=utf-8",
                data: {},
                async: false,
                success: function (response) {

                    totdata = JSON.parse(response);
                    totdata = totdata.data;


                    // //console.log(totdata);
                    if (totdata.length == 0) {


                        var table = $('#tblPOSelector').DataTable();

                        table
                            .clear()
                            .draw();


                        return;
                    };
                    console.log(totdata);
                    console.log('totdata');

                    POSelector = [];

                    var ii = 0;
                    for (i = 0; i < totdata.length ; i++) {
                        
                        var chk = "<input type='checkbox' class='poselector_chk' />";
                        //console.log(POID);
                        for (var l = 0; l < POID.split('^').length; l++) {
                            

                            if (POID.split('^')[l] == totdata[i].POID) {
                               chk = "<input type='checkbox' checked class='poselector_chk' />"
                            }
                        }
                        var fxrate = $('#exchngrate').val();

                        if (totdata[i].ProjectID == Project_ID) {
                            var polink = "<a href='/Purchaseorder/POEdit/" + totdata[i].POID + "' target='_blank'>"
                                             + totdata[i].TotalID + "</a>";

                            POSelector[ii] = new Array();

                            POSelector[ii][0] = totdata[i].POID;

                            POSelector[ii][1] = chk;
                            POSelector[ii][2] = polink;//totdata[i].TotalID;
                            POSelector[ii][3] = totdata[i].CurrencyCode;
                            POSelector[ii][4] = formatNumber(totdata[i].Total);
                            POSelector[ii][5] = formatNumber(totdata[i].Remaining);

                            POSelector[ii][7] = formatNumber(totdata[i].Tax);
                            POSelector[ii][6] = totdata[i].Terms.substring(0, 20);
                            POSelector[ii][8] = totdata[i].ProjectID;
                            POSelector[ii][9] = totdata[i].Vendor_ID;

                            POSelector[ii][10] = totdata[i].Remaining;
                            POSelector[ii][11] = totdata[i].Total;
                            ii++;
                        }


                    }


                    $('#tblPOSelector').dataTable().fnDestroy();

                    $('#tblPOSelector').dataTable({
                        "processing": true,
                        "destroy": true,
                        "data": POSelector,
                        "columns": [
                                        { "title": "POID", "class": "displaynone" },
                                        { "title": "", "class": "leftposition" },
                                        { "title": "PO #", "class": "leftposition" },
                                        { "title": "Curr", "class": "leftposition" },
                                        { "title": "Amount", "class": "rightposition" },
                                        { "title": "Remaining", "class": "rightposition" },
                                        { "title": "Pymnt Sch.", "class": "leftposition displaynone" },
                                        { "title": "Taxes", "class": "rightposition displaynone" }
                                        , { "title": "ProjectID", "class": "displaynone" }
                                        , { "title": "VendorId", "class": "displaynone" },
                                        { "title": "RemainingDuplicate", "class": "displaynone" },
                { "title": "AmountDuplicate", "class": "displaynone" }

                        ],
                        paging: false,
                        "initComplete": function () {
                            $('#tblPOSelector_filter').hide();

                            AddtableTdTextAlign('#tblPOSelector', '4^5^7', 'right', false);

                        },
                        "order": [[2, "asc"]],
                        "aoColumnDefs": [
                            { 'bSortable': false, 'aTargets': [1] }
                        ]
                         , "order": [[2, "asc"]]
                    });


                    $('#tblPOSelector tbody tr').each(function () {
                        $(this).find('td:eq(1) input').attr('onclick', 'selectpo(this);');
                    });

                   // getconvrateforproject();

                   selectpo1();

                }

            });


            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Invoice/getprojectlistForEdit';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Invoice/getprojectlistForEdit';
            }

            url += "?VendorID=" + vendors;


            $.ajax({
                type: "POST",
                url: url,
                
                contentType: "application/json; charset=utf-8",
                data: {},
                async: false,
                success: function (response) {

                    $('#ddl_project').html(response);
                    $('#ddl_project').val(Project_ID);
                    $("#ddl_project").multiselect('refresh');
                    $("#ddl_project").multiselect('disable');
                    //console.log("HAHAHAHAHAHA" + Project_ID);
                   
                    var t1 = $('#ddl_project option:selected').attr('data-tax1');
                    var t2 = $('#ddl_project option:selected').attr('data-tax2');
                    var t3 = $('#ddl_project option:selected').attr('data-tax3');

                    t1 = t1 == '' ? 'Total Tax 1' : 'Total ' + t1;
                    t2 = t2 == '' ? 'Total Tax 2' : 'Total ' + t2;
                    t3 = t3 == '' ? 'Total Tax 3' : 'Total ' + t3;

                    $('#tt1').text(t1);
                    $('#tt2').text(t2);
                    $('#tt3').text(t3);

                    //$('#ddl_project').find('option:eq(0)').prop('selected', 'selected');

                    getProjectAccount1($('#ddl_project').val());

                    //setTimeout(function () {
                    //    rebuildposelector();
                    //}, 500)


                }

          });


            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Invoice/gettermsforvendor';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Invoice/gettermsforvendor';
            }

            url += "?VendorID=" + vendors;


            $.ajax({
                type: "POST",
                url: url,
               
                contentType: "application/json; charset=utf-8",
                data: {},
                async: false,
                success: function (response) {

                    $('#txt_Terms').val(response);

                }
            });

            fetchfirst();



        }




        $(function () {
            var paymentcount = $('#hdn_status').val().split('^')[1];
            var subtotal = $('#hdn_status').val().split('^')[0];

            if (subtotal == 0) {
                $('#btn_void').remove();
            }
            if (paymentcount > 0) {
                $('#btn_void').addClass('inactivenow').removeAttr('onclick');
                $('#btn_delete').addClass('inactivenow').removeAttr('onclick');

            }

            getInvoiceDetails($('#Hdn_InvoiceNumber').val());

        });

        function voidinvoice() {

            var c = confirm("Do you want to void this invoice?");
            if (!c) {
                return;
            }
            var invoiceid = $('#Hdn_InvoiceNumber').val();

            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Invoice/VoidInvoice';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = '/Invoice/VoidInvoice';
            }
            $.ajax({
                type: "POST",
                url: url,
                data: "{ 'invoiceid': '" + invoiceid + "'}",
                contentType: "application/json; charset=utf-8",
                dataType: "text",
                async: false,
                success: function (data) {
                    if (data == 'SUCCESS') {
                        notify('Invoice voided successfully', 'green');
                        setTimeout(function () {
                            window.location.reload();
                        }, 4000);
                    }
                }
            });




        }


        function deleteinvoice() {
            var c = confirm("Do you want to delete this invoice?");
            if (!c) {
                return;
            }
            var invoiceid = $('#Hdn_InvoiceNumber').val();

            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Invoice/deleteinvoice';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = '/Invoice/deleteinvoice';
            }
            $.ajax({
                type: "POST",
                url: url,
                data: "{ 'invoiceid': '" + invoiceid + "'}",
                contentType: "application/json; charset=utf-8",
                dataType: "text",
                async: false,
                success: function (data) {
                    if (data == 'SUCCESS') {
                        notify('Invoice deleted successfully', 'green');
                        setTimeout(function () {
                            irrrrr = 0;
                            var urld = '';
                            if (LOCALORSERVERNEW == 'LOCAL') {
                                urld = '/Invoice/invoicesearch';
                            }
                            else if (LOCALORSERVERNEW == 'SERVER') {
                                urld = 'Invoice/invoicesearch';
                            }
                            

                            window.location.href = urld;

                        }, 4000);
                    }
                }
            });




        }





    </script>



