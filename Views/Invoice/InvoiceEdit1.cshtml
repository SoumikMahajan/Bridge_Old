        function getprojectaccounts(ProjectID) {
            if (ProjectID == null || ProjectID == '' || ProjectID == undefined) {
                return;
            }
          

            //
            // var ProjectID = $('#Hdn_ProjectID').val();
            var html = '';
            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Invoice/getProjectAccount';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Invoice/getProjectAccount';
            }
            url += "?ProjectID=" + ProjectID;

            $.ajax({
                type: "POST",
                url: url,
                async: false,
                datatype: "json",
                contentType: "application/json; charset=utf-8",
                data: "",
                success: function (data) {
                    if (data.trim() != '') {
                        html += data;
                    }
                    else {
                        html = '<option value="0">--No Project Account--</option>';
                    }


                },
                error: function () { notify('Something went wrong'); }
            });

            return html;
        }

        function CalculateTaxes(val, type, total) {
            var t = 0;
            if (type == '%') {
                t = total * val / 100;
            }
