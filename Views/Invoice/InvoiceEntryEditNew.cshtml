        function dataedited(val, obj) {

            //console.log('%%%%%%');

            $(obj).removeAttr('data-edited');
            $(obj).attr('data-edited', val);
        }

        function openexchange() {

            $('#currexchange').modal('show');

        }

        function getfxrate() {

            if ($('#currencysource').val() == 0) {
                notify("Select Base currency");
                return;
            }
            
            if ($('#currencytarget').val() == 0) {
                notify("Select Target currency");
                return;
            }


            var source = $('#currencysource option:selected').attr('data-currencycode');
            var target = $('#currencytarget option:selected').attr('data-currencycode');


            /////http://fixer.io/

            var url = '';
            // url = 'http://api.fixer.io/latest?base=' + source + '&symbols=' + target;
            url = "http://query.yahooapis.com/v1/public/yql?q=select%20*%20from%20yahoo.finance.xchange%20where%20pair%20in%20(%22"
                + source +  target + "%22)&format=json&env=store://datatables.org/alltableswithkeys&callback=";

            $.get(url)
               .success(function (response) {
                   //var rate = response["rates"][target];
                   $('#exchangerate').text("Convertion rate is: " + response.query.results.rate.Rate);
                   ////console.log(response.query.results.rate);
               });

        }

        function calculatefortaxfields() {
            var st = replaceAll($('#txt_SubtotalInvoice').val(), ',', '');
            var t1 = replaceAll($('#txt_TotalTax1').val(), ',', '');
            var t2 = replaceAll($('#txt_TotalTax2').val(), ',', '');
            var t3 = replaceAll($('#txt_TotalTax3').val(), ',', '');

            var tot = parseFloat(st) + parseFloat(t1) + parseFloat(t2) + parseFloat(t3);

            $('#txt_TotalInvoice').val(formatNumber(tot));
        }
       
    </script>
