    <script>
        function gotoinvoices() {

            var totid = "";
            //$('#tblPOSelector tbody tr').each(function () {
            //    var poid = $(this).find('td:eq(0)').html();
            //    totid += totid == "" ? poid : "^" + poid;
            //});
            totid = $('#Ddl_Vendors').val();

            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Invoice/invoicesearch';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Invoice/invoicesearch';
            }
            url += "/" + totid;

            window.open(url);


        }
    </script>

    <script>
        function getconvrate() {

            if ($('#exchngrate').attr('data-edited') == 'Y') {
                return;
            }


            var VID = $('#Ddl_Vendors').val();

            var totalbeforeconv = 0;
            var totalafterconv = 0;

            

            $('#tblPOItemSelector tbody tr').each(function () {

                var POLineItemID = $(this).find('td:eq(0)').html();
                var total = replaceAll($(this).find('td:eq(7)').html(), ',', '');
               

                var url = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url = '/Invoice/getconvrate';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url = 'Invoice/getconvrate';
                }

              

                $.ajax({
                    type: "POST",
                    url: url,
                    datatype: "json",
                    contentType: "application/json; charset=utf-8",
                    data: "{ \"VID\" : \"" + VID + "\",\"POLineItemID\" : \"" + POLineItemID + "\"}",
                    async: false,
                    success: function (data) {

                        if (!isNaN(data)) {
                            var data = parseFloat(data) * parseFloat(total);
                            totalafterconv += parseFloat(data);
                            totalbeforeconv += parseFloat(total);
                        }
                    },
                    error: function () { notify('Something went wrong'); }
                });





            });

           
            $('#exchngrate').val(formatNumber4(parseFloat(totalafterconv / totalbeforeconv)));

        }


        function getconvrateforproject() {

            if ($('#exchngrate').attr('data-edited') == 'Y') {
                return;
            }

            var VID = $('#Ddl_Vendors').val();

            var totalbeforeconv = 0;
            var totalafterconv = 0;



            $('#tblPOSelector tbody tr').each(function () {

              

                var POID = $(this).find('td:eq(0)').html();
                var PID = $(this).find('td:eq(8)').html();

                var total = replaceAll($(this).find('td:eq(5)').html(), ',', '');


                var url = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url = '/Invoice/getconvrateforproject';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url = 'Invoice/getconvrateforproject';
                }



                $.ajax({
                    type: "POST",
                    url: url,
                    datatype: "json",
                    contentType: "application/json; charset=utf-8",
                    data: "{ \"VID\" : \"" + VID + "\",\"PID\" : \"" + PID + "\",\"POID\" : \"" + POID + "\"}",
                    async: false,
                    success: function (data) {

                        if (!isNaN(data)) {
                            var data = parseFloat(data) * parseFloat(total);
                            totalafterconv += parseFloat(data);
                            totalbeforeconv += parseFloat(total);
                        }
                    },
                    error: function () { notify('Something went wrong'); }
                });





            });


            $('#exchngrate').val(formatNumber4(parseFloat(totalafterconv / totalbeforeconv)));

        }

