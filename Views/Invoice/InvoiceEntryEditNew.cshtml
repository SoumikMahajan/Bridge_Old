            }
            else {

                var tr = $(obj).parent();

                var tb1 = $(tr).find('input:eq(0)');
                var tb2 = $(tr).find('input:eq(1)');
                var tb3 = $(tr).find('input:eq(2)');

                if ($(tb1).hasClass('displaynone')) {
                    $(tb1).val('0.00');
