                    <input type="button" class="singledown displaynone" title="Select selected" onclick="fetch('onlyselected');" />


                    <i style="cursor: pointer;" title="Select selected" class="fa fa-angle-double-down roundbtn" aria-hidden="true" onclick="fetch('all');"></i>
                    <input type="button" class="doubledown displaynone" title="Select all" onclick="fetch('all');" />


                    <i style="cursor: pointer;" title="Unselect selected" class="fa fa-angle-up mrg10L roundbtn" aria-hidden="true" onclick="fetchreverse('onlyselected');"></i>
                    <input type="button" class="singleup displaynone" title="Unselect selected" onclick="fetchreverse('onlyselected');" />

                    <i style="cursor: pointer;" title="Unselect All" class="fa fa-angle-double-up roundbtn" aria-hidden="true" onclick="fetchreverse('all');"></i>
