                                <th style="width: 5%">
                                    <input type="checkbox" /></th>
                                <th style="text-align: center; width: 40%;">PO #</th>
                                <th style="text-align: center; width: 15%;">Curr</th>
                                <th style="text-align: right; width: 20%;">Amt.</th>
                                <th style="text-align: right; width: 20%;">Inv. Amt.</th>
                                <th  class="displaynone">Payment Schedule</th>
                                <th class="displaynone">Taxes</th>
