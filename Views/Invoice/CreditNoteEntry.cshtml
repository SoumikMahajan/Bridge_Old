            DBSP.ProcedureName = "POMS_CreditNoteAll";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var o = DBSP.call_DB_Procedure();
            o = o.data;



           
            buildLastTable(o);
            return;

        }

