            var obj = new Object();
            obj.ProjectID = ProjectID;
            obj.BankID = BnkID;


            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "POMS_GetProjectConvRate";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var o = DBSP.call_DB_Procedure();
            o = o.data;
            o = o[0];
            console.log(o);
            var Bcurr, Crate, Pcurr;
            Bcurr = o.Bcurr;
            Crate = o.Crate;
            Pcurr = o.Pcurr;
            if (Bcurr == Pcurr) {
                //$('#txtconvrate1').attr('disabled', 'disabled');
                $('#txtconvrate1').val('1.0000');

            }
            else {
                $('#txtconvrate1').removeAttr('disabled');
