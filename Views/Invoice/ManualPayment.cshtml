        function returncurrentoperationidforqbosendbatch() {
            var tmp = getCookie("checker");

            var tmp2 = '';
            var rtn = '0';

            for (var a = 0; a < tmp.split(',').length; a++) {
                if (a == 0) {
                    rtn = tmp.split(',')[a];
                }
                else {
                    tmp2 += tmp2 == "" ? tmp.split(',')[a] : ',' + tmp.split(',')[a];
                }
            }
            delete_cookie("checker");
            if (tmp != '') {
                setCookie("checker", tmp2, 3);
            }
            else {
                rtn = '0';
            }
            return rtn;


        }




        function IsNumber(e) {
            var keyCode = e.which ? e.which : e.keyCode
            if ((keyCode > 47 && keyCode < 58) || (keyCode == 8) || (keyCode == 46)) {
                return true;
            }
            else {
                if ($('#Ddl_PaymentType').val() != '2') {
