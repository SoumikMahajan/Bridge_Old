            function QBCheck() {
                var name = $('#DDl_EditBank option:selected').attr('data-bankname');
                $('#qbchecker').html("<span id='bnkchk'>Checking Bank Account- " + name + '<i class="fa fa-spinner fa-spin mrg5L" aria-hidden="true"></i><span>');
                var tttt = 0;
                setTimeout(function () {
                    qbcheckbankaccount(name);
                }, 300);
            }
            function qbcheckbankaccount(name) {
                console.log('qbcheckbankaccount' + name);
                var url = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url = '/QuickBook/CheckBankAccount';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url = 'QuickBook/CheckBankAccount';
                }
                $.ajax({
                    type: "POST",
                    url: url,
                    data: "{ 'name': '" + name + "'}",
                    contentType: "application/json; charset=utf-8",
                    dataType: "text",
                    async: false,
                    success: function (data) {
                        if (data == 'Unauthorized-401') {
                            notify("Unauthorized access to QBO. System not yet authorized to use any QB account");
                            var htm = '<i style="color:red;" class="fa fa-exclamation-triangle" aria-hidden="true"></i>';
                            $('#bnkchk').html(htm + " Unauthorized access to QBO.");
                            setTimeout(function () {
                                $('#qbmodal').modal('hide');
                            }, 5000);
                        }
                        else if (data != "INVALID") {
                            var htm = '<i style="color:green;" class="fa fa-check-circle mrg5R" aria-hidden="true"></i>';
                            $('#bnkchk').html(htm + name + " Balance:" + data.split('^^^')[0]);
                            $('#DDl_EditBank').attr('data-qboid', data.split('^^^')[1]);
                            var invoices = new Array();
                            var invids = '';
                            $('#tblInvoiceDetails tbody tr').each(function () {
                                var invoiceid = $(this).find('td:eq(8)').html();
                                var obj = $(this);
                                var url = '';
                                if (LOCALORSERVERNEW == 'LOCAL') {
                                    url = '/QuickBook/getAllInvoiceAccounts';
                                }
                                else if (LOCALORSERVERNEW == 'SERVER') {
                                    url = 'QuickBook/getAllInvoiceAccounts';
                                }
                                $.ajax({
                                    type: "POST",
                                    url: url,
                                    data: "{ 'invoices': '" + invoiceid + "'}",
                                    contentType: "application/json; charset=utf-8",
                                    dataType: "text",
                                    async: false,
                                    success: function (data) {
                                        for (var a = 0; a < data.split("^^^").length; a++) {
                                            var accountname = data.split("^^^")[a].split('|||')[0];
                                            var accountdesc = data.split("^^^")[a].split('|||')[1];
                                            $(obj).attr('data-accountname', accountname);
                                            $(obj).attr('data-accountdesc', accountdesc);
                                        }
                                    }, error: function () { notify('Something went wrong'); }
                                });
                            });
                            $('#tblInvoiceDetails tbody tr').each(function () {
                                var obj = $(this);
                                var accountname = $(obj).attr('data-accountname');
                                var accountdesc = $(obj).attr('data-accountdesc');
                                var tmp = 0;
                                for (var a = 0; a < invoices.length; a++) {
                                    if (invoices[a].accountname == accountname) {
                                        tmp = 1;
                                    }
                                }
                                if (tmp == 0) {
                                    invoices.push({ 'accountname': accountname, 'accountdesc': accountdesc });
                                }
                            });
                            invoiceaccountcheck(invoices);
                            return 1;
                        }
                        else {
                            var htm = '<i style="color:red;" class="fa fa-times-circle mrg5R" aria-hidden="true"></i>';
                            $('#bnkchk').html(htm + name + " does not exist.");
                            setTimeout(function () {
                                notify('QBO Validation error');
                                $('#qbmodal').modal('hide');
                            }, 3000);
                            return 0;
                        }
                    }, error: function () { notify('Something went wrong'); }
                });
            }

            function invoiceaccountcheck(invoices) {
                var accountname = invoices[tmpindex1].accountname;
                var url2 = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url2 = '/QuickBook/CheckInvoiceAccount';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url2 = 'QuickBook/CheckInvoiceAccount';
                }
                var name = invoices[tmpindex1].accountname + "-" + invoices[tmpindex1].accountdesc;;
                $('#qbchecker').append("<br /><span id='invchk_" + tmpindex1 + "'>Checking Invoice Account - " + name + '<i class="fa fa-spinner fa-spin mrg5L" aria-hidden="true"></i><span>');
                setTimeout(function () {
                    $.ajax({
                        type: "POST",
                        url: url2,
                        data: "{ 'name': '" + accountname + "'}",
                        contentType: "application/json; charset=utf-8",
                        dataType: "text",
                        async: false,
                        success: function (data) {
                            if (data != "INVALID") {
                                var htm = '<i style="color:green;" class="fa fa-check-circle mrg5R" aria-hidden="true" data-qboid="' + "" + '"></i>';
                                $('#invchk_' + tmpindex1).html(htm + name + " Balance:" + data.split('^^^')[0]);
                                var accountid = data.split("^^^")[1];
                                $('#tblInvoiceDetails tbody tr').each(function () {
                                    var obj = $(this);
                                    var accountnamenow = $(obj).attr('data-accountname');
                                    var accountdescnow = $(obj).attr('data-accountdesc');
                                    if (accountnamenow == accountname) {
                                        $(obj).attr('data-accountid', accountid);
                                    }
                                });
                                setTimeout(function () {
                                    tmpindex1++;
                                    if (invoices.length > tmpindex1) {
                                        invoiceaccountcheck(invoices);
                                    }
                                    else {
                                        tmpindex1 = 0;
                                        vendorloadnow();
                                    }
                                }, 300);
                                return;
                            }
                            else {
                                var htm = '<i style="color:red;" class="fa fa-times-circle mrg5R" aria-hidden="true"></i>';
                                $('#invchk_' + tmpindex1).html(htm + name + " does not exist.");
                                setTimeout(function () {
                                    notify('QBO Validation error');
                                    $('#qbmodal').modal('hide');
