        function checkpaymentnumberexistence(obj) {
            var paymentnumber = $(obj).val();
            if (paymentnumber != '') {

                var accntnum = $('#DDl_Bank').val();
                var ptype = $('#Ddl_PaymentType').val();

                var allowedwirenumber = true;

                if (ptype == '3') {
                    var pint = parseInt($('#txtPaymentNumber').val().split('-')[1]);
                    if (pint > 99999) {
                        allowedwirenumber = false;
                    }
                }

                var url11 = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url11 = '/Invoice/checkpaymentnumberexistence';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url11 = 'Invoice/checkpaymentnumberexistence';
                }


                url11 += "?paymenttype=" + ptype + "&accntnumber=" + accntnum + "&paymentnumber=" + paymentnumber;

                $.ajax({
                    type: "POST",
                    url: url11,
                    datatype: "text",
                    contentType: "application/json; charset=utf-8",
                    data: {},
                    async: false,
                    success: function (response) {
                        if (response != '0') {
                            $(obj).addClass('existingnumber');
                        }
                        else {
                            if (allowedwirenumber) {
                                $(obj).removeClass('existingnumber');
                            }
                            else {
                                $(obj).addClass('existingnumber');
                            }
                        }
                    }
                });

                //$.get(url11)
