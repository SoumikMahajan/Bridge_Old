            else if (LOCALORSERVERNEW == 'SERVER') {
                url = '/Logout/Logout?url=';
            }
            $('#master_logout').attr('href', url + url1);
            $('#master_logout_mobonly').attr('href', url + url1);
            var html = '';
            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = 'http://localhost:4347/Home/GetUserName';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Home/GetUserName';
            }
            $.ajax({
                type: "POST",
                url: url1,
                data: {},
                async: false,
                success: function (str) {
                    var url1 = '';
                    if (LOCALORSERVERNEW == 'LOCAL') {
                        url1 = 'http://localhost:4347/Home/MySettings';
                    }
                    else if (LOCALORSERVERNEW == 'SERVER') {
                        url1 = '/Home/MySettings';
                    }
                    var html = '';
                    var urlt = '';
                    var url1t = "~/Home/Login";
                    if (LOCALORSERVERNEW == 'LOCAL') {
                        urlt = 'http://localhost:4347/Logout/Logout?url=';
                    }
                    else if (LOCALORSERVERNEW == 'SERVER') {
                        urlt = 'Logout/Logout?url=';
                    }
                    $('#smallmenulogout').attr('href', urlt + url1t);
                    urlt = '';
                    var url1t = "~/Home/Login";
                    if (LOCALORSERVERNEW == 'LOCAL') {
                        urlt = 'http://localhost:4347/Home/MySettings';
                    }
                    else if (LOCALORSERVERNEW == 'SERVER') {
                        urlt = 'Home/MySettings';
                    }
                    $('#smallmenupassword').attr('href', urlt);
                    //$('#master_logout_mobonly').attr('href', url + url1);
                    //$("#formobileview").html('<a href="' + url1 + '">' + '<i class="fa fa-user mrg5R"></i>' + str.split('^')[0] + '</a>');
                    //$("#formobileview").append();
                    $('#master_username').html('<a href="' + url1 + '">' + '<i class="fa fa-user mrg5R"></i>' + str.split('^')[0] + '</a>');
                    $('#master_username').append(html);
                    $('#master_username_mobonly').html('<a href="' + url1 + '">' + str.split('^')[0] + '</a>');
                    $('#master_username_mobonly').append(html);
                    if (str.split('^')[1].trim() != '') {
                        html = '<i class="fa fa-phone-square"></i> ';
                        $('#master_phone').text(str.split('^')[1]);
                    }
                    if (str.split('^')[2].trim() != '') {
                        html = 'mailto:webmaster@example.com';
                        $('#master_email').text(str.split('^')[2]);
                        $('#master_email_mail').attr('href', 'mailto:' + str.split('^')[2]);
                    }
                },
                error: function () { notify('Something went wrong'); }
            });
        });
        function master_gotourl(obj) {
