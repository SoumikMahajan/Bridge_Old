    <script src="~/Scripts/jquery.DB_PROC.js"></script>
    <script>
        function sendmailtosupport() {
            var body = $('#vendormailapp').val();
            var page = window.location.href;
            var sub = $('#subforfeedbackmail').val();
            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = 'http://localhost:4347/SystemAdmin/sendfeedbackmail';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'SystemAdmin/sendfeedbackmail';
            }
            $.ajax({
                type: "POST",
                url: url1,
                contentType: "application/json; charset=utf-8",
                data: "{ \"body\" : \"" + escape(body) + "\",\"page\" : \"" + page + "\",\"sub\": \"" + sub + "\"}",
                async: false,
                success: function (str) {
                    if (str == 'SUCCESS') {
                        notify("Thank you for your feedback!", 'green');
                        $('#myModal').modal('hide');
                    }
                },
                error: function () { notify('Error sending mail'); }
            });
        }
        $(document).ready(function () {
            var obj = new Object();
            obj.Mode = 'GET';
            

            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "POMS_MaxFileSize_Proc";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var o1 = DBSP.call_DB_Procedure();
            o1 = o1.data;
            $('#hdn_maxfilesize').val(o1[0].Filesize);


            //           tinymce.init({
            //               selector: "#vendormailapp",
            //               plugins: "textcolor,fullscreen,image",
            //               toolbar: "image | undo redo | styleselect | bold italic | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent| forecolor backcolor"
