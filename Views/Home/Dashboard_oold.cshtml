                if (ddlid == "1") {

                    $('#datepicker_' + id).show();
                    //$('#datepicker_' + id).find('input').removeAttr('disabled');

                    //$('#datepicker_' + id).datepicker('destroy');

                    ////var currentDate = new Date();
                    ////var mindate = $('#datepicker_' + id).attr('data-mindate');

                    //$('#datepicker_' + id).datepicker('option', 'maxDate', null);
                    //$('#datepicker_' + id).datepicker("setDate", currentDate);
                    //$('#datepicker_' + id).datepicker({ dateFormat: 'dd-mm-yy' });

                    var date = new Date();
                    var currentMonth = date.getMonth();
                    var currentDate = date.getDate();
                    var currentYear = date.getFullYear();
                    var obj = $('#datepicker_' + id).find('input');
                    $(obj).datepickercustom({
                        changeMonth: true,
                        changeYear: true,
                        dateFormat: 'MM dd yy',
                        maxDate: new Date(currentYear, currentMonth, currentDate)
                    });



                }
                else {

                    $('#datepicker_' + id).show();
                    //$('#datepicker_' + id).find('input').removeAttr('disabled');

                    //$('#datepicker_' + id).datepicker('destroy');

                    //var currentDate = new Date();
                    //var mindate = $('#datepicker_' + id).attr('data-mindate');

                    //$('#datepicker_' + id).datepicker({ minDate: mindate, maxDate: +0 });
                    //$('#datepicker_' + id).datepicker("setDate", currentDate);
                    //$('#datepicker_' + id).datepicker({ dateFormat: 'dd-mm-yy' });

                    var date = new Date();
                    var currentMonth = date.getMonth();
                    var currentDate = date.getDate();
                    var currentYear = date.getFullYear();
                    var obj = $('#datepicker_' + id).find('input');
                    $(obj).datepickercustom({
                        changeMonth: true,
                        changeYear: true,
                        dateFormat: 'MM dd yy',
                        maxDate: new Date(currentYear, currentMonth, currentDate)
                    });
                }


            }
            else {
                $('#datepicker_' + id).hide();
                //$('#datepicker_' + id).find('input').attr('disabled', 'disabled');

            }


            if (ddlid == "1") {

                BindUserOnchange('GETUSERSFORRECEIVE', id);

            }
            else if (ddlid == "4") {
                BindUserOnchange('GETUSERSFORCOMMENT', id);

            }
            else if (ddlid == "6") {

                BindUserOnchange('GETUSERSFORSEND', id);

            }
            else if (ddlid == "7") {

