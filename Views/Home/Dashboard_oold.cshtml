                                    id = "INCINFO_" + pdata[a].Projectid;
                                }
                                else if (pdata[a].Taskname.trim() == "Incomplete Project") {
                                    id = "INCINFOP_" + pdata[a].Projectid;
                                }
                                else if (pdata[a].Taskname.trim() == "Incomplete Vendor") {
                                    id = "INCINFOV_" + pdata[a].Projectid;
                                }
                                html += "<h3 data-id='" + id + "'  onclick='loadaccordion(this);'>" + pdata[a].Taskname + "  <span class='badge'>" + pdata[a].Count + "</h3>"
                                            + "<div>hi</div>";
                            }
                        }
                    }

                    html += "</div>";

                    $(obj).next('div').html(html);



                    $(".accordionprojectinner2").accordion({
                        collapsible: true,
