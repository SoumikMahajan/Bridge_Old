        function loadaccordion(obj) {
            var clickneeded = false;

            if ($(obj).hasClass('loaded') || $(obj).hasClass('fa')) {
                if ($(obj).hasClass('fa')) {
                    obj = $(obj).parent();
                    $(obj).find('.fa').remove();
                    clickneeded = true;
                    if (clickneeded) {
                        $(obj).click();
                    }
                }
                else {
                    return;
                }
            }


            $(obj).next('div').html('<span>Loading...</span><i class="fa fa-spinner fa-spin"></i>');

            $(obj).append('<i class="fa fa-spinner fa-spin" style="float:right;"></i>');

            var id = $(obj).attr('data-id');
            var html = '';

            var type = id.split('_')[0];
            var componenttype = id.split('_')[1];
            $(obj).addClass('loaded');

            window.setTimeout(function () {
                if (type == 'II') {

                    html += "<div class='accordionprojectinner2'>";


                    for (var a = 0; a < pdata.length; a++) {

                        if (pdata[a].Projectid == componenttype) {

                            //console.log(pdata[a].Taskname);
