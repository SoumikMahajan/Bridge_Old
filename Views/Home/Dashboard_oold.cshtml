            var mailto = $('#vendormailto').val();
            var mailsubject = $('#vendormailsubject').val();

            var poid = $('#mailsendvendorbtn').attr('data-poid');

            if (mailto.trim() == "") {
                notify("Add recipient");
                return;
            }

            if (mailbody.trim() == "") {
                notify("Add Body");
                return;
            }

            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = 'http://www.thebridgebytcg.com/Home/VendorMailSend';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Home/VendorMailSend';
            }
            var Project_ID = $('#mailsendvendorbtn').attr('data-projectid');
            $.ajax({
                type: "POST",
                url: url1,
                data: "{ \"mailto\" : \"" + mailto + "\",\"mailsubject\" : \"" + mailsubject + "\",\"poid\":\"" + poid + "\",\"mailbody\": \""
                    + mailbody + "\",\"Project_ID\" : \"" + Project_ID + "\"}",
                async: false,
                dataType: 'text',
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    notify("Mail sent to " + mailto, 'green');
                    $('#sendmailtovendor').modal('show');

                },
                error: function (error) {
                    notify("Mail sending ERROR!!!");
                    $('#sendmailtovendor').modal('show');
                }
            });

        }


