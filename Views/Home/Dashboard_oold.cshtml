        function approveBudget(ProjectID, SectionName, obj) {

            var Comment = $(obj).parent().parent().find('td:eq(2) input').val();
            var ismanager = $('#ismanager_budget_' + ProjectID).val();

            var ManagerID = "0";
            if (ismanager == "1") {
                ManagerID = $('#userddl_budget_' + ProjectID).val();
                if (ManagerID == "0") {
                    notify('Please select a user.');
                    return;
                }
            }

          



            var url = "";
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = 'http://www.thebridgebytcg.com/Home/ApproveBudget';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {

                url = 'Home/ApproveBudget';
            }

            $.ajax({
                type: "POST",
                url: url,
                data: "{ 'ProjectID' : '" + ProjectID + "','SectionName' : '" + SectionName + "','Comment' : '" + Comment + "','ManagerID' : '" + ManagerID + "'}",
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                success: function (data) {


                    if (data == 'SUCCESS') {
                        getBudgetApproval();
                        notify("Approved Successfully.", 'green');
                        var cobj = $(obj).parent().parent().parent().parent().parent().parent().parent().prev('h3');
                        $(cobj).find('i').click();


                    }
                },
                failed: function () {
                    notify("Some error occured");
                }
            });
        }

        function rejectBudget(ProjectID, SectionName, obj) {

            var Comment = $(obj).parent().parent().find('td:eq(2) input').val();
            var ismanager = $('#ismanager_budget_' + ProjectID).val();

            if (Comment.trim() == "") {
                notify("Enter comment to reject the PO");
                return;
            }

            var ManagerID = "0";
            if (ismanager == "1") {
                ManagerID = $('#userddl_budget_' + ProjectID).val();
                if (ManagerID == "0") {
                    notify('Please select a user.');
                    return;
                }
            }


            var url = "";
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = 'http://www.thebridgebytcg.com/Home/RejectBudget';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Home/RejectBudget';
            }

            $.ajax({
                type: "POST",
                url: url,
                data: "{ 'ProjectID' : '" + ProjectID + "','SectionName' : '" + SectionName + "','Comment' : '" + Comment + "','ManagerID' : '" + ManagerID + "'}",
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    if (data == 'SUCCESS') {
                        getBudgetApproval();
                        notify("Rejected Successfully.");


                        window.setTimeout(function () {
                            window.location.reload();
                        }, 2000);

                    }
                },
                failed: function () { notify("Some error occured"); }
            });


        }


