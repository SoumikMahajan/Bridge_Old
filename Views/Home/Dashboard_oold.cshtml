            var id = $(obj).attr('data-id');
            var rw = $(obj).parent().parent();
            var user = $(rw).find('td:eq(6)').find('select').val();
            var comment = $(rw).find('td:eq(5)').find('input').val().trim();
            var ismanager = $(rw).find('td:eq(6)').find('input').val();
            if (ismanager == '1' && user == '0') {
                $('#poapprove_' + id).prop('checked', false);
                $('#poreject_' + id).prop('checked', false);
            }

            if (comment == '') {
                $('#poreject_' + id).prop('checked', false);
            }
           
        


        }


        function multipostatussave(obj) {

            var div = $(obj).parent().parent().parent().next('div');
            var approvestat = 0;
            var rejectstat = 0;
            //console.log(div);
            tmp = 0;
            $(div).find('.poapproverejectchk').each(function () {
                if ($(this).is(':checked')) {
                    var id = $(this).attr('data-id');
                    if ($(this).hasClass('approve')) {
                        //console.log('approve');
                        tmp += approvePO(id, $(this));
                        approvestat++;
                    }
                    else {
                        //console.log('reject');
                        tmp += rejectPO(id, $(this));
                        rejectstat++;

                    }
                }
            });

           
            if (tmp != 0) {
                window.setTimeout(function () {
                    var cobj = $(obj).parent().parent().parent().parent().parent().prev('h3').find('.fa-refresh');
                    
                    $(cobj).click();

                    var cobj2 = $(obj).parent().parent().parent().attr('data-id');
                    
                    delete_cookie("toclicknow");
                    setCookie("toclicknow", cobj2, 2);

                    setTimeout(function () {
                        $(cobj2).click();
                    }, 500);


                    var message = "Successfully ";
                   
                    if (approvestat != 0) {
                        message += " approved " + approvestat + " PO(s) ";
                    }
                    if (rejectstat != 0) {
                        message += " rejected " + rejectstat + " PO(s). ";
                    }

                    notify(message, 'green');
                   // window.location.reload();
                }, 2000);
            }

        }
    </script>


