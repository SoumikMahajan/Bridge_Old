        function approvallist(litemid, poid, TotalPOID) {

            var html = "";

            var ItemnameForSearch = "";

            ItemnameForSearch = ItemnameForSearch.trim();

            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = 'http://www.thebridgebytcg.com/PurchaseOrder/getApprovalItems';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {

                url = 'PurchaseOrder/getApprovalItems';
            }


            $.ajax({
                type: "POST",
                dataType: "JSON",
                async: false,
                contentType: "application/json; charset=utf-8",
                url: url,
                data: "{ 'POLineitemID': '" + litemid + "','ItemnameForSearch' : '" + ItemnameForSearch + "'}",
                success: function (data) {
                    data = data.data;




