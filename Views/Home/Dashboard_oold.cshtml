        function openpopupformailtovendormulti() {


            var poids = '';
            var emails = '';
            var contactid = '';

            var projectid = "";

            $('.vendormailtochk').each(function () {

                if ($(this).is(':checked')) {
                    projectid = $(this).parent().find('a').text().split('-')[0];  
                    poids += poids == '' ? $(this).attr('data-poid') : '^' + $(this).attr('data-poid');
                    emails += emails == '' ? $(this).attr('data-email') : '^' + $(this).attr('data-email');
                    contactid += contactid == '' ? $(this).attr('data-contactid') : '^' + $(this).attr('data-contactid');
                }

            });

            if (poids == "") {
                notify("Please select PO's to send");
                return;
            }
            $('#vendormailto').attr('data-email',emails.replace(/\^/g, ', '));
          
            var poid = poids;

            var mailsarr = emails.split("^");

            var uniquemails = [];
            $.each(mailsarr, function (i, el) {
                if ($.inArray(el, uniquemails) === -1) uniquemails.push(el);
            });

            emails = '';
            for (var a = 0; a < uniquemails.length; a++) {
                emails += emails == '' ? uniquemails[a] : '^' + uniquemails[a];
            }
           
            var projectid = parseInt(projectid) - 1000;
          


            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = 'http://www.thebridgebytcg.com/Home/VendorMailBuildMulti';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Home/VendorMailBuildMulti';
            }
            var ccadd = $('#sendaddcc').is(':checked') ? "1" : "0";
            $.ajax({
                type: "POST",
                url: url1,
                data: "{ \"poid\" : \"" + poid + "\",\"ProjectID\" : \"" + projectid + "\",\"addcc\":\"" + ccadd + "\"}",
                async: false,
                dataType: 'text',
                contentType: "application/json; charset=utf-8",
                success: function (response) {

                    $('#vendormailto').val(emails.replace(/\^/g, ', '));
                    $('#vendormailto').attr('data-real_mails', emails.replace(/\^/g, ', '));
                    $('#vendormailto').attr('data-contactid', contactid);
                    
                    $(window).scrollTop(0);
                    $('#vendormailsubject').val(response.split('$#^%*!&~')[1]);
                    response = unescape(response.split('$#^%*!&~')[0]);
                    


                    var editor = tinymce.get('vendormailbody');



                    $('#sendmailtovendor').modal('show');

                    if (editor == null) {
                        tinymce.init({
                            selector: "#vendormailbody",
                            plugins: "textcolor",
                            toolbar: "undo redo | styleselect | bold italic | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent| forecolor backcolor"
                            , menubar: false
                            , height: "300px"
                            , init_instance_callback: function () { tinyMCE.get('vendormailbody').setContent(response); }
                        });
                    }
                    else {

                        var content = editor.getContent();
                        editor.setContent(response);
                    }

                    $('#mailsendvendorbtn').attr('data-poid', poid);
                    // tinyMCE.get('vendormail').setContent(data);
                    $('#mailsendvendorbtn').attr('data-projectid', projectid);
                    


                },
                error: function (error) {
                    //alert("errror");
                }
            });


        }






