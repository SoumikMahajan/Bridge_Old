    function sendmailtovendorForMultiPDF(obj) {

        debugger;


        var poid = $(obj).attr('data-poid');

        var mailbody = escape(tinyMCE.get('vendormailbody_new').getContent());

        var mailto = $('#vendormailto_new').attr('data-real_mails');
        var mailtosend = $('#vendormailto_new').val();
        var mailsubject = $('#vendormailsubject_new').val();

        var Vid = $(obj).attr('data-vendorid');
        var Realvid = $('#vendormailto_new').attr('data-vid');


        //var object = $(obj).attr('data-obj');




        if (mailto.trim() == "") {
            notify("Add recipient");
            return;
        }

        if (mailbody.trim() == "") {
            notify("Add Body");
            return;
        }


        notify("Sending Mail...", 'YELLOW-LOAD');

        var url1 = '';
        if (LOCALORSERVERNEW == 'LOCAL') {
            url1 = '/Home/VendorMailSendPDF';
        }
        else if (LOCALORSERVERNEW == 'SERVER') {
            url1 = 'Home/VendorMailSendPDF';
        }


        //notify("Sending Mail...", 'green');

        var Project_ID = $('#mailsendvendorbtn_new').attr('data-projectid');

        var addcc = $('#sendaddcc_new').is(':checked') ? "1" : "0";



        $(obj).html('Please wait' + '<i class="fa fa-spinner fa-spin mrg10L" aria-hidden="true"></i>');
        //$(obj).removeAttr('onclick');




        $.ajax({
            type: "POST",
            url: url1,
            data: "{ \"mailto\" : \"" + mailtosend + "\",\"mailsubject\" : \"" + mailsubject + "\",\"mailbody\": \"" + mailbody
                + "\",\"poid\":\"" + poid + "\",\"Project_ID\" : \"" + Project_ID + "\",\"Realvid\" : \"" + Realvid + "\",\"vid\" : \"" + Vid
                + "\",\"addcc\" : \"" + addcc + "\"}",
            async: true,
            dataType: 'text',
            contentType: "application/json; charset=utf-8",
            success: function (response) {
                debugger;
                notify("Mail sent to " + mailtosend, 'green');
                //if (response != "") {

                //    notify("Mail sent to " + mailtosend, 'green');

                //}


                //refreshtask();
                $(obj).find('.fa').remove();
                $(obj).find('.fa-spinner').remove();
                $(obj).find('.fa-spin').remove();
                $(obj).text('');
                $(obj).text('Send Mail');

                //$(obj).attr('onclick');
                window.setTimeout(function () { $('#sendmailtovendor_new').modal('hide'); }, 4000);



            },
            error: function (error) {

                notify("Failed", 'RED');

                $(obj).find('.fa').remove();
                $(obj).find('.fa-spinner').remove();
                $(obj).find('.fa-spin').remove();
                $(obj).text('');
                $(obj).text('Send Mail');

                $('#sendmailtovendor_new').modal('hide');
            }
        });

        //var bj = $(obj).parent().find('.fa-refresh');

