    function rebuildarray(obj) {

        var b = new Array();
        var projectnow = "";

        var tot = 0;

        for (var a = 0; a < obj.length; a++) {


            if (obj[a].Projectid != projectnow && a != 0) {

                b.push({ 'Count': tot, 'Projectid': obj[a - 1].Projectid, 'Projectnumber': obj[a - 1].Projectnumber, 'Projectname': obj[a - 1].Projectname, 'Taskname': 'Incomplete Info' });

                tot = 0;
            }


            if (obj[a].Taskname != "Incomplete PO" && obj[a].Taskname != "Incomplete Project" && obj[a].Taskname != "Incomplete Vendor") {
                //console.log('1');
                b.push(obj[a]);

            }
            else {
                tot += parseInt(obj[a].Count);
                //console.log(tot + ">>>" + obj[a].Taskname + ">>>" + obj[a].Projectnumber);
            }




            projectnow = obj[a].Projectid;

        }
        return b;


    }


