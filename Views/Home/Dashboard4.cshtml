    function acceptpo(obj) {
        debugger;
        delete_cookie("sysusercookie");
        var poids = '';
        var emails = '';
        var contactid = '';

        var projectid = $(obj).attr('data-proid');
        var showid = '';
        var nspoids = '';
        $('.vendormailtochk').each(function () {

            if ($(this).is(':checked')) {
                var issystemuser = $(this).parent().parent().prev('h3').attr('data-issystemuser');
                console.log('data-issystemuser   ' + issystemuser);
                //console.log($(this).parent().parent());

                if (issystemuser != '0') {


                    //projectid = $(this).parent().parent().find('a').text().split('-')[0];
                    poids += poids == '' ? $(this).attr('data-poid') : '^' + $(this).attr('data-poid');
                    emails += emails == '' ? $(this).attr('data-email') : '^' + $(this).attr('data-email');
                    contactid += contactid == '' ? $(this).attr('data-contactid') : '^' + $(this).attr('data-contactid');
                }
                else {
                    showid = showid == '' ? $(this).prev('a').prev('a').text() : ',' + $(this).prev('a').prev('a').text();
                    nspoids += nspoids == '' ? $(this).attr('data-poid') : '^' + $(this).attr('data-poid');
                }
            }

        });

        if (nspoids != "") {

            console.log(nspoids + ' ' + showid);

            setCookie("sysusercookie", '1', 2);

            //opendownloadpospopup('a', nspoids + '#' + showid);
            //return;
        }




        if (poids == "") {
            notify("Please select PO's to send");
            return;
        }
        $('#vendormailto').attr('data-email', emails.replace(/\^/g, ', '));

        var poid = poids;

        var mailsarr = emails.split("^");

        var uniquemails = [];
        $.each(mailsarr, function (i, el) {
            if ($.inArray(el, uniquemails) === -1) uniquemails.push(el);
        });

        emails = '';
        for (var a = 0; a < uniquemails.length; a++) {
            emails += emails == '' ? uniquemails[a] : '^' + uniquemails[a];
        }

        //var projectid = parseInt(projectid) - 1000;

        var url = "";
        if (LOCALORSERVERNEW == 'LOCAL') {
            url = '/Home/CompleteVendorConfirmation';
        }
        else if (LOCALORSERVERNEW == 'SERVER') {

            url = 'Home/CompleteVendorConfirmation';
        }

        var html = "<div id='accordion'>"
        var comment = '';
        var mode = "ACCEPT";

        $.ajax({
            type: "POST",
            url: url,
            async: false,
            data: "{\"poid\" : \"" + poid + "\",\"comment\" : \"" + comment + "\",\"mode\" : \"" + mode + "\"}",
            dataType: "text",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                notify("PO accepted successfully.", "green");
                //if (data == 'SUCCESS') {
                //$(obj).parent().find('i').click();

                var bj = $(obj).parent().parent().find('.fa-refresh');

                $(bj).click();

                //window.location.reload();
                //}
            },
            failed: function () { notify("Some error occured"); }
        });

        return true;




    }

