    function openfilepopup(obj) {
        var txt = $(obj).attr('data-flink');
        $('#filepopup').modal('show');
        $('#filepopup').find('.modal-body').html(txt);

        var tfile = '';

        var j = 0;
        for (; j < txt.split('$$$$').length; j++) {
            var name = txt.split('$$$$')[j];
            var sname = name.split('_')[1];
            var path = "/Assets/POApprovals/" + name;
            tfile += tfile == "" ? "<a target='_blank' href='" + path + "'>" + name + "</a>" : " , " + "<a href='" + path + "'>" + name + "</a>";
        }

        $('#filepopup').find('.modal-body').html(tfile);



    }
