            var lab = new Array();

            for (var i = 1; i <= totl ; i++) {
                lab.push(numArray[i] + ' LEVEL');
            }

            if (level != '' || level != undefined) {
                $('#my1').milestones({
                    stage: approved,
                    checks: approved-1,
                    checkclass: 'checks',
                    labels: lab//["jQuery", "Script", "Net", "Timeline", "Milestones", "Demo", "Final"]
                });

            }


            $('#pohistorypopup').modal('show');
            var html = decodeURI($(obj).attr('data-content'));
            if (html == "") {
                html = "<td colspan='2'>No History available</td>";
            }
            $('#pohistorylist tbody').html(html);
        }
