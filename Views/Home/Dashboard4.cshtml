        function loaddataallforapproval(obj) {

            var tab = $(obj).next('div').find('table');
            var checkisloaded = $(tab).find('tbody tr:eq(0)').find('.approverstatus');
            if (!$(checkisloaded).hasClass('loaded')) {
                var ld = '<i class="fa fa-spin fa-spinner" aria-hidden="true"></i>';
                $(tab).find('.approverstatus').html(ld);

                setTimeout(function () {
                    $(tab).find('tbody tr').each(function () {
                        var poid = $(this).attr('data-poid');
                        var poitemid = $(this).attr('data-itemid');

                        var approverstatus = Check_ApproverStatusPOItems(poitemid, poid);
                        var approvedby = approverstatus.split('^')[0];
                        var requiredby = approverstatus.split('^')[1];
                        var status = $(this).find('.approverstatus').attr('data-ls');

                        console.log(approvedby + ">>>" + requiredby);
                        if (approvedby == requiredby) {
                            status = "Approved";
                        }


                        $(this).find('.approverstatus').html(approvedby + " / " + requiredby + " (" + status + ")");
                        $(this).find('.approverstatus').addClass('loaded');
                    });
                }
                , 500);
            }
        }

