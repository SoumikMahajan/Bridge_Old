        function saveactionapproval(POLineItemApprovalID, obj) {
            var FileName = "";
            for (var a = 0; a < $('#file_' + POLineItemApprovalID)[0].files.length; a++) {
                FileName += FileName == '' ? $('#file_' + POLineItemApprovalID)[0].files[a].name : "^^^" + $('#file_' + POLineItemApprovalID)[0].files[a].name;
            }
            //var len = $('#ddl_selectuser_' + POLineItemApprovalID).length();
            var isManager = $(obj).attr("data-ismanager");
            var ActionType = $('#ddl_actiontype_' + POLineItemApprovalID).val();
            if (ActionType == 0) {
                notify("Please select an Action");
                return;
            }
            var ActionByProjectManager = "0";
            if (isManager == "1") {

                var ActionByProjectManager = $('#ddl_selectuser_' + POLineItemApprovalID).val();
                //09022019 approve by client
                var utype = getUserTypeProject(POLineItemApprovalID);
                if (utype != "4") {
                    if (isManager == "1" && ActionByProjectManager == "0" && ActionType != "4") {
                        notify("Please select a user");
                        return;
                    }
                }
                //end of 09022019 approve by client
            }
            //alert(ActionByProjectManager);
            //return;
            var ActionDate = "";
            if (ActionType == "1" || ActionType == "6" || ActionType == "2" || ActionType == "3") {
                ActionDate = $('#datepicker_' + POLineItemApprovalID).find('input').val();
            }
            var Comment = $('#textarea_' + POLineItemApprovalID).val().trim();
            if (Comment == "" && (ActionType == "3" || ActionType == "7" || ActionType == "4")) {
                notify("Please add comment");
                return;
            }

            var c = true;
            if (ActionType == "7") {
                c = confirm("This is an approved item, all approval will be cancelled. Are you sure you want to amend the item?");
            }
            if (!c) {
                return;
            }


            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/PurchaseOrder/AddPOApprovalItem';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'PurchaseOrder/AddPOApprovalItem';
            }

            console.log(Comment);
            Comment = encodeURI(Comment);
            Comment = replaceAll(Comment, "'", "\\'");
            console.log(Comment);



            $(obj).css('opacity', '0.3').removeAttr('onclick');
            $.ajax({
                type: "POST",
                async: false,
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                url: url,
                data: "{ 'POLineItemApprovalID': '" + POLineItemApprovalID + "','ActionType' : '" + ActionType + "','ActionDate' : '" + ActionDate + "','Comment' : '" + Comment + "','FileName' : '" + FileName + "','ActionByProjectManager' : '" + ActionByProjectManager + "'}",
                success: function (data) {
                    var lastinsertedid = data;
                    //alert(data);
                    $(obj).attr('value', 'Save');
                    var url2 = '';
                    if (LOCALORSERVERNEW == 'LOCAL') {
                        url2 = '/UploadFile/UploadForApprovals?fileid=';
                    }
                    else if (LOCALORSERVERNEW == 'SERVER') {
                        url2 = 'UploadFile/UploadForApprovals?fileid=';
                    }
                    url2 += lastinsertedid;
                    var data = new FormData();
                    for (var a = 0; a < $('#file_' + POLineItemApprovalID)[0].files.length; a++) {
                        // FileName += FileName == '' ? $('#file_' + POLineItemApprovalID)[0].files[0].name : "^^^" + $('#file_' + POLineItemApprovalID)[0].files[0].name;
                        data.append('file-' + a, $('#file_' + POLineItemApprovalID)[0].files[a]);
                    }
                    //data.append('file-1', $('#file_' + POLineItemApprovalID)[0].files[0]);
                    $.ajax({
                        type: "POST",
                        async: false,
                        dataType: "json",
                        cache: false,
                        contentType: false,
                        processData: false,
                        url: url2,
                        data: data,
                        success: function (data) {
                            // window.location.reload();
                        }
                    });
                    var message = '';
                    switch (ActionType) {
                        case '2':
                            message = "Approved Successfully";
                            break;
                        case '3':
                            message = "Rejected Successfully";
                            break;
                        case '4':
                            message = "Added comment Successfully";
                            break;
                        case '6':
                            message = "Sent Successfully";
                            break;
                        case '1':
                            message = "Received Successfully";
                            break;
                    }
                    if (ActionType != "3") {
                        notify(message, 'green');
                    }
                    else {
                        notify(message, 'red');
                    }
                    window.setTimeout(function () {
                        var cobj = $(obj).parent().parent().parent().parent().parent().parent().parent().prev('h3');
                        //console.log(cobj);

                        $(cobj).find('.fa-refresh').click();
                    }, 500);
                }
            });
        }

