    function newPomodal(Overcommitted) {

        var html = '';
        for (i = 0; i < Overcommitted.split('^^').length; i++) {

            if (i == 0) {

                html += "<div class='modal-header' style='min-height: 58px;'><button type = 'button' class='close' data-dismiss='modal'>&times;</button><div class='modal-title'>";
            }
            else {
                html += "<div class='modal-header' style='min-height: 58px;'><div class='modal-title'>";
            }

            html += "<table class='table'>"
                + "<thead class='clstxt'>"
                + "<th>Item #</th>"
                + "<th>Description</th>"
                + "<th>Committed</th>"
                + "<th>Budget</th>"
                + "<th>Variance</th>"
                + "</thead><tbody class='clstxt_td'>";


            var pocost = Overcommitted.split('^^')[i].split(',,')[2];
            var bcost = Overcommitted.split('^^')[i].split(',,')[0];
            var curr = Overcommitted.split('^^')[i].split(',,')[5];
            var itemnumber = Overcommitted.split('^^')[i].split(',,')[4];
            var desc = Overcommitted.split('^^')[i].split(',,')[1];

            ID = Overcommitted.split('^^')[i].split(',,')[3];
            var rate = parseFloat(Overcommitted.split('^^')[i].split(',,')[6]);
            var PO = parseFloat(pocost) * rate;
            var variance = parseFloat(bcost) - PO;

            html += "<tr>" + "<td>" + itemnumber + "</td>"
                + "<td>" + desc + "</td>"
                + "<td>" + formatNumber(PO) + ' ' + curr + "</td>"
                + "<td>" + formatNumber(bcost) + "</td>"
                + "<td>" + formatNumber(variance) + "</td>" + "</tr>";

            html += '</tbody></table></div></div>';

            var url = "";

            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Purchaseorder/GetCommittedDetail';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Purchaseorder/GetCommittedDetail';
            }

            $.ajax({
                type: "POST",
                url: url,
                data: { 'POLineitemID': ID },
                async: false,
                success: function (data) {
                    //var cls = "newPomodalTable_" + i;

                    data = JSON.parse(data).data;
                    html += '<div class="modal-body">'
                        + '<div class="row">'
                        + '<div class="sm-12">'
                        + '<table cellpadding="0" cellspacing="0" border="0" class="display table newPomodal_Table">'

                        + '<thead>'
                        + "<th class='leftposition'>PO Number</th>"
                        /*"<th>Item #</th>"*/
                        + "<th class='rightposition'>Committed Amount</th>"
                        + '</thead>'
                        + '<tbody>';

                    for (j = 0; j < data.length; j++) {

                        html += '<tr>'
                            + '<th class="leftposition">' + data[j].PurchaseOrderID + '</th>'
                            //+ '<th>' + Overcommitted.split('^^')[i].split(',,')[4]+'</th>'
                            + '<th class="rightposition">' + formatNumber(data[j].POCost) + '</th>'
                            + '</tr>';
                    }


                    html += '</tbody>'
                        + '</table>'
                        + '</div>'
                        + '</div>'
                        + '</div>';

                }
            });


        }

        $('#POMS_OVERCOMMITEDMODAL').html('');
        $('#POMS_OVERCOMMITEDMODAL').html(html);

        $('.newPomodal_Table').dataTable().fnDestroy();
        $('.newPomodal_Table').dataTable({
            "processing": true,
            "retrieve": true,
            //"columns":
            //    [
            //        { "title": "PO Number", "class": "leftposition" },
            //        { "title": "Item #", "class": "rightposition" },
            //        { "title": "Committed Amount", "class": "rightposition" },
            //    ]

        });


        $('#newPomodal').modal('show');

    }

