    function ProofPODownLoadNew(obj, poid) {
        debugger;
        var poid1 = poid;

        var ponumber = $(obj).data('showid');



        checkuncheckatt(obj, poid1, ponumber);
        return;




        mode = 0;
        var url1 = '';
        if (LOCALORSERVERNEW == 'LOCAL') {
            url1 = '/Reports/PurchaseOrderReportGeneration';
        }
        else if (LOCALORSERVERNEW == 'SERVER') {
            url1 = 'Reports/PurchaseOrderReportGeneration';
        }
        url1 += "?ProjectID=" + "";
        url1 += "&SectionID=" + "";
        url1 += "&PurchaseOrder=" + poid;
        url1 += "&showImageFlag=" + mode;
        var totdata = '';
        $.get(url1)
            .success(function (response) {
                if (response == '0') {
                    notify('No records found!!!');
                    return;
                }
                var html = "";
                var url2 = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    totdata = response;
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    totdata = "/POMS/POMS/" + response;
                }
                setTimeout(function () {
                    window.open(totdata, '_blank');
                }, 1000);
            });
    }

    function openapprovalhistory(obj) {
        $('#approvalhistory').modal('show');
        var url1 = '';
        if (LOCALORSERVERNEW == 'LOCAL') {
            url1 = '/Budget/getApprovalHistory';
        }
        else if (LOCALORSERVERNEW == 'SERVER') {
            url1 = 'Budget/getApprovalHistory';
        }
        var ProjectID = $(obj).attr('data-project');
        var sectionid = '';
        var grpID = $(obj).attr('data-group');
        $.ajax({
            type: "POST",
            url: url1,
            async: false,
            dataType: "text",
            contentType: "application/json; charset=utf-8",
            data: "{ 'PID': '" + ProjectID + "','SID':'" + sectionid + "','GID':'" + grpID + "'}",
            success: function (data) {
                var t = JSON.parse(data).data;
                console.log(t);

                debugger;
                var innerfullhtml = '';
                var tempver = '';
                var innerhtmlhistory = '';
                var innerhtmlComment = '';
                var html = '';
                for (var a = 0; a < t.length; a++) {
                    var Groupname = t[a].GroupName;
                    var version = t[a].Version;
                    var versionname = t[a].versionname;
                    var CreateDate = t[a].CreateDate;
                    var approver = t[a].approver;
                    var Status = t[a].Status;
                    var Comment = t[a].Comment;

                    if (tempver != version) {
                        if (tempver != '' && tempver != version) {
                            if (innerhtmlhistory != '') {
                                html += innerhtmlhistory + "</ul></td>";
                            }
                            if (innerhtmlComment != '') {
                                html += innerhtmlComment + "</ul></td>";
                                innerhtmlComment = '';
                            }
                            else {
                                html += "<td></td>";
                            }
                            html += "</tr>";
                            innerfullhtml += html;
                        }
                        tempver = version;
                        html = "<tr  style='background: rgb(192, 186, 186);'>";
                        html += "<td>" + version + " </td><td>" + versionname + "</td><td>" + Groupname + "</td>";
                        innerhtmlhistory = "<td><ul><li>" + Status + " By " + approver + " on " + CreateDate + "</li>";
                        if (Comment != '') {
                            innerhtmlComment = "<td><ul><li>" + Comment + "</li>";
                        }
                    }
                    else {
                        innerhtmlhistory += "<li>" + Status + " By " + approver + " on " + CreateDate + "</li>"
                        if (Comment != '') {
                            if (innerhtmlComment != '') {
                                innerhtmlComment += "<li>" + Comment + "</li>";
                            }
                            else {
                                innerhtmlComment += "<td><ul><li>" + Comment + "</li>";
                            }
                        }
                    }



                }
                if (innerhtmlhistory != '') {
                    html += innerhtmlhistory + "</ul></td>";
                }
                if (innerhtmlComment != '') {
                    html += innerhtmlComment + "</ul></td>";
                    innerhtmlComment = '';
                }
                else {
                    html += "<td></td>";
                }
                html += "</tr>";
                innerfullhtml += html;
                $('#prevversionapproval tbody').html(innerfullhtml);
            },
            error: function () {
                notify('Something went wrong.');
            }
        });
    }
