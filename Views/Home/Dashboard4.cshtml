    <script type="text/javascript">

        function numberWithCommas(x) {
            var parts = x.toString().split(".");
            parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");
            return parts.join(".");
        }

        function isManager_budget(ProjectID) {
            var isManager = 0;
            var url = "";
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Home/isManager_budget';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {

                url = 'Home/isManager_budget';
            }

            $.ajax({
                type: "POST",
                url: url,
                async: false,
                data: "{ 'ProjectID' : '" + ProjectID + "'}",
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    isManager = data;
                },
                failed: function () { notify("Some error occured"); }
            });

            return isManager;


        }

        function getUserList_Budget(ProjectId, GroupID) {

            var isManager = 0;
            var url = "";
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Home/check_manager_budget';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {

                url = 'Home/check_manager_budget';
            }

            $.ajax({
                type: "POST",
                url: url,
                async: false,
                data: "{ 'ProjectID' : '" + ProjectId + "','GroupID' : '" + GroupID + "'}",
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    isManager = data;
                },
                failed: function () { notify("Some error occured"); }
            });

            return isManager;


        }
        function getBudgetApproval() {

            var url = "";
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Home/GetBudgetApprovals';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {

                url = 'Home/GetBudgetApprovals';
            }

            $.ajax({
                type: "POST",
                async: false,
                url: url,
                data: {},
                dataType: "JSON",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    data = data.data;

                    dataforbudgetapprovals = data;

                    return;

                    var html = "";
                    for (var a = 0; a < data.length; a++) {

                        var AlreadyApproved = data[a].AlreadyApproved;
                        var NumOfUserToAprv_PO = data[a].NumOfUserToAprv_Budget;
                        //var OwnerName = data[a].OwnerName;
                        var ProjectId = data[a].ProjectId;

                        var ProjectNumber = data[a].ProjectNumber;
                        var ProjectName = data[a].ProjectName;
                        var BudgetID = data[a].BudgetID;
                        var IsSentForApproval = data[a].IsSentForApproval;


                        var userddl = "";

                        var isManager = isManager_budget(ProjectId);


                        if (isManager == "1") {
                            userddl = getUserList_Budget(ProjectId);
                        }

                        //var PurchaseOrderID = data[a].PurchaseOrderID;
                        //var UserName = data[a].UserName;

                        if (AlreadyApproved == NumOfUserToAprv_PO) {
                            continue;
                        }


                        var polink = "";



                        var innerhtml = "";
                        if (userddl != "") {

                            innerhtml = "<label  style='color:black;'>Select User</label><select id='userddl_budget_" + ProjectId + "'>";
                            innerhtml += "<option value='0'>---select---</option>";
                            innerhtml += userddl + "</select>";
                            innerhtml += "<input type='hidden' value='1' id='ismanager_budget_" + ProjectId + "' />";

                        }

                        else {
                            innerhtml += "<input type='hidden' value='0' id='ismanager_budget_" + ProjectId + "' />";
                        }

                        var history = data[a].History;

                        var hlink = "";


                        var rspn = history.length + 1;


                        var budgetreportlink = '';
                        if (LOCALORSERVERNEW == 'LOCAL') {
                            budgetreportlink = '/Reports/BudgetReportByItemReportGeneration';
                        }
                        else if (LOCALORSERVERNEW == 'SERVER') {
                            budgetreportlink = 'Reports/BudgetReportByItemReportGeneration';
                        }

                        budgetreportlink += '?ProjectID=' + ProjectId + '&SectionID=&PurchaseOrder=';

                        if (AlreadyApproved <= NumOfUserToAprv_PO) {
                            html += "<tr>"
                                + "<td rowspan='" + rspn + "'>"
                                + "<span style='cursor:pointer;color:blue;' onclick='openpowindow(this);' data-url='" + budgetreportlink + "'><u>View the Budget</u></span>"
                                //+ "</br><u><a target='_blank' href='" + hlink + "'>" + "View History</a></u>"
                                + "</td>"
                                + "<td rowspan='" + rspn + "'>"
                                + ProjectName + " (" + ProjectNumber + ")</td>"
                                //+ "<td rowspan='" + rspn + "'>"
                                //+ BudgetID + "</td>"
                                //+"<td>"
                                //+ uname + "</td>"
                                + "<td rowspan='" + rspn + "' class='tooltipclass'>"
                                + AlreadyApproved + " Out of " + NumOfUserToAprv_PO
                                + "<br/><progress value='" + AlreadyApproved + "' max='" + NumOfUserToAprv_PO + "'></progress>"
                                + "</td>"
                                + "<td rowspan='" + rspn + "'>"

                                + "<label  style='color:black;'>Comment</label>"
                                + "<textarea></textarea>"
                                + innerhtml
                                + "<input type='button' value='Approve' onclick='approveBudget(\"" + ProjectId + "\",\"\",this)' />"
                                + "<input type='button' value='Reject' onclick='rejectBudget(\"" + ProjectId + "\",\"\",this)' /></td></tr>"

                        }
                        else {

                            html += "<tr>"
                                + "<td rowspan='" + rspn + "'>"
                                + "<span style='cursor:pointer;color:blue;' onclick='openpowindow(this);' data-url='" + budgetreportlink + "'><u>View the Budget</u></span>"
                                //+ "</br><u><a target='_blank' href='" + hlink + "'>" + "View History</a></u>"
                                + "</td>"
                                + "<td rowspan='" + rspn + "'>"
                                + ProjectName + " (" + ProjectNumber + ")</td>"
                                //+ "<td rowspan='" + rspn + "'>"
                                //+ BudgetID + "</td>"
                                //+"<td>"
                                //+ uname + "</td>"
                                + "<td rowspan='" + rspn + "' class='tooltipclass'>"
                                + AlreadyApproved + " Out of " + NumOfUserToAprv_PO
                                + "<br/><progress value='" + AlreadyApproved + "' max='" + NumOfUserToAprv_PO + "'></progress>"
                                + "</td>"
                                + "<td rowspan='" + rspn + "'>"

                                + "<label  style='color:black;'>Comment</label>"
                                + "<textarea></textarea>"
                                + innerhtml
                                + "<input type='button' value='Approve' onclick='approveBudget(\"" + ProjectId + "\",\"\",this)' />"
                                + "<input type='button' value='Reject' onclick='rejectBudget(\"" + ProjectId + "\",\"\",this)' /></td></tr>"


                        }

                        for (var k = 0; k < history.length; k++) {

                            history_Approved = history[k].Approved;
                            history_Rejected = history[k].Rejected;
                            history_Version = history[k].Version;
                            history_resend = history[k].resend;
                            history_resendon = history[k].resendon;
                            history_InsertDate = history[k].InsertDate;
                            history_UserName = history[k].UserName;
                            history_Comment = history[k].Comment === '' || history[k].Comment === undefined ? '---' : history[k].Comment;
                            history_ManagerName = history[k].ManagerName;

                            var txt = "";
                            if (history_Approved == "1") {
                                txt = "Approved";
                            }
                            if (history_Rejected == "1") {
                                txt = "Rejected";
                            }
                            if (history_resend == "0") {
                                html += "<tr>"

                            }
                            else {
                                html += "<tr style='background:rgb(192, 186, 186);'>"

                            }

                            var tempstr = "";

                            if (history_ManagerName.trim() != "") {
                                tempstr = " by " + history_ManagerName + " on behalf of " + history_UserName;
                            }
                            else {
                                tempstr = " by " + history_UserName;

                            }



                            html += "<td>" + txt + " On " + history_InsertDate + tempstr + " </td>"
                                + "<td>" + history_Comment + "</td>"
                                + "</tr>";


                        }



                    }

                    var tot = "";
                    $('#Budgetapprovalslabel').append('  (' + data.length + ' Approvals awaiting)');
                    $('#Budgetapprovals tbody').html(html);


                    if (data.length < 1) {
                        $('#BudgetApprovalSection').css('display', 'none');
                    }
                    else {
                        $('#BudgetApprovalSection').css('display', 'block');
                    }

                },
                failed: function () { notify("Some error occured"); }
            });

        }


        function approveBudget(ProjectID, SectionName, obj) {


            var groupid = $(obj).attr('data-groupid');
            var Comment = $(obj).parent().parent().find('td:eq(3) input').val();
            var ismanager = $('#ismanager_budget_' + ProjectID + '_' + groupid).val();


            var ManagerID = "0";
            if (ismanager == "1") {
                ManagerID = $('#userddl_budget_' + ProjectID + '_' + groupid).val();
                if (ManagerID == "0" || ManagerID == null) {
                    notify('Please select a user.');
                    return;
                }
            }
            //ManagerID = $('#userddl_budget_' + ProjectID + '_' + groupid).val();
            console.log(ismanager);
            console.log(ManagerID);

            console.log(groupid);
            //return;



            var url = "";
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Home/ApproveBudget';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {

                url = 'Home/ApproveBudget';
            }

            $.ajax({
                type: "POST",
                url: url,
                data: "{ 'ProjectID' : '" + ProjectID + "','SectionName' : '" + SectionName + "','Comment' : '" + Comment + "','ManagerID' : '" + ManagerID + "','GroupID' : '" + groupid + "'}",
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                success: function (data) {


                    if (data == 'SUCCESS') {
                        getBudgetApproval();
                        notify("Approved Successfully.", 'green');
                        var cobj = $(obj).parent().parent().parent().parent().parent().parent().parent().prev('h3');
                        $(cobj).find('i').click();


                    }
                },
                failed: function () {
                    notify("Some error occured");
                }
            });
        }

        function rejectBudget(ProjectID, SectionName, obj) {

            var groupid = $(obj).attr('data-groupid');
            var Comment = $(obj).parent().parent().find('td:eq(3) input').val();
            //var ismanager = $('#ismanager_budget_' + ProjectID).val();
            var ismanager = $('#ismanager_budget_' + ProjectID + '_' + groupid).val();


            if (Comment.trim() == "") {
                notify("Enter comment to reject the budget");
                return;
            }




            var ManagerID = "0";
            if (ismanager == "1") {
                //ManagerID = $('#userddl_budget_' + ProjectID).val();
                ManagerID = $('#userddl_budget_' + ProjectID + '_' + groupid).val();
                if (ManagerID == "0") {
                    notify('Please select a user.');
                    return;
                }
            }


            ManagerID = $('#userddl_budget_' + ProjectID + '_' + groupid).val();
            console.log(ismanager);
            console.log(ManagerID);
            // return;



            var url = "";
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Home/RejectBudget';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Home/RejectBudget';
            }

            $.ajax({
                type: "POST",
                url: url,
                data: "{ 'ProjectID' : '" + ProjectID + "','SectionName' : '" + SectionName
                    + "','Comment' : '" + Comment + "','ManagerID' : '" + ManagerID + "','GroupID' : '" + groupid + "'}",
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    if (data == 'SUCCESS') {
                        getBudgetApproval();
                        notify("Rejected Successfully.", "green");


                        window.setTimeout(function () {
                            window.location.reload();
                        }, 2000);

                    }
                },
                failed: function () { notify("Some error occured"); }
            });


        }


