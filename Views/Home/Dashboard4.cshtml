        function openbudgetgroup(obj) {
            var gid = $(obj).attr('data-id');


            var obj = new Object();
            obj.GroupID = gid;
            obj.Mode = 'GETGROUPBYID';


            var DBSP = new DB_SP_CONNECT();
            DBSP.ProcedureName = "POMS_BudgetGroupProc";
            DBSP.obj = obj;
            DBSP.isasync = false;
            var o = DBSP.call_DB_Procedure();
            o = o.data;
            console.log(o);
            console.log("All data");
            var html = '';
            var gname = '';
            for (var i = 0 ; i < o.length; i++) {
                var tgname = o[i].Groupname;
                console.log(tgname + ">>> " + gname);

                var h = '';


                if (gname == '' || tgname != gname) {
                    html += '<div class="groupheader" style="height: 35px;background: #748fa5;padding: 10px;color: white;" data-groupid="' + o[i].GroupID + '">' + h + tgname + '</div>';
                }

                html += '<div class="groupsubheader">' + o[i].Sectionnumber + " - " + o[i].Name + "</div>";
                gname = o[i].Groupname;
            }



            console.log(html);
            $('#approvalsecdiv').html(html);
            $('#approvalsec').modal('show');


            //$('#appgroup').html(html);

        }

