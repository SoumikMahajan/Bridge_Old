<script>
    function filternow(obj) {


        $(obj).next('div').find('h3').each(function () {

            if ($(this).find('.searchable').text().toUpperCase().indexOf($(obj).val().toUpperCase()) < 0) {

                $(this).hide();

            }
            else {
                $(this).show();
            }

        });
    }


    function poapproverejectchk(obj) {

        var status = $(obj).is(':checked');
        var id = $(obj).attr('data-id');

        if (status != true) {
            return;
        }

        if ($('#ismanager_' + id).val() == '1' && $('#userddl_' + id).val() == '0' && !$(obj).hasClass('comment')) {
            notify("Please Select a User first");

            $(obj).prop('checked', !status);
            return;
        }

        if ($(obj).hasClass('approve')) {
            $('#poreject_' + id).prop('checked', !status);
            $('#pocomment_' + id).prop('checked', !status);
        }
        else if ($(obj).hasClass('reject')) {
            var Comment = $(obj).parent().parent().find('td:eq(7)').find('input').val();
            if (Comment.trim() == "") {
                notify("You cannot select reject without a comment");
                $(obj).prop('checked', !status);
            }
            else {
                $('#poapprove_' + id).prop('checked', !status);
                $('#pocomment_' + id).prop('checked', !status);
            }

        }
        else if ($(obj).hasClass('comment')) {
            var Comment = $(obj).parent().parent().find('td:eq(7)').find('input').val();
            if (Comment.trim() == "") {
                notify("You must put a comment");
                $(obj).prop('checked', !status);
            }
            else {
                $('#poapprove_' + id).prop('checked', !status);
                $('#poreject_' + id).prop('checked', !status);
            }

        }




    }


