            if (LOCALORSERVERNEW == 'LOCAL') {
                url11 = '/Project/GetProjectFilesToIncludePOList';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url11 = 'Project/GetProjectFilesToIncludePOList';
            }

            var availablefiles = '';

            $.ajax({
                type: "POST",
                async: false,
                datatype: "json",
                contentType: "application/json; charset=utf-8",
                url: url11,
                data: " { \"PID\" : \"" + poid + "\"}",
                success: function (data) {
                    availablefiles = data;

                    //console.log(data);

                    var baseurl = '';

                    if (LOCALORSERVERNEW == 'LOCAL') {
                        baseurl = '../../Assets/';
                    }
                    else if (LOCALORSERVERNEW == 'SERVER') {
                        baseurl = 'Assets/';
                    }

                    var html = '';

                    if (data != "") {
                        for (var i = 0; i < availablefiles.split('^^^').length; i++) {
                            filename = availablefiles.split('^^^')[i].split('|||')[0];
                            if (html != "") { html += "<br />"; }
                            html += "<a target='_blank' href ='" + baseurl + "ProjectFiles/" + filename + "'><i class='fa fa-download mrg5R' aria-hidden='true'></i>" + filename + "</a>";//data.files[0].name;


                        }
                    }

                    $('#filedownload').modal('show');
                    if (html != "") {
                        $('#filebody').html(html);
                    }
                    else {
                        $('#filebody').html("No file available");
                    }
                    //console.log(html);
                }
            });




