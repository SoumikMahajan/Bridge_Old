    //New PO Approve on Batch
    function approvePOBatch(POID, obj) {
        debugger;
        var res = 'Failed';
        var Comment = $(obj).parent().parent().find('td:eq(7)').find('input').val();
        var ismanager = $('#ismanager_' + POID).val();
        var UserID = "0";


        var f = $(obj).parent().parent().find('td:eq(6)').find('input');
        //console.log(f);
        var fd = new FormData();
        for (var i = 0; i < f[0].files.length; i++) {
            fd.append('file' + i, f[0].files[i]);
        }



        if (ismanager == "1") {
            UserID = $('#userddl_' + POID).val();
            if (UserID == "0") {
                notify("Please select  a user");
                return 0;
            }
        }


        var url = "";
        if (LOCALORSERVERNEW == 'LOCAL') {
            url = '/Home/ApprovePOBatch';
        }
        else if (LOCALORSERVERNEW == 'SERVER') {

            url = 'Home/ApprovePOBatch';
        }

        fd.append('POID', POID);
        fd.append('Comment', Comment);
        fd.append('UserID', UserID);

        //console.log(POID + " " + Comment + "   " + UserID);

        //return 1;

        $.ajax({
            type: "POST",
            url: url,
            data: fd,
            contentType: false,
            processData: false,

            async: false,

            success: function (data) {
                res = '1|' + data;
                if (data == 'SUCCESS') {


                }
            },
            failed: function () { notify("Some error occured"); }
        });

        return res;

    }

