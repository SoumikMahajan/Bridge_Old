        </div>


        <div class="row">
            <div class="col-sm-12 req mrg15B">
                <label>Old Password</label>
                <input class="form-control"  type="password" id="txt_oldpassword" />
            </div>

            <div class="col-sm-12 req mrg15B">
                 <label>New Password</label>
                    <input class="form-control" type="password" id="txt_newpassword" />
            </div>

            <div class="col-sm-12 req mrg15B">
               <label>Retype New Password</label>
                    <input class="form-control" type="password" id="txt_retypenewpassword" />
            </div>

            <div class="col-sm-6">
                <div class="form-group">
                    <label>&nbsp;</label>
                    <button class="btn btn-block btn-primary" onclick="UpdatePassword();"><i class="fa fa-pencil-square-o mrg5R"></i>Save Password</button>

                </div>
            </div>



        </div>

    </div>

