    <script type="text/javascript">
        function UpdatePassword() {
            if ($('#txt_oldpassword').val().trim() == '') {
                errorfunc('txt_oldpassword', 'Please insert old Password.');
                return;
            }
            var oldpassword = $('#txt_oldpassword').val().trim();

            if ($('#txt_newpassword').val().trim() == '') {
                errorfunc('txt_newpassword', 'Please insert new Password.');
                return;
            }





            var newpassword = $('#txt_newpassword').val().trim();
            var decimal = /^(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{6,15}$/;
            var val = newpassword;
            if (val.length > 7 && val.length < 16) {
                if (val.match(decimal)) {
                }
                else {
                    $('#txt_newpassword').val('');
                    errorfunc('txt_newpassword', 'Password Must contains atleast one lower case,one upper case and one digit');
                    return false;
                }
            }
            else {
                $('#txt_newpassword').val('');
                errorfunc('txt_newpassword', 'Password must be between 8 to 15 character');
                return false;
            }


            if ($('#txt_retypenewpassword').val().trim() == '') {
                errorfunc('txt_retypenewpassword', 'Please re insert new Password.');
                return;
            }



            if ($('#txt_retypenewpassword').val().trim() != $('#txt_newpassword').val().trim()) {
                errorfunc('txt_retypenewpassword', 'Password mismatched!');
                return;
            }

            var retypenewpassword = $('#txt_retypenewpassword').val().trim();


            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Home/UpdatePassword';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = '/Home/UpdatePassword';
            }

            var UserID = $('#Hdn_UserID').val();
            var oldpassword = $('#txt_oldpassword').val();
            var newpassword = $('#txt_newpassword').val();
            var retypenewpassword = $('#txt_retypenewpassword').val();


            $.ajax({
                type: "POST",
                url: url,
                datatype: "json",
                contentType: "application/json; charset=utf-8",
                data: "{ \"UserID\" : \"" + UserID + "\", \"oldpassword\" : \"" + oldpassword + "\", \"newpassword\" : \"" + newpassword + "\", \"retypenewpassword\" : \"" + retypenewpassword + "\"}",
                async: false,
                success: function (data) {
                    irrrrr = 0;
                    if (data == 'SUCCESS') {
                        
                        notify('Password succesfully changed !', 'green');
                        setTimeout(function () {
                            window.location.reload();
                        }, 2000);

                    }
                    else {
                        notify(data);
                    }
                },
                error: function () { notify('Something went wrong'); }
            });
        }
    </script>
