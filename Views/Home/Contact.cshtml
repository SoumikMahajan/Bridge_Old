<script src="https://code.jquery.com/jquery-1.12.2.js"></script>
<script src="~/Scripts/jquery.DB_PROC.js"></script>
<script>
    $(document).ready(function () {
        var obj = new Object();
        obj.ApprovalID = 1;       
       

        var DBSP = new DB_SP_CONNECT();
        DBSP.ProcedureName = "poms_deleteitemapprovals";
        DBSP.obj = obj;
        DBSP.isasync = false;
        //console.log(DBSP);
        
        
        var o = DBSP.call_DB_Procedure();
        $('#tarea').val(o.data[0].Comment);

        //var o = call_DB_Procedure(obj, "poms_deleteitemapprovals");
        //$('#tarea').val(o.data[0].Comment);
    });

   



    function call_DB_Procedure(obj, ProcedureName, encodemode) {
        //console.log(isasync);
        var data = "";
      
        var obj = JSON.stringify(obj);
        if (arguments.length == 2) {
            data = "{\"data\": \"" + escape(obj) + "\", \"ProcedureName\":\"" + ProcedureName + "\"}";
        }
        else if (arguments.length == 3) {
            data = "{\"data\": \"" + escape(obj) + "\", \"ProcedureName\":\"" + ProcedureName + "\",\"encodemode\":\"" + encodemode + "\"}";

        }
        else {
            return;
        }
        var datret = "";
        
        var url = '';
       
            url = '/Home/SP_Call';
      

        $.ajax({
            type: "POST",
            url: url,
            contentType: "application/json; charset=utf-8",
            async: isasync,
            data: data,
            success: function (data) {
                datret = JSON.parse(data);
                ////$('#popupforItemApproval').modal('hide');
                //$(o).remove();

            },
            failed: function () {

            }

        });

        return datret;

    }


</script>
