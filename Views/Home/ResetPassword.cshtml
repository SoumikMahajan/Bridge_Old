<!DOCTYPE html>

<html>
<head>
     <meta name="viewport" content="width=device-width" />
     <title>ResetPassword</title>
</head>
<body>
    <div>
        <div class="main_container" style="display:none;">
            <div class="left_panel_container">
                <a href="javascript:void(0)" class="logo_container">
                    <img src="~/images/logo.png" width="372" height="73" alt="" />
                </a>

                <div class="from_row_container_wrap login">

                    <div class="heading_container">Reset Password:</div>
                    <div class="from_row_container">
                        @*<label>New Password:</label>
                        <input type="password" id="txt_NewPassword" />*@
                    </div>
                    <div class="from_row_container">
                        @*<label>Confirm Password:</label>
                        <input type="password" id="txt_NewConfirmPassword" />*@
                    </div>
                    <div class="from_row_container">
                        @*<input type="submit" id="btn_ResetPassword" value="Reset Password" />           *@ 
                    </div>
                </div>

            </div>
        </div>




        <link href="~/css/InnerMisc.css" rel="stylesheet" />

<style>
body {
    background-image: none;
    padding: 40px;
}
.mrg10B {
	margin-bottom:10px;
}
.pad0B {
	padding-bottom:0px;
}
.user_panel_container label a, .logo_container_heading a {
	color:#208093;
}
.login-text {
	margin-top:40px;
}
.login-text p {
	width:100%;
	display:inline-block;
	text-align:center;
	margin-bottom:5px;
	color:#999;
}
</style>
<script>
    $(document).ready(function () {
        $('.forgotTop').click(function () {
            $('.login').slideUp(200);
            $('.forgotBot').slideDown(200);
        });
        $('.cancelBtn').click(function () {
            $('.forgotBot').slideUp(200);
            $('.login').slideDown(200);
        });
    });
</script>



        <div class="main_container">
	        <h2 style="text-align: center;">
		        <img width="790" height="213" alt="BridgeLogo6-darker" src="~/images/BridgeLogo6-darker2.png" class="">
	        </h2>
	        <h2 style="text-align: center;color: #7792a8;padding:20px 80px;font-size: 24px;font-weight: 600;"><em>The Bridge purchasing system connects our clients, consultants, designers and vendors with information to make valuable decisions and provides the foundation in bringing conceptual design to final placement of furniture.</em></h2>
	

        <div class="login">
		<div class="edit_vendor_full mrg10B">
			<div class="edit_vendor_half">
				<div class="user_panel_container req pad0B">
					<label>New Password:</label>
                    <input type="password" id="txt_NewPassword" />
				</div>
			</div>
		</div>
		<div class="edit_vendor_full mrg10B">
			<div class="edit_vendor_half">
				<div class="user_panel_container req pad0B">
					<label>Confirm Password:</label>
                    <input type="password" id="txt_NewConfirmPassword" />
				</div>
			</div>
		</div>
		<div class="edit_vendor_full mrg10B">
			<div class="edit_vendor_half">
				<div class="user_panel_container pad0B">
					<input type="submit" id="btn_ResetPassword" value="Reset Password" />           
				</div>
			</div>
		</div>		
	</div>

            <div class="edit_vendor_full login-text">
		        <p>By entering this site, you hereby agree to the <a href="javascript:void(0);"> Terms of Use. </a> </p>
		        <p>© 2015 The Cardy Group. All rights reserved.</p>
		        <p>Version 1.01.XX Enterprise Edition</p>
		        <p>Last Release Date: 25/08/2015 00:00:00</p>
	        </div>

        </div>



    </div>
