<script>
    function getHistory(id) {

        var obj = new Object();
        //obj.curr = curr;
        obj.Mode = 'GETHISTORY';
        obj.FldID = id;

        obj.SESSIONUSERBACKEND = 'UserID';

        var DBSP = new DB_SP_CONNECT();
        DBSP.ProcedureName = "POMS_BridgeSupporterAll";
        DBSP.obj = obj;
        DBSP.isasync = false;
        var o = DBSP.call_DB_Procedure();
        o = o.data;
        console.log(o);

        $('#historymodal').modal('show');
        $('#tblhistory').dataTable().fnDestroy();

        var ob = new Array();

        for (var a = 0; a < o.length; a++) {

            ob[a] = new Array();
            ob[a][0] = o[a].Username;
            ob[a][1] = o[a].Event;
            ob[a][2] = o[a].Date + ' at ' + o[a].Time;

        }
        console.log(ob);

        //$('#tblhistory')
        $('#tblhistory').dataTable({
            "processing": true,
            fixedHeader: true,
            "data": ob,
            //"autoWidth": false,
            "columns":
              [
                { "title": "User" },
                { "title": "Event", },
                 { "title": "Time"}

              ],
            
            "initComplete": function () {

            },
            "aoColumnDefs": [
                { 'bSortable': false, 'aTargets': [0] }
            ]
        });



    }

    function issent(status, id,objs) {
        var obj = new Object();
        //obj.curr = curr;
        obj.Mode = 'ISSENT';
        obj.Status = status;
        obj.FldID = id;
        obj.SESSIONUSERBACKEND = 'UserID';

        if (status == '0') {
            $(objs).removeClass('fa-check');
            $(objs).addClass('fa-times');
            $(objs).removeAttr('onclick');

            $(objs).attr('onclick', "issent('1'," + id + ",this);");
            $(objs).css('color', '#fb3939');
           
        }
        else {
            $(objs).removeClass('fa-times');
            $(objs).addClass('fa-check');
            $(objs).removeAttr('onclick');

            $(objs).attr('onclick', "issent('0'," + id + ",this);");
            $(objs).css('color', '#5abf26');
            
        }


        var DBSP = new DB_SP_CONNECT();
        DBSP.ProcedureName = "POMS_BridgeSupporterAll";
        DBSP.obj = obj;
        DBSP.isasync = false;
        var o = DBSP.call_DB_Procedure();
        o = o.data;
        notify("Updated.", "GREEN");

        //getInvoices();
    }

    function ispaid(status, id,objs) {
        var obj = new Object();
        //obj.curr = curr;
        obj.Mode = 'ISPAID';
        obj.Status = status;
        obj.FldID = id;
        obj.SESSIONUSERBACKEND = 'UserID';

        var DBSP = new DB_SP_CONNECT();
        DBSP.ProcedureName = "POMS_BridgeSupporterAll";
        DBSP.obj = obj;
        DBSP.isasync = false;
        var o = DBSP.call_DB_Procedure();
        o = o.data;
        notify("Updated.", "GREEN");

        if (status == '0') {
            $(objs).removeClass('fa-check');
            $(objs).addClass('fa-times');
            $(objs).removeAttr('onclick');

            $(objs).attr('onclick', "ispaid('1'," + id + ",this);");
            $(objs).css('color', '#fb3939');

        }
        else {
            $(objs).removeClass('fa-times');
            $(objs).addClass('fa-check');
            $(objs).removeAttr('onclick');

            $(objs).attr('onclick', "ispaid('0'," + id + ",this);");
            $(objs).css('color', '#5abf26');

        }
        //getInvoices();
    }



    function cansend(status,id,objs) {
        var obj = new Object();
        //obj.curr = curr;
        
        obj.Mode = 'CANSEND';
        obj.Status = status;
        obj.FldID = id;
        obj.SESSIONUSERBACKEND = 'UserID';


        var DBSP = new DB_SP_CONNECT();
        DBSP.ProcedureName = "POMS_BridgeSupporterAll";
        DBSP.obj = obj;
        DBSP.isasync = false;
        var o = DBSP.call_DB_Procedure();
        o = o.data;
        notify("Updated.","GREEN");
        if (status == '0') {
            $(objs).removeClass('fa-check');
            $(objs).addClass('fa-times');
            $(objs).removeAttr('onclick');

            $(objs).attr('onclick', "cansend('1'," + id + ",this);");
            $(objs).css('color', '#fb3939');
            var h = '<i style="cursor:not-allowed;color:#d2c8c8;font-size: 1.3em;" class="fa fa-times" aria-hidden="true"></i>';
            $(objs).parent().next('td').html(h);
        }
        else {
            $(objs).removeClass('fa-times');
            $(objs).addClass('fa-check');
            $(objs).removeAttr('onclick');

            $(objs).attr('onclick', "cansend('0'," + id + ",this);");
            $(objs).css('color', '#5abf26');
            var h = '<i style="cursor:pointer;color:#fb3939;font-size: 1.3em;" onclick="issent(\'1\',' + id + ',this);" class="fa fa-times" aria-hidden="true"></i>';
            $(objs).parent().next('td').html(h);
        }
        //getInvoices();
    }

    function getInvoices() {
        text = "Loading Invoices. Please wait...";
        mode = "alert-warning";
        sign = "<i class='fa fa-spinner fa-spin mrg5R'></i>";
        var html = "<div class='container alert " + mode + "  notification col-sm-12' role='alert' style='z-index:99999; cursor: pointer;' onclick='removenotification();'>"
            + "<span style='width:90%;float:left;'>"
            + sign
            + text
            + "</span>"
            + "</div>";

        $('body').append(html);

        var vendorID = $('#txt_Project3').val() + '';
        var projectID = $('#txt_Project').val() + '';
        //var FromDate = $('.txt_FromDate').val();
        //var ToDate = $('.txt_ToDate').val();

        var obj = new Object();
        //obj.curr = curr;
        obj.Mode = 'GETINVOICES';
        obj.VendorID = vendorID == 'null' ? '' : vendorID;
        obj.ProjectID = projectID == 'null' ? '' : projectID;
        //obj.FromDate = FromDate == 'null' ? '' : FromDate;
        //obj.ToDate = ToDate == 'null' ? '' : ToDate;

        var url = "";
        if (LOCALORSERVERNEW == 'LOCAL') {
            url = '/Home/BridgeSupporterSearch';
        }
        else if (LOCALORSERVERNEW == 'SERVER') {

            url = 'Home/BridgeSupporterSearch';
        }
        //var obj = $(obj).parent().find('i');
        $.ajax({
            type: "POST",
            url: url,
            async: false,
            data: JSON.stringify(obj),
            contentType: "application/json; charset=utf-8",
            success: function (o) {
                o = JSON.parse(o);
                var ob = new Array();
                for (var a = 0; a < o.length; a++) {

                    var htm = '';
                    var id = o[a].fldid;

                    ob[a] = new Array();
                    ob[a][0] = htm = '<i style="cursor:pointer;font-size: 1.3em;" onclick="getHistory(' + id + ');" class="fa fa-eye" aria-hidden="true"></i>';

                    ob[a][1] = o[a].GeneratedPONumber;

                    ob[a][2] = o[a].LegalName;

                    ob[a][3] = o[a].InvoiceNumberVendor;

                    ob[a][4] = o[a].FullyInvoicedDate;
                    ob[a][5] = formatNumber(o[a].TotalInvoice);

                    if (o[a].Cansend == "1") {
                        htm = '<p class="displaynone">1</p><i style="cursor:pointer;color:#5abf26;font-size: 1.3em;" onclick="cansend(\'0\',' + id + ',this);" class="fa fa-check" aria-hidden="true"></i>'
                        ob[a][6] = htm;

                        if (o[a].IsSent == "1") {
                            htm = '<p class="displaynone">1</p><i style="cursor:pointer;color:#5abf26;font-size: 1.3em;" onclick="issent(\'0\',' + id + ',this);" class="fa fa-check" aria-hidden="true"></i>'
                        }
                        else {
                            htm = '<i style="cursor:pointer;color:#fb3939;font-size: 1.3em;" onclick="issent(\'1\',' + id + ',this);" class="fa fa-times" aria-hidden="true"></i>'

                        }
                        ob[a][7] = htm;

                    }
                    else {
                        htm = '<i style="cursor:pointer;color:#fb3939;font-size: 1.3em;" onclick="cansend(\'1\',' + id + ',this);" class="fa fa-times" aria-hidden="true"></i>'
                        ob[a][6] = htm;


                        htm = '<p class="displaynone">-1</p><i style="cursor:not-allowed;color:#d2c8c8;font-size: 1.3em;" class="fa fa-times" aria-hidden="true"></i>'


                        ob[a][7] = htm;


                    }



                    if (o[a].IsPaid == "1") {
                        htm = '<p class="displaynone">1</p><i style="cursor:pointer;color:#5abf26;font-size: 1.3em;" onclick="ispaid(\'0\',' + id + ',this);" class="fa fa-check" aria-hidden="true"></i>'
                    }
                    else {
                        htm = '<i style="cursor:pointer;color:#fb3939;font-size: 1.3em;" onclick="ispaid(\'1\',' + id + ',this);" class="fa fa-times" aria-hidden="true"></i>'

