    function openref(obj) {
        var id = $(obj).parent().parent().find('td:eq(14)').html();
        var val = $(obj).parent().parent().find('td:eq(12)').html();
        $('#refidval').val(id);
        $('#reftext').val(val);
        
        $('#refmodal').modal('show');

    }
    function saveref() {
        var id = $('#refidval').val();
        var reftext = $('#reftext').val();

        console.log(id + ",,," + reftext);
        var obj = new Object();
        //obj.curr = curr;
        obj.Mode = 'EDITREF';
        obj.FldID = id;
        obj.InvRef = reftext;
        
        obj.SESSIONUSERBACKEND = 'UserID';

        var DBSP = new DB_SP_CONNECT();
        DBSP.ProcedureName = "POMS_BridgeSupporterAll";
        DBSP.obj = obj;
        DBSP.isasync = false;
        var o = DBSP.call_DB_Procedure();
        o = o.data;
        console.log(o);

        notify("Updated Inv. Ref", "GREEN");

        $('#refmodal').modal('hide');

        $('#invtable tbody tr').each(function () {
            var idt = $(this).find('td:eq(14)').html();
            if (idt == id) {
                $(this).find('td:eq(12)').html(reftext);
                

                if (reftext != "") {
                    $(this).find('td:eq(13)').html(reftext + ' <i style="color:green;cursor:pointer;"  onclick="openref(this);" class="fa fa-pencil-square-o mrg5L"></i>');
                }
                else {
                    $(this).find('td:eq(13)').html('<i style="color:green;cursor:pointer;" onclick="openref(this);" class="fa fa-plus"></i>');
                }

            }

        });


    }

    function ResetSearch() {
        var table = $('#invtable').DataTable();
        $('.srch').each(function () {
            this.value = '';
            var indx = $(this).attr('data-indx');
            var txt = this.value;
            table
                   .column(indx)
                   .search(txt)
                   .draw();
        });
    }



    function projectddlchange() {
        setProjectPreference($("#txt_Project"));
        var project_id = $("#txt_Project").val();
        console.log("working");
        if (project_id == null) {
            project_id = '';
        }
        if (project_id == '')
            return;
        var url = '';
        if (LOCALORSERVERNEW == 'LOCAL') {
            url = '/Home/getAllParentVendorsByProject';
        }
        else if (LOCALORSERVERNEW == 'SERVER') {
            url = 'Home/getAllParentVendorsByProject';
        }
        $.ajax({
            type: "POST",
            url: url,
            async: true,
            dataType: "text",
            contentType: "application/json; charset=utf-8",
            data: "{ 'ProjectID': '" + project_id + "'}",
            success: function (data) {
                //return;
                var html = data;

                $("#txt_Project3").html(html);
                $("#txt_Project3").multiselect('refresh');//.multiselectfilter();
                var width = '100%';
                $('.ui-multiselect').css('width', width);
                //$('.ui-multiselect-menu').css('width', '39.5%');
                $('.ui-multiselect-menu').css('width', '39.5%');
                $('.ui-state-default').css('color', '#C31001');
                $('.ui-multiselect').css('height', '34px');
                $('.ui-multiselect').css('margin-top', '5px');
            },
            error: function () {
                notify('Something went wrong.');
            }
        });

       
    }

