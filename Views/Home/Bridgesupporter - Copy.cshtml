                    ob[a][8] = htm;

                    ob[a][9] = o[a].Cansend;
                    ob[a][10] = o[a].IsSent;
                    ob[a][11] = o[a].IsPaid;

                    ob[a][12] = o[a].InvRef;
                    if (o[a].InvRef == '') {
                        ob[a][13] = '<i style="color:green;cursor:pointer;" onclick="openref(this);" class="fa fa-plus"></i>';
                    }
                    else {
                        ob[a][13] = o[a].InvRef + ' <i style="color:green;cursor:pointer;"  onclick="openref(this);" class="fa fa-pencil-square-o mrg5L"></i>';

                    }

                    ob[a][14] = id;

                }

                $('#invtable').dataTable().fnDestroy();

                if ($('#invtable thead').find('tr').length > 1) {


                    $('#invtable thead').find('tr:eq(1)').remove();

                }


                $('#invtable').dataTable({
                    "processing": true,
                    fixedHeader: true,
                    "data": ob,
                    //  "bAutoWidth": false,
                    "columns":
                        [
                            { "title": "History" },
