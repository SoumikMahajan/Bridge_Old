                            { "title": "Can send", "class": "leftposition" },
                            { "title": "Sent", "class": "leftposition" },
                            { "title": "Paid", "class": "leftposition" },
                            { "title": "Paid", "class": "displaynone" },
                            { "title": "Paid", "class": "displaynone" },
                            { "title": "Paid", "class": "displaynone" },

                            { "title": "Ref#", "class": "displaynone" },
                            { "title": "Ref#", "class": "leftposition" },
                            { "title": "Ref#", "class": "displaynone" },


                        ],
                    "order": [1, "asc"],
                    "initComplete": function () {

                        var htm1 = "<select class='srch' data-indx='9'><option value=''>All</option><option value='true'>Yes</option><option value='false'>No</option>";
                        var htm2 = "<select class='srch' data-indx='10'><option value=''>All</option><option value='true'>Yes</option><option value='false'>No</option>";
                        var htm3 = "<select class='srch' data-indx='11'><option value=''>All</option><option value='true'>Yes</option><option value='false'>No</option>";
                        html = "<tr>"
                            + "<th class='Resetth' rowspan='1' colspan='1'>"
                            + "<a><input type='button' value='Reset' onclick='ResetSearch();' style='margin-bottom:6px;width:110px;' /></a>"
                            + "</th>"
                            + "<th rowspan='1' colspan='1'><input class='srch' style='width:100%;padding: 2px 2%; font-family:Arial, FontAwesome' placeholder=' &#xF002;' data-indx='1' type='text'></th>"
                            + "<th rowspan='1' colspan='1'><input class='srch' style='width:100%;padding: 2px 2%; font-family:Arial, FontAwesome' placeholder=' &#xF002;' data-indx='2' type='text'></th>"
                            + "<th rowspan='1' colspan='1'><input class='srch' style='width:100%;padding: 2px 2%; font-family:Arial, FontAwesome' placeholder=' &#xF002;' data-indx='3' type='text'></th>"
                            + "<th rowspan='1' colspan='1'><input class='srch' style='width:100%;padding: 2px 2%; font-family:Arial, FontAwesome' placeholder=' &#xF002;' data-indx='4' type='text'></th>"
                            + "<th rowspan='1' colspan='1'><input class='srch' style='width:100%;padding: 2px 2%; font-family:Arial, FontAwesome' placeholder=' &#xF002;' data-indx='5' type='text'></th>"
                            + "<th rowspan='1' colspan='1'>" + htm1 + "</th>"
                            + "<th rowspan='1' colspan='1'>" + htm2 + "</th>"
                            + "<th rowspan='1' colspan='1'>" + htm3 + "</th>"
                            + "<th rowspan='1' colspan='1'><input class='srch' style='width:100%;padding: 2px 2%; font-family:Arial, FontAwesome' placeholder=' &#xF002;' data-indx='12' type='text'></th>"
                            + "</tr>"


                        //if ($('#invtable thead').find('tr').length == 1) {
                        //    $('#invtable thead').append(html);
                        //}
                        //else {
                        //    $('#invtable thead').find('tr:eq(1)').remove();
                        //    $('#invtable thead').append(html);
                        //}

                        $('#invtable thead').append(html);
                        var table = $('#invtable').DataTable();
                        $('.srch').on('keyup change', function () {
                            var indx = $(this).attr('data-indx');
                            var txt = this.value;
                            table
                                .column(indx)
                                .search(txt)
                                .draw();
                            //RowHtmlRendernew();
                        });

                    },
                    "aoColumnDefs": [
                        { 'bSortable': false, 'aTargets': [0] }
                    ]
                });

                $('.notification').fadeOut(3000);



                console.log(o);

            },
            failed: function () { notify("Some error occured"); }
        });

        //var DBSP = new DB_SP_CONNECT();
        //DBSP.ProcedureName = "POMS_BridgeSupporterAll";
        //DBSP.obj = obj;
        //DBSP.isasync = false;
        //var o = DBSP.call_DB_Procedure();
        //o = o.data;
        //var ob = new Array();





    }


