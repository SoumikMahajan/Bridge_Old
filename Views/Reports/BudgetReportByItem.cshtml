    <script type="text/javascript">

        function CallReport() {


            var url = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url = '/Reports/BudgetReportByItem';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url = 'Reports/BudgetReportByItem';
            }


            $.ajax({

                type: "POST",
                url: url,
                data: {},
                success: function () { },
                error: function () {

                }

                });


        }


    </script>

    <script type="text/javascript">

        $(function () {
            $('#Ddl_SelPro').change(function () {
                var pid = $("#Ddl_SelPro option:selected").attr('data-id');
                if (pid == 0) {
                    $('#Ddl_SelProSec').html("<option>--Select Section--</option>");
                    return;
                }
                getsections(pid);
            });
        });
        function getsections(pid) {
            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/PurchaseOrder/getAllProjectSection';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'PurchaseOrder/getAllProjectSection';
            }
            url1 += "?projectid=" + pid;
            var totdata;
            $.get(url1)
               .success(function (response) {
                   var html = "";
                   totdata = response;
                   totdata = JSON.parse(totdata).data;
                   html += " <option value=0>--Select All--</option> ";
                   for (var a = 0; a < totdata.length; a++) {
                       var id = totdata[a].id;
                       var name = totdata[a].sectionname;
                       var Sectionnumber = totdata[a].Sectionnumber;
                      
                       html += "<option value='" + id + "' data-sctnNmbr='" + Sectionnumber + "'>" + Sectionnumber + "-" + name + "</option>";
                   }
                   $('#Ddl_SelProSec').html(html);
                   if (html == "") {
                       //call here
                   }
               });
        }

        function BudgetReportByItemReportGeneration() {
            var ProjectID = $('#Ddl_SelPro').val();
            var SectionID = $('#Ddl_SelProSec').val();
            var PurchaseOrder = '';//$('#Txt_PurchaseOrder').val();
            if (ProjectID == null || ProjectID == undefined || ProjectID == 'null' || ProjectID == 'undefined' || ProjectID == '0') {
                ProjectID = '';
                notify('Select a Project');
                $('#Ddl_SelPro').focus();
                return;
            }
            if (SectionID == null || SectionID == undefined || SectionID == 'null' || SectionID == 'undefined') {
                SectionID = '';
            }
            if (PurchaseOrder == null || PurchaseOrder == undefined || PurchaseOrder == 'null' || PurchaseOrder == 'undefined') {
                PurchaseOrder = '';
            }
            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Reports/BudgetReportByItemReportGeneration';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Reports/BudgetReportByItemReportGeneration';
            }
            url1 += "?ProjectID=" + ProjectID;
            url1 += "&SectionID=" + SectionID;
            url1 += "&PurchaseOrder=" + PurchaseOrder;
            var totdata = '';
            $.get(url1)
               .success(function (response) {
                   var html = "";

                   var url2 = '';
                   if (LOCALORSERVERNEW == 'LOCAL') {
                       totdata = response;
                   }
                   else if (LOCALORSERVERNEW == 'SERVER') {
                       totdata = "POMS/" + response;
                   }


                   //totdata = response;                   
                   setTimeout(function () {
                       window.open(totdata, '_blank');
                   }, 1000);
               });
        }

    </script>
     <script type="text/javascript">
         $(function () {
             $('#Btn_Excel').click(function () {
                 var AllProjectID = $('#txt_Project').val();
                 var AllSectionID = $('#txt_Section').val();
                 var OrderPattern = "";

                 if (AllProjectID == null) {
                     notify('Please Select Project');
                     return;
                 }

                 if (AllSectionID == null) {
                     AllSectionID = "0";
                 }

                 if (OrderPattern == "") {
                     OrderPattern = "0";
                 }
                 else {

                     OrderPattern = OrderPattern.substr(0, (OrderPattern.length - 1));
                 }

                 
                             
                 var url1 = '';
                 if (LOCALORSERVERNEW == 'LOCAL') {
                     url1 = '/Reports/BudgetReportByItemExportFile';
                 }
                 else if (LOCALORSERVERNEW == 'SERVER') {
                     url1 = 'Reports/BudgetReportByItemExportFile';
                 }
                 url1 += "?ProjectID=" + AllProjectID;
                 url1 += "&SectionID=" + AllSectionID;
                 url1 += "&order=" + OrderPattern;
                 var totdata = '';
                 $.get(url1)
                    .success(function (response) {
                        var html = "";

                        var url2 = '';
                        if (response == '0') {
                            notify('No records found!!!');
                            return;
                        }
                        if (LOCALORSERVERNEW == 'LOCAL') {
                            totdata = response;
                        }
                        else if (LOCALORSERVERNEW == 'SERVER') {
                            totdata = "/POMS/" + response;
                        }


                        //totdata = response;                   
                        window.location = totdata;
                    });
             });
         });

     </script>
</head>
<body>
    
    <div class="main_container" id="angulardiv" ng-app="Reports" ng-controller="Reports">

       
