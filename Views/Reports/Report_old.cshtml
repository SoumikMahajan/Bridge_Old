                                    <div class="sm-4 mrg5T">
                                        <select class="form-control ddl_approvalstatus" multiple="multiple">
                                            @Html.Raw(ViewData["getApproval"])
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="sm-12">
                                <div class="sm-3 req">
                                    <label class="lblHeader">Sorting</label>
                                </div>
                                <div class="sm-4 mrg5T" id="status_po">
