                      }
                      ).multiselectfilter();
        //tab menu start
        var itr = 1;
        var firsttab = 0;

        setTimeout(function () {

            $('.datecontrol').val('13');
            var from = $('.datecontrol').attr('data-from');
            var to = $('.datecontrol').attr('data-to');
            from = $('.' + from);
            to = $('.' + to);
            //startdate = moment().startOf('month').format("YYYY.MM.DD");
            //enddate = moment().format("YYYY.MM.DD");


            startdate = moment().subtract(365, "days").format("YYYY.MM.DD");
            enddate = moment().format("YYYY.MM.DD");
            startdate = '';
            enddate = '';


            $(from).datepicker("option", "disabled", true);
            $(to).datepicker("option", "disabled", true);

            $(from).datepicker('setDate', startdate);
            $(to).datepicker('setDate', enddate);

        }, 0);

        $('#barofnav').find('li').each(
            function () {
                var nav = $(this).find('a').attr('href');
                var nav2 = nav;
                switch (nav) {
                    case "#budget":
                        nav2 = "BUDGET REPORT";
                        break;
                    case "#puchase":
                        nav2 = "PURCHASE COMMITMENT";
                        break;
                    case "#committed":
                        nav2 = "COMMITTED COST REPORT";
                        break;
                    case "#status":
                    case "#approvalstatus":
                        nav2 = "STATUS REPORT";
                        break;
                    case "#receiving":
                        nav2 = "RECEIVING REPORT";
                        break;
                    case "#po":
                    case "#invoice":
                    case "#payment":
                        nav2 = "PO REPORT";
                        break;
