                    <li class="active"><a data-toggle="tab" href="#budget" aria-expanded="true" onclick="setActiveTab(1);">BUDGET</a></li>
                    <li class=""><a data-toggle="tab" href="#puchase" aria-expanded="false" onclick="setActiveTab(2);">PURCHASE COMMITMENT</a></li>
                    <li class=""><a data-toggle="tab" href="#committed" aria-expanded="false" onclick="setActiveTab(3);">COMMITTED COST</a></li>
                    <li class=""><a data-toggle="tab" href="#status" aria-expanded="false" onclick="setActiveTab(4);">STATUS</a></li>
                    @*<li class=""><a data-toggle="tab" href="#approvalstatus" aria-expanded="false" onclick="setActiveTab(9);" style="display:none;">APPROVAL STATUS</a></li>*@
