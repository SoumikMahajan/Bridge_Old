<script>
    var ProjectDdlForPage = $('#txt_Project'); //The project dropdown ID
    var count = 0;
    var menuorder ='';
    var firstload = false;
    $(document).ready(function () {
        debugger;
        $(".txt_Ship_To").multiselect(
                       {
                           click: function (e) {
                               //if ($(this).multiselect("widget").find("input:checked").length > 3) {
                               //    e.preventDefault();
                               //    notify("Select maximum three sections!")
                               //    return false;
                               //}
