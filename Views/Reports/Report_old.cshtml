                                        @*<option value="0">---Select Category---</option>*@
                                        <option value="1">Detail</option>
                                        <option value="2">Summary</option>
                                    </select>
                                </div>
                            </div>
                            <div class="sm-12">
                                <div class="sm-6">
                                    <label class="lblHeader">Filters (Leave blank for all)</label>
                                </div>
                            </div>
                            <div class="sm-12">
                                <div class="sm-3 pad15L">
                                    <label class="lblNormal">Section</label>
                                </div>
                                <div class="sm-4">
                                    <select class="txt_Section" multiple="multiple"></select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="puchase" class="tab-pane fade">
