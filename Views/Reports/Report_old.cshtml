                    <li class=""><a data-toggle="tab" href="#po" aria-expanded="false" onclick="setActiveTab(6);">PO</a></li>
                    <li class=""><a data-toggle="tab" href="#invoice" aria-expanded="false" onclick="setActiveTab(7);">INVOICE</a></li>
                    <li class=""><a data-toggle="tab" href="#payment" aria-expanded="false" onclick="setActiveTab(8);">PAYMENT</a></li>
