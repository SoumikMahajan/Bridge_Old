            if ($("#committed .txtBudgetReportCategory").val() == "1") {
                CommittedCostReportDetailReportGenerationFilter(1,isSSRSCall);
            }
            else if ($("#committed .txtBudgetReportCategory").val() == "2") {
                CommittedCostReportGenerationFilter(1,isSSRSCall);
            }
        }
            //Status Report Tab Operation
        else if ($("#activeTabID").val() == "4") {
            if ($("#status .txtStatusReportCategory").val() == '4' || $("#status .txtStatusReportCategory").val() == '5')
            {
                ApprovalStatusReportGenerationFilter(1,isSSRSCall);
            }
            else
            {
                ExpeditNoteReportGenerationFilter1(1,isSSRSCall);
            }
        }
            //Receiving Report Tab Operation
        else if ($("#activeTabID").val() == "5") {
            ReceivingReportSectionReportGenerationFilter(1,isSSRSCall);
        }
            //Payment Report Tab Operation
        else if ($("#activeTabID").val() == "8") {
            PrintedChequeListReportGenerationFilter(1,isSSRSCall);
        }
            //PO Report Tab Operation
        else if ($("#activeTabID").val() == "6") {
            if ($("#po .txtBudgetReportCategory").val() == null) {
                notify('Please select report type!!');
                return false;
            }
            if ($("#po .txtStatusReportCategory").val() == null) {
                notify('Please select group by!!');
                return false;
            }
            if ($("#po .txtStatusReportCategory").val() == "0") {
                PODetailReportGenerationGroupByVendorFilter(1,isSSRSCall);
            }
            else if ($("#po .txtStatusReportCategory").val() == "1") {
                PODetailReportGenerationGroupByNoneFilter(1,isSSRSCall);
            }
            else if ($("#po .txtStatusReportCategory").val() == "2") {
                PODetailReportGenerationGroupByCurrencyFilter(1,isSSRSCall);
            }
        }
            //Invoice Report Tab Operation
        else if ($("#activeTabID").val() == "7") {
            if ($("#invoice .txtBudgetReportCategory").val() == null) {
                notify('Please select report type!!');
                return false;
            }
            if ($("#invoice .txtStatusReportCategory").val() == null) {
                notify('Please select group by!!');
                return false;
            }
            else {
                InvoiceReportGenerationFilter(1,isSSRSCall);
            }
        }
