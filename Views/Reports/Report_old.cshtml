    function ExportToPdf(isSSRSCall) {
        if ($("#txt_Project").val() == null)
        {
            notify('Please select project!!');
            return false;
        }
        //Budget Report Tab Operation
        if ($("#activeTabID").val() == "1") {
            if ($("#budget .txtBudgetReportCategory").val() == null) {
                notify('Please select report type!!');
                return false;
            }
            if ($("#budget .txtBudgetReportCategory").val() == "1") {
