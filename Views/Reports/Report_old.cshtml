<body>
    <div class="container-fluid" style="zoom: 0.95;">
        <input type="hidden" id="activeTabID" />
        <div class="roww" style="min-height:360px;">
            <div class="sm-12">
                <h3 class="section-header">REPORTS</h3>
            </div>
            <div class="sm-7">
