                    else
                        From_Date = null;
                    if ($("#txt_ToDate2").val() != '')
                        To_date = ($("#txt_ToDate2").val());
                    else
                        To_date = null;

                    if (AllSectionID == null) {
                        AllSectionID = "0";
                    }

                    if (AllVendorID == null) {
                        AllVendorID = "0";
                    }
                    if (OrderPattern == "") {
                        OrderPattern = "0";
                    }
                    if ($("#DDl_Sort7").val() == '1') {
                        ReportNo = "2";
                    }
                    else {
                        ReportNo = "3";
                    }


                }

                var url1 = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url1 = '/Reports/ProjectToDateReportExportFile';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url1 = 'Reports/ProjectToDateReportExportFile';
                }
                url1 += "?ProjectID=" + AllProjectID;
                url1 += "&SectionID=" + AllSectionID;
                url1 += "&VendorID=" + AllVendorID;
                url1 += "&StartDate=" + From_Date;
                url1 += "&EndDate=" + To_date;
                url1 += "&order=" + OrderPattern;
                url1 += "&ReportNo=" + ReportNo;
                var totdata = '';
                $("#Btn_Excel2").html('<i class="fa fa-spinner"></i>');
                $.get(url1)
                   .success(function (response) {
                       var html = "";

                       var url2 = '';

                       if (response == '0') {
                           notify('No records found!!!');
                           return;
                       }
                       if (LOCALORSERVERNEW == 'LOCAL') {
                           totdata = response;
                       }
                       else if (LOCALORSERVERNEW == 'SERVER') {
                           totdata = "POMS/" + response;
                       }


                       setTimeout(function () {
                           window.open(totdata, '_blank');
                           $("#Btn_Excel2").html('<i class="fa fa-file-excel-o"></i> Export to Excel');
                       }, 1000);
                   });
            });
        });

    </script>





