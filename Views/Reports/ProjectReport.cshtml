                        @Html.Raw(ViewData["getAllProjectNameNumber"])
                    </select>

                </div>

                <div>
                    <label id="LabelForProject"></label>
                </div>

            </div>

            <div class="col-sm-6 req">
                <div class="form-group">
                    <label>Group By</label>
                    <select id="ddlReportCategory" multiple="multiple">
                        @*<option value="0">---Select Category---</option>*@
                        <option value="1">Vendor</option>
                        <option value="2">Item</option>

                    </select>

                </div>
            </div>

        </div>



        <div id="section_panel">

            <div id="ByDetail">

                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label>Select Section (Leave Blank For All)</label>
                            <select multiple="multiple" onchange="ShowSectionsAtLabel(this,1);" id="ddlSection1"></select>

                        </div>
                        

                        <div class="form-group">

                            <label id="lblSec1"></label>


                        </div>
                    </div>

                    <div class="col-sm-3">
                        <div class="form-group">
                                <label>From Date (Leave Blank For All)</label>
                                <input type="text" id="txt_FromDate1" onkeypress="return IsNumber(event);" placeholder="Select From Date" class="makedisable form-control"/>
                           
                        </div>
                    </div>

                    <div class="col-sm-3">
                        <div class="form-group">
                            <label>To Date (Leave Blank For All)</label>
                            <input type="text" id="txt_ToDate1" onkeypress="return IsNumber(event);" placeholder="Select To Date" class="makedisable form-control" />

                        </div>
                    </div>


                </div>



                <div class="row">

                    <div class="col-sm-6">
                        <div class="form-group">
                            <button type="submit" id="Btn_Report" onclick="ProjectToDateReportReportGenerationFilter();" class="btn btn-block btn-primary mrg10T btnReport"><i class="fa fa-file-pdf-o"></i> Export to PDF</button>
                            @*<input type="button" id="Btn_Report" value="Export to PDF" onclick="BudgetReportByItemReportGenerationFilter();" />*@
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="form-group">
                            <button type="submit" id="Btn_Excel1" class="btn btn-block btn-primary mrg10T"><i class="fa fa-file-excel-o"></i> Export to Excel</button>
                            @*<input type="button" id="Btn_Report" value="Export to PDF" onclick="BudgetReportByItemReportGenerationFilter();" />*@
                        </div>
                    </div>


                </div>

            </div>

            <div id="summery">

                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label>Select Section (Leave Blank For All)</label>
                            <select multiple="multiple" onchange="ShowSectionsAtLabel(this,2);" id="ddlSection2"></select>

                        </div>


                        <div class="form-group">
                            <label id="lblSec2"></label>
                        </div>


                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label>Select Vendor (Leave Blank For All)</label>
                            <select id="txt_Vendor" multiple="multiple" onchange="ShowVendorsAtLabel(this);"></select>
                            

                        </div>
                        <div class="form-group">
                            <label id="LabelForVendor"></label>
                        </div>
                    </div>

                </div>

                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label>From Date (Leave Blank For All)</label>
                            <input type="text" id="txt_FromDate2" onkeypress="return IsNumber(event);" placeholder="Select From Date" class="makedisable form-control" />

                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="form-group">
                            <label>To Date (Leave Blank For All)</label>
                            <input type="text" id="txt_ToDate2" onkeypress="return IsNumber(event);" placeholder="Select To Date" class="makedisable form-control" />

                        </div>
                    </div>


                </div>

                <div class="row">
                    <div class="col-sm-6 req">
                       
                            <label>Sorting</label>
                            <select id="DDl_Sort7" multiple="multiple" class="form-control">
                                <option value="1" data-id="1" selected="selected">PO</option>
                                <option value="2" data-id="2">Vendor</option>

                            </select>

                       
                    </div>

                    <div class="col-sm-6">
                        <div class="form-group" style="display:none !important;">
                            <label>Sorting Order</label>
                            <div class="sort_div">


                            </div>

                        </div>
                    </div>


                </div>


                <div class="row">

                    <div class="col-sm-6">
                        <div class="form-group">
                            <button type="submit" id="Btn_Report1" onclick="ProjectToDateReportReportGenerationFilter1();" class="btn btn-block btn-primary mrg15T btnReport"><i class="fa fa-file-pdf-o"></i> Export to PDF</button>
                            @*<input type="button" id="Btn_Report" value="Export to PDF" onclick="BudgetReportByItemReportGenerationFilter();" />*@
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="form-group">
                            <button type="submit" id="Btn_Excel2" class="btn btn-block btn-primary mrg15T"><i class="fa fa-file-excel-o"></i> Export to Excel</button>
                            @*<input type="button" id="Btn_Report" value="Export to PDF" onclick="BudgetReportByItemReportGenerationFilter();" />*@
                        </div>
                    </div>


                </div>
            </div>

        </div>


    </div>

    <script>
        $(document).ready(function () {
            $("#txt_Project").multiselect(
        {
            header: "Select Project(s)!",
            close: function () {
                var project_id = $('#txt_Project').val();
                if ($("#ddlReportCategory").val() != null) {
                    bindSectionByProject(project_id, parseInt(($("#ddlReportCategory").val())));
                    bindVendor(project_id);
                    $('#LabelForVendor').text('');
                    Sort7();

                }
                else {
                    bindSectionByProject(project_id, 0);
                }
                $("#txt_Vendor").multiselect(
                        {
                            //header: "Select Vendors!",
                            click: function (e) {
                                //if ($(this).multiselect("widget").find("input:checked").length > 3) {
                                //    e.preventDefault();
                                //    notify("Select maximum three vendors!")
                                //    return false;
                                //}
                            }
                        }).multiselectfilter();
            },
            click: function (e) {
                if ($(this).multiselect("widget").find("input:checked").length > 3) {
                    e.preventDefault();
                    notify("Select maximum three projects!")
                    return false;
                }
            }

        }).multiselectfilter();
            var width = '100%';
            $('.ui-multiselect').css('width', width);
            //$('.ui-multiselect-menu').css('width', '39.5%');
            $('.ui-multiselect-menu').css('width', '39.5%');
            $('.ui-state-default').css('color', '#C31001');
            $('.ui-multiselect').css('height', '34px');
            $('.ui-multiselect').css('margin-top', '5px');


            $("#ddlReportCategory").multiselect({
                close: function () {

                },
                header: 'Select Category',
                multiple: false
            });

            $("#section_panel").hide();

            $("#ddlReportCategory").on("change", function () {
                var project_id = $('#txt_Project').val();

                if ($(this).val() == '1') {
                    $("#section_panel").show();
                    $("#ByDetail").show();
                    $("#summery").hide();
                    bindSection(project_id, 1);
                    $('#txt_FromDate1').val('');
                    $('#txt_ToDate1').val('');
                    $('#txt_FromDate1').datepicker({
                        changeMonth: true,
                        changeYear: true,
                        dateFormat: 'MM dd yy',

                    });

                    $('#txt_ToDate1').datepicker({
                        changeMonth: true,
                        changeYear: true,
                        dateFormat: 'MM dd yy',

                    });
                    $("#lblSec1").text('');
                    $("#lblSec2").text('');
                    $('#LabelForVendor').text('');

                }
                else if ($(this).val() == '2') {
                    $("#section_panel").show();
                    $("#ByDetail").hide();
                    $("#summery").show();
                    bindSection(project_id, 2);
                    bindVendor(project_id);
                    $('#LabelForVendor').text('');
                    $("#lblSec1").text('');
                    $("#lblSec2").text('');
                    $('#txt_FromDate2').val('');
                    $('#txt_ToDate2').val('');
                    $('#txt_FromDate2').datepicker({
                        changeMonth: true,
                        changeYear: true,
                        dateFormat: 'MM dd yy',

                    });

                    $('#txt_ToDate2').datepicker({
                        changeMonth: true,
                        changeYear: true,
                        dateFormat: 'MM dd yy',

                    });
                    Sort7();
                    $("#DDl_Sort7").val('1');
                    $("#DDl_Sort7").multiselect("refresh");
                    var width = '100%';
                    $('.ui-multiselect').css('width', width);
                    //$('.ui-multiselect-menu').css('width', '39.5%');
                    $('.ui-multiselect-menu').css('width', '39.5%');
                    $('.ui-state-default').css('color', '#C31001');
                    $('.ui-multiselect').css('height', '34px');
                    $('.ui-multiselect').css('margin-top', '5px');
                    
                    var html1 = '';
                    html1 += "<span class='remove' data-id='" + 1 + "' ><a onclick='deleteorder(this,\"" + 1 + "\")' title='Remove this ordering'>x</a><span>" + "PO" + "</span></span>";
                    $(".sort_div").append(html1);

                    
                }
                else {
                    $("#section_panel").hide();
                }

            });

        });

        function ShowProjectsAtLabel(obj) {

            var Projects = $(obj).val();
            var totalProjects = '';

            $('#LabelForSection').text('');
            $('#LabelForVendor').text('');
            if ($(obj).find(":selected").text() == '') {
                $('#LabelForProject').text('');
            }
            else {

                for (var i = 0; i < Projects.length; i++) {
                    if (totalProjects == '') {
                        totalProjects = $(obj).find("option[value='" + Projects[i] + "']").text();
                    }
                    else {
                        totalProjects += ' , ' + $(obj).find("option[value='" + Projects[i] + "']").text();
                    }
                }

                $('#LabelForProject').text('Selected Project(s) : ' + totalProjects + "");


            }
        }
        function ShowSectionsAtLabel(obj, option) {


            var Sections = $(obj).val();

            var totalSections = '';

            if (option == 1) {
                $('#lblSec2').text('');

                if (Sections == '' || Sections == null || Sections == undefined) {

                    $('#lblSec1').text('');
                }
                else {

                    for (var i = 0; i < Sections.length; i++) {
                        if (totalSections == '') {
                            totalSections = $(obj).find("option[value='" + Sections[i] + "']").text();
                        }
                        else {
                            totalSections += ' , ' + $(obj).find("option[value='" + Sections[i] + "']").text();
                        }
                    }
                    $('#lblSec1').text('Selected Section(s) : ' + totalSections);

                }
            }

            else if (option == 2) {
                $('#lblSec1').text('');

                if (Sections == '' || Sections == null || Sections == undefined) {

                    $('#lblSec2').text('');
                }
                else {

                    for (var i = 0; i < Sections.length; i++) {
                        if (totalSections == '') {
                            totalSections = $(obj).find("option[value='" + Sections[i] + "']").text();
                        }
                        else {
                            totalSections += ' , ' + $(obj).find("option[value='" + Sections[i] + "']").text();
                        }
                    }
                    $('#lblSec2').text('Selected Section(s) : ' + totalSections);
                }

            }
        }

        function bindSection(project_id, opt) {



            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Reports/getAllProjectSectionByProjectID';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {

                url1 = 'Reports/getAllProjectSectionByProjectID';
            }
            $.ajax({
                type: "POST",
                url: url1,
                async: false,
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                data: "{ 'projectid': '" + project_id + "'}",
                success: function (data) {
                    var sections = JSON.parse(data);
                    var total_section = sections.data.length;


                    //if (count > 0) {
                    //    //$("#txt_Section").multiselect('destroy');

                    //    count++;

                    //}
                    //else if (count == 0) {
                    //    count++;
                    //}

                    var html = '';
                    for (i = 0; i < total_section; i++) {

                        var option = '<option value="' + sections.data[i].id + '" data-id="' + sections.data[i].id + '">' + sections.data[i].Sectionnumber + '-' + sections.data[i].sectionname + '</option>';
                        html += option;


                    }



                    if (opt == 1) {

                        $("#ddlSection1").html(html);

                        $("#ddlSection1").multiselect(
                            {

                                click: function (e) {
                                    //if ($(this).multiselect("widget").find("input:checked").length > 3) {
                                    //    e.preventDefault();
                                    //    notify("Select maximum three sections!")
                                    //    return false;
                                    //}
                                }
                            }
                            ).multiselectfilter();
                        $("#ddlSection1").multiselect("refresh");
                        var width = '100%';
                        $('.ui-multiselect').css('width', width);
                        //$('.ui-multiselect-menu').css('width', '39.5%');
                        $('.ui-multiselect-menu').css('width', '39.5%');
                        $('.ui-state-default').css('color', '#C31001');
                        $('.ui-multiselect').css('height', '34px');
                        $('.ui-multiselect').css('margin-top', '5px');
                    }
                    else if (opt == 2) {
                        $("#ddlSection2").html(html);

                        $("#ddlSection2").multiselect(
                            {

                                click: function (e) {
                                    //if ($(this).multiselect("widget").find("input:checked").length > 3) {
                                    //    e.preventDefault();
                                    //    notify("Select maximum three sections!")
                                    //    return false;
                                    //}
                                }
                            }
                            ).multiselectfilter();
                        $("#ddlSection2").multiselect("refresh");
                        var width = '100%';
                        $('.ui-multiselect').css('width', width);
                        //$('.ui-multiselect-menu').css('width', '39.5%');
                        $('.ui-multiselect-menu').css('width', '39.5%');
                        $('.ui-state-default').css('color', '#C31001');
                        $('.ui-multiselect').css('height', '34px');
                        $('.ui-multiselect').css('margin-top', '5px');
                    }


                },
                error: function () {
                    notify('Something went wrong.');
                }
            });

        }

        function bindSectionByProject(project_id, opt) {

            if (opt == 0) {
                $("#section_panel").hide();
            }


            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Reports/getAllProjectSectionByProjectID';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {

                url1 = 'Reports/getAllProjectSectionByProjectID';
            }
            $.ajax({
                type: "POST",
                url: url1,
                async: false,
                dataType: "text",
                contentType: "application/json; charset=utf-8",
                data: "{ 'projectid': '" + project_id + "'}",
