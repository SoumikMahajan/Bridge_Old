    <script type="text/javascript">
        $(function () {
            $('#Btn_Excel1').click(function () {
                
                var AllProjectID = $('#txt_Project').val();

                var AllVendorID = $('#txt_Vendor').val();
                var OrderPattern = "";
                var ReportNo = "";

                var From_Date;
                var To_date;

                if (AllProjectID == null) {
                    notify('Please Select Project');
                    return;
                }

                if ($("#ddlReportCategory").val() == "1") {
                    var AllSectionID = $('#ddlSection1').val();
                    if ($("#txt_FromDate1").val() != '')
                        From_Date = ($("#txt_FromDate1").val());
                    else
                        From_Date = null;
                    if ($("#txt_ToDate1").val() != '')
                        To_date = ($("#txt_ToDate1").val());
                    else
                        To_date = null;

                    if (AllSectionID == null) {
                        AllSectionID = "0";
                    }

                    if (AllVendorID == null) {
                        AllVendorID = "0";
                    }
                    if (OrderPattern == "") {
                        OrderPattern = "0";
                    }
                    ReportNo = "1";
                }

                var url1 = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url1 = '/Reports/ProjectToDateReportExportFile';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url1 = 'Reports/ProjectToDateReportExportFile';
                }
                url1 += "?ProjectID=" + AllProjectID;
                url1 += "&SectionID=" + AllSectionID;
                url1 += "&VendorID=" + AllVendorID;
                url1 += "&StartDate=" + From_Date;
                url1 += "&EndDate=" + To_date;
                url1 += "&order=" + OrderPattern;
                url1 += "&ReportNo=" + ReportNo;
                $("#Btn_Excel1").html('<i class="fa fa-spinner"></i>');
                var totdata = '';
                $.get(url1)
                   .success(function (response) {
                       var html = "";
                       var url2 = '';
                       if (response == '0') {
                           notify('No records found!!!');
                           return;
                       }
                       if (LOCALORSERVERNEW == 'LOCAL') {
                           totdata = response;
                       }
                       else if (LOCALORSERVERNEW == 'SERVER') {
                           totdata = "POMS/" + response;
                       }


                       setTimeout(function () {
                           window.open(totdata, '_blank');
                           $("#Btn_Excel1").html('<i class="fa fa-file-excel-o"></i> Export to Excel');
                       }, 1000);
                   });
            });
        });

    </script>

    <script type="text/javascript">
        $(function () {
            $('#Btn_Excel2').click(function () {
                
                if ($("#DDl_Sort7").val() == null) {
                    notify("Please Select Sorting Option", "RED");
                    return;
                }

                var AllProjectID = $('#txt_Project').val();

                var AllVendorID = $('#txt_Vendor').val();
                var OrderPattern = "";
                var ReportNo = "";

                var From_Date;
                var To_date;

                if (AllProjectID == null) {
                    notify('Please Select Project');
                    return;
                }

                if ($("#ddlReportCategory").val() == "2") {
                    var AllSectionID = $('#ddlSection2').val();
                    if ($("#txt_FromDate2").val() != '')
