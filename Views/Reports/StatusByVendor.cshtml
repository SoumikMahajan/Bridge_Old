    <script type="text/javascript">

        

        function ExpeditNoteReportGeneration() {
            var ProjectID = $('#Ddl_SelPro').val();
            var SectionID = '';//$('#Ddl_SelProSec').val();
            var PurchaseOrder = '';//$('#Txt_PurchaseOrder').val();
            if (ProjectID == null || ProjectID == undefined || ProjectID == 'null' || ProjectID == 'undefined' || ProjectID == '0') {
                ProjectID = '';
                notify('Select a Project');
                $('#Ddl_SelPro').focus();
                return;
            }
            //if (SectionID == null || SectionID == undefined || SectionID == 'null' || SectionID == 'undefined') {
            //    SectionID = '';
            //}
            //if (PurchaseOrder == null || PurchaseOrder == undefined || PurchaseOrder == 'null' || PurchaseOrder == 'undefined') {
            //    PurchaseOrder = '';
            //}
            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Reports/StatusByVendorGeneration';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Reports/StatusByVendorGeneration';
            }
            url1 += "?ProjectID=" + ProjectID;
            url1 += "&SectionID=" + SectionID;
            url1 += "&PurchaseOrder=" + PurchaseOrder;
            var totdata = '';
            $.get(url1)
               .success(function (response) {
                   var html = "";

                   var url2 = '';
                   if (LOCALORSERVERNEW == 'LOCAL') {
                       totdata = response;
                   }
                   else if (LOCALORSERVERNEW == 'SERVER') {
                       totdata = "POMS/" + response;
                   }


                   setTimeout(function () {
                       window.open(totdata, '_blank');
                   }, 1000);
               });
        }

    </script>
    <script type="text/javascript">
        $(function () {
            $('#Btn_Excel').click(function () {
                var AllProjectID = $('#txt_Project').val();
                var OrderPattern = "";
                var Status = $("#ddl_ItemStatus").val();

                var From_Date;
                var To_date;

                if (AllProjectID == null) {
                    notify('Please Select Project');
                    return;
                }

                if ($("#txt_FromDate").val() != '')
                    From_Date = ($("#txt_FromDate").val());
                else
                    From_Date = null;
                if ($("#txt_ToDate").val() != '')
                    To_date = ($("#txt_ToDate").val());
                else
                    To_date = null;

                $(".sort_div").find("span").each(function (index, item) {

                    var orderIndex = $(this).attr("data-id");

                    if (typeof (orderIndex) != 'undefined') {

                        if (orderIndex == "1")
                            OrderPattern += '1' + ",";
                        if (orderIndex == "2")
                            OrderPattern += '2' + ",";
                        if (orderIndex == "3")
                            OrderPattern += '3' + ",";

                    }

                });

                if (OrderPattern == "") {
                    OrderPattern = "0";
                }
                else {

                    OrderPattern = OrderPattern.substr(0, (OrderPattern.length - 1));
                }
                var url1 = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url1 = '/Reports/StatusByVendorExportFile';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url1 = 'Reports/StatusByVendorExportFile';
                }
                url1 += "?AllProjectID=" + AllProjectID;
                url1 += "&Status=" + Status;
                url1 += "&StartDate=" + From_Date;
                url1 += "&EndDate=" + To_date;
                url1 += "&order=" + OrderPattern;


                var totdata = '';
                $.get(url1)
                   .success(function (response) {
                       var html = "";
                       var url2 = '';
                       if (response == '0') {
                           notify('No records found!!!');
                           return;
                       }
                       if (LOCALORSERVERNEW == 'LOCAL') {
                           totdata = response;
                       }
                       else if (LOCALORSERVERNEW == 'SERVER') {
                           totdata = "POMS/" + response;
                       }


                       setTimeout(function () {
                           window.open(totdata, '_blank');
                       }, 1000);
                   });
            });
        });

    </script>
</head>
<body>

    <div class="main_container" id="angulardiv" ng-app="Reports" ng-controller="Reports">

        <div class="logo_container_heading"> Status By Vendor </div>

