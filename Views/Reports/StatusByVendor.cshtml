                @*------------------------------------------------Previously Begin---------------------------------------------------*@

                @*<select id="Ddl_SelPro">
            <option data-id="0" value="0">--Select Project--</option>
            @Html.Raw(ViewData["getAllProjectName"])
        </select>*@

                @*------------------------------------------------Previously End---------------------------------------------------*@


