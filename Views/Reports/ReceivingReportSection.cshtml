    <script>
        //Receiving Report By Section Start
        function ReceivingReportSectionReportGenerationFilter(option,obj) {
            
            var AllProjectID = $('#txt_Project').val();
            var AllSectionID;
            var ReportOption;
            if(option == 1)
            {
                AllSectionID = $('#ddlSection1').val();
            }
            if (option == 2) {
                AllSectionID = $('#ddlSection2').val();
            }
            var AllVendorID = $('#txt_Vendor').val();
            var OrderPattern = "";
            
            if (AllProjectID == null) {
                notify('Please Select Project');
                return;
            }

            if (AllSectionID == null) {
                AllSectionID = "0";
            }

            if (AllVendorID == null) {
                AllVendorID = "0";
            }
            if (option == 1) {

                $(".sort_div:first").find("span").each(function (index, item) {

                    var orderIndex = $(this).attr("data-id");

                    if (typeof (orderIndex) != 'undefined') {

                        if (orderIndex == "1") {
                            OrderPattern += '1' + ",";
                            ReportOption = "1";
                        }
                        if (orderIndex == "2") {
                            OrderPattern += '2' + ",";
                            ReportOption = "2";
                        }

                    }

                });
            }

            if (option == 2) {

                $(".sort_div:last").find("span").each(function (index, item) {

                    var orderIndex = $(this).attr("data-id");

                    if (typeof (orderIndex) != 'undefined') {

                        if (orderIndex == "1") {
                            OrderPattern += '1' + ",";
                            ReportOption = "3";
                        }
                        if (orderIndex == "2") {
                            OrderPattern += '2' + ",";
                            ReportOption = "4";
                        }
                        if (orderIndex == "3") {
                            OrderPattern += '3' + ",";
                            ReportOption = "5";
                        }

                    }

                });
            }

            if (OrderPattern == "") {
                notify('Please Select Sorting Option!');
                return;
            }
            else {

                OrderPattern = OrderPattern.substr(0, (OrderPattern.length - 1));
            }
            $(obj).html('<i class="fa fa-spinner"></i>');
            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Reports/ReceivingReportSectionReportGeneration';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Reports/ReceivingReportSectionReportGeneration';
            }
            url1 += "?ProjectID=" + AllProjectID;
            url1 += "&SectionID=" + AllSectionID;
            url1 += "&VendorID=" + AllVendorID;
            url1 += "&order=" + OrderPattern;
            url1 += "&option=" + ReportOption;
            var totdata = '';
            $.get(url1)
               .success(function (response) {
                   var html = "";
                   var url2 = '';
                   if (response == '0') {
                       notify('No records found!!!');
                       return;
                   }
                   if (LOCALORSERVERNEW == 'LOCAL') {
                       totdata = response;
                   }
                   else if (LOCALORSERVERNEW == 'SERVER') {
                       totdata = "POMS/" + response;
                   }


                   setTimeout(function () {
                       window.open(totdata, '_blank');
                       $(obj).html('<i class="fa fa-file-pdf-o"></i> Export to PDF ');
                   }, 1000);
               });
        }
        //Receiving Report By Section End
    </script>

