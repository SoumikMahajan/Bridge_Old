            }
            else {

                for (var i = 0; i < Vendors.length; i++) {
                    if (totalVendors == '') {
                        totalVendors = $(obj).find("option[value='" + Vendors[i] + "']").text();
                    }
                    else {
                        totalVendors += ' , ' + $(obj).find("option[value='" + Vendors[i] + "']").text();
                    }
                }
                $('#LabelForVendor').text('Selected Vendor(s) : ' + totalVendors);

            }
