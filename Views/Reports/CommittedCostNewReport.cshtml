<body>

    <div class="container-fluid" id="angulardiv" ng-app="Reports" ng-controller="Reports">


        <div class="row">
            <div class="col-sm-12">
                <h3 class="section-header">Committed Cost Report</h3>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-6">
                <div class="form-group req">
                    <label>Select Project</label>
                    <select id="txt_Project" multiple="multiple" onchange="ShowProjectsAtLabel(this);">
                        @*<option value="0">--Select Project--</option>*@
                        @Html.Raw(ViewData["getAllProjectNameNumber"])
                    </select>

                </div>

                <div>
                    <label id="LabelForProject"></label>
                </div>

            </div>

            <div class="col-sm-6 req">
                <div class="form-group">
                    <label>Report Type</label>
                    <select id="ddlReportCategory" multiple="multiple">
                        @*<option value="0">---Select Category---</option>*@
                        <option value="1">Detail</option>
                        <option value="2">Summary</option>

                    </select>

                </div>
            </div>

        </div>



        <div id="section_panel">

            <div id="ByDetail">

                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label>Select Section (Leave Blank For All)</label>
                            <select multiple="multiple" onchange="ShowSectionsAtLabel(this,1);" id="ddlSection1"></select>

                        </div>

                        <div class="form-group">

                            <label id="lblSec1"></label>


                        </div>
                    </div>

                    
                </div>



                <div class="row">

                    <div class="col-sm-6">
                        <div class="form-group">
                            <button type="submit" id="Btn_Report" onclick="CommittedCostReportDetailReportGenerationFilter();" class="btn btn-block btn-primary mrg10T btnReport"><i class="fa fa-file-pdf-o"></i> Export to PDF</button>
                            @*<input type="button" id="Btn_Report" value="Export to PDF" onclick="BudgetReportByItemReportGenerationFilter();" />*@
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="form-group">
                            <button type="submit" id="Btn_Excel1" class="btn btn-block btn-primary mrg10T"><i class="fa fa-file-excel-o"></i> Export to Excel</button>
                            @*<input type="button" id="Btn_Report" value="Export to PDF" onclick="BudgetReportByItemReportGenerationFilter();" />*@
                        </div>
                    </div>


                </div>

            </div>

            <div id="summery">

                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label>Select Section (Leave Blank For All)</label>
                            <select multiple="multiple" onchange="ShowSectionsAtLabel(this,2);" id="ddlSection2"></select>

                        </div>


                        <div class="form-group">
                            <label id="lblSec2"></label>
                        </div>


                    </div>

                    
                </div>


                <div class="row">

                    <div class="col-sm-6">
                        <div class="form-group">
                            <button type="submit" id="Btn_Report" onclick="CommittedCostReportGenerationFilter();" class="btn btn-block btn-primary mrg10T btnReport"><i class="fa fa-file-pdf-o"></i> Export to PDF</button>
                            @*<input type="button" id="Btn_Report" value="Export to PDF" onclick="BudgetReportByItemReportGenerationFilter();" />*@
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="form-group">
                            <button type="submit" id="Btn_Excel2" class="btn btn-block btn-primary mrg10T"><i class="fa fa-file-excel-o"></i> Export to Excel</button>
                            @*<input type="button" id="Btn_Report" value="Export to PDF" onclick="BudgetReportByItemReportGenerationFilter();" />*@
                        </div>
                    </div>


                </div>
            </div>

        </div>


