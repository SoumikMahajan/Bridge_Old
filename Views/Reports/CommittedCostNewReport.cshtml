    <script type="text/javascript">
        $(function () {
            $('#Btn_Excel1').click(function () {
                $("#Btn_Excel1").html('<i class="fa fa-spinner"></i>');
                var AllProjectID = $('#txt_Project').val();
                var AllSectionID = $('#ddlSection1').val();
                var OrderPattern = "";

                if (AllProjectID == null) {
                    notify('Please Select Project');
                    return;
                }

                if (AllSectionID == null) {
                    AllSectionID = "0";
                }

                if (OrderPattern == "") {
                    OrderPattern = "0";
                }
                else {

                    OrderPattern = OrderPattern.substr(0, (OrderPattern.length - 1));
                }

                var url1 = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url1 = '/Reports/CommittedCostReportDetailExportFile';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url1 = 'Reports/CommittedCostReportDetailExportFile';
                }
                url1 += "?ProjectID=" + AllProjectID;
                url1 += "&SectionID=" + AllSectionID;
                url1 += "&order=" + OrderPattern;


                var totdata = '';
                $.get(url1)
                   .success(function (response) {
                       var html = "";
                       var url2 = '';
                       if (response == '0') {
                           notify('No records found!!!');
                           return;
                       }
                       if (LOCALORSERVERNEW == 'LOCAL') {
                           totdata = response;
                       }
                       else if (LOCALORSERVERNEW == 'SERVER') {
                           totdata = "POMS/" + response;
                       }


                       setTimeout(function () {
                           window.open(totdata, '_blank');
                           $("#Btn_Excel1").html('<i class="fa fa-file-excel-o"></i> Export to Excel');
                       }, 1000);
                   });
            });
        });

    </script>

    <script type="text/javascript">
        $(function () {
            $('#Btn_Excel2').click(function () {
                $("#Btn_Excel2").html('<i class="fa fa-spinner"></i>');
                var AllProjectID = $('#txt_Project').val();
                var AllSectionID = $('#ddlSection2').val();
                var OrderPattern = "";

                if (AllProjectID == null) {
                    notify('Please Select Project');
                    return;
                }

                if (AllSectionID == null) {
                    AllSectionID = "0";
                }

                $(".sort_div").find("span").each(function (index, item) {

                    var orderIndex = $(this).attr("data-id");

                    if (typeof (orderIndex) != 'undefined') {

                        if (orderIndex == "1")
                            OrderPattern += '1' + ",";
                    }

                });

                if (OrderPattern == "") {
                    OrderPattern = "0";
                }
                else {

                    OrderPattern = OrderPattern.substr(0, (OrderPattern.length - 1));
                }
                var url1 = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url1 = '/Reports/CommittedCostReportExportFile';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url1 = 'Reports/CommittedCostReportExportFile';
                }
                url1 += "?ProjectID=" + AllProjectID;
                url1 += "&SectionID=" + AllSectionID;
                url1 += "&order=" + OrderPattern;
                var totdata = '';
                $.get(url1)
                   .success(function (response) {
                       var html = "";

                       var url2 = '';

                       if (response == '0') {
                           notify('No records found!!!');
                           return;
                       }
                       if (LOCALORSERVERNEW == 'LOCAL') {
                           totdata = response;
                       }
                       else if (LOCALORSERVERNEW == 'SERVER') {
                           totdata = "POMS/" + response;
                       }


                       setTimeout(function () {
                           window.open(totdata, '_blank');
                           $("#Btn_Excel2").html('<i class="fa fa-file-excel-o"></i> Export to Excel');
                       }, 1000);
                   });
            });
        });

    </script>





