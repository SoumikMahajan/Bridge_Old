    <script type="text/javascript">
        $(function () {
            $('#Btn_Excel1').click(function () {
                var AllProjectID = $('#txt_Project').val();
                var AllSectionID = $('#txt_Section').val();
                var AllVendorID = $('#txt_Vendor').val();
                var OrderPattern = "";
                var Status = $("#ddl_ItemStatus").val();
                var NoteStatus = $("#ddl_NoteStatus").val();
                var From_Date;
                var To_date;

                if (AllProjectID == null) {
                    notify('Please Select Project');
                    return;
                }

                $(".sort_div").find("span").each(function (index, item) {

                    var orderIndex = $(this).attr("data-id");

                    if (typeof (orderIndex) != 'undefined') {

                        if (orderIndex == "1")
                            OrderPattern += '1' + ",";
                        if (orderIndex == "2")
                            OrderPattern += '2' + ",";
                        if (orderIndex == "3")
                            OrderPattern += '3' + ",";

                    }

                });

                if (OrderPattern == "") {
                    notify('Please Select Sorting Order!!');
                    return;
                }
                else {

                    OrderPattern = OrderPattern.substr(0, (OrderPattern.length - 1));
                }


                if ($("#txt_FromDate").val() != '')
                    From_Date = ($("#txt_FromDate").val());
                else
                    From_Date = null;
                if ($("#txt_ToDate").val() != '')
                    To_date = ($("#txt_ToDate").val());
                else
                    To_date = null;

                if (AllSectionID == null) {
                    AllSectionID = "0";
                }

                if (AllVendorID == null) {
                    AllVendorID = "0";
                }


                var ReportOption = parseInt(($('#txtStatusReportCategory').val() - 1) * 3) + parseInt($('#ddl_Sort').val());
                var url1 = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url1 = '/Reports/ExpeditNoteExportFile';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url1 = 'Reports/ExpeditNoteExportFile';
                }
                url1 += "?ProjectID=" + AllProjectID;
                url1 += "&SectionID=" + AllSectionID;
                url1 += "&VendorID=" + AllVendorID;
                url1 += "&Status=" + Status;
                url1 += "&StartDate=" + From_Date;
                url1 += "&EndDate=" + To_date;
                url1 += "&order=" + OrderPattern;
                url1 += "&NoteStatus=" + NoteStatus;
                url1 += "&ReportOption=" + ReportOption;

                $("#Btn_Excel1").html('<i class="fa fa-spinner"></i>');
                var totdata = '';

                $.get(url1)
                   .success(function (response) {
                       var html = "";
                       var url2 = '';
                       if (response == '0') {
                           notify('No records found!!!');
                           return;
                       }
                       if (LOCALORSERVERNEW == 'LOCAL') {
                           totdata = response;
                       }
                       else if (LOCALORSERVERNEW == 'SERVER') {
                           totdata = "POMS/" + response;
                       }


                       setTimeout(function () {
                           window.open(totdata, '_blank');
                           $("#Btn_Excel1").html('<i class="fa fa-file-excel-o"></i> Export to Excel');
                       }, 1000);
                   });
            });

            $('#Btn_Excel2').click(function () {
                var AllProjectID = $('#txt_Project').val();
                var AllSectionID = $('#txt_Section').val();
                var OrderPattern = "";

                if (AllProjectID == null) {
                    notify('Please Select Project');
                    return;
                }

                if (AllSectionID == null) {
                    AllSectionID = "0";
                }

                if (OrderPattern == "") {
                    OrderPattern = "0";
                }
                else {

                    OrderPattern = OrderPattern.substr(0, (OrderPattern.length - 1));
                }
                var url1 = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url1 = '/Reports/ExpediteReportByItemExportFile';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url1 = 'Reports/ExpediteReportByItemExportFile';
                }
                url1 += "?ProjectID=" + AllProjectID;
                url1 += "&SectionID=" + AllSectionID;
                url1 += "&order=" + OrderPattern;
                var totdata = '';
                $.get(url1)
                   .success(function (response) {
                       var html = "";

                       var url2 = '';
                       if (response == '0') {
                           notify('No records found!!!');
                           return;
                       }
                       if (LOCALORSERVERNEW == 'LOCAL') {
                           totdata = response;
                       }
                       else if (LOCALORSERVERNEW == 'SERVER') {
                           totdata = "/POMS/" + response;
                       }


                       //totdata = response;
                       window.location = totdata;
                   });
            });
        });

    </script>

