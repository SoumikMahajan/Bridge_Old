<body>

    <div class="container-fluid" id="angulardiv" ng-app="Reports" ng-controller="Reports">


        <div class="row">
            <div class="col-sm-12">
                <h3 class="section-header">Status Report</h3>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-6">
                <div class="form-group req">
                    <label>Select Project</label>
                    <select id="txt_Project" multiple="multiple" onchange="ShowProjectsAtLabel(this);">
                        @*<option value="0">--Select Project--</option>*@
                        @Html.Raw(ViewData["getAllProjectNameNumber"])
                    </select>

                </div>

                <div class="form-group">
                    <label id="LabelForProject"></label>
                </div>

            </div>

            <div class="col-sm-6 req">
                <div class="form-group">
                    <label>Group By</label>
                    <select id="txtStatusReportCategory" multiple="multiple">
                        @*<option value="0">---Select Category---</option>*@
                        <option value="1">Section</option>
                        <option value="2">Vendor</option>
                        <option value="3">Status</option>
                        

                    </select>

                </div>
            </div>

        </div>



        <div id="section_panel">

            <div id="AtRiskByItem">

                <div class="row">
                    <div class="col-sm-4">
                        <div class="form-group">
                            <label>Select Section (Leave Blank For All)</label>
                            <select id="txt_Section" multiple="multiple" onchange="ShowSectionsAtLabel(this);"></select>

                        </div>

                        <div class="form-group">
                            <label id="LabelForSection"></label>
                        </div>

                    </div>

                    <div class="col-sm-4">
                        <div class="form-group">
                            <label>Select Vendor (Leave Blank For All)</label>
                            <select id="txt_Vendor" multiple="multiple" onchange="ShowVendorsAtLabel(this);"></select>

                        </div>

                        <div class="form-group">
                            <label id="LabelForVendor"></label>
                        </div>
                    </div>

                    <div class="col-sm-4">

                        <label for="ddl_ItemStatus">Item Status (Leave Blank For All)</label>
                        <select class="form-control itemStatus" id="ddl_ItemStatus">
                            <option value="0">--Select Status--</option>
                            @Html.Raw(ViewData["getItemStatus"])
                        </select>


                    </div>
                </div>

                <div class="row">

                    <div class="col-sm-4">

                        <label>From Date (Leave Blank For All)</label>
                        <input type="text" id="txt_FromDate" onkeypress="return IsNumber(event);" placeholder="Select From Date" class="makedisable form-control fromDate" />
                    </div>

                    <div class="col-sm-4">


                        <label>To Date (Leave Blank For All)</label>
                        <input type="text" id="txt_ToDate" onkeypress="return IsNumber(event);" placeholder="Select To Date" class="makedisable form-control toDate" />


                    </div>


                    <div class="col-sm-4">

                        <label for="ddl_NoteStatus">Include Note</label>
                        <select class="form-control itemStatus" id="ddl_NoteStatus">
                            <option value="0">Yes</option>
                            <option value="1">No</option>

                        </select>


                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-6 mrg15T req">

                        <label>Sorting</label>
                        <select multiple="multiple" id="ddl_Sort">
                            <option value="1" data-id="1">Item</option>
                            <option value="2" data-id="2">PO</option>
                            <option value="3" data-id="3">Arrival Date</option>

                        </select>


                    </div>
                    <div class="col-sm-6 mrg15T" style="display:none !important;">

                        <label>Sorting Order</label>
                        <div class="sort_div user_panel_container">


                        </div>



                    </div>
                </div>

                <div class="row">

                    <div class="col-sm-6 mrg15T">
                        <div class="form-group">
                            <button type="submit" id="Btn_Report" onclick="ExpeditNoteReportGenerationFilter1();" class="btn btn-block btn-primary mrg10T"><i class="fa fa-file-pdf-o"></i> Export to PDF</button>
                            @*<input type="button" id="Btn_Report" value="Export to PDF" onclick="BudgetReportByItemReportGenerationFilter();" />*@
                        </div>
                    </div>

                    <div class="col-sm-6 mrg15T">
                        <div class="form-group">
                            <button type="submit" id="Btn_Excel1" class="btn btn-block btn-primary mrg10T"><i class="fa fa-file-excel-o"></i> Export to Excel</button>
                            @*<input type="button" id="Btn_Report" value="Export to PDF" onclick="BudgetReportByItemReportGenerationFilter();" />*@
                        </div>
                    </div>


                </div>

            </div>

           
            
        </div>


    </div>

    <script>
        var ProjectDdlForPage = $('#txt_Project'); //The project dropdown ID
        $(document).ready(function () {

            $("#txt_Project").multiselect(
        {
            header: "Select Project(s)!",
            close: function () {
                
                
            },
            click: function (e) {
                if ($(this).multiselect("widget").find("input:checked").length > 3) {
                    e.preventDefault();
                    notify("Select maximum three projects!")
                    return false;
                }
            }

        }).multiselectfilter();
            var width = '100%';
            $('.ui-multiselect').css('width', width);
            //$('.ui-multiselect-menu').css('width', '39.5%');
            $('.ui-multiselect-menu').css('width', '39.5%');
            $('.ui-state-default').css('color', '#C31001');
            $('.ui-multiselect').css('height', '34px');
            $('.ui-multiselect').css('margin-top', '5px');

            var selectedpreferredpid = getProjectPreferencemulti();

            if (selectedpreferredpid.split(',').length == 0) {
                $(ProjectDdlForPage).find('option[value="' + selectedpreferredpid[i] + '"]').attr("selected", "true");
            }

            else {
                for (var i = 0; i < 3; i++) {

                    $(ProjectDdlForPage).find('option[value="' + selectedpreferredpid.split(',')[i] + '"]').attr("selected", "true");

                }
            }




            $(ProjectDdlForPage).multiselect('refresh');

            var width = '100%';
            $('.ui-multiselect').css('width', width);
            $('.ui-multiselect-menu').css('width', '39.5%');
            $('.ui-state-default').css('color', '#C31001');
            $('.ui-multiselect').css('height', '34px');
            $('.ui-multiselect').css('margin-top', '5px');



            //To call page specific dropdown change event
            ShowProjectsAtLabel(ProjectDdlForPage);
            //close_project_dropdown(selectedpreferredpid);




        });



        $(document).on('change', ProjectDdlForPage, function () {

            setProjectPreference(ProjectDdlForPage);

        });

