@{
    Layout = "../Shared/_Layout.cshtml";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>PrintedChequeList</title>


    <link href='https://fonts.googleapis.com/css?family=Alegreya+Sans:400,300,500,700' rel='stylesheet' type='text/css'>
    <link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.1.0/css/font-awesome.min.css" rel="stylesheet" type="text/css">
    <link href="~/css/jquery-ui.css" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="https://ajax.googleapis.com/ajax/libs/jqueryui/1/themes/ui-lightness/jquery-ui.css" />
    <link href="~/css/jquery.multiselect.css" rel="stylesheet" />
    <link href="~/css/jquery.multiselect.filter.css" rel="stylesheet" />

   
    <link href="~/css/jquery.switchButton.css" rel="stylesheet" />
    <link href="~/css/ui-lightness/jquery-ui-1.8.19.custom.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-1.7.1.js"></script>
    <script src="~/Scripts/jquery-ui.min.js"></script>
    <script src="~/Scripts/jquery.switchButton.js"></script>
    <script src="~/Scripts/jquery.autosize.js"></script>
    <script src="~/Scripts/GlobalJS.js"></script>
    <link href="~/css/Misc.css" rel="stylesheet" />


    <script type="text/javascript">

        $(function () {
            $('#Ddl_SelPro').change(function () {
                var pid = $("#Ddl_SelPro option:selected").attr('data-id');
                if (pid == 0) {
                    $('#Ddl_SelProSec').html("<option>---Select---</option>");
                    return;
                }
                getsections(pid);
            });
        });
        function getsections(pid) {
            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/PurchaseOrder/getAllProjectSection';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'PurchaseOrder/getAllProjectSection';
            }
            url1 += "?projectid=" + pid;
            var totdata;
            $.get(url1)
               .success(function (response) {
                   var html = "";
                   totdata = response;
                   totdata = JSON.parse(totdata).data;
                   for (var a = 0; a < totdata.length; a++) {
                       var id = totdata[a].id;
                       var name = totdata[a].sectionname;
                       var Sectionnumber = totdata[a].Sectionnumber;
                       html += "<option value='" + id + "' data-sctnNmbr='" + Sectionnumber + "'>" + Sectionnumber + "-" + name + "</option>";
                   }
                   $('#Ddl_SelProSec').html('<option value="0" data-sctnNmbr>----Select Section-----</option>' + html);
                   if (html == "") {
                       //call here
                   }
               });
        }

        function PrintedChequeListReportGeneration() {
            var ProjectID = $('#Ddl_SelPro').val();
            var SectionID = $('#Ddl_SelProSec').val();
            var PurchaseOrder = '';//$('#Txt_PurchaseOrder').val();
            if (ProjectID == null || ProjectID == undefined || ProjectID == 'null' || ProjectID == 'undefined' || ProjectID == '0') {
                ProjectID = '';
                notify('Select a Project');
                $('#Ddl_SelPro').focus();
                return;
            }
            if (SectionID == null || SectionID == undefined || SectionID == 'null' || SectionID == 'undefined') {
                SectionID = '';
            }
            if (PurchaseOrder == null || PurchaseOrder == undefined || PurchaseOrder == 'null' || PurchaseOrder == 'undefined') {
                PurchaseOrder = '';
            }
            var url1 = '';
            if (LOCALORSERVERNEW == 'LOCAL') {
                url1 = '/Reports/PrintedChequeListReportGeneration';
            }
            else if (LOCALORSERVERNEW == 'SERVER') {
                url1 = 'Reports/PrintedChequeListReportGeneration';
            }
            url1 += "?ProjectID=" + ProjectID;
            url1 += "&SectionID=" + SectionID;
            url1 += "&PurchaseOrder=" + PurchaseOrder;
            var totdata = '';
            $.get(url1)
               .success(function (response) {
                   var html = "";

                   var url2 = '';
                   if (LOCALORSERVERNEW == 'LOCAL') {
                       totdata = response;
                   }
                   else if (LOCALORSERVERNEW == 'SERVER') {
                       totdata = "POMS/" + response;
                   }


                   setTimeout(function () {
                       window.open(totdata, '_blank');
                   }, 1000);
               });
        }

    </script>
    <script type="text/javascript">
        $(function () {
            $('#Btn_Excel').click(function () {
                var AllProjectID = $('#txt_Project').val();
                var AllSectionID = $('#txt_Section1').val();
                var AllVendorID = $('#txt_Vendor1').val();
                var OrderPattern = "";
                $(".sort_div").find("span").each(function (index, item) {

                    var orderIndex = $(this).attr("data-id");

                    if (typeof (orderIndex) != 'undefined') {

                        if (orderIndex == "1")
                            OrderPattern += '1' + ",";
                        if (orderIndex == "2")
                            OrderPattern += '2' + ",";

                    }

                });

                if (OrderPattern == "") {
                    OrderPattern = "0";
                    notify("Please Select Sorting Option!");
                    return;
                }
                else {

                    OrderPattern = OrderPattern.substr(0, (OrderPattern.length - 1));
                }

                var From_Date;
                var To_date;

                if (AllProjectID == null) {
                    notify('Please Select Project');
                    return;
                }
                $(this).html('<i class="fa fa-spinner"></i>');
                if ($("#txt_FromDate").val() != '')
                    From_Date = ($("#txt_FromDate").val());
                else
                    From_Date = null;
                if ($("#txt_ToDate").val() != '')
                    To_date = ($("#txt_ToDate").val());
                else
                    To_date = null;

                if (AllSectionID == null) {
                    AllSectionID = "0";
                }

                if (AllVendorID == null) {
                    AllVendorID = "0";
                }


                var url1 = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url1 = '/Reports/PrintedChequeListExportFile';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url1 = 'Reports/PrintedChequeListExportFile';
                }
                url1 += "?ProjectID=" + AllProjectID;
                url1 += "&SectionID=" + AllSectionID;
                url1 += "&VendorID=" + AllVendorID;
                url1 += "&StartDate=" + From_Date;
                url1 += "&EndDate=" + To_date;
                url1 += "&order=" + OrderPattern;



                var totdata = '';
                $.get(url1)
                   .success(function (response) {
                       var html = "";
                       var url2 = '';
                       if (response == '0') {
                           notify('No records found!!!');
                           return;
                       }
                       if (LOCALORSERVERNEW == 'LOCAL') {
                           totdata = response;
                       }
                       else if (LOCALORSERVERNEW == 'SERVER') {
                           totdata = "POMS/" + response;
                       }


                       setTimeout(function () {
                          
                           window.open(totdata, '_blank');
                           $(this).html('<i class="fa fa-file-excel-o"></i> Export to Excel');
                           
                       }, 1000);
                   });
            });
        });
    </script>

</head>
<body>
    <div class="container-fluid" id="angulardiv" ng-app="Reports" ng-controller="Reports">

        <div class="row">
            <div class="col-sm-12">
                <h3 class="section-header">Payment Report</h3>
            </div>
        </div>

        <script src="~/Scripts/jquery.multiselect.filter.js"></script>
        <script src="~/Scripts/jquery.multiselect.js"></script>
        <script type="text/javascript" src="~/Scripts/ReportFilter.js"></script>
        <div class="row">
            <div class="col-sm-6 ">
                <div class="form-group req">
                    <label>Select Project</label>
                    <select id="txt_Project" multiple="multiple" onchange="ShowProjectsAtLabel(this);">
                        @*<option value="0">--Select Project--</option>*@
                        @Html.Raw(ViewData["getAllProjectNameNumber"])
                    </select>
                </div>
                <label id="LabelForProject"></label>
            </div>
            <div class="col-sm-6">
                <label>Select Section (Leave Blank For All)</label>
                <select id="txt_Section1" multiple="multiple" onchange="ShowSectionsAtLabel(this);"></select>
                <label id="LabelForSection"></label>
            </div>
        </div>
        <div id="section_panel1">
            <div class="row">
                <div class="col-sm-6">
                    <label>Select Vendor (Leave Blank For All)</label>
                    <select id="txt_Vendor1" multiple="multiple" onchange="ShowVendorsAtLabel(this);"></select>
                    <label id="LabelForVendor"></label>
                </div>
                <div class="col-sm-3">
                    <label>From Date (Leave Blank For All)</label>
                    <input type="text" id="txt_FromDate" onkeypress="return IsNumber(event);" placeholder="Select From Date" class="makedisable form-control"  />
                </div>
                <div class="col-sm-3">
                    <label>To Date (Leave Blank For All)</label>
                    <input type="text" id="txt_ToDate" onkeypress="return IsNumber(event);" placeholder="Select To Date" class="makedisable form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6 req">
                    <label>Sorting</label>
                    <select id="DDl_Sort8" multiple="multiple">
                        <option value="1" data-id="1">Payment Number</option>
                        <option value="2" data-id="2">Payment Date</option>
                    </select>
                </div>
                <div class="col-sm-6" style="display:none !important;">
                    <label>Sorting Order</label>
                    <div class="sort_div user_panel_container">
                    </div>
                </div>
            </div>
        </div>
        <div class="row">

            <div class="col-sm-6">
                <div class="form-group">
                    <button type="submit" id="Btn_Report" onclick="PrintedChequeListReportGenerationFilter();" class="btn btn-block btn-primary mrg15T btnReport"><i class="fa fa-file-pdf-o"></i> Export to PDF</button>
                    @*<input type="button" id="Btn_Report" value="Export to PDF" onclick="BudgetReportByItemReportGenerationFilter();" />*@
                </div>
            </div>

            <div class="col-sm-6">
                <div class="form-group">
                    <button type="submit" id="Btn_Excel" class="btn btn-block btn-primary mrg15T"><i class="fa fa-file-excel-o"></i> Export to Excel</button>
                    @*<input type="button" id="Btn_Report" value="Export to PDF" onclick="BudgetReportByItemReportGenerationFilter();" />*@
                </div>
            </div>


        </div>
    </div>
</body>

<script type="text/javascript">
    $(document).ready(function () {
        AllDatePicker();

        $("#DDl_Sort8").multiselect('uncheckAll');
        $("#DDl_Sort8").val('1');
        $("#DDl_Sort8").multiselect("refresh");
        var width = '100%';
        $('.ui-multiselect').css('width', width);
        //$('.ui-multiselect-menu').css('width', '39.5%');
        $('.ui-multiselect-menu').css('width', '39.5%');
        $('.ui-state-default').css('color', '#C31001');
        $('.ui-multiselect').css('height', '34px');
        $('.ui-multiselect').css('margin-top', '5px');

        var html = '';
        var text = '';
        text += 'Payment Number';
        html += "<span class='remove' data-id='" + "1" + "' ><a onclick='deleteorder(this," + "1" + ");' title='Remove this ordering'>x</a><span>" + text + "</span></span>";
        $(".sort_div").append(html);

    });

</script>

<script>


    var ProjectDdlForPage = $('#txt_Project'); //The project dropdown ID
    $(document).ready(function () {

        var selectedpreferredpid = getProjectPreferencemulti();

        if (selectedpreferredpid.split(',').length == 0) {
            $(ProjectDdlForPage).find('option[value="' + selectedpreferredpid[i] + '"]').attr("selected", "true");
        }

        else {
            for (var i = 0; i < 3; i++) {

                $(ProjectDdlForPage).find('option[value="' + selectedpreferredpid.split(',')[i] + '"]').attr("selected", "true");

            }
        }

        $(ProjectDdlForPage).multiselect('refresh');

        var width = '100%';
        $('.ui-multiselect').css('width', width);
        $('.ui-multiselect-menu').css('width', '39.5%');
        $('.ui-state-default').css('color', '#C31001');
        $('.ui-multiselect').css('height', '34px');
        $('.ui-multiselect').css('margin-top', '5px');



        //To call page specific dropdown change event
        ShowProjectsAtLabel(ProjectDdlForPage);
        close_project_dropdown(selectedpreferredpid);




    });



    $(document).on('change', ProjectDdlForPage, function () {

        setProjectPreference(ProjectDdlForPage);

    });


</script>



</html>
