    <script type="text/javascript">

        angular.module("customer", [])
            .controller("customer", function ($http, $scope) {


                $scope.IsBuyeroptions = [
                     { label: 'YES', value: 1 },
                     { label: 'NO', value: 0 }
                ];

                $scope.IsBuyerSelected = $scope.IsBuyeroptions[1];

                $scope.getPriority = function () {


                    var selectedid = $scope.selectedUserType.Fldid;

                    if (selectedid == 4 || selectedid == 5) {
                        $scope.selectedDefaultBuyer.Fldid = 0;
                        $scope.IsBuyerSelected.value = 0;
                        //$('#Ddl_IsByr').attr('disabled', 'disabled').val('1').css('opacity','0.35');
                        //$('#Ddl_DefltByr').attr('disabled', 'disabled').val('0').css('opacity', '0.35');
                        $('#Ddl_IsByr').parent().css('display', 'none');
                        $('#Ddl_DefltByr').parent().css('display', 'none');
                        //$scope.apply();
                    }
                    else {
                        //$('#Ddl_IsByr').removeAttr('disabled', 'disabled').css('opacity', '1');
                        //$('#Ddl_DefltByr').removeAttr('disabled', 'disabled').css('opacity', '1');
                        $('#Ddl_IsByr').parent().css('display', '');
                        $('#Ddl_DefltByr').parent().css('display', '');
                    }
                   
                    var url57 = '';
                    if (LOCALORSERVERNEW == 'LOCAL') {
                        url57 = 'return_priorities_new';
                    }
                    else if (LOCALORSERVERNEW == 'SERVER') {
                        url57 = 'adduser/return_priorities_new';
                    }

                    $http.get(url57 + "?usertypeid=" + selectedid)
                            .success(function (response) {
                    $scope.prioritylist = response;
                                // $("input[type=checkbox]").switchButton();


                            $('#UserTypeSecurityDiv').css('display', 'block');
                            var grouptype = "";
                            var currg = "";
                            var html = "<tr>"
                                + "<th>Security Item</th>"
                                + "<th>Assigned</th>"
                                + "</tr>";
                            
                            var plist = response.data;
                            var html = "";
                            for (var i = 0; i < plist.length; i++) {
                                currg = plist[i].GroupType;
                                if (currg == grouptype) {
                                }
                                else {
                                    grouptype = currg;
                                    html += "<tr><td style='color:white;background:black;' colspan='2'>" + grouptype + "</td></tr>";
                                }
                                html += "<tr><td><label style='padding:0px;width:100%;' for='prioritychk_" + plist[i].security_id + "'>" + plist[i].priority_name + "</label></td>";
                                if (plist[i].is_selected == "1") {
                                    html += '<td><input  type="checkbox" class="chkScrty" value="1" id="prioritychk_' + plist[i].security_id + '" checked></td></tr>';
                                }
                                else {
                                    html += '<td><input type="checkbox" class="chkScrty" value="0" id="prioritychk_' + plist[i].security_id + '"></td></tr>';
                                }
                            }
                           
                            $('#priority_checkbox').html(html);

                          


                            var tableobj = $('#priority_checkbox');
                            rebuiltPriorityintoDivs(tableobj);

                    });
                }




                $scope.User = {
                    FName: '',
                    LName: '',
                    UName: '',
                    Password: '',
                    ConfrmPswrd: '',
                    Email: '',
                    selectedUserType: '',
                    IsByr: '',
                    selectedDefaultBuyer: '',
                    priorities_on_list: ''
                };

            


                var url59 = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url59 = 'getUserType';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url59 = 'user/getUserType';
                }



                $http.get(url59)
                    .success(function (response) {

                        var newr = [{
                            Fldid: "0",
                            UserType: "---Select UserType---"
                        }, {
                            Fldid: "2",
                            UserType: "Administrator"
                        }, {
                            Fldid: "3",
                            UserType: "Buyer"
                        }, {
                            Fldid: "8",
                            UserType: "Accountant"
                        }];
                       

                        $scope.UserType = newr;

                        $scope.selectedUserType = $scope.UserType[0];
                    });

                var url69 = '';
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url69 = 'DefaultBuyer';
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url69 = 'user/DefaultBuyer';
                }

                $http.get(url69)
                   .success(function (response) {
                       $scope.DefaultBuyer = response;

                       if ($scope.DefaultBuyer.length != 0) {
                           $scope.selectedDefaultBuyer = $scope.DefaultBuyer[0];
                       }
                       else {
                           $scope.selectedDefaultBuyer =
                               { Fldid: 0 }
                       }
                   });

                $scope.GetDefaultBuyer = function (obj) {
                    //alert(1);

                    var url67 = '';
                    if (LOCALORSERVERNEW == 'LOCAL') {
                        url67 = 'DefaultBuyerFORME';
                    }
                    else if (LOCALORSERVERNEW == 'SERVER') {
                        url67 = 'user/DefaultBuyerFORME';
                    }


                    if ($scope.IsBuyerSelected.value == 1) {




                        $http.get(url67)
                   .success(function (response) {
                       $scope.DefaultBuyer = response;

                       if ($scope.DefaultBuyer.length != 0) {
                           $scope.selectedDefaultBuyer = $scope.DefaultBuyer[0];
                       }
                       else {
                           $scope.selectedDefaultBuyer =
                               { Fldid: 0 }
                       }
                   });
                    }
                    else {


                        var urldfltbyr = '';
                        if (LOCALORSERVERNEW == 'LOCAL') {
                            urldfltbyr = 'DefaultBuyer';
                        }
                        else if (LOCALORSERVERNEW == 'SERVER') {
                            urldfltbyr = 'user/DefaultBuyer';
                        }




                        $http.get(urldfltbyr)
                   .success(function (response) {
                       $scope.DefaultBuyer = response;

                       if ($scope.DefaultBuyer.length != 0) {
                           $scope.selectedDefaultBuyer = $scope.DefaultBuyer[0];
                       }
                       else {
                           $scope.selectedDefaultBuyer =
                               { Fldid: 0 }
                       }
                   });
                    }


                }

                $scope.AddUser = function () {

                    var priorities = "";

                    $('.chkScrty').each(function () {

                        if ($(this).is(":checked")) {


                            if (priorities == "")
                            { priorities += $(this).attr('id').split('prioritychk_')[1]; }
                            else {
                                priorities += "," + $(this).attr('id').split('prioritychk_')[1];
                            }
                        }
                    });
                    $scope.User.selectedUserType = $scope.selectedUserType.Fldid;
                    $scope.User.selectedDefaultBuyer = $scope.selectedDefaultBuyer.Fldid;
                    $scope.User.priorities_on_list = priorities;
                    $scope.User.IsByr = $scope.IsBuyerSelected.value;



                    if ($scope.User.Password == null || $scope.User.Password == '') {
                        var plength = 8;
                        var keylist = 'abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ';
                        var temp = ''
                        var isupperchar = false;
                        var isnumber = false;
                        var islowerchar = false;
                        temp = ''
                        while (isupperchar == false || isnumber == false || islowerchar == false) {
                            temp = '';
                            for (i = 0; i < plength; i++) {
                                var tmp = keylist.charAt(Math.floor(Math.random() * keylist.length));
                                var ccode = tmp.charCodeAt(0);
                                if ((ccode > 64 && ccode < 91)) {
                                    isupperchar = true;
                                }
                                else if ((ccode > 96 && ccode < 123)) {
                                    islowerchar = true;
                                }
                                else if (ccode > 47 && ccode < 58) {
                                    isnumber = true;
                                }
                                temp += tmp;
                            }
                        }
                        $scope.User.Password = temp;
                        $scope.User.ConfrmPswrd = temp;

                       // alert(1);
                    }

                    

                   

                    $('#loader_createuser').show();
                    $('#btn_CrtUsr').hide();

                    var obj = JSON.stringify($scope.User);



                    var urlcrtUsr = '';
                    if (LOCALORSERVERNEW == 'LOCAL') {
                        urlcrtUsr = 'CreateUser';
                    }
                    else if (LOCALORSERVERNEW == 'SERVER') {
                        urlcrtUsr = 'user/CreateUser';
                    }

                    


                    $.ajax({
                        url: urlcrtUsr,
                        type: "POST",
                        dataType: "text",
                        contentType: "application/json; charset=utf-8",
                        data: obj,
                        failed: function (error) {
                            notify("failed");
                            $('#loader_createuser').hide();
                            $('#btn_CrtUsr').show();
                        },
                        success: function (data) {
                            if (data == 'INVALID^USERNAME') {
                                $('#txt_UName').val('');
                                errorfunc('txt_UName', 'Please enter an unique User name');
                                notify('Username already exists !! Please give an unique one !!');
                            }
                            else if (data == 'INVALID^EMAIL') {
                                $('#txt_Email').val('');
                                errorfunc('txt_Email', 'Please enter an unique Email Address');
                                notify('Email already exists !! Please give an unique one !!');
                            }
                            else {
                                notify('User Activation mail has been sent to User.','green');
                                $scope.User.FName = '';
                                $scope.User.LName = '';
                                $scope.User.UName = '';
                                $scope.User.Password = '';
                                $scope.User.ConfrmPswrd = '';
                                $scope.User.Email = '';
                                $scope.User.selectedUserType = '';
                                $scope.User.IsByr = '';
                                $scope.User.selectedDefaultBuyer = '';
                                $scope.User.priorities_on_list = '';
                                $('#txt_FName').val('');
                                $('#txt_LName').val('');
                                $('#txt_UName').val('');
                                $('#txt_Password').val('');
                                $('#txt_ConfrmPswrd').val('');
                                $('#txt_Email').val('');
                                irrrrr = 0;
                                setTimeout(function () {
                                    window.location.reload();
                                }, 3000);

                            }

                            $('#loader_createuser').hide();
                            $('#btn_CrtUsr').show();
                        }
                    });

                }

                // return;

                $scope.GetUserData = function (selectedid) {

                    $http.get("GetUserData?userid=" + selectedid).success(function (response) {






                   });



                }


            });



        function EditPOPUP(obj) {
            alert(obj);

            $('.popup_container').fadeIn(40);
        }
    </script>


    <script>

        function rebuiltPriorityintoDivs(obj) {

            $('.newappendeddivforpermissions').remove();

            var ttt = 0;
            var cnt = -1;
            var outerhtml = "<div style='margin-left: -16px;margin-right: -14px;' class='row newappendeddivforpermissions'>";

            $(obj).find('tbody tr').each(function () {



                if ($(this).find('td').length == 1) {

                    cnt++;

                    if (ttt == 0) {


                        outerhtml += '<div class="row" style="margin-left:0px;margin-right:0px;padding-left:12px;padding-right:12px;">';

                        outerhtml += '<div class="col-sm-3">';
                    }
                    else {




                        if (cnt % 4 == 0) {
                            outerhtml += '</div></div><div class="row"  style="margin-left:0px;margin-right:0px;padding-left:12px;padding-right:12px;"><div class="col-sm-3">';

                        }
                        else {
                            outerhtml += '</div><div class="col-sm-3">';
                        }
                    }
                    outerhtml += '<div class="col-sm-12 section-header"><span style="float: left;width: 76.9%;text-align: left;">' + $(this).find('td:eq(0)').html() + '</span>'
                    + '<input style="float:left;margin-left:2px;    margin-top: 10px;" type="checkbox" onclick="Checkallinner(this);" /></div> ';


                }

                else {
                    outerhtml += '<div class="col-sm-9">';
                    outerhtml += '<span>' + $(this).find('td:eq(0)').html() + '</span></div>';
                    outerhtml += '<div class="col-sm-3">' + $(this).find('td:eq(1)').html() + '</div>';

                }

                ttt = 1;


            });

            outerhtml += "</div>";
            //console.log(outerhtml);

            $(obj).after(outerhtml);

            $(obj).html('');

        }

        function Checkallinner(obj) {

            var pdiv = $(obj).parent().parent();
            if ($(obj).is(':checked')) {
                $(pdiv).find('.chkScrty').prop('checked', true);
            }
            else {
                $(pdiv).find('.chkScrty').prop('checked', false);

            }
        }
    </script>


    
</body>
