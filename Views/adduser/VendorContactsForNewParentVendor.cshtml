    <script type="text/javascript">
        function ChkIsHiddnChange(obj) {
            if ($(obj).is(":checked")) {
                $('#Ddl_IsHiddn').val("1");
            } else {
                $('#Ddl_IsHiddn').val("0");
            }
        }
        function ChkIsSystemUser(obj) {
            if ($(obj).is(":checked")) {
                $('#txt_Email').removeAttr('disabled');
                $('#txt_Email').css('background-color', '#FFFFFF');
                $('#txt_Email').parent().addClass('req');
                $('#Ddl_IsSystemUser').val("1");
                $('.showHide').removeClass('displaynone');
            } else {
                $('#txt_Email').parent().removeClass('req');
                $('.showHide').addClass('displaynone');
                $('#Ddl_IsSystemUser').val("0");
            }
        }
    </script>
    <style type="text/css">
        #sidebar {
