<body>
    <input type="hidden" id="prevcountry" value="@ViewData["Country"]" />
    <input type="hidden" id="prevstate" value="@ViewData["State"]"/>
    <input type="hidden" id="prevzipcode" value="@ViewData["ZipCode"]"/>
    <input type="hidden" id="prevcity" value="@ViewData["City"]"/>
    <input type="hidden" id="prevaddress" value="@ViewData["Address1"]"/>
    <div class="container-fluid" id="angulardiv" ng-app="customer" ng-controller="customer" style="zoom:0.95;">

        <div class="row">
            <div class="col-sm-12">
                <h3 class="section-header">Add Vendor Contacts</h3>
            </div>

            <div class="col-sm-5">
                <div class="col-sm-3">
                    <label>Parent Vendor</label>
                    <input type="text" disabled="disabled" Value="@ViewBag.ParentVendorName" class="form-control" />
                </div>

                <div class="col-sm-3">
                    <label>Contact Title</label>
                    <input type="text" id="txt_ContactTitle" ng-model="User.ContactTitle"  class="form-control"/>
                </div>

                <div class="col-sm-6" style="text-align: right;margin-top: 22px;margin-bottom: 2px;">
                    <label for="Chk_IsHiddn">Hidden</label>
                    <input type="checkbox" id="Chk_IsHiddn" onchange="ChkIsHiddnChange(this);" />
                    <select id="Ddl_IsHiddn" style="display: none;">
                        <option value="1">Yes</option>
                        <option value="0" selected="selected">No</option>
                    </select>
                    <label class="mrg10L" for="Chk_IsSystemUser">System User </label>
                    <input type="checkbox" id="Chk_IsSystemUser" onchange="ChkIsSystemUser(this);" checked />
                    <select id="Ddl_IsSystemUser" style="display: none;">
                        <option value="1">Yes</option>
                        <option value="0" selected="selected">No</option>
                    </select>
                </div>

                <div class="col-sm-3 req">
                    <label>First Name</label>
                    <input type="text" id="txt_ContactFname" ng-model="User.ContactFname" class="form-control text-uppercase" />
                </div>
                <div class="col-sm-3">
                    <label>Last Name</label>
                    <input type="text" id="txt_ContactLname" ng-model="User.ContactLname" class="form-control text-uppercase" />
                </div>

                <div class="col-sm-3">
                    <label>Email address</label>
                    <input type="text" class="form-control" id="txt_Email" ng-model="User.Email" />
                    @*onblur="CheckAvailEmail(this);"*@
                </div>
                <div class="col-sm-3">
                    <label>Website</label>
                    <input type="text" id="txt_Website" ng-model="User.Website" class="form-control" />
                </div>

                <div class="col-sm-3">
                    <label>Phone</label>
                    <input type="text" id="txt_Phone" ng-model="User.Phone" class="form-control" />
                </div>
                <div class="col-sm-3">
                    <label>Ext</label>
                    <input type="text" id="txt_Extension" ng-model="User.Extension" class="form-control" />
                </div>
                <div class="col-sm-3">
                    <label>Fax</label>
                    <input type="text" id="txt_Fax" ng-model="User.Fax" class="form-control" />
                </div>
                <div class="col-sm-3">
                    <label>Mobile</label>
                    <input type="text" id="txt_Mobile" ng-model="User.Mobile" class="form-control" />
                </div>

                <div class="col-sm-6">
                    <label>Address(Press Enter for multiple lines)</label>
                    <textarea id="txt_Add1" ng-model="User.Address1" class="form-control no-resize" style="height:70px;"></textarea>
                </div>

                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Country</label>
                        <select id="Ddl_Country" onchange="GetCtryID(this);" class="form-control">
                            @Html.Raw(ViewData["GetAllCountry"])
                        </select>
                    </div>
                    <div class="form-group">
                        <label>State/Prov</label>
                        <select id="Ddl_State" onchange="GetStateID(this);" class="form-control">
                            <option value="0">select</option>
                            @Html.Raw(ViewData["GetAllStateByCntryID"])
                        </select>
                    </div>
                </div>


                <div class="col-sm-6">
                    <label>City</label>
                    <input type="text" id="Ddl_City" ng-model="User.City" class="form-control" />
                </div>
                <div class="col-sm-6">
                    <label>Postal Code/Zip Code</label>
                    <input type="text" class="postalcode form-control" id="txt_ZipCode" ng-model="User.ZipCode" />
                </div>

                





            </div>


            <div class="col-sm-7 showHide displaynone" style="margin-top: 21px !important;">

                <div class="col-sm-12">
                    <h3 class="section-header">Permissions</h3>
                </div>


                <div class="col-sm-12">
                    <button type="button" class="btn btn-poms mrg5B uncheckallbtn" data-uncheckclass="chkScrty">Uncheck All</button>
                    <button type="button" class="btn btn-poms mrg5B checkallbtn" data-checkclass="chkScrty">Check All</button>
                    <table border="1" class="logo_container_table table" cellspacing="0" cellpadding="0" style="width: 100%;" id="priority_checkbox"></table>
                </div>
            </div>



        </div>

        
       
        
       
        <div class="user_panel_container displaynone">
            <label>Address2</label>
            <input type="text" id="txt_Add2" ng-model="User.Address2" />
        </div>
        <div class="user_panel_container" style="display: none;">
            <label>Contact</label>
            <input type="text" id="txt_Contact" ng-model="User.Contact" />
        </div>
        <div class="user_panel_container" style="display: none;">
            
        </div>
        <div class="user_panel_container" style="display: none;">
            <label>Password</label>
            <input type="password" id="txt_Password" ng-model="User.Password" />
        </div>
        <div class="user_panel_container" style="display: none;">
            <label>Confirm password</label>
            <input type="password" id="txt_ConfrmPswrd" ng-model="User.ConfrmPswrd" />
        </div>
        
        <div class="user_panel_container policy-items showHide">
            <div class="security-detail">
            </div>
        </div>
        @*<div class="user_panel_container" style="margin-bottom:22px;">
            <input type="button" value="Create User" id="btn_CrtVendorContact">
            <img id="loader_CrtVendorContact" style="display: none;" src="~/Images/load.gif" />
        </div>*@
    </div>
    <div class="float-panel-container">
        <ul>
            <li id="btn_CrtVendorContact"><a href="javascript:void(0);"><i class="fa fa-save mrg5R" title="Create Contact" data-toggle="tooltip"></i><span class="tooltip-toggle">Create Contact</span></a></li>
        </ul>
    </div>
    <script type="text/javascript">
        angular.module("customer", [])
            .controller("customer", function ($http, $scope) {
                var url1 = "";
                if (LOCALORSERVERNEW == 'LOCAL') {
                    url1 = "/adduser/return_priorities_new";
                }
                else if (LOCALORSERVERNEW == 'SERVER') {
                    url1 = 'adduser/return_priorities_new';        //'adduser/return_priorities';
                }
                $http.get(url1 + "?usertypeid=6")
                               .success(function (response) {
                                   //$scope.prioritylist = response;
                                   $('#UserTypeSecurityDiv').css('display', 'block');
                                   // $scope.prioritylist = response;
                                   var grouptype = "";
                                   var currg = "";
                                   var html = "<tr>"
                                       + "<th>Security Item</th>"
                                       + "<th>Assigned</th>"
                                       + "</tr>";
                                   var plist = response.data;
                                   var html = "";
                                   for (var i = 0; i < plist.length; i++) {
                                       currg = plist[i].GroupType;

                                       if (currg.toUpperCase() != "PROJECT" && currg.toUpperCase() != "USER" && currg.toUpperCase() != "VENDOR") {

                                       if (currg == grouptype) {
                                       }
                                       else {
                                           grouptype = currg;
                                           html += "<tr><td style='color:white;background:black;' colspan='2'>" + grouptype + "</td></tr>";
                                       }
                                       html += "<tr><td><label style='padding:0px;width:100%;' for='prioritychk_" + plist[i].security_id + "'>" + plist[i].priority_name + "</label></td>";
                                       if (plist[i].is_selected == "1") {
                                           //if (plist[i].security_id == 16 || plist[i].security_id == 6 || plist[i].security_id == 2 || plist[i].security_id == 1 || plist[i].security_id == 17 || plist[i].security_id == 17 || plist[i].security_id == 4) {
                                           //    html += '<td><input  type="checkbox" checked class="chkScrty" value="1" id="prioritychk_' + plist[i].security_id + '" disabled ></td></tr>';
                                           //} else {
                                           //    html += '<td><input  type="checkbox" class="chkScrty" value="1" id="prioritychk_' + plist[i].security_id + '" checked></td></tr>';
                                           //}
                                           html += '<td><input  type="checkbox" class="chkScrty" value="1" id="prioritychk_' + plist[i].security_id + '" checked></td></tr>';
                                       }
                                       else {
                                           html += '<td><input type="checkbox" class="chkScrty" value="0" id="prioritychk_' + plist[i].security_id + '"></td></tr>';
                                       }
                                   }


                               }
                                   $('#priority_checkbox').html(html);

                                   var tableobj = $('#priority_checkbox');
                                   rebuiltPriorityintoDivs(tableobj);

                               });
                $scope.User = {
                    FName: '',
                    LName: '',
                    UName: '',
                    Password: '',
                    ConfrmPswrd: '',
                    Email: '',
                    selectedUserType: '',
                    IsByr: '',
                    selectedDefaultBuyer: '',
                    priorities_on_list: '',
                    selectedUserType1: '',
                    selectedUserType2: ''
                };
                //$http.get("return_salesagent")
                //    .success(function (response) {
                //$scope.salesagent = response;
                //$scope.selectedsalesagent = angular.copy($scope.salesagent);
                //});
                //$http.get("getUserTypeBYFilter")
                //    .success(function (response) {
                //        $scope.UserType = response;
                //        $scope.selectedUserType = $scope.UserType[0];
                //    });
                // $http.get("getAllCountry")
                //     .success(function (response) {
                //         $scope.CountryCode = response;
                //         $scope.selectedUserType1 = $scope.CountryCode[0];
                //     });
                $scope.AddVendorContact = function () {
                    var priorities = "";
                    var url1 = "";
                    if (LOCALORSERVERNEW == 'LOCAL') {
                        url1 = "/adduser/CreateVendorContactForNew";
                    }
                    else if (LOCALORSERVERNEW == 'SERVER') {
                        url1 = 'adduser/CreateVendorContactForNew';
                    }
                    $('.chkScrty').each(function () {
                        if ($(this).is(":checked")) {
                            if (priorities == "")
                            { priorities += $(this).attr('id').split('prioritychk_')[1]; }
                            else {
                                priorities += "," + $(this).attr('id').split('prioritychk_')[1];
                            }
                        }
                    });
                    // $scope.User.ParentVendorID = $('#Vendorid').val();
                    $scope.User.Address1 = $('#txt_Add1').val();
                    $scope.User.ZipCode = $('#txt_ZipCode').val();

                    
                    
                    $scope.User.priorities_on_list = priorities;
                    $scope.User.Country = $('#Ddl_Country').val();
                    $scope.User.State = $('#Ddl_State').val();
                    $scope.User.City = $('#Ddl_City').val().trim();
                    $scope.User.IsHiddn = $('#Ddl_IsHiddn').val();
                    $scope.User.IsSystemUser = $('#Ddl_IsSystemUser').val();
                    $('#loader_CrtVendorContact').show();
                    $('#btn_CrtVendorContact').hide();
                    var obj = JSON.stringify($scope.User);
                    $.ajax({
                        url: url1,
                        type: "POST",
                        dataType: "text",
                        contentType: "application/json; charset=utf-8",
                        data: obj,
                        error: function () {
                            alert("failed");
                            $('#loader_CrtVendorContact').hide();
                            $('#btn_CrtVendorContact').show();
                        },
                        success: function (data) {
                            if (data == 'INVALID^USERNAME') {
                                $('#txt_UName').val('');
                                errorfunc('txt_UName', 'Please enter an unique User name');
                                alert('Username already exists !! Please give an unique one !!');
                            }
                            else if (data == 'INVALID^EMAIL') {
                                $('#txt_Email').val('');
                                errorfunc('txt_Email', 'Please enter an unique Email Address');
                                alert('Email already exists !! Please give an unique one !!');
                            }
                            else {
                                if (data == '1') {
                                    notify('User Activation mail has been sent to User.', 'green');
                                }
                                else if (data == '0') {
                                    notify('User created.', 'green');
                                }
                                else if (data == 'Error') {
                                    alert('Error sending mail.');
                                }
                                //window.location.reload();
                                var locurl = "";
                                if (LOCALORSERVERNEW == 'LOCAL') {
                                    locurl = "/vendor/allcontacts";
                                }
                                else if (LOCALORSERVERNEW == 'SERVER') {
                                    locurl = 'vendor/allcontacts';
                                }
                                irrrrr = 0;
                                window.setTimeout(function () {
                                    window.location.href = locurl;
                                }, 2000);
                            }
                            $('#loader_CrtVendorContact').hide();
                            $('#btn_CrtVendorContact').show();
                        }
                    });
                }
            });
        function EditPOPUP(obj) {
            //alert(obj);
            $('.popup_container').fadeIn(40);
        }
    </script>
    <script>
        $(document).ready(function () {
            irrrrr = 1;
            $('#Ddl_Country').val($('#prevcountry').val());
            GetCtryID($('#Ddl_Country'));
            $('#Ddl_State').val($('#prevstate').val());
            $('#txt_Add1').val($('#prevaddress').val());
            $('#Ddl_City').val($('#prevcity').val());
            $('#txt_ZipCode').val($('#prevzipcode').val());
        });
    </script>

    <script>

        function rebuiltPriorityintoDivs(obj) {

            $('.newappendeddivforpermissions').remove();

            var ttt = 0;
            var cnt = -1;
            var outerhtml = "<div style='class='row newappendeddivforpermissions'>";

            $(obj).find('tbody tr').each(function () {

                var nowDiv = $(this).find('td:eq(0)').html().toUpperCase();

                //console.log(nowDiv);

                if (nowDiv != "PROJECT" && nowDiv != "USER" && nowDiv != "VENDOR") {

                    if ($(this).find('td').length == 1) {

                        cnt++;

                        if (ttt == 0) {


                            outerhtml += '<div class="row" style="margin-left:0px;margin-right:0px;">';

                            outerhtml += '<div class="col-sm-3" style="width:20%;">';
                        }
                        else {




                            if (cnt % 7 == 0) {
                                if (nowDiv != "PROJECT" && nowDiv != "USER" && nowDiv != "VENDOR") {
                                    outerhtml += '</div></div><div class="row"  style="margin-left:0px;margin-right:0px;"><div class="col-sm-3"  style="width:20%;">';
                                }
                                else {
                                    outerhtml += '</div></div><div class="row"  style="margin-left:0px;margin-right:0px;"><div class="col-sm-3 displaynone"  style="width:20%;">';


                                }


                            }
                            else {

                                if (nowDiv != "PROJECT" && nowDiv != "USER" && nowDiv != "VENDOR") {
                                    outerhtml += '</div><div class="col-sm-3"  style="width:20%;">';
                                }
                                else {
                                    outerhtml += '</div><div class="col-sm-3 displaynone">';

                                }

                            }
                        }
                        //outerhtml += '<h3 class="section-header">' + $(this).find('td:eq(0)').html() + '</h3>';

                        outerhtml += '<div class="col-sm-12 section-header"><span style="float: left;width: 76.9%;text-align: left;">' + $(this).find('td:eq(0)').html() + '</span>'
                  + '<input style="float:left;margin-left:2px;    margin-top: 10px;" type="checkbox" onclick="Checkallinner(this);" /></div> ';

                    }

                    else {

                        if (nowDiv != "PROJECT" && nowDiv != "USER" && nowDiv != "VENDOR") {
                            outerhtml += '<div class="col-sm-9">';
                            outerhtml += '<span>' + $(this).find('td:eq(0)').html() + '</span></div>';
                            outerhtml += '<div class="col-sm-3">' + $(this).find('td:eq(1)').html() + '</div>';
                        }
                        else {
                            outerhtml += '<div class="col-sm-9 displaynone">';
                            outerhtml += '<span>' + $(this).find('td:eq(0)').html() + '</span></div>';
                            outerhtml += '<div class="col-sm-3 displaynone">' + $(this).find('td:eq(1)').html() + '</div>';

                        }


                    }

                    ttt = 1;

                }

            });

            outerhtml += "</div>";
            //console.log(outerhtml);

            $(obj).after(outerhtml);

            $(obj).html('');

        }


        function Checkallinner(obj) {

            var pdiv = $(obj).parent().parent();
            if ($(obj).is(':checked')) {
                $(pdiv).find('.chkScrty').prop('checked', true);
            }
            else {
                $(pdiv).find('.chkScrty').prop('checked', false);

            }
        }
    </script>
</body>
</html>
