    <script type="text/javascript">

        $(document).ready(function () {
            $('#txt_Terms').val('24');

            $("#Ddl_Clftion").multiselect().multiselectfilter();


            var width = '100%';
            $('.ui-multiselect').css('width', width);
            $('.ui-multiselect-menu').css('width', '84%');
            $('.ui-state-default').css('color', '#C31001');
            $('.ui-multiselect').css('height', '34px');
            $('.ui-multiselect').css('margin-top', '5px');
            $('.ui-multiselect-menu').css('width', '24%');

        });

    </script>
