    <script type="text/javascript">
        var filedata = {};
        var filedatacount = 0;
        var formData = new FormData();

        function delobject1(val, obj) {

            delete filedata[val];
            $(obj).parent().remove();
        }

        $("#fileupload").live("change", function () {
            filedata["fileupload" + filedatacount] = $('input[type=file]')[0].files[0];
            html = "<ul class='filesul'>";
            html += $('input[type=file]')[0].files[0].name;
            html += "<input type='button' class='delfile' onclick='delobject1(\"" + "fileupload" + filedatacount + "\",this)' /></ul>";
            filedatacount++;
            $(this).parent().parent().find('.filelist').append(html);


        })

    </script>

    @*-----------------------------------------End By Subhabrata Mondal 7_11_2015------------------------------------*@

    <script type="text/javascript">
        function ifduplicated() {
            if ($("#Ddl_Currency").val() != '0') {
                var curr = $("#Ddl_Currency").val();
                var lname = $("#txt_LegalName").val();

                var obj = new Object();
                obj.curr = curr;
                obj.lname = lname;

               
                var DBSP = new DB_SP_CONNECT();
                DBSP.ProcedureName = "POMS_CheckParentvendorexistense";
                DBSP.obj = obj;
                DBSP.isasync = false;
                var o = DBSP.call_DB_Procedure();
                o = o.data;
                console.log(o);
                if (parseInt(o[0].result) > 0) {
                    $('#txt_LegalName').addClass('errorClass');
                    $('#txt_LegalName').attr('title', 'This vendor already exists');

                    $('#Ddl_Currency').addClass('errorClass');
                    $('#Ddl_Currency').attr('title', 'This vendor already exists');

                    
                }
                else {
                    $('#txt_LegalName').attr('title', '');
                    $('#txt_LegalName').removeClass('errorClass');

                    $('#Ddl_Currency').attr('title', '');
                    $('#Ddl_Currency').removeClass('errorClass');

                }



            }
        }
        $("#Ddl_Currency").on("change", function () {

            ifduplicated();
            var p1 = $('#txt_Name').val().lastIndexOf(" (");
            console.log(p1);
            var nm = '';
            if (p1 == -1) {
                nm = $('#txt_Name').val();
            }
            else {
                nm = $('#txt_Name').val().substring(0, p1);
            }
            if (nm == '') {
                nm = $('#txt_LegalName').val();
            } 
            console.log(nm);

            if ($("#Ddl_Currency").val() != '0') {
                $("#txt_Name").val(nm + " (" + $("#Ddl_Currency option:selected").attr('data-currcode') + ")");
            }
            else {
                $("#txt_Name").val(nm);
            }
        });

        function buildcommonname() {
            ifduplicated();

            if ($("#Ddl_Currency").val() != '0') {
                $("#txt_Name").val($("#txt_LegalName").val() + " (" + $("#Ddl_Currency option:selected").attr('data-currcode') + ")");
            }
            else {
                $("#txt_Name").val($("#txt_LegalName").val());
            }
        }

        function r_chk(obj) {
            if ($(obj).is(':checked')) {
                $('#r_div').show();
            }
            else {
                $('#r_div').hide();
            }
        }
    </script>


</body>
</html>
