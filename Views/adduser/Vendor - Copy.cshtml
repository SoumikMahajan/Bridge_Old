<body>

    <div class="container-fluid" id="angulardiv" ng-app="customer" ng-controller="customer" style="zoom:0.95;">



        <div class="row">
            <div class="col-sm-12" style="margin-top:-20px;">
                <h3 class="section-header">
                    Add Vendor
                    <i style="cursor:pointer;" class="fa fa-info-circle mrg5L" data-toggle="popover" data-content="Here you will add the vendor and the address for accounting purposes. Afterwards you will be prompted to add a contact"></i>
                </h3>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-5 mrg10B">
                Invoice Terms: <select id="txt_Terms" ng-model="User.Terms_ID" style="width: 300px;">
                    <option value="0">--Select Terms--</option>
                    @Html.Raw(ViewData["getAllTerms"])
                </select>
            </div>
        </div>

        <div class="row">


            <div class="col-sm-2 req">
                <label>Legal Name</label>
                <input type="text" id="txt_LegalName" class="form-control text-uppercase" ng-model="User.FName" onkeyup="buildcommonname();" />
            </div>


            <div class="col-sm-2 req">
                <label>Common Name</label>
                <input type="text" id="txt_Name" ng-model="User.FName" class="form-control text-uppercase" />
            </div>

            <div class="col-sm-2 req">
                <label>Currency</label>
                <select id="Ddl_Currency" class="form-control">
                    @Html.Raw(ViewData["GetAllCurency"])
                </select>
            </div>


            <div class="col-sm-6">
                <label>Classification</label>
                <select id="Ddl_Clftion" multiple='multiple' class="form-control">
                    @Html.Raw(ViewData["GetClassification"])
                </select>
            </div>

        </div>


        <div class="row mrg10T">
            <div class="col-sm-2">

                <div class="form-group">
                    <div class="col-sm-12">
                        <label>Address</label>
                        <textarea id="txt_Addr" style="height:70px;" ng-model="User.Address1" class="form-control no-resize"></textarea>
                    </div>

                    <div class="col-sm-12">
                        <label>City</label>
                        <input type="text" id="txt_City" ng-model="User.City" class="form-control" />
                    </div>
                </div>
            </div>
            <div class="col-sm-2">
                <div class="form-group">
                    <div class="col-sm-12">
                        <label>Country</label>
                        <select id="Ddl_Country" onchange="GetCtryID(this);" class="form-control">
                            @Html.Raw(ViewData["GetAllCountry"])
                        </select>
                    </div>
                    <div class="col-sm-12">
                        <label>State/Prov</label>
                        <select id="Ddl_State" onchange="GetStateID(this);" class="form-control">
                            <option value="0" name="ddlState_0">--Select State/Prov--</option>
                        </select>
                    </div>

                    <div class="col-sm-12">
                        <label>Postal/Zip Code</label>
                        <input type="text" id="txt_ZipCode" ng-model="User.ZipCode" class="form-control postalcode" />
                    </div>


                </div>
            </div>

            <div class="col-sm-2 displaynone">

                <div class="col-sm-12">
                    <label>Email address</label>
                    <input type="text" id="txt_Email" ng-model="User.Email" class="form-control" />
                </div>

                <div class="col-sm-12">
                    <label>Phone</label>
                    <input type="text" id="txt_Phone" ng-model="User.Contact" class="form-control" />
                </div>

                <div class="col-sm-12">
                    <label>Phone 2</label>
                    <input type="text" id="txt_Phone2" ng-model="User.Contact2" class="form-control" />
                </div>
            </div>

            <div class="col-sm-2 displaynone">
                <div class="col-sm-12">
                    <label>Website</label>
                    <input type="text" id="txt_WebSiteUrl" ng-model="User.Address2" class="form-control" />
                </div>

                <div class="col-sm-12">
                    <label>Ext</label>
                    <input type="text" id="txt_Extension" ng-model="User.Extension" class="form-control" />

                </div>



                <div class="col-sm-12">
                    <label>Fax</label>
                    <input type="text" id="txt_Fax" ng-model="User.Fax" class="form-control" />
                </div>


            </div>

            <div class="col-sm-4">

                <label>Internal Notes</label>
                <textarea id="txt_VndrNotes" style="height:115px;" class="form-control no-resize"></textarea>

            </div>

        </div>



        <div class="row mrg5T">
            <div class="sm-12">
                <label>
                    Minority Owned Business
                    <input class="mrg5L" type="checkbox" id="Minority_check" />
                </label>
            </div>

        </div>

        <div class="row mrg5T">
            <div class="sm-12">
                <label>
                    Women Owned Business
                    <input class="mrg5L" type="checkbox" id="Woman_check" />
                </label>
            </div>

        </div>

        <div class="row mrg5T">
            <div class="col-sm-12">
                <label>
                    Remit To address different than Main address
                    <input class="mrg5L" onclick="r_chk(this);" type="checkbox" id="Remit_chk" />
                </label>
            </div>

        </div>

        <div class="row displaynone" id="r_div">

            <div class="col-sm-4">



                <div class="col-sm-6">
                    <label>Address</label>
                    <textarea id="Rtxt_Addr" ng-model="User.RAddress1" style="height:70px;" class="form-control no-resize"></textarea>

                    <label>City</label>
                    <input type="text" id="Rtxt_City" ng-model="User.RCity" class="form-control" />



                </div>


                <div class="col-sm-6">


                    <div class="col-sm-12" style="padding-left:2px;padding-right:0px;">
                        <label>Country</label>
                        <select id="RDdl_Country" onchange="GetCtryID2(this);" class="form-control">
                            @Html.Raw(ViewData["GetAllCountry"])
                        </select>
                    </div>
                    <div class="col-sm-12" style="padding-left:2px;padding-right:0px;">
                        <label>State/Prov</label>
                        <select id="RDdl_State" onchange="GetStateID(this);" class="form-control">
                            <option value="0" name="RddlState_0">--Select State/Prov--</option>
                        </select>
                    </div>

                    <div class="col-sm-12" style="padding-left:2px;padding-right:0px;">
                        <label>Postal/Zip Code</label>
                        <input type="text" class="postalcode form-control " id="Rtxt_ZipCode" ng-model="User.RZipCode" />
                    </div>

                </div>

            </div>

        </div>

        <div class="user_panel_container" style="width: 5%; margin-left: 2%; margin-top: 55px; float: right; display: none;">
            <span style="float: right;">Active</span>
            <input type="checkbox" id="txt_Actv" style="margin-left: 1%; margin-top: 1.5%; float: right;" ng-model="User.IsActive" />
        </div>









        <div class="user_panel_container" style="display: none;">
            <label>Short Name</label>
            <input type="text" id="txt_ShrtName" ng-model="User.LName" />
        </div>





        @*----------------------------------------Designed Start By Subhabrata Mondal 7_11_2015----------------------------------------*@

        <div class="edit_vendor_full" style="display: none;">
            <div class="user_panel_container" style="width: 10%;">
                <label>Upload Files : </label>
            </div>
            <div class="user_panel_container">
                <div class="user_panel_container1" style="margin-top: 20px; width: 50%;">

                    <fieldset>
                        <legend align="left">Vendor Files</legend>
                        <div class="upload-verify-container" style="padding: 12px;">
                            <div class="button-container">
                                <!-- Button to select & upload files -->
                                <span class="btn btn-success fileinput-button">
                                    <!-- The file input field used as target for the file upload widget -->
                                    Drop a file or click here to upload!
                                    <input id="fileupload" type="file" name="files[]" multiple class="upload-button-drag-style" />
                                </span>
                                <!-- The global progress bar -->
                                <!-- The list of files uploaded -->
                                <p style="float: left; clear: left;">
                                    Files selected&nbsp;:&nbsp;
                                </p>
                                <ul class="filelist" style="float: left;"></ul>
                            </div>
                        </div>
                    </fieldset>
                </div>
                <div class="user_panel_container1" style="margin-top: 20px; width: 50%;">
                </div>
            </div>
        </div>

        @*----------------------------------------Designed End By Subhabrata Mondal 7_11_2015----------------------------------------*@

















        <div class="user_panel_container" style="margin-bottom: 12px;">
        </div>





    </div>


    <div class="float-panel-container">
        <ul>
            <li id="btn_CrtPrntVndr"><a href="javascript:void(0);"><i class="fa fa-save mrg5R" title="Update" data-toggle="tooltip"></i><span class="tooltip-toggle">Update</span></a></li>

            <li id="btn_CnclPrntVndr"><a href="javascript:void(0);"><i class="fa fa-remove" title="Cancel" data-toggle="tooltip"></i><span class="tooltip-toggle">Cancel</span></a></li>

        </ul>
    </div>

