&gt;
(Fields!ItemCost.Value +  Fields!StateTax.Value),
"(" &amp; FormatNumber(SUM(Fields!InvoiceAmount.Value+Fields!StateTax2.Value+Fields!OtherTax.Value)-(Fields!ItemCost.Value +  Fields!StateTax.Value),2) &amp; ")"
,
FormatNumber((Fields!ItemCost.Value +  Fields!StateTax.Value)-SUM(Fields!InvoiceAmount.Value+Fields!StateTax2.Value+Fields!OtherTax.Value),2))</Value>
                              <Style>
                                <FontSize>6pt</FontSize>
                              </Style>
                            </TextRun>
