  <Code>Dim Num As Integer = 0
Dim tempstr As String = ""
Dim CurrentLineNumber As String=""
Dim PrevLineNumber As String=""
Dim LineNumberFirst As String = ""

Dim ItemNumber As String=""
Dim PrevItemNumber As String=""
Dim PONumber As String=""
Dim PrevPONumber As String=""
Dim Position As String=""
Dim PrevPosition  As String=""
Dim CheckID As String=""
Dim PrevCheckID  As String=""


Function AggregateString(PONotes as String,PONumber as String,LineNumber as String)
CurrentLineNumber  =LineNumber 
If PrevLineNumber ="" Then
PrevLineNumber = CurrentLineNumber  
If PONotes  &lt;&gt; "" Then
tempstr = tempstr+PONumber + " Notes:-"+PONotes + vbCrlf
End IF

Return tempStr
End IF

If CurrentLineNumber =PrevLineNumber and CurrentLineNumber &lt;&gt;""  Then
If PONotes  &lt;&gt; "" Then
tempstr = tempstr+PONumber + " Notes:-"+PONotes + vbCrlf
End IF

Return tempStr
End IF

If CurrentLineNumber &lt;&gt; PrevLineNumber and CurrentLineNumber &lt;&gt;""  Then
tempstr =""
PrevLineNumber = CurrentLineNumber  
If PONotes  &lt;&gt; "" Then
tempstr = tempstr+PONumber + " Notes:-"+PONotes + vbCrlf
End IF

Return tempStr
End If

End Function

Function ShowCounter(LineNumber as String)
If LineNumberFirst = "" Then
LineNumberFirst = LineNumber 
PrevLineNumber = LineNumberFirst 
return LineNumberFirst 
Else  If PrevLineNumber &lt;&gt; LineNumber Then
PrevLineNumber = LineNumber 
return PrevLineNumber 
End If 
End Function

Function ShowHideData(D1 as String,D2 as String,D3 as String,D4 as String)

If ItemNumber = "" Then
ItemNumber = D1 
PrevItemNumber = ItemNumber 
PONumber = D2  
PrevPONumber = PONumber 
Position = D3 
PrevPosition = Position 
CheckID = D4 
PrevCheckID = CheckID 
return true

Else if PrevItemNumber = D1 and  PrevPONumber = D2  and  PrevPosition = D3 and PrevCheckID  = D4 Then
return false
Else
PrevItemNumber  = D1
PrevPONumber = D2
PrevPosition = D3 
PrevCheckID  = D4 
return true
End If 
End Function</Code>
