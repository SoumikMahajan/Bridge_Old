  <Code>Dim public totalItemCost as Double
Dim public totalTax1 as Double
Dim public totalTax2 as Double
Dim public totalTax3 as Double
Dim public total as Double
Dim public totalProjectCost as Double
Dim public totalInvoiceAmount as Double
Dim public totalInvTax1 as Double
Dim public totalInvTax2 as Double
Dim public totalInvTax3 as Double
Dim public totalOtherTax as Double
Dim public totalInvoice as double


Public Function AddProjectCost(ByVal itemValue AS Double,ByVal op AS Integer) AS Double
                Select Case op
	Case 1
	totalItemCost = totalItemCost + itemValue
	Case 2
	totalTax1 = totalTax1 + itemValue
	Case 3
	totalTax2 = totalTax2 + itemValue
	Case 4
	totalTax3 = totalTax3 + itemValue
	Case 5
	total  = total + itemValue
	End Select
	totalProjectCost =( totalProjectCost + itemValue )
                return itemValue 
 
End Function
 



