                <TablixCell>
                  <CellContents>
                    <Textbox Name="Textbox34">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=IIF(SUM(
IIF(Fields!Position2.Value = 1,CDEC(Fields!TotalPayment.Value),CDEC("0"))
)="0","-",FormatNumber(
SUM(
IIF(Fields!Position2.Value = 1,CDEC(Fields!TotalPayment.Value),CDEC("0")))
,2))</Value>
                              <Style>
                                <FontSize>6.5pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style>
                            <TextAlign>Right</TextAlign>
                          </Style>
                        </Paragraph>
                      </Paragraphs>
                      <rd:DefaultName>Textbox34</rd:DefaultName>
                      <Style>
                        <Border>
                          <Style>None</Style>
                          <Width>0.5pt</Width>
                        </Border>
                        <TopBorder>
                          <Style>Solid</Style>
                        </TopBorder>
                        <PaddingLeft>2pt</PaddingLeft>
                        <PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop>
                        <PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="Textbox35">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=IIF(SUM(IIF(Fields!Position1.Value =1,CDEC(Fields!InvoiceAmount.Value
+Fields!InvTax1.Value+Fields!InvTax2.Value+Fields!InvTax3.Value
),CDEC("0"))) &lt;&gt;"0",

IIF(SUM(IIF(Fields!Position1.Value =1,CDEC(Fields!InvoiceAmount.Value
+Fields!InvTax1.Value+Fields!InvTax2.Value+Fields!InvTax3.Value
),CDEC("0")))
-SUM(
IIF(Fields!Position2.Value = 1,CDEC(Fields!TotalPayment.Value),CDEC("0"))) 
&lt; 0,
"(" &amp;

FormatNumber((SUM(IIF(Fields!Position1.Value =1,CDEC(Fields!InvoiceAmount.Value
+Fields!InvTax1.Value+Fields!InvTax2.Value+Fields!InvTax3.Value
),CDEC("0")))
-SUM(
IIF(Fields!Position2.Value = 1,CDEC(Fields!TotalPayment.Value),CDEC("0")))) * (-1),2)

&amp; ")"
 ,
 FormatNumber((SUM(IIF(Fields!Position1.Value =1,CDEC(Fields!InvoiceAmount.Value
+Fields!InvTax1.Value+Fields!InvTax2.Value+Fields!InvTax3.Value
),CDEC("0")))
-SUM(
IIF(Fields!Position2.Value = 1,CDEC(Fields!TotalPayment.Value),CDEC("0")))),2)
 
 ),
 IIF(SUM(IIF(Fields!Position.Value =1,CDEC(Fields!ItemCost.Value),CDEC("0")))
+SUM(IIF(Fields!Position.Value =1,CDEC(Fields!Tax1.Value),CDEC("0")))
+SUM(IIF(Fields!Position.Value =1,CDEC(Fields!Tax2.Value),CDEC("0")))
+SUM(IIF(Fields!Position.Value =1,CDEC(Fields!Tax3.Value),CDEC("0"))) = 0,
"-",
FormatNumber(SUM(IIF(Fields!Position.Value =1,CDEC(Fields!ItemCost.Value),CDEC("0")))
+SUM(IIF(Fields!Position.Value =1,CDEC(Fields!Tax1.Value),CDEC("0")))
+SUM(IIF(Fields!Position.Value =1,CDEC(Fields!Tax2.Value),CDEC("0")))
+SUM(IIF(Fields!Position.Value =1,CDEC(Fields!Tax3.Value),CDEC("0"))),2)))</Value>
                              <Style>
                                <FontSize>6.5pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style>
                            <TextAlign>Right</TextAlign>
                          </Style>
                        </Paragraph>
                      </Paragraphs>
                      <rd:DefaultName>Textbox35</rd:DefaultName>
                      <Style>
                        <Border>
                          <Style>None</Style>
                          <Width>0.5pt</Width>
                        </Border>
                        <TopBorder>
                          <Color>Black</Color>
                          <Style>Solid</Style>
                        </TopBorder>
                        <PaddingLeft>2pt</PaddingLeft>
                        <PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop>
                        <PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
